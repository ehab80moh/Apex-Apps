app SUPPLIERS-CONTRACTORS (
    name: Suppliers\Contractors
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#SUP.jpg
        text: Suppliers/Contractors
    }
    navigation {
        homeUrl: {
            page: 13
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-addActions
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme-2
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    css {
        fileUrls: #APP_FILES#custom#MIN#.css
    }
    authentication {
        scheme: @supplier-authentication
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        scheme: @app-authorization
    }
    sessionStateProtection {
        checksumSalt: BD2002719C655FB14F69F773EDF3481ACB5E39D8E8287ABA89B2DA19B8A4846B
    }
    globalization {
        translationMethod: translationApps
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Suppliers/Contractors
        }
    )

)
