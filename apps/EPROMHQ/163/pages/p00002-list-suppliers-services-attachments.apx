    dynamicAction refresh (
        name: REFRESH
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @list-suppliers-services-attachments
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @list-suppliers-services-attachments
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_zip blob;
                begin
                    -- create a temporary zip BLOB
                    dbms_lob.createtemporary(l_zip, true);
                
                    -- add all attachments for the supplier
                    for rec in (
                        select file_name, file_content
                        from sup_suppliers_attaches
                        where supplier_id = :SUPPLIER_ID
                    ) loop
                        if rec.file_content is not null 
                           and dbms_lob.getlength(rec.file_content) > 0 then
                            apex_zip.add_file(
                                p_zipped_blob => l_zip,
                                p_file_name   => rec.file_name,
                                p_content     => rec.file_content
                            );
                        end if;
                    end loop;
                
                    -- finish zip
                    apex_zip.finish(l_zip);
                
                    -- send to browser
                    sys.htp.init;
                    owa_util.mime_header('application/zip', false);
                    htp.p('Content-Disposition: attachment; filename="supplier_'||:SUPPLIER_ID||'_attachments.zip"');
                    owa_util.http_header_close;
                    wpg_docload.download_file(l_zip);
                
                    apex_application.g_unrecoverable_error := true;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 135399918427219640
        }
        config {
            buildOption: @commented-out
        }
    )

)
