    region list-suppliers-services-attachments (
        name: List Suppliers/services/Attachments
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ss.supplier_id,
                       ss.supplier_registered_no,
                       ss.company_name,
                       ss.applay_as,
                       ss.status,
                       ser.categories_products,
                       ss.is_new,
                
                       APEX_PAGE.GET_URL (
                           p_page   => 3,
                           p_items  => 'P3_SUPPLIER_ID,P3_COMPANY_NAME',
                           p_values => ss.supplier_id || ',' || ss.company_name ) as download_link   ,
                    APEX_PAGE.GET_URL (
                    p_page   => 26,
                    p_items  => 'P26_SUPPLIER_ID',
                    p_values => ss.supplier_id
                    -- ,p_plain_url => true
                ) 
                 as contacts_link
                from sup_suppliers ss
                left join ( 
                    select s.supplier_id,
                           -- XMLAGG returns a CLOB to handle massive strings
                           RTRIM(XMLAGG(XMLELEMENT(e, category || ' - ' || product || ' - ' || general_info, ' | ').EXTRACT('//text()') 
                           ORDER BY category, product, general_info).GETCLOBVAL(), ' | ') as categories_products
                    from sup_services s
                    group by s.supplier_id
                ) ser
                on ss.supplier_id = ser.supplier_id
                where ( ss.status in ('APPROVED')
                     or ss.status like '%APPROV%')
                order by
                    case
                        when ss.status = 'APPROVED' then 1
                  
                        else 2
                    end
                -- select  ss.supplier_id,
                --         ss.supplier_registered_no,
                --         ss.company_name,
                --         ss.applay_as,
                --         ss.status,
                --         /*ser.categories_products*/ '' categories_products,
                --         ss.is_new,
                --         APEX_PAGE.GET_URL (
                --             p_page   =>3,
                --             p_items  => 'P3_SUPPLIER_ID,p3_applay_as',
                --             p_values => ss.supplier_id || ',' || ss.applay_as )
                    
                --         as download_link
                -- from   sup_suppliers ss
                --   left join ( select s.supplier_id,
                --                 listagg(category || ' - ' || product || ' - '||general_info, ' | ')
                --                   within group (order by category, product,general_info) as categories_products
                --          from   sup_services s
                --          group by s.supplier_id
                --        ) ser
                --         on  ss.supplier_id = ser.supplier_id;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
