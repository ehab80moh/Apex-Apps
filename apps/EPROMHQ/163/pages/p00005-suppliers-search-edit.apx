            }
        )

        column HEADOFF_PHONE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Phone
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_SUPPLIERS"
                    where "HEADOFF_PHONE" is not null
                    and "SUPPLIER_ID" = :P5_SUPPLIER_ID
                    ```
            }
        )

        column LASTUPDATEDATE (
            reportColumnQueryId: 22
            derivedColumn: N
            heading {
                heading: Lastupdatedate
            }
            layout {
                sequence: 22
            }
            appearance {
                formatMask: YYYY-MM-DD
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_SUPPLIERS"
                    where "LASTUPDATEDATE" is not null
                    and "SUPPLIER_ID" = :P5_SUPPLIER_ID
                    ```
            }
        )

        column LAST_LOGIN_ON (
            reportColumnQueryId: 27
            derivedColumn: N
            heading {
                heading: Last Login
            }
            layout {
                sequence: 72
            }
            appearance {
                formatMask: YYYY-MM-DD
            }
        )

        column PASSWORD_HASH (
            reportColumnQueryId: 28
            derivedColumn: N
            type: hidden
            layout {
                sequence: 82
            }
        )

        column SECONDARY_BRANCH_INFO (
            reportColumnQueryId: 15
            derivedColumn: N
            heading {
                heading: Secondary Branch Info
            }
            layout {
                sequence: 15
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_SUPPLIERS"
                    where "SECONDARY_BRANCH_INFO" is not null
                    and "SUPPLIER_ID" = :P5_SUPPLIER_ID
                    ```
            }
        )

        column STATUS (
            reportColumnQueryId: 24
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 42
            }
        )

        column SUPPLIER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_SUPPLIERS"
                    where "SUPPLIER_ID" is not null
                    and "SUPPLIER_ID" = :P5_SUPPLIER_ID
                    ```
            }
        )

        column SUPPLIER_REGISTERED_NO (
