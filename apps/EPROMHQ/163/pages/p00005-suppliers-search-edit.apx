page 5 (
    name: Suppliers  Search Edit
    alias: SUPPLIERS-SEARCH-EDIT
    title: Suppliers  Search
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            
            /* Style input field */
            #P5_SEARCH {
                background-color: #d2dff8 !important;
                color: #0b3d91 !important;
                font-weight: bold !important;
                text-align: center !important;
                border: 1.5px solid #11508f !important;
                border-radius: 8px !important;
            }
            
            /* Style label */
            label[for="P5_SEARCH"] {
                color: #0D355D !important;
                font-weight: bold !important;
                font-size: 15px !important;
                text-align: center !important;
                }
                #P5_APPLAY_AS {
                background-color: #e2e8f2 !important;
                color: #336bc6 !important;
                font-weight: bold !important;
                text-align: center !important;
                border: 1.5px solid #11508f !important;
                border-radius: 8px !important;
            }
            
            /* Style label */
            label[for="P5_APPLAY_AS"] {
                color: #408edc !important;
                font-weight: bold !important;
                font-size: 15px !important;
                text-align: center !important;
                }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region b-attachments-b (
        name: <b>Attachments</b>
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       ATTACH_ID,
                       SUPPLIER_ID,
                       STATIC_NAME,
                       FILE_NAME,
                       MIME_TYPE,
                       ORIGINAL_NAME,
                       UPLOAD_DATE,
                       apex_util.prepare_url(
                            'f?p=' || :APP_ID || ':12:' || :APP_SESSION ||
                            '::::P12_ATTACH_ID:' || ATTACH_ID
                       ) as DOWNLOAD_LINK
                from SUP_SUPPLIERS_ATTACHES
                where SUPPLIER_ID = :P5_SUPPLIER_ID
                ```
            pageItemsToSubmit: P5_SUPPLIER_ID
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ATTACH_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column DOWNLOAD_LINK (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Download
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #DOWNLOAD_LINK#
                }
                linkText: <i class="fa fa-download"></i>
            }
        )

        column FILE_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: File Name
            }
            layout {
                sequence: 40
            }
        )

        column MIME_TYPE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Mime Type
            }
            layout {
                sequence: 50
            }
        )

        column ORIGINAL_NAME (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Original Name
            }
            layout {
                sequence: 70
            }
        )

        column STATIC_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Static Name
            }
            layout {
                sequence: 30
            }
        )

        column SUPPLIER_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column UPLOAD_DATE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

    )

