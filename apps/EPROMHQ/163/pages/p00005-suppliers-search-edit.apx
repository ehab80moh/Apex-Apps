    pageItem P5_APPLAY_AS (
        type: selectList
        label {
            label: Apply As
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Supplier;Supplier,Contractor;Contractor,Both;Both
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P5_APP_USER (
        type: hidden
        layout {
            sequence: 20
            region: @search
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: :app_user
        }
    )

    pageItem P5_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        layout {
            sequence: 30
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--postTextBlock
            ]
            icon: fa-search
            width: 30
            valuePlaceholder: Search...
        }
    )

    pageItem P5_SUPPLIER_ID (
        type: hidden
        layout {
            sequence: 40
            region: @suppliers-contractors
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                clearCache: 9
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button edit (
        buttonName: EDIT
        label: Edit
        layout {
            sequence: 20
            region: @suppliers-contractors
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                items: {
                    P9_SUPPLIER_ID: &P5_SUPPLIER_ID.
                }
                clearCache: 9
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: edit_master_btn
        }
        config {
            buildOption: @commented-out
        }
    )

    button pop-sup-services (
        buttonName: POP_SUP_SERVICES
        label: Add Services
        layout {
            sequence: 10
            region: @b-services-b
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                items: {
                    P10_SUPPLIER_ID: &P5_SUPPLIER_ID.
                }
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 40
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
                action: resetPagination
                request: RESET
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @b-services-b
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Services row(s) updated.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @b-services-b
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-2 (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @suppliers-contractors
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Suppliers row(s) updated.');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @suppliers-contractors
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P5_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: refresh
        execution {
            sequence: 160
        }
        when {
            selectionType: items
            items: P5_APPLAY_AS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
