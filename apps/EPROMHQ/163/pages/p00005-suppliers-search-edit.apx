            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_SUPPLIERS"
                    where "WEBSITE" is not null
                    and "SUPPLIER_ID" = :P5_SUPPLIER_ID
                    ```
