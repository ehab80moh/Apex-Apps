    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    x.supplier_id,
                    null as link_class,
                    apex_page.get_url(
                        p_items  => 'P5_SUPPLIER_ID',
                        p_values => x.supplier_id
                    ) as link,
                    null as ICON_CLASS,
                    null as LINK_ATTR,
                    null as ICON_COLOR_CLASS,
                    case
                        when coalesce(:p5_supplier_id,'0') = x.supplier_id
                        then 'is-active'
                        else ' '
                    end as list_class,
                    substr(x.COMPANY_NAME, 1, 50)
                        || case when length(x.COMPANY_NAME) > 50 then '...' end
                        as list_title,
                
                substr(x.applay_as, 1, 50)
                || case when length(x.applay_as) > 50 then '...' else '' end
                || ' - ' || initcap(x.status)
                as list_text,
                    null as list_badge
                from sup_suppliers x
                where
                    ( :p5_search is null
                      or upper(x.applay_as) like '%'||upper(:p5_search)||'%'
                      or upper(x.COMPANY_NAME) like '%'||upper(:p5_search)||'%'
                    )
                    and ( :P5_applay_as is null or upper(x.applay_as) = upper(:P5_applay_as))
                    and nvl(x.status, 'X') not in ('ACTIVE', 'PENDING')
                order by
                    case
                        when x.status = 'APPROVED' then 1
                        when x.status like '%APPROV%' then 2
                        else 3
                    end,
                    x.COMPANY_NAME
                ```
            pageItemsToSubmit: [
                P5_SEARCH
                P5_APPLAY_AS
            ]
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">No data found.</div>
        }

