page 7 (
    name: PASSWORD
    alias: PASSWORD
    title: Password
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region password (
        name: Password
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            icon: fa-lock-password
        }
    )

    pageItem P7_COMPANY_NAME (
        type: displayOnly
        label {
            label: Company Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P7_CONFERM_PASSWORD (
        type: password
        label {
            label: CONFERM PASSWORD
            alignment: left
        }
        layout {
            sequence: 60
            region: @password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P7_HEADOFF_MOBILE (
        type: displayOnly
        label {
            label: Mobile
            alignment: left
        }
        layout {
            sequence: 40
            region: @password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P7_PASSWORD (
        type: password
        label {
            label: Password
            alignment: left
        }
        settings {
            submitWhenEnterPressed: false
        }
        layout {
            sequence: 50
            region: @password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P7_SUPPLIER_ID (
        type: hidden
        layout {
            sequence: 20
            region: @password
            slot: regionBody
        }
    )

    button go-to-supplier (
        buttonName: GO_TO_SUPPLIER_17
        label: Complete Registration
        layout {
            sequence: 80
            region: @password
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 17
                items: {
                    P17_SUPPLIER_ID: &P7_SUPPLIER_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: GO_TO_SUPPLIER_17
        }
        serverSideCondition {
            type: never
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit
        layout {
            sequence: 70
            region: @password
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation 8-or (
        name: 8 or >
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  IF LENGTH(:P7_PASSWORD) < 8 THEN
                    RETURN FALSE; -- Password too short
                  ELSIF :P7_PASSWORD != :P7_CONFERM_PASSWORD THEN
                    RETURN FALSE; -- Passwords do not match
                  ELSE
                    RETURN TRUE; -- All good
                  END IF;
                END;
                ```
        }
        error {
            errorMessage: "&{PLEASE_ENTER_AT_LEAST_8_CHARACTERS}."
        }
    )

    validation password-not-matching (
        name: password not matching
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P7_PASSWORD = :P7_CONFERM_PASSWORD
        }
        error {
            errorMessage: "&{PLEASE_REPEAT_PASSWORD_CORRECTLY}."
        }
    )

    process update (
        name: UPDATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update sup_suppliers
                set PASSWORD_HASH = :P7_PASSWORD
                where supplier_id = :P7_SUPPLIER_ID;
                --apex_application.g_print_success_message := 'A new password created.';
                  apex_util.set_session_state('P17_SUPPLIER_ID', :P7_SUPPLIER_ID);
                  apex_application.g_print_success_message := 'Password created successfully.';
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 164851911711894026
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Set Supplier_id
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
                items: {
                    P9999_USERNAME: &P7_HEADOFF_MOBILE.
                }
            }
        }
    )

)
