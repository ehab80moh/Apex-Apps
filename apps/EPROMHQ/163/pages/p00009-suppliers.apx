page 9 (
    name: Edit_Suppliers
    alias: SUPPLIERS
    title: Suppliers
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region suppliers (
        name: Suppliers
        type: form
        source {
            location: localDatabase
            tableName: SUP_SUPPLIERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P9_ACTIVATED_ON (
        type: hidden
        layout {
            sequence: 280
            region: @suppliers
            slot: regionBody
        }
        source {
            formRegion: @suppliers
            column: ACTIVATED_ON
            dataType: timestamp
        }
    )

    pageItem P9_APPLAY_AS (
        type: selectList
        label {
            label: Applay As
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:مقاولون;مقاولون,موردون;موردون
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @suppliers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @suppliers
            column: APPLAY_AS
            dataType: varchar2
        }
    )

