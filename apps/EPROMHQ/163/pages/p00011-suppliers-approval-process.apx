            }
            sorting {
                sortable: false
            }
        )

        column EMPLOYEE_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 3
            }
        )

        column RECORD_STATUS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Record Status
            }
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 3
            }
        )

        column ROLE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Role
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 3
            }
        )

    )

