page 11 (
    name: New Suppliers Approval Process
    alias: SUPPLIERS-APPROVAL-PROCESS
    title: Suppliers Approval Process
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region approval-history (
        name: Approval History
        title: Approval / Reject Comments
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- SELECT
                --     procurement_by        AS approved_by,
                --     procurement_date     AS action_date,
                --     procurement_comment   AS comment_text,
                --     'PROCUREMENT'         AS role
                -- FROM sup_supplier_approvals
                -- WHERE supplier_id = :P11_SUPPLIER_ID
                
                -- UNION ALL
                
                -- SELECT
                --     technical_by,
                --     technical_date ,
                --     technical_comment,
                --     'TECHNICAL'
                -- FROM sup_supplier_approvals
                -- WHERE supplier_id = :P11_SUPPLIER_ID
                --   AND technical_comment IS NOT NULL
                
                -- UNION ALL
                
                -- SELECT
                --     financial_by,
                --     financial_date ,
                --     financial_comment,
                --     'FINANCE'
                -- FROM sup_supplier_approvals
                -- WHERE supplier_id = :P11_SUPPLIER_ID
                --   AND financial_comment IS NOT NULL
                
                -- UNION ALL
                
                -- SELECT
                --     legal_by,
                --     legal_date ,
                --     legal_comment,
                --     'LEGAL'
                -- FROM sup_supplier_approvals
                -- WHERE supplier_id = :P11_SUPPLIER_ID
                --   AND legal_comment IS NOT NULL
                
                SELECT
                    m.employee_name                    AS employee_name,
                    a.procurement_date                 AS action_date,
                    a.procurement_comment              AS comment_text,
                    'PROCUREMENT'                      AS role,
                    CASE
                        WHEN a.procurement_decision = 'REJECT' THEN 'REJECTED'
                        ELSE 'APPROVED'
                    END                                AS record_status
                FROM sup_supplier_approvals a
                JOIN sup_approval_members m
                  ON m.employee_num = a.procurement_by
                 AND m.approval_role = 'PROC'
                WHERE a.supplier_id = :P11_SUPPLIER_ID
                  --AND a.procurement_comment IS NOT NULL
                
                UNION ALL
                
                SELECT
                    m.employee_name,
                    a.technical_date,
                    a.technical_comment,
                    'TECHNICAL',
                    CASE
                        WHEN a.technical_decision = 'REJECT' THEN 'REJECTED'
                        ELSE 'APPROVED'
                    END
                FROM sup_supplier_approvals a
                JOIN sup_approval_members m
                  ON m.employee_num = a.technical_by
                 AND m.approval_role = 'TECH'
                WHERE a.supplier_id = :P11_SUPPLIER_ID
                  --AND a.technical_comment IS NOT NULL
                
                UNION ALL
                
                SELECT
                    m.employee_name,
                    a.financial_date,
                    a.financial_comment,
                    'FINANCE',
                    CASE
                        WHEN a.financial_decision = 'REJECT' THEN 'REJECTED'
                        ELSE 'APPROVED'
                    END
                FROM sup_supplier_approvals a
                JOIN sup_approval_members m
                  ON m.employee_num = a.financial_by
                 AND m.approval_role = 'FIN'
                WHERE a.supplier_id = :P11_SUPPLIER_ID
                 -- AND a.financial_comment IS NOT NULL
                
                UNION ALL
                
                SELECT
                    m.employee_name,
                    a.legal_date,
                    a.legal_comment,
                    'LEGAL',
                    CASE
                        WHEN a.legal_decision = 'REJECT' THEN 'REJECTED'
                        ELSE 'APPROVED'
                    END
                FROM sup_supplier_approvals a
                JOIN sup_approval_members m
                  ON m.employee_num = a.legal_by
                 AND m.approval_role = 'LEGAL'
                WHERE a.supplier_id = :P11_SUPPLIER_ID
                 -- AND a.legal_comment IS NOT NULL
                
                --ORDER BY 2 DESC;
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--scrollBody
            ]
            icon: fa-history
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                EXISTS (
                    SELECT 1
                    FROM sup_approval_members
                    WHERE employee_num = :APP_USER
                      --AND approval_role = 'PROC'
                      AND status = 'ACTIVE'
                )
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ACTION_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Action Date
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
        )

        column COMMENT_TEXT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Comment Text
            }
            layout {
