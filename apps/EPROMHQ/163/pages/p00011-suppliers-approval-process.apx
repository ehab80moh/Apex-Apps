    process page-default-supplier (
        name: Page Default Supplier
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_supplier_id sup_suppliers.supplier_id%type;
                begin
                    select supplier_id
                    into v_supplier_id
                    from (
                        with my_role as (
                            select approval_role
                            from sup_approval_members
                            where employee_num = :APP_USER
                              and status = 'ACTIVE'
                        )
                        select x.supplier_id
                        from sup_suppliers x
                        join my_role r on 1 = 1
                        where
                            (
                                :P11_SEARCH is null
                                or upper(x.company_name) like '%' || upper(:P11_SEARCH) || '%'
                                or upper(x.applay_as) like '%' || upper(:P11_SEARCH) || '%'
                            )
                        and (
                                (r.approval_role = 'PROC'  and x.status in ('COMPLETE'))
                             or (r.approval_role = 'TECH'  and x.status in ('PROCUREMENT_APPROVED'))
                             or (r.approval_role = 'FIN'   and x.status in ('TECHNICAL_APPROVED'))
                             or (r.approval_role = 'LEGAL' and x.status in ('FINANCE_APPROVED'))
                        )
                        order by x.company_name
                    )
                    where rownum = 1;
                
                    :P11_SUPPLIER_ID := v_supplier_id;
                
                exception
                    when no_data_found then
                        :P11_SUPPLIER_ID := null;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 194455300136640134
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_SUPPLIER_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    process set-default-supplier (
        name: Set Default Supplier
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_supplier_id sup_suppliers.supplier_id%type;
                begin
                    select supplier_id
                    into v_supplier_id
                    from (
                        with my_role as (
                            select approval_role
                            from sup_approval_members
                            where employee_num = :APP_USER
                              and status = 'ACTIVE'
                        )
                        select x.supplier_id
                        from sup_suppliers x
                        join my_role r on 1 = 1
                        where
                            (
                                :P11_SEARCH is null
                                or upper(x.company_name) like '%' || upper(:P11_SEARCH) || '%'
                                or upper(x.applay_as) like '%' || upper(:P11_SEARCH) || '%'
                            )
                        and (
                                (r.approval_role = 'PROC'  and x.status in ('COMPLETE'))
                             or (r.approval_role = 'TECH'  and x.status in ('PROCUREMENT_APPROVED'))
                             or (r.approval_role = 'FIN'   and x.status in ('TECHNICAL_APPROVED'))
                             or (r.approval_role = 'LEGAL' and x.status in ('FINANCE_APPROVED'))
                        )
                        order by x.company_name
                    )
                    where rownum = 1;
                
                    :P11_SUPPLIER_ID := v_supplier_id;
                
                exception
                    when no_data_found then
                        :P11_SUPPLIER_ID := null;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 194455248902640133
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_SUPPLIER_ID
        }
        config {
            buildOption: @commented-out
        }
    )

