    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH my_role AS (
                    SELECT approval_role
                    FROM sup_approval_members
                    WHERE employee_num = :APP_USER
                      AND status = 'ACTIVE'
                )
                SELECT 
                
                    x.supplier_id,
                    null AS link_class,
                    apex_page.get_url(
                        p_items  => 'P11_SUPPLIER_ID',
                        p_values => x.supplier_id
                    ) AS link,
                x.status AS icon_class,
                
                    case
                  when x.status like '%REJECT%' then 'aria-disabled="true"'
                end as link_attr,
                    null AS icon_color_class,
                
                    CASE 
                        WHEN COALESCE(:P11_SUPPLIER_ID,'0') = x.supplier_id THEN 'is-active'
                        ELSE ' '
                    END AS list_class,
                
                    SUBSTR(x.company_name, 1, 50) ||
                       CASE WHEN LENGTH(x.company_name) > 50 THEN '...' END AS list_title,
                
                case
                  when x.status like '%REJECT%' then
                       '<span style="color:#d63031;font-weight:bold">'||x.status||'</span>'
                  when x.status = 'COMPLETE' then
                       '<span style="color:#2ecc71;font-weight:bold">'||x.status||'</span>'
                  else
                       x.status
                end as list_text,
                
                
                case
                  when x.status like '%REJECT%' then 'u-text-danger'
                  when x.status = 'COMPLETE'   then 'u-text-success'
                  else 'u-text-muted'
                end as list_text_css,
                
                x.status as list_badge
                FROM sup_suppliers x
                JOIN my_role r ON 1 = 1
                WHERE 
                    -- SEARCH FILTER
                    (
                        :P11_SEARCH IS NULL
                        OR UPPER(x.company_name) LIKE '%'||UPPER(:P11_SEARCH)||'%'
                        OR UPPER(x.applay_as) LIKE '%'||UPPER(:P11_SEARCH)||'%'
                    )
                    AND
                    (
                        (r.approval_role = 'PROC'  AND x.status IN ('COMPLETE','PROCUREMENT_REJECTED','TECHNICAL_REJECTED','FINANCE_REJECTED','LEGAL_REJECTED'))
                        OR
                               ( r.approval_role = 'TECH'
                          and x.status in ('PROCUREMENT_APPROVED')
                          and exists (
                              select 1
                              from SUP_SUPPLIER_APPROVALS m
                              where m.supplier_id     = x.supplier_id
                                and m.technical_empno = :app_user        )        )
                        OR
                        (r.approval_role = 'FIN'   AND x.status IN ('TECHNICAL_APPROVED'/*,'FIN_REVIEW','FIN_REJECT'*/))
                        OR
                        (r.approval_role = 'LEGAL' AND x.status IN ('FINANCE_APPROVED'/*,'LEGAL_REVIEW','LEGAL_REJECT'*/))
                    )
                order by
                  case
                    when x.status = 'COMPLETE' then 1
                    when x.status like '%REJECT%' then 2
                    else 3
                  end,
                  x.company_name
                
                ```
            pageItemsToSubmit: [
                P11_SEARCH
                P11_APPLAY_AS
                P11_SUPPLIER_ID
            ]
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
