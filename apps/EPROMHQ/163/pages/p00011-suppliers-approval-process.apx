    region suppliers (
        name: Suppliers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select SUPPLIER_ID,
                       COMPANY_NAME,
                       APPLAY_AS,
                       COMPANY_CAPITAL,
                       HEADOFF_ADDRESS,
                       HEADOFF_PHONE,
                       HEADOFF_MOBILE,
                       HEADOFF_FAX,
                       HEADOFF_EMAIL,
                       WEBSITE,
                       EXPERIENCE_EGY,
                       EXPERIENCE_OUT_EGY,
                       BRANCHES_EGY,
                       BRANCHES_OUT_EGY,
                       SECONDARY_BRANCH_INFO,
                       CONTACT_PERSON,
                       CONTACT_POSITION,
                       CONTACT_MAIN_MOBILE,
                       CONTACT_SEC_MOBILE,
                       CONTACT_EMAIL,
                       CREATIONDATE,
                       LASTUPDATEDATE,
                       SUPPLIER_REGISTERED_NO,
                       STATUS,
                       CREATED_ON,
                       ACTIVATED_ON,
                       LAST_LOGIN_ON,
                       PASSWORD_HASH,
                       LOCATION_LINE,
                       IS_NEW
                  from SUP_SUPPLIERS
                 where "SUPPLIER_ID" = :P11_SUPPLIER_ID*/
                 WITH my_role AS (
                    SELECT approval_role
                    FROM sup_approval_members
                    WHERE employee_num = :APP_USER
                      AND status = 'ACTIVE'
                )
                SELECT 
                    ss.supplier_id,
                    ss.company_name,
                    APPLAY_AS,
                       COMPANY_CAPITAL,
                       HEADOFF_ADDRESS "HEAD OFFICE ADDRESS",
                       HEADOFF_PHONE "HEAD OFFICE PHONE",
                       HEADOFF_MOBILE "HEAD OFFICE MOBILE",
                   -- ss.supplier_registered_no,
                    ss.status,
                   -- ser.categories_products,
                    ss.creationdate,
                    ss.lastupdatedate
                FROM sup_suppliers ss
                JOIN my_role r ON 1 = 1
                   where ss.SUPPLIER_ID= :P11_SUPPLIER_ID
                
                -- LEFT JOIN (
                --     SELECT supplier_id,
                --            LISTAGG(category || ' - ' || product || ' - ' || COALESCE(general_info,''), ' | ')
                --                WITHIN GROUP (ORDER BY category, product) AS categories_products
                --     FROM sup_services
                --    where ss.SUPPLIER_ID= :P11_SUPPLIER_ID
                --     GROUP BY supplier_id
                -- ) ser ON ser.supplier_id = ss.supplier_id
                and (
                        (r.approval_role = 'PROC'  AND ss.status IN ('COMPLETE','PROCUREMENT_REJECTED','TECHNICAL_REJECTED','FINANCE_REJECTED','LEGAL_REJECTED')) OR
                        (r.approval_role = 'TECH'  AND ss.status IN ('PROCUREMENT_APPROVED'/*,'TECH_REVIEW','TECH_REJECT'*/)) OR
                        (r.approval_role = 'FIN'   AND ss.status IN ('TECHNICAL_APPROVED'/*,'FIN_REVIEW','FIN_REJECT'*/)) OR
                        (r.approval_role = 'LEGAL' AND ss.status IN ('FINANCE_APPROVED'/*,'LEGAL_REVIEW','LEGAL_REJECT'*/))
                      )
                ORDER BY ss.creationdate DESC;
                
                ```
            pageItemsToSubmit: P11_SUPPLIER_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent14
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
