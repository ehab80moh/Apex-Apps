    region completion-status (
        name: Completion Status
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_total_services    number;
                    l_total_attachments number;
                    l_html              clob;
                begin
                    -- Get counts for this supplier
                    select 
                        count(distinct ss.rowid),
                        count(distinct sa.attach_id)
                    into
                        l_total_services,
                        l_total_attachments
                    from sup_suppliers s
                    left join sup_suppliers_attaches sa on s.supplier_id = sa.supplier_id
                    left join sup_services ss on s.supplier_id = ss.supplier_id
                    where s.supplier_id = :P13_SUPPLIER_ID;
                
                    -- Start region HTML with smaller font
                    l_html := '<div style="font-size:20px;text-align:center">';
                
                    -- Check services
                    if l_total_services = 0 then
                        l_html := l_html || '<div class="t-Alert t-Alert--warning">No <span style="color:red;font-weight:bold;">services</span> uploaded for this supplier.</div>';
                    end if;
                
                    -- Check attachments
                    if l_total_attachments = 0 then
                        l_html := l_html || '<div class="t-Alert t-Alert--warning">No <span style="color:red;font-weight:bold;">attachments</span> uploaded for this supplier.</div>';
                    elsif l_total_attachments < 8 then
                        l_html := l_html || '<div class="t-Alert t-Alert--info"><span style="color:red;font-weight:bold;">' 
                                  || l_total_attachments || '</span> <span style="color:red;font-weight:bold;">attachments</span> uploaded, 8 required.</div>';
                    end if;
                
                    -- If everything is healthy
                    if l_total_services > 0 and l_total_attachments >= 8 then
                        l_html := l_html || '<div class="t-Alert t-Alert--success">Profile is healthy. <span style="color:green;font-weight:bold;">services</span> and <span style="color:green;font-weight:bold;">attachments</span> are complete.</div>';
                    end if;
                
                    -- Close region div
                    l_html := l_html || '</div>';
                
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 11
            parentRegion: @profile
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
    )

    region internal-dashboard (
        name: Internal_Dashboard
        title: Internal Dashboard
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Total Suppliers' title,
                       count(*) value,
                       'fa-users' icon
                from sup_suppliers
                
                union all
                
                select 'Approved Suppliers',
                       count(*),
                       'fa-check-circle'
                from sup_suppliers
                where status = 'APPROVED'
                
                union all
                
                -- select 'Pending Suppliers',
                --        count(*),
                --        'fa-clock'
                -- from sup_suppliers
                -- where status like '%PENDING%'
                
                select 'Pending Suppliers',
                       count(*),
                       'fa-hourglass-half'
                from sup_suppliers
                where status like '%PENDING%'
                   or (
                        status not like '%APPROV%'
                    and status not like '%REJECT%'
                      )
                
                union all
                
                select 'Rejected Suppliers',
                       count(*),
                       'fa-times-circle'
                from sup_suppliers
                where status like '%REJECT%'
                
                -- select 'Total Suppliers' title,
                --        count(*) value,
                --        'fa-building' icon,
                --        'blue' icon_class
                -- from sup_suppliers
                
                -- union all
                
                -- select 'Approved Suppliers',
                --        count(*) value,
                --        'fa-check-circle' icon,
                --        'green' icon_class
                -- from sup_suppliers
                -- where status = 'APPROVED'
                
                -- union all
                
                -- select 'Pending Suppliers',
                --        count(*) value,
                --        'fa-clock-o' icon,
                --        'orange' icon_class
                -- from sup_suppliers
                -- where status like '%PENDING%'
                --    or (
                --         status not like '%APPROV%'
                --     and status not like '%REJECT%'
                --       )
                
                -- union all
                
                -- select 'Rejected Suppliers',
                --        count(*) value,
                --        'fa-ban' icon,
                --        'red' icon_class
                -- from sup_suppliers
                -- where status like '%REJECT%';
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                 exists (
                    select 1
                    from sup_user_roles
                    where user_id = :APP_USER  )
                ```
        }
        componentAppearance {
            gridColumns: 4
        }
        card {
            primaryKeyColumn1: ICON
        }
        subtitle {
            column: TITLE
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div style="font-size:28px;font-weight:bold;text-align:center;">
                    &VALUE.
                </div>
                ```
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: ICON
        }
        media {
            advancedFormatting: true
            htmlExpression:
                ```html
                
                {! <span class="fa &ICON. fa-2x"></span>   /}
                
                <span class="fa &ICON." style="font-size:42px;color:#1976d2;"></span>
                
                
                
                ```
            position: first
        }
    )

