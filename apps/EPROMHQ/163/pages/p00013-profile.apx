    region profile (
        name: Profile
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SUPPLIER_ID,
                       COMPANY_NAME,
                       APPLAY_AS,
                       COMPANY_CAPITAL,
                       HEADOFF_ADDRESS,
                       HEADOFF_PHONE,
                       HEADOFF_MOBILE,
                       HEADOFF_FAX,
                       HEADOFF_EMAIL,
                       WEBSITE,
                       nvl(EXPERIENCE_EGY, '---') AS EXPERIENCE_EGY,
                       EXPERIENCE_OUT_EGY,
                       BRANCHES_EGY,
                       BRANCHES_OUT_EGY,
                       SECONDARY_BRANCH_INFO,
                       CONTACT_PERSON,
                       CONTACT_POSITION,
                       CONTACT_MAIN_MOBILE,
                       CONTACT_SEC_MOBILE,
                       CONTACT_EMAIL,
                       CREATIONDATE,
                       LASTUPDATEDATE,
                       SUPPLIER_REGISTERED_NO,
                       STATUS,
                       CREATED_ON,
                       ACTIVATED_ON,
                       LAST_LOGIN_ON,
                       PASSWORD_HASH,location_line
                  from SUP_SUPPLIERS
                  where supplier_id = :P13_SUPPLIER_ID
                ```
            pageItemsToSubmit: [
                SUP_SUPPLIER_ID
                P13_SUPPLIER_ID
                P13_COMPANY_NAME
                P13_APPLAY_AS
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: R_profile_id
        }
        security {
            authorizationScheme: @is-suppplier
        }
    )

    region profile-attachments (
        name: Profile Attachments
        title: Attachments
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    initcap(sa.static_name) AS document_type,
                    substr(sa.original_name,instr(sa.original_name,' - ')+3) AS file_name,
                    sa.upload_date,
                    sa.attach_id
                FROM sup_suppliers_attaches sa
                WHERE   supplier_id = :P13_SUPPLIER_ID
                
                
                ```
            pageItemsToSubmit: P13_SUPPLIER_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 
                    initcap(sa.static_name) AS document_type,
                    substr(sa.original_name,instr(sa.original_name,' - ')+3) AS file_name,
                    sa.upload_date,
                    sa.attach_id
                FROM sup_suppliers_attaches sa
                WHERE   supplier_id = :P13_SUPPLIER_ID
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ATTACH_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column DOCUMENT_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Document Type
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column FILE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: File Name
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
