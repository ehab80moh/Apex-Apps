                --                    procurement_decision= 'REJECT',
                --                    procurement_date    = sysdate,
                --                    procurement_comment = :P14_COMMENT
                --              where supplier_id = :P14_SUPPLIER_ID;
                
                --             v_reject_status := 'PROCUREMENT_REJECTED';
                
                --         when 'TECH' then
                --             update sup_supplier_approvals
                --                set technical_empno     = :P14_EMP_NUM,
                --                    technical_by        = :APP_USER,
                --                    technical_decision  = 'REJECT',
                --                    technical_date      = sysdate,
                --                    technical_comment   = :P14_COMMENT
                --              where supplier_id = :P14_SUPPLIER_ID;
                
                --             v_reject_status := 'TECHNICAL_REJECTED';
                
                --         when 'FIN' then
                --             update sup_supplier_approvals
                --                set financial_by        = :APP_USER,
                --                    financial_decision  = 'REJECT',
                --                    financial_date      = sysdate,
                --                    financial_comment   = :P14_COMMENT
                --              where supplier_id = :P14_SUPPLIER_ID;
                
                --             v_reject_status := 'FINANCE_REJECTED';
                
                --         when 'LEGAL' then
                --             update sup_supplier_approvals
                --                set legal_by            = :APP_USER,
                --                    legal_decision      = 'REJECT',
                --                    legal_date          = sysdate,
                --                    legal_comment       = :P14_COMMENT
                --              where supplier_id = :P14_SUPPLIER_ID;
                
                --             v_reject_status := 'LEGAL_REJECTED';
                --     end case;
                
                --     update sup_suppliers
                --        set status = v_reject_status
                --      where supplier_id = :P14_SUPPLIER_ID;
                
                --     --apex_util.close_dialog;
                
                -- end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 195292633470702134
        }
        serverSideCondition {
            whenButtonPressed: @submit-reject
        }
    )

    process send-sms-after-approval (
        name: SEND_SMS_AFTER_APPROVAL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_result VARCHAR2(50);
                BEGIN
                    l_result :=
                        sup_sms_after_decision(
                            p_supplier_id  => :P14_SUPPLIER_ID,
                            p_action       => 'SUBMIT-APPROVAL',
                            p_current_role => :P14_ROLE,
                            p_sender_empno  => :APP_USER
                        );
                END;
                
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 241510785538027302
        }
        serverSideCondition {
            whenButtonPressed: @submit-approval
        }
    )

    process send-sms-after-reject (
        name: SEND_SMS_AFTER_REJECT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_result VARCHAR2(50);
                BEGIN
                    l_result :=
                        sup_sms_after_decision(
                            p_supplier_id  => :P14_SUPPLIER_ID,
                            p_action       => 'SUBMIT-REJECT',
                            p_current_role => :P14_ROLE,
                            p_sender_empno  => :APP_USER
                        );
                END;
                
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 241510932318027304
        }
        serverSideCondition {
            whenButtonPressed: @submit-reject
        }
    )

    branch (
        name: Close
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 11
                clearCache: 11
                action: clearRegions
            }
        }
    )

)
