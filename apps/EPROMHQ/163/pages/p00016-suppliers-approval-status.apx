page 16 (
    name: Suppliers Approval Status
    alias: SUPPLIERS-APPROVAL-STATUS
    title: Suppliers Approval Status
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region suppliers-approval-status (
        name: Suppliers Approval Status
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.company_name,
                    s.applay_as,
                    REPLACE(s.status, '_', ' ') AS status,
                    q.supplier_id,
                    q.current_role,
                    q.assigned_empno,
                    e.emp_name,
                    q.last_route_date
                FROM (
                    SELECT
                        a.supplier_id,
                
                        /* ==========================================
                           CURRENT ROLE
                           Handle old rejection history using dates
                           ========================================== */
                        CASE
                            /* Rejection newer than Procurement approval */
                            WHEN (
                                   a.technical_decision = 'REJECT'
                                   AND a.technical_date > a.procurement_date
                                 )
                              OR (
                                   a.financial_decision = 'REJECT'
                                   AND a.financial_date > a.procurement_date
                                 )
                              OR (
                                   a.legal_decision = 'REJECT'
                                   AND a.legal_date > a.procurement_date
                                 )
                            THEN 'PROC'
                
                            /* Procurement approved; TECH not yet reviewed
                               after the latest Procurement approval */
                            WHEN a.procurement_decision = 'APPROVE'
                             AND (
                                    a.technical_date IS NULL
                                 OR a.technical_date <= a.procurement_date
                                 OR a.technical_decision IS NULL
                                 )
                            THEN 'TECH'
                
                            /* TECH approved after Procurement approval */
                            WHEN a.technical_decision = 'APPROVE'
                             AND a.technical_date > a.procurement_date
                             AND (
                                    a.financial_date IS NULL
                                 OR a.financial_date <= a.technical_date
                                 OR a.financial_decision IS NULL
                                 )
                            THEN 'FIN'
                
                            /* FIN approved after TECH approval */
                            WHEN a.financial_decision = 'APPROVE'
                             AND a.technical_date > a.procurement_date
                             AND a.financial_date > a.technical_date
                             AND (
                                    a.legal_date IS NULL
                                 OR a.legal_date <= a.financial_date
                                 OR a.legal_decision IS NULL
                                 )
                            THEN 'LEGAL'
                
                            /* All stages approved in the current cycle */
                            WHEN a.legal_decision = 'APPROVE'
                             AND a.legal_date > a.financial_date
                             AND a.financial_date > a.technical_date
                             AND a.technical_date > a.procurement_date
                            THEN 'FULLY APPROVED'
                
                        END AS current_role,
                
                        /* ==========================================
                           ASSIGNED EMPLOYEE
                           ========================================== */
                        CASE
                            WHEN (
                                   a.technical_decision = 'REJECT'
                                   AND a.technical_date > a.procurement_date
                                 )
                              OR (
                                   a.financial_decision = 'REJECT'
                                   AND a.financial_date > a.procurement_date
                                 )
                              OR (
                                   a.legal_decision = 'REJECT'
                                   AND a.legal_date > a.procurement_date
                                 )
                            THEN a.procurement_by
                
                            WHEN a.procurement_decision = 'APPROVE'
                             AND (
                                    a.technical_date IS NULL
                                 OR a.technical_date <= a.procurement_date
                                 OR a.technical_decision IS NULL
                                 )
                            THEN a.technical_empno
                
                            WHEN a.technical_decision = 'APPROVE'
                             AND a.technical_date > a.procurement_date
                             AND (
                                    a.financial_date IS NULL
                                 OR a.financial_date <= a.technical_date
                                 OR a.financial_decision IS NULL
                                 )
                            THEN a.financial_by
                
                            WHEN a.financial_decision = 'APPROVE'
                             AND a.technical_date > a.procurement_date
                             AND a.financial_date > a.technical_date
                             AND (
                                    a.legal_date IS NULL
                                 OR a.legal_date <= a.financial_date
                                 OR a.legal_decision IS NULL
                                 )
                            THEN a.legal_by
                
                            ELSE NULL
                        END AS assigned_empno,
                
                        /* ==========================================
                           LAST ROUTE DATE
                           ========================================== */
                        CASE
                            WHEN (
                                   a.technical_decision = 'REJECT'
                                   AND a.technical_date > a.procurement_date
                                 )
                              OR (
                                   a.financial_decision = 'REJECT'
                                   AND a.financial_date > a.procurement_date
                                 )
                              OR (
                                   a.legal_decision = 'REJECT'
                                   AND a.legal_date > a.procurement_date
                                 )
                            THEN a.procurement_date
                
                            WHEN a.procurement_decision = 'APPROVE'
                             AND (
                                    a.technical_date IS NULL
                                 OR a.technical_date <= a.procurement_date
                                 OR a.technical_decision IS NULL
                                 )
                            THEN a.procurement_date
                
                            WHEN a.technical_decision = 'APPROVE'
                             AND a.technical_date > a.procurement_date
                             AND (
                                    a.financial_date IS NULL
                                 OR a.financial_date <= a.technical_date
                                 OR a.financial_decision IS NULL
                                 )
                            THEN a.technical_date
                
                            WHEN a.financial_decision = 'APPROVE'
                             AND a.technical_date > a.procurement_date
                             AND a.financial_date > a.technical_date
                             AND (
                                    a.legal_date IS NULL
                                 OR a.legal_date <= a.financial_date
                                 OR a.legal_decision IS NULL
                                 )
                            THEN a.financial_date
                
                            WHEN a.legal_decision = 'APPROVE'
                            THEN a.legal_date
                
                        END AS last_route_date
                
                    FROM sup_supplier_approvals a
                ) q
                
                JOIN sup_suppliers s
                    ON s.supplier_id = q.supplier_id
                
                LEFT JOIN xxapex_hr_emp_data e
                    ON e.emp_number = q.assigned_empno
                
                ORDER BY
                    q.last_route_date DESC NULLS LAST,
                    s.company_name;
                 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
