    pageItem P17_BUSINESS_CATEGORY (
        type: selectList
        label {
            label: COMPANY BUSINESS CATEGORY
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select category as display_value,
                       category as return_value
                from sup_suppliers_business_categories
                where language =
                      case
                          when substr(upper(:app_language), 1, 2) = 'AR' then 'AR'
                          else 'EN'
                      end
                order by category;
                
                ```
            displayExtraValues: false
            nullDisplayValue: -- SELECT COMPANY BUSINESS CATEGORY --
        }
        layout {
            sequence: 140
            region: @supplier
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @supplier
            column: BUSINESS_CATEGORY
            dataType: varchar2
        }
    )

