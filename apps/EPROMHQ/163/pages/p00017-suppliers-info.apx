page 17 (
    name: SuppliersW
    alias: SUPPLIERS_INFO
    title: "&{SUPPLIER_INFORMATION}."
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        attributes: closeOnEscape:false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region supplier (
        name: Main Information
        type: form
        source {
            location: localDatabase
            tableName: SUP_SUPPLIERS
            pageItemsToSubmit: P17_SUPPLIER_ID
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard_container
        }
    )

    region wizard-progress (
        name: Registration Progress
        type: list
        source {
            list: @suppliers-registration
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

