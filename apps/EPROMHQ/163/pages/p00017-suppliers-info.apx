    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button next (
        buttonName: NEXT
        label: Next to Services
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button next-2 (
        buttonName: NEXT2
        label: Next2
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 18
                items: {
                    P18_SUPPLIER_ID: &P17_SUPPLIER_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        config {
            buildOption: @commented-out
        }
    )

    process initialize-form-suppliersw (
        name: Initialize form SuppliersW
        type: formInitialization
        formRegion: @supplier
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 131390043524884335
        }
    )

    process new (
        name: New
        type: formAutoRowProcessing
        formRegion: @supplier
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 131455153247988613
        }
    )

    process new-2 (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                insert into EPROMHQ.SUP_SUPPLIERS  ( supplier_id,company_name,applay_as )
                values
                ( :P17_SUPPLIER_ID,:P17_COMPANY_NAME,:P17_APPLAY_AS );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 131907944561953743
        }
        config {
            buildOption: @commented-out
        }
    )

    process new-3 (
        name: New_2
        type: executeCode
        source {
            plsqlCode: :P17_SUPPLIER_ID := :SUP_SUPPLIER_ID;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 131908560952953749
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @commented-out
        }
        comments {
            comments:
                ```
                select 1 from EPROMHQ.SUP_SUPPLIERS
                where SUPPLIER_ID = :SUP_SUPPLIER_ID  
                
                ```
        }
    )

    branch (
        name: Go To Page 18
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 18
                items: {
                    P18_SUPPLIER_ID: &P17_SUPPLIER_ID.
                    P18_APPLAY_AS: &P17_APPLAY_AS.
                }
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
