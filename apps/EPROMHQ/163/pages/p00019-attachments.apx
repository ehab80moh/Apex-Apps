    region classic-report (
        name: Classic_Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select ATTACH_ID,
                       SUPPLIER_ID,
                       STATIC_NAME,
                       FILE_NAME,
                       MIME_TYPE,
                       FILE_CONTENT,
                       ORIGINAL_NAME,
                       UPLOAD_DATE
                  from SUP_SUPPLIERS_ATTACHES
                 where supplier_id = :p19_supplier_id  */
                
                 select attach_id,
                       supplier_id,
                       STATIC_NAME,
                       FILE_NAME,
                       MIME_TYPE,
                       FILE_CONTENT,
                       ORIGINAL_NAME,
                       UPLOAD_DATE,
                    --    apex_util.prepare_url(
                    --        'f?p=' || :APP_ID || ':19:' || :APP_SESSION ||
                    --        '::::P19_DELETE_ID:' || attach_id
                    --    ) as 
                       
                       '--' delete_link
                from sup_suppliers_attaches
                where supplier_id = :P19_SUPPLIER_ID
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
