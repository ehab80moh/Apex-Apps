    process update-supplier-status-after-attachments (
        name: Update Supplier Status After Attachments
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_attach_cnt   NUMBER;
                    l_status       sup_suppliers.status%TYPE;
                BEGIN
                    -- Count attachments
                    SELECT COUNT(*)
                      INTO l_attach_cnt
                      FROM sup_suppliers_attaches
                     WHERE supplier_id = :P19_SUPPLIER_ID;
                
                    -- Get current supplier status
                    SELECT status
                      INTO l_status
                      FROM sup_suppliers
                     WHERE supplier_id = :P19_SUPPLIER_ID
                       FOR UPDATE;
                
                    ------------------------------------------------------------------
                    -- RULE:
                    -- First time completion ONLY
                    ------------------------------------------------------------------
                    IF l_attach_cnt >= 8
                       AND l_status = 'ACTIVE'
                    THEN
                        UPDATE sup_suppliers
                           SET status      = 'COMPLETE',
                               is_modified = 'N'
                         WHERE supplier_id = :P19_SUPPLIER_ID;
                    END IF;
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 205313465681615424
        }
        serverSideCondition {
            whenButtonPressed: @finish
        }
    )

    branch (
