    pageItem P19_STATIC_NAME (
        type: selectList
        label {
            label: Choose Attachment Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT display_name d,
                       static_name r
                FROM sup_attachment_types
                WHERE static_name NOT IN (
                        SELECT static_name
                        FROM sup_suppliers_attaches
                        WHERE supplier_id = :P19_SUPPLIER_ID
                      )
                AND (
                        -- Supplier must NOT see the construction certificate
                        :P19_APPLY_AS <> 'Supplier'
                        OR static_name <> 'egy-constructor'
                    )
                ORDER BY attach_id;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 80
            region: @attachments
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @attachments
            column: STATIC_NAME
            dataType: varchar2
        }
