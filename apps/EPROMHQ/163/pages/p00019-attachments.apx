    dynamicAction delete-attach (
        name: delete attach
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .del-attach
        }

        action native-confirm (
            action: confirm
            settings {
                message: are you sure to delete ?
                style: warning
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        delete from sup_suppliers_attaches
                        where attach_id = :P19_DELETE_ID;
                    end;
                    ```
                itemsToSubmit: P19_DELETE_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var id = $(this.triggeringElement).data('id');
                    console.log('id is: ' + id);
                    $s('P19_DELETE_ID',id);
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action submit-page (
            name: Submit page
            action: submitPage
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    validation validate-supplier-attachments (
        name: Validate Supplier Attachments
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_required_types number;
                    l_uploaded_required number;
                begin
                    ----------------------------------------------------------------
                    -- 1. Count mandatory attachment TYPES
                    ----------------------------------------------------------------
                    select count(*)
                      into l_required_types
                      from sup_attachment_types
                     where exclude_from is null;
                
                    ----------------------------------------------------------------
                    -- 2. Count uploaded mandatory attachment TYPES
                    ----------------------------------------------------------------
                    select count(distinct a.static_name)
                      into l_uploaded_required
                      from sup_suppliers_attaches a
                      join sup_attachment_types t
                        on t.static_name = a.static_name
                     where a.supplier_id = :p19_supplier_id
                       and t.exclude_from is null;
                
                    ----------------------------------------------------------------
                    -- VALIDATION
                    ----------------------------------------------------------------
                    if l_uploaded_required < l_required_types then
                        return '⚠️ Please upload all mandatory attachments before continuing.';
                    end if;
                
                    return null; -- VALID
                end;
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST IN ('FINISH'/*,'PREVIOUS'*/)
        }
    )

    process auto-dml (
        name: Auto_DML
        type: formAutoRowProcessing
