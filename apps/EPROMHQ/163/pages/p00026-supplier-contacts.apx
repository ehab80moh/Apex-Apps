page 26 (
    name: Supplier Contacts
    alias: SUPPLIER-CONTACTS
    title: Supplier Contacts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* Style input field */
            #P26_COMPANY_NAME {
                background-color: #b9c9e9 !important;
                color: #0b3d91 !important;
                font-weight: bold !important;
                text-align: center !important;
                border: 1.5px solid #11508f !important;
                border-radius: 8px !important;
            }
            
            /* Style label */
            label[for="P26_COMPANY_NAME"] {
                color: #0D355D !important;
                font-weight: bold !important;
                font-size: 13px !important;
                text-align: center !important;
                }
            
            
             #P26_CONTACT_PERSON {
                background-color: #b6c9eb !important;
                color: #0b3d91 !important;
                font-weight: bold !important;
                text-align: center !important;
                border: 1.5px solid #11508f !important;
                border-radius: 8px !important;
            }
            
            label[for="P26_CONTACT_PERSON"] {
                color: #0D355D !important;
                font-weight: bold !important;
                font-size: 13px !important;
                text-align: center !important;
                }
            ```
    }
    readOnly {
        type: always
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
                t-Region-orderBy--center
            ]
        }
        settings {
            outputAs: text
        }
    )

    region supplier-contacts (
        name: Supplier Contacts
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select supplier_id,
                    Company_name,
                    HEADOFF_MOBILE,
                    HEADOFF_PHONE,
                    HEADOFF_FAX,
                    HEADOFF_EMAIL,
                    WEBSITE,
                    HEADOFF_ADDRESS,
                    CONTACT_PERSON,
                    CONTACT_POSITION,
                    CONTACT_MAIN_MOBILE,
                    CONTACT_SEC_MOBILE,
                    CONTACT_EMAIL
                from sup_suppliers
                where supplier_id = :P26_SUPPLIER_ID
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region-orderBy--center
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P26_COMPANY_NAME (
        type: displayOnly
        label {
            label: Company Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @supplier-contacts
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @supplier-contacts
            column: COMPANY_NAME
            dataType: varchar2
        }
    )

