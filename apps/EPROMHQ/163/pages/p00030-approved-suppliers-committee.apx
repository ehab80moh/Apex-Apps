                    ```javascript-browser
                    (function () {
                    
                        var region = apex.region("Committee");
                        var ig$ = region.widget();
                        var gridView = ig$.interactiveGrid("getViews", "grid");
                    
                        if (!gridView || !gridView.view$) {
                            return;
                        }
                    
                        var i = 1;
                    
                        gridView.view$.find("tbody tr").each(function () {
                            $(this).find("td[headers='ROW_NUM']").text(i++);
                        });
                    
                    })();
                    
