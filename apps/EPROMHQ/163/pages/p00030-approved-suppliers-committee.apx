    process approve-committee-proc (
        name: APPROVE_COMMITTEE_PROC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_ids apex_t_varchar2;
                begin
                
                    if apex_application.g_x01 is null then
                        apex_json.open_object;
                        apex_json.write('status','error');
                        apex_json.write('message','No suppliers selected.');
                        apex_json.close_object;
                        return;
                    end if;
                
                    if :P30_COMMITTEE_DATE is null then
                        apex_json.open_object;
                        apex_json.write('status','error');
                        apex_json.write('message','Committee Date is required.');
                        apex_json.close_object;
                        return;
                    end if;
                
                    l_ids := apex_string.split(apex_application.g_x01, ',');
                
                update sup_suppliers
                   set committee_approved = 'Y',
                       committee_date     = to_date(:P30_COMMITTEE_DATE,'DD-MM-YYYY')
                 where supplier_id in (
                       select to_number(column_value)
                       from table(l_ids)
                 );
                
                    apex_json.open_object;
                    apex_json.write('status','success');
                    apex_json.write('updated_count', sql%rowcount);
                    apex_json.close_object;
                
                exception
                    when others then
                        rollback;
                
                        apex_json.open_object;
                        apex_json.write('status','error');
                        apex_json.write('message', sqlerrm);
                        apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 265618648337371307
        }
    )

