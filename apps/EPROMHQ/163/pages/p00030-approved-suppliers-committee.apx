    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region approved-suppliers-committee (
        name: Approved Suppliers Committee
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                --row_number() over (order by s.company_name) as "NO",
                    s.supplier_id,
                    s.company_name,
                    s.applay_as,
                        case committee_approved
                        when 'N' then 'Not Approved Yet'
                        when Null then 'Not Approved Yet'
                        when 'Y' then 'Committee Approved'
                    end committee_approved,
                
                    /* Aggregated Categories */
                    (
                        select listagg(distinct ss.category, ', ')
                               within group (order by ss.category)
                        from sup_services ss
                        where ss.supplier_id = s.supplier_id
                    ) as service_categories,
                
                    /* Procurement */
                    proc.employee_name ||
                    case
                        when a.procurement_date is not null
                        then chr(10) || to_char(a.procurement_date,'DD/MM/YYYY')
                        else null
                    end as procurement_name,
                
                    /* Technical */
                    tech.employee_name ||
                    case
                        when a.technical_date is not null
                        then chr(10) || to_char(a.technical_date,'DD/MM/YYYY')
                        else null
                    end as technical_name,
                
                    /* Financial */
                    fin.employee_name ||
                    case
                        when a.financial_date is not null
                        then chr(10) || to_char(a.financial_date,'DD/MM/YYYY')
                        else null
                    end as financial_name,
                
                    /* Legal */
                    leg.employee_name ||
                    case
                        when a.legal_date is not null
                        then chr(10) || to_char(a.legal_date,'DD/MM/YYYY')
                        else null
                    end as legal_name
                
                from sup_suppliers s
                
                left join (
                    select a1.*
                    from sup_supplier_approvals a1
                    where a1.approval_id = (
                        select max(a2.approval_id)
                        from sup_supplier_approvals a2
                        where a2.supplier_id = a1.supplier_id
                    )
                ) a
                on a.supplier_id = s.supplier_id
                
                left join sup_approval_members proc
                    on proc.employee_num = a.procurement_by
                   and proc.approval_role = 'PROC'
                   and proc.status = 'ACTIVE'
                
                left join sup_approval_members tech
                    on tech.employee_num = a.technical_empno
                   and tech.approval_role = 'TECH'
                   and tech.status = 'ACTIVE'
                
                left join sup_approval_members fin
                    on fin.employee_num = a.financial_by
                   and fin.approval_role = 'FIN'
                   and fin.status = 'ACTIVE'
                
                left join sup_approval_members leg
                    on leg.employee_num = a.legal_by
                   and leg.approval_role = 'LEGAL'
                   and leg.status = 'ACTIVE'
                
                where s.status = 'APPROVED'
                and   s.COMMITTEE_APPROVED like 'N'
                
                
                -- select
                --     s.supplier_id,
                --     s.company_name,
                --     s.APPLAY_AS,
                --     s.committee_approved,
                
                --     /* Procurement */
                --     proc.employee_name ||
                --     case
                --         when a.procurement_date is not null
                --         then chr(10) || to_char(a.procurement_date,'DD/MM/YYYY')
                --         else null
                --     end as procurement_name,
                
                --     /* Technical */
                --     tech.employee_name ||
                --     case
                --         when a.technical_date is not null
                --         then chr(10) || to_char(a.technical_date,'DD/MM/YYYY')
                --         else null
                --     end as technical_name,
                
                --     /* Financial */
                --     fin.employee_name ||
                --     case
                --         when a.financial_date is not null
                --         then chr(10) || to_char(a.financial_date,'DD/MM/YYYY')
                --         else null
                --     end as financial_name,
                
                --     /* Legal */
                --     leg.employee_name ||
                --     case
                --         when a.legal_date is not null
                --         then chr(10) || to_char(a.legal_date,'DD/MM/YYYY')
                --         else null
                --     end as legal_name
                
                -- from sup_suppliers s
                
                -- left join (
                --     select a1.*
                --     from sup_supplier_approvals a1
                --     where a1.approval_id = (
                --         select max(a2.approval_id)
                --         from sup_supplier_approvals a2
                --         where a2.supplier_id = a1.supplier_id
                --     )
                -- ) a
                -- on a.supplier_id = s.supplier_id
                
                -- left join sup_approval_members proc
                --     on proc.employee_num = a.procurement_by
                --    and proc.approval_role = 'PROC'
                --    and proc.status = 'ACTIVE'
                
                -- left join sup_approval_members tech
                --     on tech.employee_num = a.technical_empno
                --    and tech.approval_role = 'TECH'
                --    and tech.status = 'ACTIVE'
                
                -- left join sup_approval_members fin
                --     on fin.employee_num = a.financial_by
                --    and fin.approval_role = 'FIN'
                --    and fin.status = 'ACTIVE'
                
                -- left join sup_approval_members leg
                --     on leg.employee_num = a.legal_by
                --    and leg.approval_role = 'LEGAL'
                --    and leg.status = 'ACTIVE'
                
                -- where s.status = 'APPROVED'
                
                --order by s.company_name
                -----------------------------------------------------------------------------------------
                -- select
                
                --     s.supplier_id,
                --     s.company_name,
                --     s.committee_approved,
                
                --     /* Procurement */
                --     proc.employee_name as procurement_name,
                
                --     /* Technical */
                --     tech.employee_name as technical_name,
                
                --     /* Finance */
                --     fin.employee_name as financial_name,
                
                --     /* Legal */
                --     leg.employee_name as legal_name
                
                -- from sup_suppliers s
                -- left outer join sup_supplier_approvals a
                --      on a.supplier_id = s.supplier_id
                
                -- left join sup_approval_members proc
                --        on proc.employee_num = a.procurement_by
                --       and proc.approval_role = 'PROC'
                --       and proc.status = 'ACTIVE'
                
                -- left join sup_approval_members tech
                --        on tech.employee_num = a.technical_empno
                --       and tech.approval_role = 'TECH'
                --       and tech.status = 'ACTIVE'
                
                -- left join sup_approval_members fin
                --        on fin.employee_num = a.financial_by
                --       and fin.approval_role = 'FIN'
                --       and fin.status = 'ACTIVE'
                
                -- left join sup_approval_members leg
                --        on leg.employee_num = a.legal_by
                --       and leg.approval_role = 'LEGAL'
                --       and leg.status = 'ACTIVE'
                
                -- where s.status = 'APPROVED'
                -- --   and a.procurement_decision = 'APPROVE'
                -- --   and a.technical_decision   = 'APPROVE'
                -- --   and a.financial_decision   = 'APPROVE'
                -- --   and a.legal_decision       = 'APPROVE'
                ```
            pageItemsToSubmit: P30_DECISION_NO
        }
        layout {
            sequence: 30
            slot: body
        }
