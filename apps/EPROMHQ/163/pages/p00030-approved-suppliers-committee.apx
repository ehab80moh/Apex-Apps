    button approve-committee (
        buttonName: Approve_Committee
        label: Approve For Committee
        layout {
            sequence: 10
            region: @approved-suppliers-committee
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--pill
                t-Button--stretch
            ]
        }
        behavior {
            action: triggerAction
        }

        triggerAction confirm (
            name: Confirm
            action: confirm
            settings {
                message: Are you sure you want to approve the selected suppliers as a committee Approved?
            }
            execution {
                sequence: 10
            }
        )

        triggerAction js-button (
            name: JS BUTTON
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                    
                        var region = apex.region("Committee");
                        if (!region) {
                            apex.message.alert("Region not found.");
                            return;
                        }
                    
                        var ig$ = region.widget();
                        var gridView = ig$.interactiveGrid("getViews", "grid");
                    
                        if (!gridView) {
                            apex.message.alert("Grid not ready.");
                            return;
                        }
                    
                        var model = gridView.model;
                        var selected = gridView.getSelectedRecords();
                    
                        if (!selected || selected.length === 0) {
                            apex.message.alert("Please select at least one supplier.");
                            return;
                        }
                    
                        var ids = selected.map(function (record) {
                            return model.getValue(record, "SUPPLIER_ID");
                        }).filter(function (v) {
                            return v !== null;
                        });
                    
                        if (ids.length === 0) {
                            apex.message.alert("No valid suppliers selected.");
                            return;
                        }
                    
                        if (!apex.item("P30_COMMITTEE_DATE").getValue()) {
                            apex.message.alert("Please select Committee Date.");
                            return;
                        }
                    
                        apex.server.process(
                            "APPROVE_COMMITTEE_PROC",
                            {
                                x01: ids.join(","),
                                pageItems: "#P30_COMMITTEE_DATE"
                            },
                            {
                                dataType: "json",
                                success: function (pData) {
                    
                                    if (!pData) {
                                        apex.message.alert("Empty server response.");
                                        return;
                                    }
                    
                                    if (pData.status === "success") {
                    
                                        apex.message.showPageSuccess(
                                            "Updated rows: " + pData.updated_count
                                        );
                    
                                        region.refresh();
                    
                                    } else {
                                        apex.message.alert(pData.message);
                                    }
                                },
                                error: function (jqXHR) {
                                    console.log(jqXHR.responseText);
                                    apex.message.alert("Server error occurred.");
                                }
                            }
                        );
                    
                    })();
                    
                    // apex.server.process(
                    //   "APPROVE_COMMITTEE_PROC",
                    //   { x01: apex.item("P30_ITEMS").getValue()  },
                    //   {
                    //     success: function (pData) {
                    //       if (pData.status === "success") {
                    //         apex.message.showPageSuccess("Committee approval completed. Updated: " + pData.updated_count);
                    //         ig$.interactiveGrid("refresh");
                    //       } else {
                    //         apex.message.alert(pData.message || "Error");
                    //       }
                    //     },
                    //     error: function (jqXHR, textStatus, errorThrown) {
                    //       apex.message.alert("Ajax error: " + (jqXHR.responseText || errorThrown));
                    //     }
                    //   }
                    // );
                    
                    ```
            }
            execution {
                sequence: 30
            }
        )

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approved-suppliers-committee
            }
            execution {
                sequence: 40
            }
        )

    )

