            }
        )

        triggerAction plugin-be-apexrnd-aop-da (
            action: plugin/ucApexOfficePrintAopDa
            settings {
                templateType: filenameWithPathRelativeToAopServer
                templateSource3: C:\aop_24_2\reports\committee_template.docx
                dataSource:
                    ```sql
                    with suppliers_q as (
                        select
                            s.supplier_id
                        from sup_suppliers s
                        where instr(',' || :P30_ITEMS || ',',
                                    ',' || to_char(s.supplier_id) || ',') > 0
                        and s.status = 'APPROVED'
                    )
                    select
                    
                      'Committee_Report_' || :P30_COMMITTEE_NO as "filename",
                      cursor(
                        select
                            :P30_COMMITTEE_NO  as "COMMITTEE_NO",
                            :P30_COMMITTEE_DATE as "COMMITTEE_DATE",
                            :P30_DECISION_NO as "DECISION_NO",
                            (select count(*) from suppliers_q) as "S_TOT",
                            cursor(
                                select
                                    row_number() over(order by s.company_name) as "NO",
                                    -- count(*) over() as "S_COUNT",
                                    s.supplier_id,
                                    s.company_name,
                                    case 
                                        when s.applay_as = 'BOTH' then 'Supplier/Contractor'
                                        else s.applay_as
                                    end as applay_as,
                    
                                    /* Service Categories */
                                   sc.SERVICE_CATEGORIES,
                    
                                    /* Procurement */
                                    proc.employee_name as procurement_name,
                                    to_char(a.procurement_date,'DD/MM/YYYY') as procurement_date,
                    
                                    /* Technical */
                                    tech.employee_name as technical_name,
                                    to_char(a.technical_date,'DD/MM/YYYY') as technical_date,
                    
                                    /* Financial */
                                    fin.employee_name as financial_name,
                                    to_char(a.financial_date,'DD/MM/YYYY') as financial_date,
                    
                                    /* Legal */
                                    leg.employee_name as legal_name,
                                    to_char(a.legal_date,'DD/MM/YYYY') as legal_date
                    
                                from sup_suppliers s
                                   left join (
                                        select
                                            supplier_id,
                                            listagg(distinct category, ', ')
                                            within group (order by category) as service_categories
                                        from sup_services
                                        group by supplier_id
                                        ) sc
                                on sc.supplier_id = s.supplier_id
                                left join (
                                    select a1.*
                                    from sup_supplier_approvals a1
                                    where a1.approval_id = (
                                        select max(a2.approval_id)
                                        from sup_supplier_approvals a2
                                        where a2.supplier_id = a1.supplier_id
                                    )
                                ) a
                                on a.supplier_id = s.supplier_id
                    
                                left join sup_approval_members proc
                                    on proc.employee_num = a.procurement_by
                                   and proc.approval_role = 'PROC'
                                   and proc.status = 'ACTIVE'
                    
                                left join sup_approval_members tech
                                    on tech.employee_num = a.technical_empno
                                   and tech.approval_role = 'TECH'
                                   and tech.status = 'ACTIVE'
                    
                                left join sup_approval_members fin
                                    on fin.employee_num = a.financial_by
                                   and fin.approval_role = 'FIN'
                                   and fin.status = 'ACTIVE'
                    
                                left join sup_approval_members leg
                                    on leg.employee_num = a.legal_by
                                   and leg.approval_role = 'LEGAL'
                                   and leg.status = 'ACTIVE'
                    
                                where instr(',' || :P30_ITEMS || ',',
                                            ',' || to_char(s.supplier_id) || ',') > 0
                                and s.status = 'APPROVED'
                            
                    
                            ) as "SUPPLIERS"
                    
                        from dual
                    ) as "data"
                    from dual
                    
                    
                    ```
                initPlSqlCode: aop_api_pkg.g_output_filename := 'Committee_&P30_COMMITTEE_NO.';
                outputType: wordDocx
            }
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: jsExpression
                javaScriptExpression:
                    ```javascript-browser
                    apex.item("P30_ITEMS").getValue() !== "" &&
                    apex.item("P30_COMMITTEE_DATE").getValue() !== "" &&
                    apex.item("P30_COMMITTEE_NO").getValue() !== ""
                    ```
            }
            comments {
                comments: https://www.webtoolkitonline.com/sql-minifier.html
            }
        )

    )

    dynamicAction da-collect-selected-ids (
        name: DA_Collect_Selected_IDs
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @approved-suppliers-committee
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                    
                        var region = apex.region("Committee");
                        if (!region) return;
                    
                        var ig$ = region.widget();
                        var gridView = ig$.interactiveGrid("getViews","grid");
                    
                        if (!gridView) return;
                    
                        var model = gridView.model;
                    
                        // ✅ correct selection API
                        var selectedRecords = gridView.getSelectedRecords();
                    
                        var ids = [];
                    
                        selectedRecords.forEach(function(record){
                            var val = model.getValue(record, "SUPPLIER_ID");
                            if (val) {
                                ids.push(val);
                            }
                        });
                    
                        apex.item("P30_ITEMS").setValue(ids.join(","));
                    
                    })();
                    
                    // (function () {
                    //   // IG Static ID
                    //   var region = apex.region("Committee");
