page 100 (
    name: roles
    alias: ROLES1
    title: roles
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ROLE_ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P100_ROLE_ID', p_values => "ROLE_ID") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P100_ROLE_ID,'0') = "ROLE_ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("ROLE_NAME", 1, 50)||( case when length("ROLE_NAME") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("ROLE_ID", 1, 50)||( case when length("ROLE_ID") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "SUP_ROLES" x
                where (:P100_SEARCH is null
                        or upper(x."ROLE_NAME") like '%'||upper(:P100_SEARCH)||'%'
                        or upper(x."ROLE_ID") like '%'||upper(:P100_SEARCH)||'%'
                    )
                order by "ROLE_NAME"
                ```
            pageItemsToSubmit: P100_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">No data found.</div>
        }

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ICON_CLASS
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: ICON_COLOR_CLASS
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: LINK
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: LINK_ATTR
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: LINK_CLASS
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: LIST_BADGE
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: LIST_CLASS
                alignment: center
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: LIST_TEXT
                alignment: center
            }
            layout {
                sequence: 9
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: LIST_TITLE
                alignment: center
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column ROLE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ROLE_ID
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

    )

    region no-record-selected (
        name: No Record Selected
        type: staticContent
        source {
            htmlCode: No Record Selected
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P100_ROLE_ID
        }
    )

    region region-display-selector (
        name: Region Display Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: js-detail-rds
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ROLE_ID
        }
        settings {
            rememberSelection: false
        }
    )

    region roles (
        name: Roles
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- select ROLE_ID,
                --        ROLE_NAME,
                --        ROLE_PAGES
                --   from SUP_ROLES
                --  where "ROLE_ID" = :P100_ROLE_ID
                
                select r.role_id,
                       r.role_name,
                       (
                         select listagg(p.page_title || ' (' || p.page_id || ')', ', ')
                                within group (order by p.page_id)
                         from apex_application_pages p
                         where p.application_id = :APP_ID
                           and instr(':' || r.role_pages || ':',
                                     ':' || p.page_id || ':') > 0
                       ) role_pages
                from sup_roles r
                where r.role_id = :P100_ROLE_ID
                ```
            pageItemsToSubmit: P100_ROLE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ROLE_ID
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No Record Selected
        }
        componentAdvanced {
            stripHtml: true
        }

        column ROLE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Role Id
            }
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_ROLES"
                    where "ROLE_ID" is not null
                    and "ROLE_ID" = :P100_ROLE_ID
                    ```
            }
        )

        column ROLE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Role Name
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_ROLES"
                    where "ROLE_NAME" is not null
                    and "ROLE_ID" = :P100_ROLE_ID
                    ```
            }
        )

        column ROLE_PAGES (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Role Pages
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "SUP_ROLES"
                    where "ROLE_PAGES" is not null
                    and "ROLE_ID" = :P100_ROLE_ID
                    ```
            }
        )

    )

    region search (
        name: Search
        type: staticContent
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                search-region
                padding-md
            ]
        }
    )

    region user-roles (
        name: user roles
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select USER_ID,
                       ROLE_ID,
                       USER_ROLES_ID,
                       '--'Delete_user
                  from SUP_USER_ROLES
                 where "ROLE_ID" = :P100_ROLE_ID
                ```
            pageItemsToSubmit: P100_ROLE_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ROLE_ID
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DELETE_USER (
            reportColumnQueryId: 4
            derivedColumn: N
            type: link
            heading {
                heading: Delete
            }
            layout {
                sequence: 22
            }
            link {
                target: {
                    type: url
                    url: #
                }
                linkText: <span class="fa fa-trash del-user-role" data-id="#USER_ROLES_ID#" title="Delete user role" aria-label="Delete user role"></span>
                linkAttributes: #USER_ROLES_ID#
            }
        )

        column ROLE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: User Name With Number
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT e.emp_number || ' -- ' || e.emp_name AS display_value,
                           e.emp_number      AS return_value
                    FROM xxapex_hr_emp_data e
                    ORDER BY e.emp_number;
                    ```
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column USER_ROLES_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 12
            }
        )

    )

    pageItem P100_DELETE_USER (
        type: hidden
        layout {
            sequence: 10
            region: @user-roles
            slot: regionBody
        }
        source {
            used: always
        }
    )

    pageItem P100_ROLE_ID (
        type: hidden
        layout {
            sequence: 40
            region: @roles
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P100_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--postTextBlock
            ]
            icon: fa-search
            width: 30
            valuePlaceholder: Search...
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 101
                clearCache: 101
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button edit (
        buttonName: EDIT
        label: Edit
        layout {
            sequence: 20
            region: @roles
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 101
                items: {
                    P101_ROLE_ID: &P100_ROLE_ID.
                }
                clearCache: 101
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: edit_master_btn
        }
    )

    button pop-sup-user-roles (
        buttonName: POP_SUP_USER_ROLES
        label: Add user roles
        layout {
            sequence: 10
            region: @user-roles
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                items: {
                    P22_ROLE_ID: &P100_ROLE_ID.
                }
                clearCache: 22
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 100
                clearCache: 100
                action: resetPagination
                request: RESET
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction delete-user (
        name: Delete User
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P100_DELETE_USER
        }

        action native-confirm (
            action: confirm
            settings {
                message: Are you sure you want to delete this user role?
                style: danger
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF :P100_DELETE_USER IS NULL THEN
                            raise_application_error(-20001, 'No user role was selected for deletion.');
                        END IF;
                    
                        DELETE FROM SUP_USER_ROLES
                         WHERE USER_ROLES_ID = :P100_DELETE_USER
                           AND ROLE_ID       = :P100_ROLE_ID;
                    
                        IF SQL%ROWCOUNT = 0 THEN
                            raise_application_error(-20002, 'The selected user role was not found or does not belong to this role.');
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P100_DELETE_USER
                    P100_ROLE_ID
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item('P100_DELETE_USER').setValue('', null, true);
                    apex.message.showPageSuccess('User role deleted successfully.');
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-roles
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-roles
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('user roles row(s) updated.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-roles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-2 (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @roles
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('roles row(s) updated.');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @roles
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P100_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction register-delete-user-click (
        name: Register Delete User Click
        execution {
            sequence: 15
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery(document)
                        .off('click.p100DeleteUserRole', '.del-user-role')
                        .on('click.p100DeleteUserRole', '.del-user-role', function (event) {
                            event.preventDefault();
                            apex.item('P100_DELETE_USER').setValue(apex.jQuery(this).data('id'));
                        });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)
