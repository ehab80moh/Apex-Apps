    button نقابة-المهندسين (
        buttonName: نقابة_المهندسين
        label: &APP_TEXT$ENGINEERS_SYNDICATE_MEMBERSHIP_NUMBER.
        layout {
            sequence: 70
            region: @public-relation
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: f?p=&APP_ID.:77:&APP_SESSION.::&DEBUG.::P77_ID:&P1_ID_NKABA.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                
                
                
                EXISTS (
                    SELECT 1
                    FROM central.xxapex_hr_emp_data d
                    JOIN central.xxapex_hr_emp_gender g
                      ON g.employee_number = d.emp_number
                    LEFT JOIN central.xxapex_hr_emp_social_birth s
                      ON s.emp_number = d.emp_number
                    LEFT JOIN central.xxapex_hr_qualifications q
                      ON q.employee_number = d.emp_number
                     AND q.maon_or_not = 'Yes'
                    LEFT JOIN central.xxapex_hr_emp_addresses a
                      ON a.employee_number = d.emp_number
                     AND a.primary_add = 'Y'
                    WHERE g.title = 'ENGG'
                      AND d.emp_number = :APP_USER
                )
                AND NOT EXISTS (
                    SELECT 1
                    FROM EPROMHQ.ENG_SYNDICATE_LOG l
                    WHERE l.APP_USER_NAME = :APP_USER
                )
                ```
        }
        config {
            buildOption: @commented-out
        }
    )

