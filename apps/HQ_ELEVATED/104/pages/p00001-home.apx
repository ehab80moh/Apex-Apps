    region تم-الترسيه-المصيف-لسيادتكم-علي-الوحدة-المصيفيه (
        name: "تم الترسيه المصيف لسيادتكم علي الوحدة المصيفيه "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s."مسلسل_كامل" AS S1,
                    s.EMP_ID,
                    s.EMP_NAME,
                    s.SITE_CODE,
                    d.CURRENT_GRADE,
                    s."مسلسل_الوحدة_والفوج" AS S2,
                    s.BLOCK_ID,
                        s.BLOCK_ID as bbblok,
                   central.xxapex_util_vacations.get_bloc_price_per_mon_p_group_id(
                        s.emp_id,
                        s.block_id,
                        TO_DATE(s.group_id, 'YYYY-MM-DD')
                    ) AS price,
                    s.GROUP_ID,
                    s.EMP_MOBILE,
                    s.ALLOCATION_ID,
                    NVL(H.HISTORY, 'لا يوجد'),
                    Nvl(v.STATUS_RESONE,' طلب اعتزار'),
                    null as instructions,
                    NULL AS PICS
                FROM
                    epromhq.V_VAC_UNIT_EMP_SERIALS s
                JOIN
                    epromhq.VAC_UNIT_ALLOCATION v
                    ON s.ALLOCATION_ID = v.ID
                   left join
                    epromhq.VAC_HISTORY H
                    on s.EMP_ID = H.EMP_ID
                      left  join central.xxapex_hr_emp_data d on d.EMP_NUMBER =  s.emp_id
                
                WHERE
                    -- v.STATUS_ID = 1
                    -- and
                    trip_id = 16
                    --   sysdate Between :APPLICATION_END_DATE and :APPLICATION_START_DATE
                 and s.EMP_ID = :app_user
                
                ORDER BY
                    S1, S2, s.BLOCK_ID, s.GROUP_ID;
                
                ```
        }
        layout {
            sequence: 210
            parentRegion: @تم-الترسيه-المصيف-لسيادتكم-علي-الوحدة-المصيفيه_1
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-Form--stretchInputs
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM EPROMHQ.VAC_UNIT_ALLOCATION v
                WHERE v.TRIP_ID  = 16
                  AND v.EMP_ID   = :APP_USER
                  AND v.STATUS_ID = 1
                  AND TRUNC(SYSDATE) <=
                      TO_DATE(TRIM(v.GROUP_ID), 'YYYY-MM-DD') + 7
                  AND ROWNUM = 1
                ```
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 27472628907743412
        }

