            // لحذف طلب سلفه المدارس
            
            $(document)
                .off("click.schoolLoan", "#btnDeleteSchoolLoan")
                .on("click.schoolLoan", "#btnDeleteSchoolLoan", function () {
            
                    var requestId = $(this).attr("data-request-id");
            
                    if (!requestId) {
                        apex.message.alert("تعذر تحديد رقم الطلب.");
                        return;
                    }
            
                    apex.message.confirm(
                        "هل أنت متأكد من حذف طلب سلفة المدارس؟",
                        function (confirmed) {
            
                            if (!confirmed) {
                                return;
                            }
            
                            apex.server.process(
                                "DELETE_SCHOOL_LOAN",
                                {
                                    x01: requestId
                                },
                                {
                                    dataType: "json",
            
                                    success: function (data) {
            
                                        if (data.success === true) {
            
                                            apex.message.showPageSuccess(
                                                data.message || "تم حذف الطلب بنجاح."
                                            );
            
                                            setTimeout(function () {
                                                window.location.reload();
                                            }, 700);
            
                                        } else {
            
                                            apex.message.alert(
                                                data.message ||
                                                "لم يتم حذف الطلب."
                                            );
                                        }
                                    },
            
                                    error: function (
                                        jqXHR,
                                        textStatus,
                                        errorThrown
                                    ) {
            
                                        console.error(
                                            "Response:",
                                            jqXHR.responseText
                                        );
            
                                        console.error(
                                            "Status:",
                                            textStatus
                                        );
            
                                        console.error(
                                            "Error:",
                                            errorThrown
                                        );
            
                                        apex.message.alert(
                                            "حدث خطأ أثناء حذف الطلب."
                                        );
                                    }
                                }
                            );
                        }
                    );
                });
