    region appraisal (
        name: Appraisal
        title: &APP_TEXT$APPRAISAL.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select 1 from dual
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @cards-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: card_104
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                  SELECT 1
                  FROM apr.apr_emps e
                  WHERE e.emp_id = :APP_USER
                    AND EXISTS (
                      SELECT 1
                      FROM apr.apr_assignment_evaluators v
                      WHERE v.evaluator_emp_rec_id = e.emp_rec_id
                    )
                ```
        }
        componentAppearance {
            cssClasses: a-CardView
        }
        title {
            advancedFormatting: true
            htmlExpression: &APP_TEXT$TITLE_HTML_EXPR_2!RAW.
        }
        media {
            source: imageUrl
            url: /apex/hq_elevated/g/attach/e4da3b7fbbce2345d7772b0674a318d5
            sizing: cover
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: f?p=205:205:&SESSION.
            }
        )

    )

    region emp-card-desktop (
        name: emp card desktop
        title: &APP_TEXT$EMP_CARD_DESKTOP.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select EMP_NUMBER, EMP_NAME, NATIONAL_IDENTIFIER, EMP_DATE_OF_BIRTH, EMP_POSITION_NAME, SITE_CODE, ORGANIZATION_NAME, ASSIGNMENTS_DATE, GRADE_NAME, PERMANENT_DATE, EXCEL_POS, PROJECT, BASIC_SALARY, EXP_DATE, IMAGE, IMAGE_ID, COMP_EMAIL, PAY_EMAIL, EGPC_EMAIL, MAR_STAT, JOB_DATE, PRIM_ADDRESS from (select EMP_NUMBER, EMP_NAME, NATIONAL_IDENTIFIER, EMP_DATE_OF_BIRTH, EMP_POSITION_NAME, SITE_CODE, ORGANIZATION_NAME, ASSIGNMENTS_DATE, GRADE_NAME, PERMANENT_DATE, EXCEL_POS, PROJECT, BASIC_SALARY, EXP_DATE, IMAGE, IMAGE_ID, COMP_EMAIL, PAY_EMAIL, EGPC_EMAIL, MAR_STAT, JOB_DATE, PRIM_ADDRESS from CENTRAL.XXAPEX_HR_EMP_DATA union all select emp_id as emp_number, emp_name, national_identifier, to_char(sysdate, 'DD/MM/YYYY') as emp_date_of_birth, emp_position_name, site_code, project as organization_name, to_char(sysdate, 'DD/MM/YYYY') as assignments_date, 'EPROM.10' as grade_name, to_char(sysdate, 'DD/MM/YYYY') as permanent_date, 'Senior Engineer' as excel_pos, project, 0 as basic_salary, to_char(sysdate, 'DD/MM/YYYY') as exp_date, to_blob(null) as image, image_id, email as comp_email, email as pay_email, email as egpc_email, 'Single' as mar_stat, sysdate as job_date, 'Alexandria' as prim_address from HQ_ELEVATED.DEVELOPERS_EMPS where is_active = 'Y') where EMP_NUMBER = :APP_USER
        }
        layout {
            sequence: 10
            parentRegion: @region-to-handel-cards-in-desktop-and-mobile-size
            slot: subRegions
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                t-Region-orderBy--center
            ]
            cssClasses: [
                hidden-sm-down
                eprom-emp-card-region
                eprom-emp-card-region--desktop
            ]
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            primaryKeyColumn1: EMP_NUMBER
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="eprom-card-title-wrap">
                    <h2 class="eprom-card-name">&EMP_NAME.</h2>
                    <div class="eprom-card-chips">
                        <span class="eprom-chip eprom-chip--role"><span class="fa fa-briefcase" aria-hidden="true"></span> &EXCEL_POS.</span>
                        <span class="eprom-chip eprom-chip--id"><span class="fa fa-id-card-o" aria-hidden="true"></span> #&EMP_NUMBER.</span>
                    </div>
                </div>
                ```
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="eprom-card-meta">
                    <span class="eprom-meta-item"><span class="fa fa-building-o" aria-hidden="true"></span> &ORGANIZATION_NAME.</span>
                    <span class="eprom-meta-sep">•</span>
                    <span class="eprom-meta-item"><span class="fa fa-map-marker" aria-hidden="true"></span> &PROJECT.</span>
                    <span class="eprom-meta-sep">•</span>
                    <span class="eprom-meta-item"><span class="fa fa-envelope-o" aria-hidden="true"></span> &COMP_EMAIL.</span>
                </div>
                ```
        }
        media {
            source: blobColumn
            blobColumn: IMAGE
            position: first
            appearance: square
        }
        performance {
            lazyLoading: true
        }

        action action (
            type: fullCard
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 10
                }
            }
        )

    )

