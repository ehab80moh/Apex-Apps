        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                
                v_pass_changed varchar(1);
                
                begin
                
                select PASSWORD_CHANGED into v_pass_changed from central.EMP_AUTH_VIEW
                where EMP_NUMBER = :APP_USER;
                
                if v_pass_changed='Y' then return false;
                else
                return true;
                end if;
                
                exception when others then return true;
                end;
