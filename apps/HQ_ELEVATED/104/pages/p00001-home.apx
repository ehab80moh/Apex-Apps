        when {
            event: ready
        }

        action enable-push-notifications (
            name: enable_push_notifications
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //put in dynamic action aupage stload
                    
                    async function subscribeOnLoad() {
                    
                    const hasPushSubscription = await apex.pwa.hasPushSubscription();
                    console.log(hasPushSubscription);
                    if(!hasPushSubscription){
                    if(Notification.permission!='denied'){
                         apex.pwa.subscribePushNotifications();
                    }else{
                        apex.message.showPageSuccess('You have Blocked Notifications, please enable manually.');
                    }
                    }
                    
                    }
                    
                    
                    subscribeOnLoad();
                    
                    ```
            }
            execution {
                sequence: 10
            }
            security {
                authorizationScheme: @super-duper
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#instructions_btn").trigger("click");
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: expression
                plsqlExpression:
                    ```plsql
