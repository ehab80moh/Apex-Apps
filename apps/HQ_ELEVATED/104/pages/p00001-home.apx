                        P_EMP_ID => :APP_USER,
                        P_PREF_ID => 41
                      )
                    ```
            }
        )

    )

    process delete-school-loan (
        name: DELETE_SCHOOL_LOAN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    L_ROWS_DELETED NUMBER := 0;
                    L_COUNT_AFTER  NUMBER := 0;
                BEGIN
                    DELETE FROM epromhq.PRF_LOANS_REQUEST
                     WHERE TRIM(UPPER(TO_CHAR(EMP_ID))) = TRIM(UPPER(:APP_USER))
                       AND Created_at >= DATE '2026-01-01'
                       AND Created_at <  DATE '2027-01-01';
                
                    L_ROWS_DELETED := SQL%ROWCOUNT;
                
                    IF L_ROWS_DELETED = 0 THEN
                        ROLLBACK;
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', FALSE);
                        APEX_JSON.WRITE('rows_deleted', 0);
                        APEX_JSON.WRITE(
                            'message',
                            'لم يتم العثور على طلب خاص بالمستخدم الحالي لحذفه.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                
                        RETURN;
                    END IF;
                
                    COMMIT;
                
                    SELECT COUNT(*)
                      INTO L_COUNT_AFTER
                      FROM epromhq.PRF_LOANS_REQUEST
                     WHERE TRIM(UPPER(TO_CHAR(EMP_ID))) = TRIM(UPPER(:APP_USER))
                       AND Created_at >= DATE '2026-01-01'
                       AND Created_at <  DATE '2027-01-01';
                
                    IF L_COUNT_AFTER = 0 THEN
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', TRUE);
                        APEX_JSON.WRITE('rows_deleted', L_ROWS_DELETED);
                        APEX_JSON.WRITE(
                            'message',
                            'تم حذف طلب سلفة المدارس بنجاح.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                    ELSE
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', FALSE);
                        APEX_JSON.WRITE('rows_deleted', L_ROWS_DELETED);
                        APEX_JSON.WRITE('remaining_rows', L_COUNT_AFTER);
                        APEX_JSON.WRITE(
                            'message',
                            'تم تنفيذ أمر الحذف، ولكن ما زال يوجد طلب آخر مسجل للمستخدم.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                    END IF;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', FALSE);
                        APEX_JSON.WRITE(
                            'message',
                            'حدث خطأ أثناء حذف الطلب: ' || SQLERRM
                        );
                        APEX_JSON.CLOSE_OBJECT;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 43227706178928329
        }
        serverSideCondition {
            type: never
        }
    )

    process log-sigen-in (
        name: LOG_SIGEN_IN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_ip        VARCHAR2(100);
                    v_ua        VARCHAR2(4000);
                    v_os        VARCHAR2(100);
                    v_browser   VARCHAR2(100);
                    v_device    VARCHAR2(50);
                BEGIN
                    v_ip      := central.emp_log_util.get_client_ip;
                    v_ua      := owa_util.get_cgi_env('HTTP_USER_AGENT');
                    v_os      := central.emp_log_util.parse_os(v_ua);
                    v_browser := central.emp_log_util.parse_browser(v_ua);
                    v_device  := central.emp_log_util.parse_device_type(v_ua);
                
                    INSERT INTO CENTRAL.EMP_APP_LOGS
                        (EMP_NUMBER, USERNAME, LOGIN_DATE, IP_ADDRESS, APP_ID, PAGE_ID, SESSION_ID,
                         USER_AGENT, BROWSER, OS_NAME, DEVICE_TYPE, HOST_NAME)
                    VALUES
                        (
                            :APP_USER,
                            :APP_USER,
                            SYSDATE,
                            v_ip,
                            :APP_ID,
                            :APP_PAGE_ID,
                            :APP_SESSION,
                            v_ua,
                            v_browser,
                            v_os,
                            v_device,
                            owa_util.get_cgi_env('REMOTE_HOST')
                        );
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 104955672585377709
        }
    )

