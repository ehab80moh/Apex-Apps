        ]
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /**
             * Helper: sendPrompt
             * Purpose: Simulates a user typing a prompt into the APEX AI Assistant chat input
             *          and pressing Enter to submit it automatically without manual typing.
             *
             * @param {string} promptText - The prompt text to be dispatched to the AI assistant.
             */
            function sendPrompt(promptText) {
                // Locate the standard APEX AI Assistant chat input textarea/input element
                const input = document.querySelector(".a-ChatInput-text");
                if (input) {
                    // Set the value directly in the DOM
                    input.value = promptText;
            
                    // Dispatch the 'input' event so APEX reactive state captures the change
                    input.dispatchEvent(new Event("input", { bubbles: true }));
            
                    // Dispatch keyboard 'Enter' event to trigger automatic message submission
                    input.dispatchEvent(new KeyboardEvent("keydown", {
                        key: "Enter",
                        code: "Enter",
                        keyCode: 13,
                        which: 13,
                        bubbles: true
                    }));
                }
                // Dispatch follow-up dynamic quick action chips if applicable
                handlePromptFollowUp(promptText);
            }
            
            /**
             * Helper: showQuickActions
             * Purpose: Dynamically renders interactive quick-action pill buttons in the APEX AI chat UI.
             *
             * @param {Array<{label: string, value: string}>} actions - Array of button labels and prompts.
             */
            function showQuickActions(actions) {
                // Remove previous quick action buttons if present
                $(".dynamic-quick-actions").remove();
                if (!actions || !actions.length) return;
            
                // Build container using APEX Universal Theme Chat quick-picks classes
                let html = '<div class="a-ChatActions-quickPicks dynamic-quick-actions" style="margin: 8px 12px; display: flex; flex-wrap: wrap; gap: 6px; z-index: 100;">';
                actions.forEach(function(item) {
                    html += '<button type="button" class="a-Button a-Button--pill" onclick="sendPrompt(\'' + item.value.replace(/'/g, "\\'") + '\')">' +
                            '<span class="a-Button-label">' + item.label + '</span></button>';
                });
                html += '</div>';
            
                // Inject the generated button bar directly above the chat input box
                const container = document.querySelector(".a-ChatInputContainer");
                if (container) {
                    $(container).before(html);
                }
            }
            
            /**
             * Helper: handlePromptFollowUp
             * Purpose: Detects the request category and renders dynamic contextual chips mid-conversation.
             *
             * @param {string} promptText - The prompt that was just submitted.
             */
            function handlePromptFollowUp(promptText) {
                $(".dynamic-quick-actions").remove();
                const text = (promptText || "").toLowerCase();
            
                if (text.includes("إجازة") || text.includes("leave")) {
                    setTimeout(function() {
                        showQuickActions([
                            { label: "🌴 إجازة عارضة", value: "إجازة عارضة" },
                            { label: "🌴 إجازة اعتيادية", value: "إجازة اعتيادية" },
                            { label: "🌴 بدل راحة", value: "إجازة بدل راحة" }
                        ]);
                    }, 500);
                } else if (text.includes("إذن") || text.includes("permission")) {
                    setTimeout(function() {
                        showQuickActions([
                            { label: "⏱️ صباحاً (08:00 - 10:00)", value: "إذن شخصي من 08:00 إلى 10:00" },
                            { label: "⏱️ ظهراً (12:00 - 14:00)", value: "إذن شخصي من 12:00 إلى 14:00" },
                            { label: "🏢 إذن عمل رسمي", value: "إذن عمل رسمي" }
                        ]);
                    }, 500);
                } else if (text.includes("مأمورية") || text.includes("mission")) {
                    setTimeout(function() {
                        showQuickActions([
                            { label: "💼 مأمورية عادية (72)", value: "مأمورية عمل عادية" },
                            { label: "🎓 دورة تدريبية (121)", value: "دورة تدريبية" }
                        ]);
                    }, 500);
                }
            }
            
            /**
             * Helper: initAiAssistantQuickActions
             * Purpose: Monitors the DOM for when the AI Assistant chat opens and injects initial quick actions.
             *          Also attaches the FAB button directly to body and renders the conversation bubble.
             */
            function initAiAssistantQuickActions() {
                // Ensure FAB button is reparented to <body> for true viewport fixed positioning
                function ensureFabAttached() {
                    const fab = $("button.ai-assistant-fab-btn, #AI_ASSISTANT_FAB");
                    if (fab.length && !fab.parent().is("body")) {
                        fab.appendTo("body");
                    }
                }
                ensureFabAttached();
            
                // Render conversation bubble next to the FAB if not already present
                if (!document.querySelector(".ai-fab-bubble")) {
                    const bubbleHtml = `
                        <div class="ai-fab-bubble" onclick="$('button.ai-assistant-fab-btn, #AI_ASSISTANT_FAB').click();">
                            <span style="font-size: 14px;">✨</span>
                            <span>كيف يمكنني مساعدتك؟</span>
                        </div>
                    `;
                    $("body").append(bubbleHtml);
                }
            
                const observer = new MutationObserver(function(mutations) {
                    ensureFabAttached();
            
                    const container = document.querySelector(".a-ChatInputContainer");
                    if (container) {
                        // Hide the speech bubble while the chat dialog is open
                        $(".ai-fab-bubble").fadeOut(200);
            
                        if (!document.querySelector(".dynamic-quick-actions")) {
                            showQuickActions([
                                { label: "🌴 طلب إجازة", value: "أرغب في تقديم طلب إجازة" },
                                { label: "⏱️ طلب إذن", value: "أرغب في تقديم طلب إذن" },
                                { label: "💼 طلب مأمورية عمل", value: "أرغب في تقديم طلب مأمورية عمل" }
                            ]);
                        }
                    } else {
                        // Restore the speech bubble when the chat is closed
                        $(".ai-fab-bubble").fadeIn(300);
                    }
                });
                observer.observe(document.body, { childList: true, subtree: true });
            }
            ```
