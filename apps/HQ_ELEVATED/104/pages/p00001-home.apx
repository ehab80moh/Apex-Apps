    region school_loan_region (
        name: تم التقديم علي طلب السلفه
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    L_REQUEST_ID epromhq.PRF_LOANS_REQUEST.REQUEST_ID%TYPE;
                BEGIN
                    BEGIN
                        SELECT REQUEST_ID
                          INTO L_REQUEST_ID
                          FROM (
                                SELECT REQUEST_ID
                                  FROM epromhq.PRF_LOANS_REQUEST
                                 WHERE EMP_ID = :APP_USER
                                   AND Created_at >= DATE '2026-01-01'
                                   AND Created_at <  DATE '2027-01-01'
                                 ORDER BY Created_at DESC
                               )
                         WHERE ROWNUM = 1;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN NULL;
                    END;
                
                    RETURN '
                        <div class="t-Alert t-Alert--success t-Alert--horizontal">
                            <div class="t-Alert-wrap">
                
                                <div class="t-Alert-icon">
                                    <span class="t-Icon fa fa-check-circle"
                                          aria-hidden="true"></span>
                                </div>
                
                                <div class="t-Alert-content">
                
                                    <div class="t-Alert-header">
                                        <h2 class="t-Alert-title">
                                            تم التقديم بنجاح
                                        </h2>
                                    </div>
                
                                    <div class="t-Alert-body">
                                        تم تقديم طلب سلفة المدارس بنجاح،
                                        وجارٍ العمل عليه.
                
                                        <div style="margin-top:15px;">
                
                                            <button type="button"
                                                    id="btnDeleteSchoolLoan"
                                                    data-request-id="' ||
                                                    apex_escape.html_attribute(L_REQUEST_ID) ||
                                                    '"
                                                    class="t-Button
                                                           t-Button--danger
                                                           t-Button--small">
                
                                                <span class="t-Icon fa fa-trash"
                                                      aria-hidden="true"></span>
                
                                                <span class="t-Button-label">
                                                    حذف الطلب
                                                </span>
                
                                            </button>
                
                                        </div>
                                    </div>
                
                                </div>
                            </div>
                        </div>';
                
                EXCEPTION
                    WHEN OTHERS THEN
                        RETURN '
                            <div class="t-Alert t-Alert--danger t-Alert--horizontal">
                                <div class="t-Alert-wrap">
                                    <div class="t-Alert-content">
                                        <div class="t-Alert-body">
                                            حدث خطأ أثناء التحقق من طلب سلفة المدارس:
                                            ' || apex_escape.html(SQLERRM) || '
                                        </div>
                                    </div>
                                </div>
                            </div>';
                END;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @تم-التقديم-علي-طلب-السلفه
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: school_loan_region
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT *
                FROM epromhq.PRF_LOANS_REQUEST
                WHERE Created_at >= DATE '2026-01-01'
                  AND Created_at <  DATE '2027-01-01'
                and emp_id = :App_user
                ```
        }
        config {
            buildOption: @commented-out
        }
    )

