    region happy-birthday (
        name: Happy Birthday
        title: &APP_TEXT$HAPPY_BIRTHDAY.
        type: staticContent
        layout {
            sequence: 10
            slot: body
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
