                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region تعديل-المواقع-الطبية (
        name: تعديل المواقع الطبية
        title: &APP_TEXT$EDITING_MEDICAL_WEBSITES.
