    region البيانات-الشخصية (
        name: "البيانات الشخصية "
        title: &APP_TEXT$PERSONAL_DATA.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                q.comments,
                       EMP_NAME,
                       NATIONAL_IDENTIFIER,
                       EMP_DATE_OF_BIRTH,
                       EMP_POSITION_NAME,
                       SITE_CODE,
                       ORGANIZATION_NAME,
                       ASSIGNMENTS_DATE,
                       REPLACE(GRADE_NAME,'EPROM.','') GRADE_NAME,
                       PERMANENT_DATE,
                       EXCEL_POS,
                       PROJECT,
                       BASIC_SALARY,
                       EXP_DATE,
                       SYS.dbms_lob.getlength(IMAGE) image,
                       IMAGE_ID,
                       COMP_EMAIL,
                       PAY_EMAIL,
                       EGPC_EMAIL,
                       MAR_STAT,
                       prim_address,
                       a.town_or_city
                  from CENTRAL.XXAPEX_HR_EMP_DATA D,
                (select* from central.xxapex_hr_qualifications qq
                    where 1=1 and qq.maon_or_not='Yes')q,
                 (select* from central.XXAPEX_HR_EMP_ADDRESSES aa
                  where 1=1 and aa.PRIMARY_ADD='Y') a
                where EMP_NUMBER = :APP_USER
                and q.employee_number (+) = d.emp_number
                and a.employee_number (+) = d.emp_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--textContent
                t-Region--scrollBody
                t-Form--stretchInputs
                margin-bottom-lg
            ]
            icon: fa-user
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
