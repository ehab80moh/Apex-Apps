page 10 (
    name: "البيانات الشخصيه "
    alias: PERSONAL-INFORMATIONS
    title: &APP_TEXT$PERSONAL_DATA.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ui-dialog.modal-dialog--pullout{
               top: 0!important;
            }
            
            /* ==========================================================================
               EPROM Portal Page 10 - Modern Executive Theme (Matched with Page 1)
               ========================================================================== */
            
            /* Page Background & Atmosphere */
            body.t-PageBody {
                background: 
                    radial-gradient(circle at 10% 0%, rgba(15, 118, 110, 0.07), transparent 32rem),
                    radial-gradient(circle at 90% 15%, rgba(14, 165, 233, 0.07), transparent 32rem),
                    #f8fafc !important;
            }
            
            /* Wrapper container for employee card */
            .eprom-emp-card-wrapper {
                background: transparent !important;
                border: none !important;
                box-shadow: none !important;
                margin-block: 0.5rem 1.5rem !important;
            }
            
            .eprom-emp-card-wrapper .t-Region-body {
                padding: 0 !important;
                background: transparent !important;
            }
            
            .eprom-emp-card-wrapper .t-Region-bodyWrap {
                background: transparent !important;
                border: 0 !important;
                box-shadow: none !important;
            }
            
            /* --------------------------------------------------------------------------
               Employee Profile Card (Desktop & Mobile)
               -------------------------------------------------------------------------- */
            .eprom-emp-card-region {
                max-width: 880px;
                margin-inline: auto;
            }
            
            .eprom-emp-card-region .a-CardView-items {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            
            .eprom-emp-card-region .a-CardView-item {
                position: relative;
                background: #ffffff !important;
                border: 1px solid #e2e8f0 !important;
                border-radius: 22px !important;
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04) !important;
                overflow: hidden !important;
                transition: transform 0.25s ease, box-shadow 0.25s ease;
            }
            
            .eprom-emp-card-region .a-CardView-item:hover {
                box-shadow: 0 16px 38px rgba(15, 23, 42, 0.09) !important;
            }
            
            /* Decorative corporate top accent gradient */
            .eprom-emp-card-region .a-CardView-item::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                background: linear-gradient(90deg, #0f2744 0%, #0f766e 50%, #0284c7 100%);
                z-index: 2;
            }
            
            /* Layout for Employee Card Content (vertical, no dead space) */
            .eprom-emp-card-region .a-CardView {
                display: flex !important;
                flex-direction: column !important;
                align-items: stretch !important;
                padding: 1.15rem 1.6rem !important;
                gap: 0.85rem !important;
            }
            
            /* Avatar Photo Styling */
            .eprom-emp-card-region .a-CardView-media,
            .eprom-emp-card-region .a-CardView-mediaWrap {
                flex: 0 0 110px !important;
                width: 110px !important;
                height: 110px !important;
                min-width: 110px !important;
                min-height: 110px !important;
                max-width: 110px !important;
                max-height: 110px !important;
                padding: 0 !important;
                margin: 0 auto !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                border-radius: 50% !important;
                background: transparent !important;
                overflow: hidden !important;
            }
            
            .eprom-emp-card-region .a-CardView-media img {
                width: 110px !important;
                height: 110px !important;
                min-width: 110px !important;
                min-height: 110px !important;
                max-width: 110px !important;
                max-height: 110px !important;
                border-radius: 50% !important;
                object-fit: cover !important;
                border: 3px solid #11765b !important;
                box-shadow: 0 0 0 3px #0f766e, 0 4px 14px rgba(15, 23, 42, 0.12) !important;
                background-color: #f1f5f9;
                display: block !important;
                margin: 0 !important;
                padding: 0 !important;
                transition: transform 0.25s ease;
            }
            
            .eprom-emp-card-region .a-CardView-item:hover .a-CardView-media img {
                transform: scale(1.04);
            }
            
            /* Header & Text Content Area */
            .eprom-emp-card-region .a-CardView-header,
            .eprom-emp-card-region .a-CardView-mainContent {
                flex: 0 1 auto !important;
                width: 100% !important;
                display: flex;
                flex-direction: column;
                gap: 0.4rem;
                text-align: right;
                padding: 0 !important;
                margin: 0 !important;
            }
            
            [dir="ltr"] .eprom-emp-card-region .a-CardView-header,
            [dir="ltr"] .eprom-emp-card-region .a-CardView-mainContent {
                text-align: left;
            }
            
            /* Employee Name */
            .eprom-card-name {
                margin: 0;
                font-size: 1.45rem;
                font-weight: 800;
                color: #0f172a;
                line-height: 1.3;
                letter-spacing: -0.01em;
            }
            
            /* Badges / Chips row */
            .eprom-card-chips {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.5rem;
                margin-top: 0.25rem;
            }
            
            .eprom-chip {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.25rem 0.75rem;
                border-radius: 999px;
                font-size: 0.82rem;
                font-weight: 700;
                line-height: 1.2;
            }
            
            .eprom-chip--role {
                background: #f0fdfa;
                color: #0f766e;
                border: 1px solid #99f6e4;
            }
            
            .eprom-chip--id {
                background: #f8fafc;
                color: #475569;
                border: 1px solid #e2e8f0;
            }
            
            /* Metadata items (Dept, Location, Email) */
            .eprom-card-meta {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.5rem;
                margin-top: 0.35rem;
                color: #64748b;
                font-size: 0.86rem;
                line-height: 1.5;
            }
            
            .eprom-meta-item {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
            }
            
            .eprom-meta-item .fa {
                color: #0f766e;
                font-size: 0.95rem;
            }
            
            .eprom-meta-sep {
                color: #cbd5e1;
                font-weight: bold;
            }
            
            /* Action Buttons Container - Side by Side */
            .eprom-emp-card-region .a-CardView-actions {
                display: flex !important;
                flex-direction: row !important;
                align-items: center !important;
                justify-content: center !important;
                width: 100% !important;
                margin: 0.45rem 0 0 !important;
                margin-inline-start: 0 !important;
                flex-shrink: 0 !important;
                padding: 0 !important;
            }
            
            .eprom-emp-card-region .a-CardView-actionsPrimary {
                display: flex !important;
                flex-direction: row !important;
                align-items: center !important;
                flex-wrap: nowrap !important;
                gap: 0.65rem !important;
                justify-content: center !important;
                width: 100% !important;
            }
            
            .eprom-emp-card-region .a-CardView-button {
                margin-bottom: 0 !important;
            }
            
            .eprom-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 0.45rem !important;
                padding: 0.55rem 1.15rem !important;
                font-size: 0.88rem !important;
                font-weight: 700 !important;
                border-radius: 12px !important;
                transition: all 0.2s ease !important;
                cursor: pointer !important;
                text-decoration: none !important;
                white-space: nowrap !important;
                width: auto !important;
            }
            
            .eprom-btn--profile {
                background: linear-gradient(135deg, #0f766e 0%, #115e59 100%) !important;
                border: 1px solid #0f766e !important;
                color: #ffffff !important;
                box-shadow: 0 4px 12px rgba(15, 118, 110, 0.25) !important;
            }
            
            .eprom-btn--profile:hover {
                background: linear-gradient(135deg, #115e59 0%, #134e4a 100%) !important;
                transform: translateY(-2px) !important;
                box-shadow: 0 6px 16px rgba(15, 118, 110, 0.35) !important;
                color: #ffffff !important;
            }
            
            .eprom-btn--edit {
                background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
                border: 1px solid #0284c7 !important;
                color: #ffffff !important;
                box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25) !important;
            }
            
            .eprom-btn--edit:hover {
                background: linear-gradient(135deg, #0369a1 0%, #075985 100%) !important;
                transform: translateY(-2px) !important;
                box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35) !important;
                color: #ffffff !important;
            }
            
            /* Responsive Mobile Adjustments for Profile Card */
            @media (max-width: 768px) {
                .eprom-emp-card-region .a-CardView {
                    flex-direction: column !important;
                    text-align: center !important;
                    padding: 1.25rem 1rem !important;
                    gap: 0.75rem !important;
                }
            
                .eprom-emp-card-region .a-CardView-media,
                .eprom-emp-card-region .a-CardView-mediaWrap,
                .eprom-emp-card-region .a-CardView-media img {
                    width: 96px !important;
                    height: 96px !important;
                    min-width: 96px !important;
                    min-height: 96px !important;
                    max-width: 96px !important;
                    max-height: 96px !important;
                }
            
                .eprom-emp-card-region .a-CardView-header,
                .eprom-emp-card-region .a-CardView-mainContent {
                    align-items: center !important;
                    text-align: center !important;
                }
            
                .eprom-card-chips,
                .eprom-card-meta {
                    justify-content: center !important;
                }
            
                .eprom-emp-card-region .a-CardView-actions,
                .eprom-emp-card-region .a-CardView-actionsPrimary {
                    margin-inline-start: 0 !important;
                    width: 100% !important;
                    display: flex !important;
                    flex-direction: row !important;
                    justify-content: center !important;
                    align-items: center !important;
                    flex-wrap: wrap !important;
                    gap: 0.5rem !important;
                    margin-top: 0.5rem !important;
                }
            
                .eprom-emp-card-region .a-CardView-actionsPrimary .eprom-btn {
                    flex: 1 1 calc(50% - 0.5rem) !important;
                    min-width: 120px !important;
                    padding: 0.5rem 0.6rem !important;
                    font-size: 0.82rem !important;
                    white-space: nowrap !important;
                }
            }
            
            /* --------------------------------------------------------------------------
               Region Display Selector (Modern Pill Tabs)
               -------------------------------------------------------------------------- */
            .apex-rds-container {
                max-width: 960px;
                margin: 0.75rem auto 1.5rem !important;
            }
            
            .apex-rds {
                background: #ffffff !important;
                border: 1px solid #e2e8f0 !important;
                border-radius: 16px !important;
                padding: 6px !important;
                box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04) !important;
                display: flex !important;
                flex-wrap: wrap !important;
                gap: 6px !important;
                justify-content: center !important;
            }
            
            .apex-rds li {
                border: none !important;
                margin: 0 !important;
            }
            
            .apex-rds-item a {
                border-radius: 12px !important;
                padding: 0.6rem 1.25rem !important;
                font-weight: 700 !important;
                font-size: 0.92rem !important;
                color: #475569 !important;
                transition: all 0.22s ease !important;
                text-decoration: none !important;
            }
            
            .apex-rds-item.apex-rds-selected a,
            .apex-rds-item a:hover {
                background: linear-gradient(135deg, #0f766e 0%, #115e59 100%) !important;
                color: #ffffff !important;
                box-shadow: 0 4px 14px rgba(15, 118, 110, 0.3) !important;
            }
            
            /* --------------------------------------------------------------------------
               Detail Regions & Report Panels
               -------------------------------------------------------------------------- */
            .p10-side-by-side-region {
                max-width: none !important;
                margin-inline: 0 !important;
            }
            
            @media (max-width: 768px) {
                .p10-side-by-side-region {
                    grid-column: 1 / -1 !important;
                    width: 100% !important;
                    max-width: 960px !important;
                    margin-inline: auto !important;
                }
            }
            
            .t-Region {
                max-width: 960px;
                margin-inline: auto !important;
                background: #ffffff !important;
                border: 1px solid #e2e8f0 !important;
                border-radius: 20px !important;
                box-shadow: 0 6px 24px rgba(15, 23, 42, 0.04) !important;
                overflow: hidden !important;
                margin-bottom: 1.5rem !important;
                transition: box-shadow 0.25s ease;
            }
            
            .t-Region:hover {
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07) !important;
            }
            
            /* Keep the employee-card host transparent; only the card itself is surfaced. */
            .t-Region.eprom-emp-card-wrapper {
                background: transparent !important;
                border: 0 !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                overflow: visible !important;
            }
            
            .t-Region.eprom-emp-card-wrapper:hover {
                box-shadow: none !important;
            }
            
            .t-Region.eprom-emp-card-wrapper .t-Region-header,
            .t-Region.eprom-emp-card-wrapper .t-Region-bodyWrap,
            .t-Region.eprom-emp-card-wrapper .t-Region-body {
                background: transparent !important;
                border: 0 !important;
                box-shadow: none !important;
            }
            
            .t-Region-header {
                background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%) !important;
                border-bottom: 1px solid #f1f5f9 !important;
                padding: 1.15rem 1.6rem !important;
            }
            
            .t-Region-title {
                font-size: 1.25rem !important;
                font-weight: 800 !important;
                color: #0f2744 !important;
                letter-spacing: -0.01em;
            }
            
            .t-Region-headerIcon .t-Icon {
                color: #0f766e !important;
                font-size: 1.2rem !important;
            }
            
            /* Value-Attribute Pairs */
            .t-AVPList {
                padding: 0.5rem 1.25rem !important;
            }
            
            .t-AVPList-item {
                padding: 0.9rem 0.5rem !important;
                border-bottom: 1px solid #f1f5f9 !important;
            }
            
            .t-AVPList-label {
                color: #64748b !important;
                font-weight: 600 !important;
                font-size: 0.92rem !important;
            }
            
            .t-AVPList-value {
                color: #0f172a !important;
                font-weight: 700 !important;
                font-size: 0.98rem !important;
            }
            
            /* Report Tables (Telephones, Training, Qualifications, Addresses) */
            .t-Report-report {
                border-collapse: separate !important;
                border-spacing: 0 !important;
                width: 100% !important;
                border-radius: 14px !important;
                overflow: hidden !important;
                border: 1px solid #e2e8f0 !important;
            }
            
            .t-Report-report th {
                background: #f8fafc !important;
                color: #334155 !important;
                font-weight: 700 !important;
                font-size: 0.88rem !important;
                padding: 0.95rem 1.15rem !important;
                border-bottom: 2px solid #0f766e !important;
            }
            
            .t-Report-report td {
                padding: 0.95rem 1.15rem !important;
                border-bottom: 1px solid #f1f5f9 !important;
                color: #1e293b !important;
                font-size: 0.92rem !important;
            }
            
            .t-Report-report tbody tr:hover td {
                background: #f0fdfa !important;
            }
            
            .t-Report-report tbody tr:last-child td {
                border-bottom: none !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emp-card-desktop (
        name: emp card desktop
        title: &APP_TEXT$EMP_CARD_DESKTOP.
        type: cards
        source {
            location: localDatabase
            tableOwner: CENTRAL
            tableName: XXAPEX_HR_EMP_DATA
            whereClause: EMP_NUMBER = :APP_USER
        }
        layout {
            sequence: 10
            parentRegion: @emp-cards-mobile-and-desktop
            slot: subRegions
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                t-Region-orderBy--center
            ]
            cssClasses: [
                hidden-sm-down
                eprom-emp-card-region
                eprom-emp-card-region--desktop
            ]
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            primaryKeyColumn1: EMP_NUMBER
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="eprom-card-title-wrap">
                    <h2 class="eprom-card-name">&EMP_NAME.</h2>
                    <div class="eprom-card-chips">
                        <span class="eprom-chip eprom-chip--role"><span class="fa fa-briefcase" aria-hidden="true"></span> &EXCEL_POS.</span>
                        <span class="eprom-chip eprom-chip--id"><span class="fa fa-id-card-o" aria-hidden="true"></span> #&EMP_NUMBER.</span>
                    </div>
                </div>
                ```
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="eprom-card-meta">
                    <span class="eprom-meta-item"><span class="fa fa-building-o" aria-hidden="true"></span> &ORGANIZATION_NAME.</span>
                    <span class="eprom-meta-sep">•</span>
                    <span class="eprom-meta-item"><span class="fa fa-map-marker" aria-hidden="true"></span> &PROJECT.</span>
                    <span class="eprom-meta-sep">•</span>
                    <span class="eprom-meta-item"><span class="fa fa-envelope-o" aria-hidden="true"></span> &COMP_EMAIL.</span>
                </div>
                ```
        }
        media {
            source: blobColumn
            blobColumn: IMAGE
            position: first
            appearance: square
        }
        performance {
            lazyLoading: true
        }

        action action (
            label: &APP_TEXT$RELATIVES.
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 5
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-user-heart
                cssClasses: [
                    eprom-btn
                    eprom-btn--profile
                ]
            }
        )

        action action-2 (
            label: &APP_TEXT$VACATION_DATA.
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 45
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-umbrella
                cssClasses: [
                    eprom-btn
                    eprom-btn--profile
                ]
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      l_count NUMBER;
                    BEGIN
                    
                     SELECT COUNT(*)
                      INTO l_count
                      FROM xxapex_hr_emp_Data
                      WHERE emp_number = :APP_USER;
                    
                      RETURN l_count > 0;
                    
                    END;
                    
                    ```
            }
        )

        action action-edit-data (
            label: &APP_TEXT$REQUEST_TO_MODIFY_DATA.
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 57
                    items: {
                        P57_EMP_ID: &EMP_NUMBER.
                    }
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-pencil-square-o
                hot: true
                cssClasses: [
                    eprom-btn
                    eprom-btn--edit
                ]
            }
        )

    )

    region emp-card-mobile (
        name: emp card mobile
        title: &APP_TEXT$EMP_CARD_MOBILE.
        type: cards
        source {
            location: localDatabase
            tableOwner: CENTRAL
            tableName: XXAPEX_HR_EMP_DATA
            whereClause: EMP_NUMBER = :APP_USER
        }
        layout {
            sequence: 20
            parentRegion: @emp-cards-mobile-and-desktop
            slot: subRegions
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
            cssClasses: [
                hidden-md-up
                eprom-emp-card-region
                eprom-emp-card-region--mobile
            ]
        }
        card {
            primaryKeyColumn1: EMP_NUMBER
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="eprom-card-title-wrap">
                    <h2 class="eprom-card-name">&EMP_NAME.</h2>
                    <div class="eprom-card-chips">
                        <span class="eprom-chip eprom-chip--role"><span class="fa fa-briefcase" aria-hidden="true"></span> &EXCEL_POS.</span>
                        <span class="eprom-chip eprom-chip--id">#&EMP_NUMBER.</span>
                    </div>
                </div>
                ```
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="eprom-card-meta">
                    <span class="eprom-meta-item"><span class="fa fa-building-o" aria-hidden="true"></span> &ORGANIZATION_NAME.</span>
                    <span class="eprom-meta-sep">•</span>
                    <span class="eprom-meta-item"><span class="fa fa-map-marker" aria-hidden="true"></span> &PROJECT.</span>
                </div>
                ```
        }
        media {
            source: blobColumn
            blobColumn: IMAGE
            position: first
            appearance: square
        }
        performance {
            lazyLoading: true
        }

        action action (
            label: &APP_TEXT$RELATIVES.
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 5
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-user-heart
                cssClasses: [
                    eprom-btn
                    eprom-btn--profile
                    t-Button--stretch
                ]
            }
        )

        action action-2 (
            label: &APP_TEXT$VACATION_DATA.
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 45
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-umbrella
                cssClasses: [
                    eprom-btn
                    eprom-btn--profile
                    t-Button--stretch
                ]
            }
        )

        action action-edit-data (
            label: &APP_TEXT$REQUEST_TO_MODIFY_DATA.
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 57
                    items: {
                        P57_EMP_ID: &EMP_NUMBER.
                    }
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-pencil-square-o
                hot: true
                cssClasses: [
                    eprom-btn
                    eprom-btn--edit
                    t-Button--stretch
                ]
            }
        )

    )

    region emp-cards-mobile-and-desktop (
        name: emp cards mobile and desktop
        title: &APP_TEXT$EMP_CARDS_MOBILE_AND_DESKTOP.
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--textContent
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
            cssClasses: eprom-emp-card-wrapper
        }
    )

    region hidden-form (
        name: Hidden form
        title: &APP_TEXT$HIDDEN_FORM.
        type: form
        source {
            location: localDatabase
            tableOwner: CENTRAL
            tableName: XXAPEX_HR_EMP_DATA
        }
