            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            includeShowAll: false
            rememberSelection: bySession
        }
    )

