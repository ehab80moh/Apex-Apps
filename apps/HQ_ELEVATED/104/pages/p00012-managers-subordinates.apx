    process enter-emp-id (
        name: Enter_emp_id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                :P12_APP_USER:=NVL(:P12_APP_USER,:APP_USER);
                :p12_EMP_NUMBER:=:P12_APP_USER;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32122373280093377
        }
    )

    process new (
        name: New
        type: formInitialization
        formRegion: @requester-data
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32090044077979420
        }
    )

)
