    region total-summary (
        name: اجمالى
        title: &APP_TEXT$TOTAL.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH leave_details AS (
                    SELECT 
                        LEAVE_TYPE,
                        central.xxapex_general.get_absence_num_of_days(From_Date, To_Date, :EMP_ROTATION) AS d_COUNT
                    FROM 
                        epromhq.HRF_EMP_LEAVE_REQUEST
                    WHERE 
                        EMP_ID = :APP_USER
                        AND Approved = 1
                        AND NVL(delete_approved, 0) <> 1
                        AND EXTRACT(YEAR FROM From_Date) = EXTRACT(YEAR FROM SYSDATE)),
                totals AS (
                    SELECT 
                        NVL(SUM(CASE WHEN LEAVE_TYPE = 'H' THEN d_COUNT ELSE 0 END), 0) AS annual_days,
                        NVL(SUM(CASE WHEN LEAVE_TYPE = 'C' THEN d_COUNT ELSE 0 END), 0) AS casual_days,
                        NVL(SUM(CASE WHEN LEAVE_TYPE = 'RH' THEN d_COUNT ELSE 0 END), 0) AS rest_hours
                    FROM leave_details)
                SELECT 
                    '<div class="eprom-vacation-cards">' ||
                    '  <div class="eprom-vcard eprom-vcard--annual">' ||
                    '    <div class="eprom-vcard-title">إجازة اعتيادية / سنوي (Annual)</div>' ||
                    '    <div class="eprom-vcard-value">' || annual_days || ' يوم</div>' ||
                    '  </div>' ||
                    '  <div class="eprom-vcard eprom-vcard--casual">' ||
                    '    <div class="eprom-vcard-title">إجازة عارضة (Casual)</div>' ||
                    '    <div class="eprom-vcard-value">' || casual_days || ' أيام</div>' ||
                    '  </div>' ||
                    '  <div class="eprom-vcard eprom-vcard--rest">' ||
                    '    <div class="eprom-vcard-title">ساعات راحة (Rest Hours)</div>' ||
                    '    <div class="eprom-vcard-value">' || rest_hours || ' ساعات</div>' ||
                    '  </div>' ||
                    '</div>' AS cards_html
                FROM totals;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @approved-leaves
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: CARDS_SUMMARY
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }

        column CARDS_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$NBSP.
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    dynamicAction dialog-closed-approved (
        name: dialog_closed_approved
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @approved-report
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ( this.data.successMessage ) {
                      apex.message.showPageSuccess(this.data.successMessage.text);
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approved-report
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-cards (
            action: refresh
            affectedElements {
                selectionType: region
                region: @total-summary
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

