    region rejected-leaves (
        name: "تم رفضها "
        title: &APP_TEXT$IT_WAS_REJECTED.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select LEAVE_TYPE, From_Date, To_Date,Updated_By,Approved,  To_Date -From_Date +1
                 from epromhq.HRF_EMP_LEAVE_REQUEST
                 where EMP_ID = :APP_USER
                 and approved = 2
                and nvl(delete_approved,0)<>1
                  AND EXTRACT(YEAR FROM From_Date) = EXTRACT(YEAR FROM SYSDATE)
                ```
        }
        layout {
            sequence: 40
            parentRegion: @hrf-leaves
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                #DEFAULT#
            ]
        }
        pagination {
            type: nextAndPreviousLinks
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: &APP_TEXT$NO_REQUESTS_IN_THIS_STATUS.
