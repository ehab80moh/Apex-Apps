    region pending-leaves (
        name: "قيد الإعتماد "
        title: &APP_TEXT$UNDER_APPROVAL.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select LEAVE_TYPE, From_Date, To_Date,Updated_By,Approved,
                'الغاء الاجازة ' delete_text
                ,substr(task_ids,INSTR(task_ids, '>', -1)+1) task_id --last task
                 ,central.xxapex_general.get_absence_num_of_days(From_Date,to_date, :EMP_ROTATION) AS d_COUNT
                ,decode( nvl(delete_approved,9999),0,'display:none;','' )  css_hide
                 from epromhq.HRF_EMP_LEAVE_REQUEST
                 where EMP_ID = :APP_USER
                 and (approved = 0  OR nvl(delete_approved,1) = 0)
                order by From_Date Asc
                ```
        }
        layout {
            sequence: 15
            parentRegion: @hrf-leaves
            slot: subRegions
        }
