    region طلبات-الإجازات (
        name: "طلبات الإجازات "
        title: &APP_TEXT$LEAVE_REQUESTS.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    request_id,
                    emp_id,
                    leave_type,
                    from_date,
                    to_date,
                    uploaded_ora,
                    task_ids,
                    updated_by,
                    created_at,
                    uploaded_tms,
                    approved,
                    last_working_date,
                    return_to_work_date,
                    cover_person,
                    leave_contact_address,
                    mobile,
                    tms_id,
                    delete_approved,
                    delete_request_date,
                    delete_tms,
                    last_approval_date
                FROM
                    epromhq.hrf_emp_leave_request
                    where
                1=1
                and (:APP_USER  in (select column_value from  table(apex_string.split(updated_by,'->')))
                or :APP_USER||'d'  in (select column_value from  table(apex_string.split(updated_by,'->')))
                )
                And emp_id <>:APP_USER
                AND EXTRACT(YEAR FROM from_date) = EXTRACT(YEAR FROM SYSDATE)
                order by from_date desc;
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
