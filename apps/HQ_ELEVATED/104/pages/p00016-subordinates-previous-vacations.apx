    region طلبات-الإجازات-2 (
        name: "طلبات الإجازات "
        title: &APP_TEXT$LEAVE_REQUESTS.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH fya AS (
                    SELECT h.request_id, 'FYA' AS role_type
                      FROM epromhq.hrf_emp_leave_request h
                     WHERE h.emp_id <> :APP_USER
                       AND EXTRACT(YEAR FROM h.from_date) = EXTRACT(YEAR FROM SYSDATE)
                       AND (:P16_EMP_ID IS NULL OR h.emp_id = :P16_EMP_ID)
                       AND ('->' || h.updated_by || '->' LIKE '%->' || :APP_USER || '->%'
                         OR '->' || h.updated_by || '->' LIKE '%->' || :APP_USER || 'd->%')
                ),
                fyi_log AS (
                    SELECT l.request_id, 'FYI' AS role_type
                      FROM central.apr_log l
                     WHERE l.request_type_id = 59
                       AND l.approver_type = 'FYI'
                       AND (l.approver = :APP_USER OR ':' || l.approver || ':' LIKE '%:' || :APP_USER || ':%')
                ),
                fyi_cust AS (
                    SELECT h.request_id, 'FYI' AS role_type
                      FROM central.apr_approval_results_cust_f f
                      JOIN epromhq.hrf_emp_leave_request h
                        ON h.emp_id = TO_NUMBER(f.emp_number)
                     WHERE f.request_type_id = 59
                       AND f.approve_type = 'FYI'
                       AND (f.approver = :APP_USER OR ':' || f.approver || ':' LIKE '%:' || :APP_USER || ':%')
                       AND h.emp_id <> :APP_USER
                       AND EXTRACT(YEAR FROM h.from_date) = EXTRACT(YEAR FROM SYSDATE)
                       AND (:P16_EMP_ID IS NULL OR h.emp_id = :P16_EMP_ID)
                ),
                all_reqs AS (
                    SELECT request_id, MAX(role_type) AS role_type
                      FROM (
                        SELECT request_id, role_type FROM fya
                        UNION ALL
                        SELECT request_id, role_type FROM fyi_log
                        UNION ALL
                        SELECT request_id, role_type FROM fyi_cust
                      )
                     GROUP BY request_id
                )
                SELECT
                    h.request_id,
                    h.emp_id,
                    h.leave_type,
                    h.from_date,
                    h.to_date,
                    h.uploaded_ora,
                    h.task_ids,
                    a.role_type,
                    epromhq.emp_to_ul(p_emp_list => central.replace_arrows_with_colon( replace(h.UPDATED_BY,h.EMP_ID,'') ),p_show_names=>'Y') AS result,
                    (
                        SELECT LISTAGG(e.emp_name, '->') WITHIN GROUP (ORDER BY t.rn)
                        FROM (
                            SELECT TRIM(column_value) AS emp_number,
                                   ROW_NUMBER() OVER (ORDER BY ROWNUM) AS rn
                            FROM TABLE(apex_string.split(h.updated_by, '->'))
                            WHERE column_value IS NOT NULL
                        ) t
                        JOIN central.XXAPEX_HR_EMP_DATA e ON e.emp_number = t.emp_number
                    ) AS updated_by_names,
                    h.created_at,
                    h.uploaded_tms,
                    h.approved,
                    h.last_working_date,
                    h.return_to_work_date,
                    h.cover_person,
                    h.leave_contact_address,
                    h.mobile,
                    h.tms_id,
                    h.delete_approved,
                    h.delete_request_date,
                    h.delete_tms,
                    h.last_approval_date
                FROM all_reqs a
                JOIN epromhq.hrf_emp_leave_request h ON h.request_id = a.request_id
                WHERE (:P16_EMP_ID IS NULL OR h.emp_id = :P16_EMP_ID)
                ORDER BY h.from_date DESC;
                ```
            pageItemsToSubmit: P16_EMP_ID
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P16_REQUEST_TYPE_ID
            value: 59
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            includeActionsMenu: false
        }
        advanced {
            savedReportMappingIdentifier: 102730799601640922
        }

