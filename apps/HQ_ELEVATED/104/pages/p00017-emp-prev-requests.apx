                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column MOBILE (
            reportColumnQueryId: 16
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column REQUEST_ID (
            reportColumnQueryId: 1
