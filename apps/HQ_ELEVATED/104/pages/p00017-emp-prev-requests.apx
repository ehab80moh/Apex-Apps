page 17 (
    name: emp_prev_requests
    alias: EMP-PREV-REQUESTS
    title: &APP_TEXT$PREVIOUS_ORDERS.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region طلبات-الاجازات (
        name: "طلبات الاجازات "
        title: &APP_TEXT$LEAVE_REQUESTS.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from EPROMHQ.hrf_emp_leave_request
                where emp_id= :APP_USER
                and approved in(1,2,0)
                order by request_id desc
                
                ;
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P17_REQUEST_TYPE_ID
            value: 59
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column APPROVED (
            reportColumnQueryId: 11
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: &APP_TEXT$THE_CONDITION.
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @request-status
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column COVER_PERSON (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: &APP_TEXT$DATE_THE_REQUEST_WAS_CREATED.
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column DELETE_APPROVED (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

        column DELETE_REQUEST_DATE (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 200
            }
        )

        column DELETE_TMS (
            reportColumnQueryId: 20
            derivedColumn: N
            type: hidden
            layout {
                sequence: 210
            }
        )

        column EMP_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: &APP_TEXT$WORKER_NUMBER.
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @employee-numbers
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column FROM_DATE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$FROM.
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column LAST_WORKING_DATE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column LEAVE_CONTACT_ADDRESS (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column LEAVE_TYPE (
            reportColumnQueryId: 3
