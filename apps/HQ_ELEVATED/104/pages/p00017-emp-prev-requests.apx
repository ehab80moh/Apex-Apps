        column UPLOADED_ORA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 100
            }
        )

        column UPLOADED_TMS (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

    )

    pageItem P17_REQUEST_TYPE_ID (
        type: hidden
