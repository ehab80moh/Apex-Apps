                sequence: 180
            }
        )

        column TO_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: &APP_TEXT$TO.
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
