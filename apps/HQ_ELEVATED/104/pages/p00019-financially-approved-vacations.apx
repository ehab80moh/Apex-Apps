    region بيانات-الاجازات (
        name: بيانات الاجازات
        title: &APP_TEXT$VACATION_DATA.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  EMPLOYEE_NUMBER,
                        FULL_NAME,
                        PROJ,
                        CASE 
                        WHEN NAME = 'Sick Leave' THEN 'اجازة عارضة'
                        WHEN NAME = 'Rest Hours' THEN 'ساعات راحة'
                        WHEN NAME = 'Casual Leave' THEN 'اجازة عارضة'
                        WHEN NAME = 'Mission Leave Days' THEN 'مهمة عمل'
                        WHEN NAME = 'Annual Leave' THEN 'اجازة اعتيادي'
                        WHEN NAME = 'Local Training' THEN 'تدريب داخلي'
                        WHEN NAME = 'Unauthorized Absence' THEN 'غياب'
                        WHEN NAME = 'Long Unpaid Absence' THEN 'اجازة خاصة بدون مرتب'
                        WHEN NAME = 'Labor Leave Paid' THEN 'اجازة وضع بأجر'
                        WHEN NAME = 'Maternity Leave Unpaid' THEN 'اجازة رعاية طفل'
                        WHEN NAME = 'Pilgrim Leave' THEN 'اجازة حج'
                        WHEN NAME = 'Unpaid Leave' THEN 'اجازة بدون مرتب'
                        WHEN NAME = 'Suspenssion' THEN 'ايقاف عن العمل'
                        ELSE NAME 
                    END AS LEAVE_TYPE,
                       DATE_START,
                       DATE_END,
                       DATE_END - DATE_START +1 NUM_DAYS 
                  from CENTRAL.XXAPEX_OTL_LEAVES
                 where  employee_number= :APP_USER
                and name not in (
                'Mission Leave Days',
                'International Training',
                'Mission Leave Hours','Local Training')
                and to_char(DATE_START,'yyyy') = to_char(sysdate,'yyyy')
                order by date_start desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: &APP_TEXT$FINANCIALLY_APPROVED_VACATIONS!RAW.
        }
