page 19 (
    name: بيانات الاجازات المعتمدة ماليا
    alias: FINANCIALLY-APPROVED-VACATIONS
    title: &APP_TEXT$FINANCIALLY_APPROVED_LEAVE_DATA.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
