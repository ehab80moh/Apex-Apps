    region رصيد-الأجازات (
        name: رصيد الأجازات
        title: &APP_TEXT$VACATION_BALANCE.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EMPLOYEE_NUMBER,
                       FULL_NAME,
                       ANNUAL_net_CREDIT,
                       
                       CASUAL_net_CREDIT,
                       HOURS_CREDIT,
                       EFF_DATE,
                    case when central.xxapex_general.get_last_oracle_upload_leaves() < TRUNC(sysdate, 'YEAR') 
                    then 
                    TRUNC(sysdate, 'YEAR')
                    else
                  central.xxapex_general.get_last_oracle_upload_leaves()
                  end 
                    Leave_credit,
                       annual_accrual
                  from CENTRAL.XXAPEX_OTL_LEAVE_CREDIT
                 where employee_number=:APP_USER
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
        security {
            authorizationScheme: @super-duper
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        messages {
            whenNoDataFound: &APP_TEXT$PLEASE_VISIT_THE_ENTITLEMENTS_DEPARTMENT_TO_VIEW_BALANCES.
        }

