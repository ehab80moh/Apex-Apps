page 25 (
    name: المقترحات
    alias: PROPOSALS
    title: &APP_TEXT$PROPOSALS.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        title: &APP_TEXT$BUTTONS.
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region استمارة-المقترحات (
        name: استمارة المقترحات
        title: &APP_TEXT$PROPOSAL_FORM.
        type: form
        source {
            location: localDatabase
            tableName: SUG_FEEDBACK
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P25_CREATED (
        type: displayOnly
        label {
            label: &APP_TEXT$DATE.
            alignment: left
        }
        settings {
            showLineBreaks: false
            sendOnPageSubmit: false
        }
        layout {
            sequence: 80
            region: @استمارة-المقترحات
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY
        }
        source {
            formRegion: @استمارة-المقترحات
            column: CREATED
            dataType: date
            queryOnly: true
            primaryKey: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT SYSDATE FROM DUAL
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P25_CREATED_BY (
        type: hidden
        layout {
            sequence: 90
            region: @استمارة-المقترحات
            slot: regionBody
        }
        source {
            formRegion: @استمارة-المقترحات
            column: CREATED_BY
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P25_FEEDBACK (
        type: textarea
        label {
            label: &APP_TEXT$PROPOSALS.
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 10
            region: @استمارة-المقترحات
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @استمارة-المقترحات
            column: FEEDBACK
            dataType: varchar2
        }
    )

    pageItem P25_FEEDBACK_ID (
        type: hidden
        layout {
            sequence: 40
            region: @استمارة-المقترحات
            slot: regionBody
        }
        source {
            formRegion: @استمارة-المقترحات
            column: FEEDBACK_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P25_HIDE_EMP (
        type: switch
        label {
            label: &APP_TEXT$REQUEST_TO_HIDE_MY_DATA.
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: 1
            offValue: 0
        }
        layout {
            sequence: 70
            region: @استمارة-المقترحات
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @استمارة-المقترحات
            column: HIDE_EMP
            dataType: number
        }
    )

    pageItem P25_RATING (
        type: radioGroup
        label {
            label: &APP_TEXT$EVALUATION.
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sharedComponent
            lov: @feedback-rating
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @استمارة-المقترحات
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @استمارة-المقترحات
            column: RATING
            dataType: number
        }
        security {
            escapeSpecialChars: false
        }
    )

    pageItem P25_RESPONSE (
        type: hidden
        layout {
            sequence: 100
            region: @استمارة-المقترحات
            slot: regionBody
        }
        source {
            formRegion: @استمارة-المقترحات
            column: RESPONSE
            dataType: varchar2
        }
    )

    pageItem P25_STATUS (
        type: hidden
        layout {
            sequence: 30
            region: @استمارة-المقترحات
            slot: regionBody
        }
        source {
            formRegion: @استمارة-المقترحات
            column: STATUS
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P25_UPDATED (
        type: hidden
        layout {
            sequence: 110
            region: @استمارة-المقترحات
            slot: regionBody
        }
        source {
            formRegion: @استمارة-المقترحات
            column: UPDATED
            dataType: date
        }
    )

    pageItem P25_UPDATED_BY (
        type: hidden
        layout {
            sequence: 120
            region: @استمارة-المقترحات
            slot: regionBody
        }
        source {
            formRegion: @استمارة-المقترحات
            column: UPDATED_BY
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$CANCEL.
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$SEND.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P25_FEEDBACK_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: &APP_TEXT$DELETE.
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P25_FEEDBACK_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$APPLY_CHANGES.
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P25_FEEDBACK_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 8398333933064156
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-الشكاوى-و-المقترحات (
        name: Initialize form الشكاوى و المقترحات
        type: formInitialization
        formRegion: @استمارة-المقترحات
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8397565499064155
        }
    )

    process process-form-الشكاوى-و-المقترحات (
        name: Process form الشكاوى و المقترحات
        type: formAutoRowProcessing
        formRegion: @استمارة-المقترحات
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8397927041064155
        }
    )

)
