    process pl-sql (
        name: PL/SQL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                :P27_SELECTED_EM_NUM:= nvl(:P27_SELECTED_EM_NUM,:APP_USER);
                :P27_EMP_CURRENT:=:P27_SELECTED_EM_NUM;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9321588311698873
        }
        serverSideCondition {
            type: never
        }
    )

)
