page 27 (
    name: البيانات الشخصية
    alias: PERSONAL-DATA
    title: &APP_TEXT$PERSONAL_DATA.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ui-dialog.modal-dialog--pullout{
               top: 0!important;
            }
            
            .a-CardView-button {
                margin-bottom: 1em;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emp-card-desktop (
        name: emp card desktop
        title: &APP_TEXT$EMP_CARD_DESKTOP.
        type: cards
        source {
            location: localDatabase
            tableOwner: CENTRAL
            tableName: XXAPEX_HR_EMP_DATA
            whereClause:
                ```sql
                EMP_NUMBER = :P27_EMP_CURRENT
                
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @emp-cards-mobile-and-desktop
            slot: subRegions
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                margin-top-lg
            ]
            cssClasses: hidden-sm-down
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            primaryKeyColumn1: EMP_NUMBER
        }
        title {
            column: EMP_NUMBER
        }
        subtitle {
            column: EMP_NAME
        }
        body {
            column: ORGANIZATION_NAME
        }
        media {
            source: blobColumn
            blobColumn: IMAGE
            position: first
            appearance: widescreen
        }
        performance {
            lazyLoading: true
        }
    )

    region emp-card-mobile (
        name: emp card mobile
