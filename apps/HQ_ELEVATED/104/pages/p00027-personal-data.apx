    region بطاقة-الموظف (
        name: بطاقة الموظف
        title: &APP_TEXT$EMPLOYEE_CARD.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.employee_number,
                       s.full_name,
                       s.dept,
                       s.position,
                       s.project,
                       s.grade,
                       s.JOB_DATE,
                       s.basic_salary,
                       s.date_of_birth,
                       s.age_years,
                       s.total_experience,
                       s.exp_y, s.exp_m, s.exp_d,
                       s.ADEQ1Y,s.ADEQ2Y,s.ADEQ3Y,
                       s.has_active_disciplinary_action,
                       s.has_long_leave
                from APR.active_employees_snap s
                join APR.apr_emps e
                  on e.emp_id = s.employee_number
                where s.employee_number = :P27_SELECTED_EM_NUM
                
                
                ```
