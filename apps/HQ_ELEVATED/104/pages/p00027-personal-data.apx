    region الرصيد-الاعتيادي (
        name: الرصيد الاعتيادي
        title: &APP_TEXT$REGULAR_BALANCE.
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EMPLOYEE_NUMBER,
                       FULL_NAME,
                       ANNUAL_CREDIT,
                       to_number(ANNUAL_CREDIT)-
                       nvl(central.xxapex_general.get_apex_approved_leaves_count( :P27_SELECTED_EM_NUM,'H',ACC_START_DATE,ACC_END_DATE),0)
                       Remain_annual,
                       CASUAL_CREDIT,
                       to_number(CASUAL_CREDIT)-
                       nvl(central.xxapex_general.get_apex_approved_leaves_count(:P27_SELECTED_EM_NUM,'C',ACC_START_DATE,ACC_END_DATE),0)
                       C_remain
                ,HOURS_CREDIT
                       
                from CENTRAL.XXAPEX_OTL_LEAVE_CREDIT
                where 1=1
                AND EMPLOYEE_NUMBER = :P27_EMP_CURRENT
                ORDER BY FULL_NAME
                ```
        }
        layout {
            sequence: 10
            parentRegion: @رصيد-الأجازات
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                js-headingLevel-2
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        chartAppearance {
            stack: true
        }
        chartLayout {
            maxWidth: 800
            height: 500
        }
        legend {
            position: top
            fontSize: 18
            fontColor: #000000
        }

        series رصيد-ساعات (
            name: &APP_TEXT$HOURS_BALANCE.
            execution {
                sequence: 30
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: HOURS_CREDIT
                value: HOURS_CREDIT
            }
            appearance {
                color: #319a00
            }
            label {
                show: true
                position: center
                fontSize: 18
                fontColor: #000000
            }
        )

        series رصيد-سنوي (
            name: &APP_TEXT$ANNUAL_BALANCE.
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: ANNUAL_CREDIT
                value: REMAIN_ANNUAL
                customTooltip: REMAIN_ANNUAL
                labelTooltip: REMAIN_ANNUAL
            }
            appearance {
                color: #0bd1c0
            }
            label {
                show: true
                position: center
                fontSize: 18
                fontColor: #000000
            }
        )

        series رصيد-عارضة (
            name: &APP_TEXT$CASUAL_BALANCE.
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CASUAL_CREDIT
                value: CASUAL_CREDIT
            }
            appearance {
                color: #f68300
            }
            label {
                show: true
                position: center
                fontSize: 18
                fontColor: #000000
            }
        )

