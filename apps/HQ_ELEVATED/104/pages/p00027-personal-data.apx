    region التقييمات-السنوية (
        name: التقييمات السنوية
        title: &APP_TEXT$ANNUAL_EVALUATIONS.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       had.YEARR,
                       had.AQU_GRADE
                  from CENTRAL.XXAPEX_HR_APPRAISAL_DATA had,
                    central.xxapex_hr_emp_data       hed
                WHERE
                    hed.emp_number = had.employee_number
                    and grade_name is not null
                    and EMPloyee_NUMBER= :P27_SELECTED_EM_NUM
                    order by had.YEARR;
                ```
            pageItemsToSubmit: P27_SELECTED_EM_NUM
        }
        layout {
            sequence: 140
            slot: body
            startNewRow: false
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent14
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @value-attribute-pairs-row
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }

        column AQU_GRADE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: &APP_TEXT$APPRECIATION.
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @تقدير
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column YEARR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$YEARR.
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

    region التليفونات (
        name: التليفونات
        title: &APP_TEXT$TELEPHONES.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.PERSON_ID,
                       p.EMPLOYEE_NUMBER,
                       c.MOBILE as Phone_apex,
                       p.FULL_NAME,
                       p.TYPEE,
                       replace(p.PHONE_NUMBER,' ','') PHONE_NUMBER,
                       p.DATE_FROM,
                       p.DATE_TO
                  from CENTRAL.XXAPEX_HR_EMP_PHONES p join central.EMP_CONTACT c on c.emp_id = p.EMPLOYEE_NUMBER
                 where p.EMPLOYEE_NUMBER=:P27_SELECTED_EM_NUM
                ```
