    region emp-cards-mobile-and-desktop (
        name: emp cards mobile and desktop
        title: &APP_TEXT$EMP_CARDS_MOBILE_AND_DESKTOP.
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--textContent
                t-Region--scrollBody
            ]
