    css {
        inline:
            ```css
            body.eprom-history-dialog .t-Dialog-header,
            body.eprom-history-dialog .ui-dialog-titlebar {
                padding: 0.6rem 0.95rem !important;
            }
            body.eprom-history-dialog .t-Dialog-title,
            body.eprom-history-dialog .ui-dialog-title {
                font-size: 1rem !important;
                line-height: 1.35 !important;
                font-weight: 700 !important;
            }
            body.eprom-history-dialog .t-Region-title {
                font-size: 0.92rem !important;
                line-height: 1.35;
            }
            body.eprom-history-dialog .t-Region-body {
                padding: 0.65rem 0.8rem;
            }
            body.eprom-history-dialog .apex-rds {
                gap: 0.35rem !important;
                margin-bottom: 0.85rem !important;
            }
            body.eprom-history-dialog .apex-rds-item a {
                padding: 0.5rem 0.8rem !important;
                font-size: 0.9rem !important;
                line-height: 1.35;
            }
            body.eprom-history-dialog .t-Report-wrap {
                overflow-x: auto;
            }
            body.eprom-history-dialog .t-Report-report {
                font-size: 0.88rem !important;
            }
            body.eprom-history-dialog .t-Report-report th {
                padding: 0.55rem 0.65rem !important;
                font-size: 0.84rem !important;
                line-height: 1.35;
            }
            body.eprom-history-dialog .t-Report-report td {
                padding: 0.5rem 0.65rem !important;
                line-height: 1.4;
            }
            body.eprom-history-dialog .t-Report-report a:focus-visible,
            body.eprom-history-dialog .apex-rds-item a:focus-visible {
                outline: 2px solid #0e7490 !important;
                outline-offset: 2px;
            }
            @media (max-width: 640px) {
                body.eprom-history-dialog .t-Region-body {
                    padding: 0.5rem;
                }
                body.eprom-history-dialog .t-Report-report th,
                body.eprom-history-dialog .t-Report-report td {
                    white-space: nowrap;
                }
            }
            ```
    }
