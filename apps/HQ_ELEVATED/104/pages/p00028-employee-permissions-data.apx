    region تم-إعتمادها (
        name: "تم إعتمادها "
        title: &APP_TEXT$IT_HAS_BEEN_APPROVED.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                
                WITH PermissionData AS (
                    SELECT
                        permission_type,
                        reason,
                        from_hour,
                        to_hour,
                        TO_CHAR(from_hour, 'HH24:MI') AS F_HOUR,
                        TO_CHAR(to_hour, 'HH24:MI') AS T_HOUR,
                        permission_date,
                        TO_CHAR(permission_date, 'MM/DD/YYYY') AS p_DATE,
                        updated_by,
                        approved,
                        request_id,
                        CASE
                            WHEN (delete_approved IS NULL OR delete_approved <> 0) 
                                 AND SYSDATE <= central.XXAPEX_SS_VALIDATIONS.GET_CUT_DATE(TO_DATE(permission_date), emp_id) 
                            THEN
                                'الغاء الاذن'
                            ELSE
                                ''
                        END AS delete_text,
                        ROUND((to_hour - from_hour) * 24, 2) AS duration,
                        TO_CHAR(TRUNC((to_hour - from_hour) * 24), 'FM00') || ':' || 
                        LPAD(TO_CHAR(TRUNC(MOD((to_hour - from_hour) * 24 * 60, 60))), 2, '0') AS formatted_duration
                    FROM
                        epromhq.hrf_emp_permission_request
                    WHERE
                        emp_id = :app_user
                        AND approved = 1
                        AND NVL(delete_approved, 0) <> 1
                        AND EXTRACT(YEAR FROM permission_date) = EXTRACT(YEAR FROM SYSDATE)
                )
                SELECT *
                FROM PermissionData
                ORDER BY
                p_DATE DESC,
                    TRUNC(duration),  
                    LPAD(TO_CHAR(TRUNC(MOD(duration * 60, 60))), 2, '0');
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @hrf-permissions
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                t-Report--altRowsDefault
                t-Report--rowHighlight
                #DEFAULT#
                t-Report--stretch
            ]
        }
