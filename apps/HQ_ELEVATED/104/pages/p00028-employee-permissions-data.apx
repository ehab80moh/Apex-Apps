    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @تم-إعتمادها
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ( this.data.successMessage ) {
                    
                      apex.message.showPageSuccess(this.data.successMessage.text);
                    
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @تم-إعتمادها
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

