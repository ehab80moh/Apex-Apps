                    from_date,
                    to_date,
                    updated_by,
                    approved,
                    request_id,
                    task_ids,
                    REQUEST_TYPE_ID,
                    To_Date -From_Date +1,
                    decode( nvl(delete_approved,9999),0,'display:none;','' )  css_hide
                     from epromhq.HRF_EMP_MISSION_REQUEST
                 where EMP_ID = :APP_USER
                And approved = 0
                 and (approved = 0  OR nvl(delete_approved,1) = 0)
                AND EXTRACT(YEAR FROM From_Date) = EXTRACT(YEAR FROM SYSDATE)
                ```
