page 30 (
    name: بيانات طلبات السهر للموظف
    alias: EMPLOYEE-OVERTIME-DATA
    title: &APP_TEXT$OVERTIME_HOURS_DATA.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
        cssClasses: eprom-history-dialog
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            body.eprom-history-dialog .t-Dialog-header,
            body.eprom-history-dialog .ui-dialog-titlebar {
                padding: 0.6rem 0.95rem !important;
            }
            body.eprom-history-dialog .t-Dialog-title,
            body.eprom-history-dialog .ui-dialog-title {
                font-size: 1rem !important;
                line-height: 1.35 !important;
                font-weight: 700 !important;
            }
            body.eprom-history-dialog .t-Region-title {
                font-size: 0.92rem !important;
                line-height: 1.35;
            }
            body.eprom-history-dialog .t-Region-body {
                padding: 0.65rem 0.8rem;
            }
            body.eprom-history-dialog .apex-rds {
                gap: 0.35rem !important;
                margin-bottom: 0.85rem !important;
            }
            body.eprom-history-dialog .apex-rds-item a {
                padding: 0.5rem 0.8rem !important;
                font-size: 0.9rem !important;
                line-height: 1.35;
            }
            body.eprom-history-dialog .t-Report-wrap {
                overflow-x: auto;
            }
            body.eprom-history-dialog .t-Report-report {
                font-size: 0.88rem !important;
            }
            body.eprom-history-dialog .t-Report-report th {
                padding: 0.55rem 0.65rem !important;
                font-size: 0.84rem !important;
                line-height: 1.35;
            }
            body.eprom-history-dialog .t-Report-report td {
                padding: 0.5rem 0.65rem !important;
                line-height: 1.4;
            }
            body.eprom-history-dialog .t-Report-report a:focus-visible,
            body.eprom-history-dialog .apex-rds-item a:focus-visible {
                outline: 2px solid #0e7490 !important;
                outline-offset: 2px;
            }
            @media (max-width: 640px) {
                body.eprom-history-dialog .t-Region-body {
                    padding: 0.5rem;
                }
                body.eprom-history-dialog .t-Report-report th,
                body.eprom-history-dialog .t-Report-report td {
                    white-space: nowrap;
                }
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hrf-overtimes (
        name: hrf_overtimes
        title: &APP_TEXT$HRFOVERTIMES.
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region region-display-selector (
        name: Region Display Selector
        title: &APP_TEXT$REGION_DISPLAY_SELECTOR.
        type: regionDisplaySelector
        layout {
            sequence: 10
            parentRegion: @hrf-overtimes
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        settings {
            includeShowAll: false
            rememberSelection: false
        }
    )

    region تم-إعتمادها (
        name: "تم إعتمادها "
        title: &APP_TEXT$IT_HAS_BEEN_APPROVED.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    REASON,
                    to_char(from_hour,'HH24-MI') from_hour,
                    to_char(to_hour,'HH24-MI')   to_hour,
                    OVERTIME_date,
                    updated_by,
                    approved,
                    request_id,
                    CASE
                        WHEN ( delete_approved IS NULL
                               OR delete_approved <> 0 )
                             and sysdate <= central.XXAPEX_SS_VALIDATIONS.GET_CUT_DATE(to_date(OVERTIME_date),EMP_ID) 
                              THEN
                            'الغاء السهر'
                        
                        ELSE
                            ''
                    END delete_text,
                    ROUND((to_hour - from_hour) * 24, 2) AS duration
                FROM
                    epromhq.hrf_emp_OVERTIME_request
                WHERE
                        emp_id = :app_user
                    AND approved = 1
                    AND nvl(delete_approved, 0) <> 1
                AND EXTRACT(YEAR FROM OVERTIME_date) = EXTRACT(YEAR FROM SYSDATE)
                order by OVERTIME_date desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @hrf-overtimes
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                #DEFAULT#
            ]
        }
        pagination {
            type: nextAndPreviousLinks
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }

        column APPROVED (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: &APP_TEXT$THE_CONDITION.
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @request-status
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

