    region طلبات-الأذون-السابقة-للمرؤوسين (
        name: طلبات الأذون السابقة للمرؤوسين
        title: &APP_TEXT$PREVIOUS_PERMISSION_REQUESTS_FOR_SUBORDINATES.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH fya AS (
                    SELECT p.request_id, 'FYA' AS role_type
                      FROM epromhq.hrf_emp_permission_request p
                     WHERE p.emp_id <> :APP_USER
                       AND EXTRACT(YEAR FROM p.permission_date) = EXTRACT(YEAR FROM SYSDATE)
                       AND (:P31_EMP_ID IS NULL OR p.emp_id = :P31_EMP_ID)
                       AND ('->' || p.updated_by || '->' LIKE '%->' || :APP_USER || '->%'
                         OR '->' || p.updated_by || '->' LIKE '%->' || :APP_USER || 'd->%')
                ),
                fyi_log AS (
                    SELECT l.request_id, 'FYI' AS role_type
                      FROM central.apr_log l
                     WHERE l.request_type_id = 61
                       AND l.approver_type = 'FYI'
                       AND (l.approver = :APP_USER OR ':' || l.approver || ':' LIKE '%:' || :APP_USER || ':%')
                ),
                fyi_cust AS (
                    SELECT p.request_id, 'FYI' AS role_type
                      FROM central.apr_approval_results_cust_f f
                      JOIN epromhq.hrf_emp_permission_request p
                        ON p.emp_id = TO_NUMBER(f.emp_number)
                     WHERE f.request_type_id = 61
                       AND f.approve_type = 'FYI'
                       AND (f.approver = :APP_USER OR ':' || f.approver || ':' LIKE '%:' || :APP_USER || ':%')
                       AND p.emp_id <> :APP_USER
                       AND EXTRACT(YEAR FROM p.permission_date) = EXTRACT(YEAR FROM SYSDATE)
                       AND (:P31_EMP_ID IS NULL OR p.emp_id = :P31_EMP_ID)
                ),
                all_reqs AS (
                    SELECT request_id, MAX(role_type) AS role_type
                      FROM (
                        SELECT request_id, role_type FROM fya
                        UNION ALL
                        SELECT request_id, role_type FROM fyi_log
                        UNION ALL
                        SELECT request_id, role_type FROM fyi_cust
                      )
                     GROUP BY request_id
                )
                SELECT
                    p.emp_id,
                    p.permission_type,
                    p.updated_by,
                    a.role_type,
                    p.from_hour,
                    p.to_hour,
                    p.approved,
                    p.request_id,
                    p.reason,
                    p.last_approval_date,
                    p.permission_date,
                    epromhq.emp_to_ul(p_emp_list => central.replace_arrows_with_colon( replace(p.updated_by, p.emp_id, '') ), p_show_names => 'Y') AS result
                FROM all_reqs a
                JOIN epromhq.hrf_emp_permission_request p ON p.request_id = a.request_id
                WHERE (:P31_EMP_ID IS NULL OR p.emp_id = :P31_EMP_ID)
                ORDER BY p.permission_date DESC;
                ```
            pageItemsToSubmit: P31_EMP_ID
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
