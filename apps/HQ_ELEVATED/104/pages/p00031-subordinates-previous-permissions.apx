                    {when 1/}
                    تم الموافقة <span aria-hidden="true" class="u-success fa fa-check fa-anim- fam-Blank fam-is-success"></span> <b>
                    {when 2/}
                    تم رفض الطلب <span aria-hidden="true" class="fa fa-exclamation-circle-o u-danger-text "></span>
                    {otherwise/}
