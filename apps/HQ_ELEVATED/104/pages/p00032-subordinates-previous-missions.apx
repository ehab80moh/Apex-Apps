            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {case APPROVED/}
                    {when 0/}
                    قيد الاعتماد <span aria-hidden="true" class="fa fa-hourglass-2 fa-anim-vertical-shake fam-pause fam-is-warning"></span>
                    {when 1/}
                    تم الموافقة <span aria-hidden="true" class="u-success fa fa-check fa-anim- fam-Blank fam-is-success"></span> <b>
                    {when 2/}
                    تم رفض الطلب <span aria-hidden="true" class="fa fa-exclamation-circle-o u-danger-text "></span>
                    {otherwise/}
                    #APPROVED#
                    {endcase/}
                    ```
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
