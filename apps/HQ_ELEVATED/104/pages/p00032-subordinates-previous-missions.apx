    alias: SUBORDINATES-PREVIOUS-MISSIONS
    title: &APP_TEXT$REQUESTS_FOR_PREVIOUS_ASSIGNMENTS_FOR_SUBORDINATES.
    appearance {
        pageMode: modalDialog
