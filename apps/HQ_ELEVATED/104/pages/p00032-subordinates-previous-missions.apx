    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region طلبات-المهمات (
        name: طلبات المهمات
        title: &APP_TEXT$TASK_REQUESTS.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH fya AS (
                    SELECT m.request_id, 'FYA' AS role_type
                      FROM epromhq.hrf_emp_mission_request m
                     WHERE m.emp_id <> :APP_USER
                       AND EXTRACT(YEAR FROM NVL(m.last_approval_date, m.from_date)) = EXTRACT(YEAR FROM SYSDATE)
                       AND (:P32_EMP_ID IS NULL OR m.emp_id = :P32_EMP_ID)
                       AND ('->' || m.updated_by || '->' LIKE '%->' || :APP_USER || '->%'
                         OR '->' || m.updated_by || '->' LIKE '%->' || :APP_USER || 'd->%')
                ),
                fyi_log AS (
                    SELECT l.request_id, 'FYI' AS role_type
                      FROM central.apr_log l
                     WHERE l.request_type_id IN (72, 121)
                       AND l.approver_type = 'FYI'
                       AND (l.approver = :APP_USER OR ':' || l.approver || ':' LIKE '%:' || :APP_USER || ':%')
                ),
                fyi_cust AS (
                    SELECT m.request_id, 'FYI' AS role_type
                      FROM central.apr_approval_results_cust_f f
                      JOIN epromhq.hrf_emp_mission_request m
                        ON m.emp_id = TO_NUMBER(f.emp_number)
                     WHERE f.request_type_id IN (72, 121)
                       AND f.approve_type = 'FYI'
                       AND (f.approver = :APP_USER OR ':' || f.approver || ':' LIKE '%:' || :APP_USER || ':%')
                       AND m.emp_id <> :APP_USER
                       AND EXTRACT(YEAR FROM NVL(m.last_approval_date, m.from_date)) = EXTRACT(YEAR FROM SYSDATE)
                       AND (:P32_EMP_ID IS NULL OR m.emp_id = :P32_EMP_ID)
                ),
                all_reqs AS (
                    SELECT request_id, MAX(role_type) AS role_type
                      FROM (
                        SELECT request_id, role_type FROM fya
                        UNION ALL
                        SELECT request_id, role_type FROM fyi_log
                        UNION ALL
                        SELECT request_id, role_type FROM fyi_cust
                      )
                     GROUP BY request_id
                )
                SELECT
                    m.request_id,
                    m.emp_id,
                    m.request_type_id,
                    a.role_type,
                    m.from_date,
                    m.to_date,
                    m.approved,
                    m.description,
                    m.last_approval_date,
                    m.updated_by,
                    epromhq.emp_to_ul(p_emp_list => central.replace_arrows_with_colon( replace(m.updated_by, m.emp_id, '') ), p_show_names => 'Y') AS result
                FROM all_reqs a
                JOIN epromhq.hrf_emp_mission_request m ON m.request_id = a.request_id
                WHERE (:P32_EMP_ID IS NULL OR m.emp_id = :P32_EMP_ID)
                ORDER BY m.request_id DESC;
                ```
            pageItemsToSubmit: P32_EMP_ID
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            includeActionsMenu: false
        }
        componentAdvanced {
