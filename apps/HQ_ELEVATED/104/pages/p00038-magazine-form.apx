page 38 (
    name: إضافة مجلة جديدة
    alias: MAGAZINE-FORM
    title: &APP_TEXT$ADD_A_NEW_MAGAZINE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region form-on-magazines (
        name: Form on MAGAZINES
        title: &APP_TEXT$FORM_ON_MAGAZINES.
        type: form
        source {
            location: localDatabase
            tableName: MAGAZINES
            orderByClause: MAG_ID
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--textContent
                t-Region--scrollBody
                t-Form--xlarge
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P38_MAG_COVER (
        type: fileUpload
        label {
            label: &APP_TEXT$MAGAZINE_COVER.
            alignment: left
        }
        storage {
            fileTypes: image/*
            maxFileSize: 500
        }
        layout {
            sequence: 50
            region: @form-on-magazines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form-on-magazines
            column: MAG_COVER
            dataType: blob
        }
    )

    pageItem P38_MAG_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-magazines
            slot: regionBody
        }
        source {
            formRegion: @form-on-magazines
            column: MAG_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P38_MAG_ID_COUNT (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            showLineBreaks: false
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @form-on-magazines
            slot: regionBody
            alignment: left
        }
        advanced {
            customAttributes: class="fielddata"
        }
        sessionState {
            storage: request
        }
        comments {
            comments: This item is needed for Get Next or Previous Primary Key Value process.
        }
    )

    pageItem P38_MAG_NAME (
        type: textField
        label {
            label: &APP_TEXT$MAGAZINE_NAME.
            alignment: left
        }
        layout {
            sequence: 40
            region: @form-on-magazines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @form-on-magazines
            column: MAG_NAME
            dataType: varchar2
        }
    )

    pageItem P38_PDF_FILE (
        type: fileUpload
        label {
            label: &APP_TEXT$MAGAZINE_FILE.
            alignment: left
        }
        storage {
            type: appTempFiles
            fileTypes: application/pdf
            maxFileSize: 30000
        }
        layout {
            sequence: 70
            region: @form-on-magazines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$CANCEL.
        layout {
            sequence: 10
            region: @form-on-magazines
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$ADDITION.
        layout {
            sequence: 40
            region: @form-on-magazines
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P38_MAG_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: &APP_TEXT$DELETE.
        layout {
            sequence: 20
            region: @form-on-magazines
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P38_MAG_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$APPLY_CHANGES.
        layout {
            sequence: 30
            region: @form-on-magazines
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P38_MAG_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: &APP_TEXT$SUCCESS.
        }
        error {
            errorMessage:
                ```
                #SQLERRM#
                
                ```
        }
        advanced {
            executionMappingIdentifier: 28505979977524827
        }
    )

    process initialize-form-form-on-magazines (
        name: Initialize form Form on MAGAZINES
        type: formInitialization
        formRegion: @form-on-magazines
        navigation {
            currentRowTotalItem: P38_MAG_ID_COUNT
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32706135121170566
        }
    )

    process process-form-form-on-magazines (
        name: Process form Form on MAGAZINES
        type: formAutoRowProcessing
        formRegion: @form-on-magazines
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32706576941170566
        }
    )

    process upload-pdf-file (
        name: upload_pdf_file
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_file_names apex_t_varchar2;
                    l_file       apex_application_temp_files%rowtype;
                    v_file_name varchar2(99);
                begin
                
                    l_file_names := apex_string.split (
                                        p_str => :P38_PDF_FILE,
                                        p_sep => ':' );
                
                    for i in 1 .. l_file_names.count loop
                        select *
                          into l_file
                          from apex_application_temp_files
                         where name = l_file_names(i) and APPLICATION_ID=:APP_ID;      
                
                v_file_name := 'mag'||:P38_MAG_ID ||'.pdf';
                
                central.blob_to_file(p_blob=>l_file.BLOB_CONTENT,p_dir=>'ATTACH',p_filename=>v_file_name);
                    
                    end loop;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 28506373813524831
        }
    )

)
