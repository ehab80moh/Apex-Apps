    button create-request (
        buttonName: create_request
        label: &APP_TEXT$SUBMIT_THE_APPLICATION.
        layout {
            sequence: 10
            region: @معتمدين-الطلب-6
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: &P40_REQUEST_URL.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v_approvers number;
                begin
                select count(*)
                into v_approvers
                  from CENTRAL.APR_APPROVAL_RESULT_V
                 where EMP_NUMBER=:P40_EMP_ID
                and REQUEST_TYPE_ID = :P40_REQUEST_TYPE_ID
                and approve_type='FYA'
                AND is_mandatory='Yes'
                and approver not in ('-1','-2');
                if v_approvers =0 then
                 return false;
                 end if;
                
                if :P40_EMP_ID <> :app_user then
                return false;
                else
                return true;
                end if;
                end;
                ```
        }
    )

    button reset (
        buttonName: RESET
        label: &APP_TEXT$RESET_1.
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 40
                clearCache: 58
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    computation p40-request-url (
        itemName: P40_REQUEST_URL
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                
                case :P40_REQUEST_TYPE_ID 
                when 59 then
                return 'f?p=115:13:'||V('SESSION');
                when 61 then
                return 'f?p=115:45:'||V('SESSION');
                when 72 then
                return 'f?p=115:25:'||V('SESSION');
                when 76 then
                return 'f?p=115:55:'||V('SESSION');
                WHEN 107 THEN
                return 'f?p=105:9:'||V('SESSION');
                WHEN 96 THEN
                return 'f?p=124:9:'||V('SESSION');
                else return null;
                end case;
                
                return null;
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    process clear-session (
        name: CLEAR SESSION
        type: clearSessionState
        clear {
            type: pages
            pages: 20
        }
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 32887786244977241
        }
    )

    process compute-req-owner (
        name: Compute Req owner
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                :p40_EMP_ID:=NVL(:P40_EMP_ID,:APP_USER);
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32888106102977242
        }
    )

)
