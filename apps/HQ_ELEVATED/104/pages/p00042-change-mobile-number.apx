    region تغيير-رقم-الهاتف (
        name: "تغيير رقم الهاتف "
        title: &APP_TEXT$CHANGE_PHONE_NUMBER.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       EMP_ID,
                       MOBILE,
                       COMP_EMAIL,
                       PERSONAL_EMAIL,
                       MOBILE_CONFIRMED,
                       COMP_EMAIL_CONFIRMED,
                       PERSONAL_EMAIL_CONFIRMED
                  from CENTRAL.EMP_CONTACT
                  WHERE EMP_ID = :APP_USER;
                ```
            pageItemsToSubmit: APP_USER
        }
        layout {
            sequence: 41
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
