    dynamicAction disable-phone-number (
        name: Disable phone number
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P42_MOBILE
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item>=value
                item: P42_GOOD
                value: 1
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: items
                items: P42_NEW_NUMBER
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item>=value
                item: P42_GOOD2
                value: 1
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @send-to-mobile-code-button
            }
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: item>=value
                item: P42_GOOD
                value: 1
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P42_CHECKLIST
            }
            execution {
                sequence: 40
            }
            serverSideCondition {
                type: never
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: region
                region: @تفاصيل-الايميل
            }
            execution {
                sequence: 50
            }
            clientSideCondition {
                type: item>=value
                item: P42_GOOD
                value: 1
            }
            serverSideCondition {
                type: never
            }
        )

        action native-hide-4 (
            action: hide
            affectedElements {
                selectionType: button
                button: @add-new-number
            }
            execution {
                sequence: 80
            }
            clientSideCondition {
                type: item=value
                item: P42_GOOD2
                value: 1
            }
        )

    )

    dynamicAction toggleitemsbasedonchecklist (
        name: ToggleItemsBasedOnChecklist
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P42_CHECKLIST
        }
        clientSideCondition {
            type: item=value
            item: P42_CHECKLIST
            value: Y
        }

        action email (
            name: Email
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      vc VARCHAR2(99);
                      personal_email VARCHAR2(99);
                      comp_email VARCHAR2(99);
                    BEGIN
                      SELECT central.conceal_email(PERSONAL_EMAIL), central.conceal_email(COMP_EMAIL)
                      INTO personal_email, comp_email
                      FROM central.EMP_CONTACT
                      WHERE EMP_ID = :P42_EMP_ID;
                    
                      IF personal_email IS NOT NULL AND comp_email IS NOT NULL THEN
                        vc := personal_email || '   _____   ' || comp_email;
                      ELSIF personal_email IS NOT NULL THEN
                        vc := personal_email;
                      ELSIF comp_email IS NOT NULL THEN
                        vc := comp_email;
                      ELSE
                        RAISE NO_DATA_FOUND;
                      END IF;
                    
                      apex_util.set_session_state('P42_MY_EMAIL_SHOW', vc);
                      apex_util.set_session_state('P42_MY_EMAIL', '');
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        apex_util.set_session_state('P42_MY_EMAIL', 'No Email Found !!');
                        apex_util.set_session_state('P42_MY_EMAIL', 0);
                      WHEN OTHERS THEN
                        apex_util.set_session_state('P42_MY_EMAIL_SHOW', 'An error occurred while retrieving the email');
                        apex_util.set_session_state('P42_MY_EMAIL', 0);
                    END;
                    ```
                itemsToSubmit: P42_EMP_ID
                itemsToReturn: P42_MY_EMAIL_SHOW
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action n (
            name: N
            action: hide
            affectedElements {
                selectionType: region
                region: @تفاصيل-الايميل
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action y (
            name: Y
            action: show
            affectedElements {
                selectionType: region
                region: @تفاصيل-الايميل
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 30
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select PERSONAL_EMAIL,COMP_EMAIL
                           from central.EMP_CONTACT
                          where EMP_ID = :P42_EMP_ID
                          and (
                           lower(PERSONAL_EMAIL) = lower(:P42_MY_EMAIL) 
                           or
                           lower(COMP_EMAIL) = lower(:P42_MY_EMAIL) 
                          )
                             )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_EMAIL_ENTERED_DOES_NOT_MATCH_THE_REGISTERED_EMAIL.
            associatedItem: @P42_MY_EMAIL
        }
        serverSideCondition {
            whenButtonPressed: @send-to-mail
        }
    )

    validation new-2 (
        name: New_1
        execution {
            sequence: 40
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select RESET_CODE
                           from central.EMP_CRIDS
                          where EMP_ID = :P42_EMP_ID
                             AND RESET_CODE = :P42_CHECK_OTP
                )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_CODE_DOES_NOT_MATCH.
            associatedItem: @P42_CHECK_OTP
        }
        serverSideCondition {
            whenButtonPressed: @check-mail-otp
        }
    )

    validation phone-new-number (
        name: Phone New Number
        execution {
            sequence: 20
        }
        validation {
            type: itemMatchesRegexp
            item: P42_NEW_NUMBER
            regexp: "^01\\d{9}$"
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE.
            associatedItem: @P42_NEW_NUMBER
        }
        serverSideCondition {
            whenButtonPressed: @add-new-number
        }
    )

    validation phone-number (
        name: Phone Number
        execution {
            sequence: 10
        }
        validation {
            type: itemMatchesRegexp
            item: P42_MOBILE
            regexp: "^01\\d{9}$"
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE.
            associatedItem: @P42_MOBILE
        }
        serverSideCondition {
            whenButtonPressed: @send-to-mobile-code-button
        }
    )

    process add-new-number (
        name: add new number
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                   v_db_mobile VARCHAR2(20); -- Assuming the data type of v_db_mobile is VARCHAR2, adjust if necessary
                   v_result NUMBER;
                BEGIN
                   v_result := central.sms_pkg.send_and_change_phone(P_USER => :P42_EMP_ID);
                
                   IF v_result <> 1 THEN
                      APEX_ERROR.ADD_ERROR (
                         P_MESSAGE          => 'خطأ في إرسال رمز الرسالة النصية',
                         P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                      );
                      :P42_GOOD2 := 0;
                   ELSE
                      :P42_GOOD2 := 1;
                  
                   END IF;
                
                   SELECT MOBILE INTO v_db_mobile
                   FROM central.emp_contact
                   WHERE emp_id = :P42_EMP_ID;
                
                   UPDATE central.emp_contact
                   SET MOBILE2 = :P42_NEW_NUMBER,
                       MOBILE2_CONFIRMED = 0
                   WHERE emp_id = :P42_EMP_ID;
                
                   IF LENGTH(:P42_NEW_NUMBER) <> 11 OR SUBSTR(:P42_NEW_NUMBER, 1, 2) <> '01' THEN
                      APEX_ERROR.ADD_ERROR (
                         P_MESSAGE          => 'صيغة رقم الهاتف غير صحيحة. يجب أن يكون طوله 11 رقمًا ويبدأ بـ "01"',
                         P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                      );
                      :P42_GOOD2 := 0;
                   END IF;
                
                   IF :P42_NEW_NUMBER = v_db_mobile THEN
                      APEX_ERROR.ADD_ERROR (
                         P_MESSAGE          => 'تطابق بين الهاتف المُدخل والهاتف المسجل بالفعل.',
                         P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                      );
                      :P42_GOOD2 := 0;
                   END IF;
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: &APP_TEXT$PLEASE_RECEIVE_THE_CODE_AND_ADD_IT_TO_COMPLETE_THE_PROCESS_SUCCESSFULLY.
        }
        error {
            errorMessage: &APP_TEXT$THE_PHONE_NUMBER_HAS_NOT_BEEN_CHANGED.
        }
        advanced {
            executionMappingIdentifier: 21092535669964907
        }
        serverSideCondition {
            whenButtonPressed: @add-new-number
        }
    )

    process check-send-code-to-new-mobile-phone (
        name: "CHECK & SEND CODE TO NEW MOBILE PHONE "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  IF central.sms_pkg.check_otp(:P42_EMP_ID, :P42_OTP_NEW_NUMBER) <> 1 THEN
                    APEX_ERROR.ADD_ERROR (
                      P_MESSAGE          => 'الكود خطأ',
                      P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                    );
                    :P42_GOOD := 0; -- Indicate that there's an error
                  ELSE
                    :P42_GOOD := 3; -- Indicate success
                    
                    UPDATE CENTRAL.Emp_contact
                    SET
                      MOBILE = MOBILE2,
                      MOBILE2 = MOBILE,
                      MOBILE2_CONFIRMED = 1
                   WHERE emp_id = :P42_EMP_ID;
                  END IF;
                END;
                
                ```
        }
        execution {
