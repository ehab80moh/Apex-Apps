    process send-and-reset-number-phone (
        name: send and reset number phone
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                   v_result NUMBER;
                   v_db_mobile VARCHAR2(255); -- Change the datatype based on the actual datatype of the mobile column
                BEGIN
                   v_result := central.sms_pkg.send_and_reset_number_phone(P_USER => :P42_EMP_ID);
                
                   IF v_result <> 1 THEN
                      APEX_ERROR.ADD_ERROR (
                         P_MESSAGE          => 'الكود خطأ',
                         P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                      );
                      :P42_GOOD := 0;
                   ELSE
                      :P42_GOOD := 1;
                   END IF;
                
                   SELECT Mobile INTO v_db_mobile
                   FROM central.emp_contact
                   WHERE emp_id = :P42_EMP_ID;
                
                   IF :P42_MOBILE <> v_db_mobile THEN
                      APEX_ERROR.ADD_ERROR (
                         P_MESSAGE          => 'عدم تطابق بين الهاتف المُدخل والهاتف المسجل.',
                         P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                      );
                      :P42_GOOD := 0;
                   END IF;
                
                   IF LENGTH(:P42_MOBILE) <> 11 OR SUBSTR(:P42_MOBILE, 1, 2) <> '01' THEN
                      APEX_ERROR.ADD_ERROR (
                         P_MESSAGE          => 'صيغة رقم الهاتف غير صحيحة. يجب أن يكون طوله 11 رقمًا ويبدأ بـ "01"',
                         P_DISPLAY_LOCATION => APEX_ERROR.C_INLINE_IN_NOTIFICATION
                      );
                      :P42_GOOD := 0;
                   END IF;
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: &APP_TEXT$THE_CODE_WAS_SENT_TO_THE_OLD_NUMBER.
        }
        error {
            errorMessage: &APP_TEXT$THE_MESSAGE_WAS_NOT_SENT.
        }
