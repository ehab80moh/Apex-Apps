        title: &APP_TEXT$OUR_REGISTERED_PERSONAL_EMAIL.
        type: staticContent
        source {
            htmlCode: <b><font size="4">&P43_MY_EMAIL.</font></b>
        }
        layout {
            sequence: 51
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

