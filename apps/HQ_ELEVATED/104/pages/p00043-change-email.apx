    button back (
        buttonName: BACK
        label: &APP_TEXT$SETTINGS.
        layout {
            sequence: 21
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--inlineLink
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button check-mail-otp (
        buttonName: CHECK_MAIL_OTP
        label: &APP_TEXT$TO_VERIFY_THE_SENT_CODE.
        layout {
            sequence: 50
            region: @إضافة-او-تغيير-البريد-الإلكتروني-الشخصي
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--hoverIconPush
                t-Button--padTop
                t-Button--padBottom
            ]
            icon: fa-mail-forward
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button send-to-mail (
        buttonName: Send_To_Mail
        label: &APP_TEXT$TO_SEND_THE_CODE_VIA_EMAIL.
        layout {
            sequence: 30
            region: @إضافة-او-تغيير-البريد-الإلكتروني-الشخصي
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--hoverIconPush
                t-Button--padBottom
            ]
            icon: fa-mail-forward
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation new (
        name: New_1
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select RESET_CODE
                           from central.EMP_CRIDS
                          where EMP_ID = :P43_EMP_ID
                             AND OTP = :P43_CHECK_OTP
                )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_CODE_DOES_NOT_MATCH.
            associatedItem: @P43_CHECK_OTP
        }
        serverSideCondition {
            whenButtonPressed: @check-mail-otp
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 39937132727487578
        }
        serverSideCondition {
            whenButtonPressed: @check-mail-otp
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process email (
        name: EMAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                  v_sent NUMBER;
                
                BEGIN
                  v_sent := Central.EMAIL_PKG.send_otp_mail_To_ADD_MAIL(
                    P_USER => :P43_EMP_ID , P_Email => :P43_MY_EMAIL
                  );
                
                  IF v_sent = 1 THEN
                    NULL; -- Success, do nothing
                  
                  END IF;
                END;
                
                
                
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &APP_TEXT$THE_EMAIL_HAS_BEEN_SENT_TO_YOU_SUCCESSFULLY_PLEASE_RECEIVE_THE_CODE.
        }
        advanced {
            executionMappingIdentifier: 39936783029487578
        }
        serverSideCondition {
            whenButtonPressed: @send-to-mail
        }
    )

    process initialize-form-إضافة-تغيير-الايميل (
        name: "Initialize form إضافة / تغيير الايميل "
        type: formInitialization
        formRegion: @إضافة-او-تغيير-البريد-الإلكتروني
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 39934466388487560
        }
    )

    process new (
        name: New
        type: clearSessionState
        execution {
            sequence: 50
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 39937553033487578
        }
    )

    process set-comp-email (
        name: SET COMP EMAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_personal_email VARCHAR2(50) := :P43_MY_EMAIL;
                    v_emp_id VARCHAR2(50) := :P43_EMP_ID;
                BEGIN
                    UPDATE central.emp_contact
                    SET personal_email = v_personal_email ,
                    PERSONAL_EMAIL_CONFIRMED = '1'
                    WHERE emp_id = v_emp_id;
                    
                    COMMIT; -- Optional: Commit the transaction if necessary
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: &APP_TEXT$THE_EMAIL_HAS_BEEN_VERIFIED_AND_ADDED_SUCCESSFULLY.
        }
        advanced {
            executionMappingIdentifier: 39936314760487577
        }
        serverSideCondition {
            whenButtonPressed: @check-mail-otp
        }
    )

)
