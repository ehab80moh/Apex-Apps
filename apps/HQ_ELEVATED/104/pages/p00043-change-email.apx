            formRegion: @إضافة-او-تغيير-البريد-الإلكتروني
            column: MOBILE_CONFIRMED
            dataType: number
        }
    )

    pageItem P43_MY_EMAIL (
        type: textField
        label {
            label: &APP_TEXT$E_MAIL.
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 10
            region: @إضافة-او-تغيير-البريد-الإلكتروني-الشخصي
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--boldDisplay
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT PERSONAL_EMAIL
                FROM central.emp_contact
                 WHERE emp_id = :App_user;
                ```
        }
