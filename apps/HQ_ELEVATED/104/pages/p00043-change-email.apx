page 43 (
    name: تغيير/ إضافه البريد الإلكتروني
    alias: CHANGE-EMAIL
    title: &APP_TEXT$CHANGE_ADD_EMAIL.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        title: &APP_TEXT$NEW.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$PLUG_SOURCE.
        }
        layout {
            sequence: 31
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
    )

    region إضافة-او-تغيير-البريد-الإلكتروني (
        name: إضافة او تغيير البريد الإلكتروني
        title: &APP_TEXT$ADD_OR_CHANGE_EMAIL.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       EMP_ID,
                       MOBILE,
                       COMP_EMAIL,
                       PERSONAL_EMAIL,
                       MOBILE_CONFIRMED,
                       COMP_EMAIL_CONFIRMED,
                       PERSONAL_EMAIL_CONFIRMED
                  from CENTRAL.EMP_CONTACT
                  WHERE EMP_ID = :APP_USER;
                ```
            pageItemsToSubmit: APP_USER
        }
        layout {
            sequence: 41
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region إضافة-او-تغيير-البريد-الإلكتروني-الشخصي (
        name: إضافة او تغيير البريد الإلكتروني  الشخصي
        title: &APP_TEXT$ADD_OR_CHANGE_YOUR_PERSONAL_EMAIL.
        type: staticContent
        layout {
            sequence: 61
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent14
                t-Region--scrollBody
                margin-top-sm
                margin-right-sm
            ]
        }
    )

    region البريد-الإلكتروني-الشخصي-المسجل-لدينا (
