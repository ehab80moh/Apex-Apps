    process leave-type (
        name: LEAVE_TYPE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    leave_type VARCHAR2(10) := '&LEAVE_TYPE.';
                    leave_description VARCHAR2(100);
                BEGIN
                    IF leave_type = 'H' THEN
                        leave_description := 'اجازة';
                    ELSIF leave_type = 'RH' THEN
                        leave_description := 'ساعات راحة';
                    ELSIF leave_type = 'C' THEN
                        leave_description := 'عارضة';
                    ELSE
                        leave_description := 'Unknown'; -- Or handle default case as needed
                    END IF;
                
                    htp.p('<span style="font-weight: bold;">Leave Type:</span>');
                    htp.p('<span>' || leave_description || '</span>');
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 37976274745404419
        }
    )

