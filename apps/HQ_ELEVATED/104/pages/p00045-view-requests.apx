    region in-out (
        name: IN & OUT
        title: &APP_TEXT$IN_OUT.
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH first_false AS (
                    SELECT 
                        employeenumber,
                        TRUNC(date_) AS date_day,
                        MIN(date_) AS date_
                    FROM 
                        hq_elevated.TMS_EMP_TRANSACTIONS
                    WHERE 
                        employeenumber = :App_user
                        AND type = 'false'
                        AND EXTRACT(YEAR FROM date_) = EXTRACT(YEAR FROM SYSDATE)
                
                    GROUP BY 
                        employeenumber,
                        TRUNC(date_)
                ),
                last_true AS (
                    SELECT 
                        employeenumber,
                        TRUNC(date_) AS date_day,
                        MAX(date_) AS date_
                    FROM 
                        hq_elevated.TMS_EMP_TRANSACTIONS
                    WHERE 
                        employeenumber = :App_user
                        AND type = 'true'
                    GROUP BY 
                        employeenumber,
                        TRUNC(date_)
                )
                SELECT DISTINCT
                    CASE 
                        WHEN t.type = 'false' THEN 'u-color-20'
                        WHEN t.type = 'true' THEN 'u-color-8'
                    END AS Css_class,
                    TO_CHAR(t.date_,'HH:MI:SS') AS formatted_date, -- Format the date and time
                    CASE 
                        WHEN t.type = 'false' THEN 'SIGN IN'
                        WHEN t.type = 'true' THEN 'SIGN OUT'
                    END AS type,
                    t.date_ AS Date_,
                    t.employeenumber
                FROM 
                    hq_elevated.TMS_EMP_TRANSACTIONS t
                JOIN 
                    first_false ff ON t.employeenumber = ff.employeenumber AND t.date_ = ff.date_
                
                UNION ALL
                
                SELECT DISTINCT
                    CASE 
                        WHEN t.type = 'false' THEN 'u-color-20'
                        WHEN t.type = 'true' THEN 'u-color-8'
                    END AS Css_class,
                    TO_CHAR(t.date_, 'HH:MI:SS') AS formatted_date, -- Format the date and time
                    CASE 
                        WHEN t.type = 'false' THEN 'SIGN IN'
                        WHEN t.type = 'true' THEN 'SIGN OUT'
                    END AS type,
                    t.date_ AS Date_,
                    t.employeenumber
                FROM 
                    hq_elevated.TMS_EMP_TRANSACTIONS t
                JOIN 
                    last_true lt ON t.employeenumber = lt.employeenumber AND t.date_ = lt.date_
                
                ```
        }
        layout {
            sequence: 70
            parentRegion: @region-display-selector
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
            icon: fa-chevron-right
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @it
        }
        settings {
            displayColumn: FORMATTED_DATE
            startDateColumn: DATE_
            endDateColumn: DATE_
            showTime: true
            timeFormat: 12Hour
            firstHour: 7
            supplementalInfo: &TYPE.
            multipleLineEvents: false
            calendarViewsAndNavigation: [
                month
                week
                day
                list
                navigation
            ]
            cssClass: CSS_CLASS
        }
        performance {
            lazyLoading: true
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function ( pOptions ) { 
                
                    pOptions.showNonCurrentDates = false;
                
                    return pOptions;
                }
                ```
        }
    )

    region in-out-with-requests (
        name: IN & OUT WITH REQUESTS
        title: &APP_TEXT$IN_OUT_WITH_REQUESTS.
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                
                WITH first_false AS (
                    SELECT 
                        employeenumber,
                        TRUNC(date_) AS date_day,
                        MIN(date_) AS date_
                    FROM 
                        hq_elevated.TMS_EMP_TRANSACTIONS
                    WHERE 
                        employeenumber = :APP_USER
                        AND type = 'false'
                    GROUP BY 
                        employeenumber,
                        TRUNC(date_)
                ),
                last_true AS (
                    SELECT 
                        employeenumber,
                        TRUNC(date_) AS date_day,
                        MAX(date_) AS date_
                    FROM 
                        hq_elevated.TMS_EMP_TRANSACTIONS
                    WHERE 
                        employeenumber = :APP_USER
                        AND type = 'true'
                    GROUP BY 
                        employeenumber,
                        TRUNC(date_)
                )
                SELECT 
                    'apex-cal-green' AS css_class,
                    TO_CHAR(H.REQUEST_ID) AS request_id,
                    central.get_Emp_name(H.emp_id) AS employee_name,
                    H.FROM_HOUR AS start_time,
                    H.TO_HOUR AS end_time,
                    CAST(NULL AS VARCHAR2(100)) AS request_type,
                    'Overtime Request' || '-' || TO_CHAR(H.FROM_HOUR, 'HH:MI:SS') || '-' || TO_CHAR(H.TO_HOUR, 'HH:MI:SS') AS request_category,
                    TO_CHAR(H.emp_id) AS emp_id
                FROM
                    EPROMHQ.HRF_EMP_OVERTIME_REQUEST H
                WHERE    
                    H.emp_id = :APP_USER
                    AND EXTRACT(YEAR FROM H.FROM_HOUR) = EXTRACT(YEAR FROM SYSDATE)
                    AND H.APPROVED = 1
                    AND NVL(H.DELETE_TMS, 0) != 1
                UNION ALL
                SELECT 
                    'u-color-3' AS css_class,
                    TO_CHAR(H.REQUEST_ID) AS request_id,
                    central.get_Emp_name(H.emp_id) AS employee_name,
                    H.FROM_HOUR AS start_time,
                    H.TO_HOUR AS end_time,
                    TO_CHAR(H.PERMISSION_TYPE) AS request_type,
                    'Permission Request' || '-' || TO_CHAR(H.PERMISSION_TYPE) || '-' || TO_CHAR(H.FROM_HOUR, 'HH:MI:SS') || '-' || TO_CHAR(H.TO_HOUR, 'HH:MI:SS') AS request_category,
                    TO_CHAR(H.emp_id) AS emp_id
                FROM 
                    EPROMHQ.HRF_EMP_PERMISSION_REQUEST H  
                WHERE  
                    H.emp_id = :APP_USER
                    AND EXTRACT(YEAR FROM H.FROM_HOUR) = EXTRACT(YEAR FROM SYSDATE)
                    AND H.APPROVED = 1
                    AND NVL(H.DELETE_TMS, 0) != 1
                UNION ALL
                SELECT 
                    'apex-cal-blue' AS css_class,
                    TO_CHAR(H.REQUEST_ID) AS request_id,
                    central.get_Emp_name(H.emp_id) AS employee_name,
                    H.FROM_DATE AS start_time,
                    H.TO_DATE + 1/24 AS end_time,
                    TO_CHAR(H.REQUEST_TYPE_ID) AS request_type,
                    CASE 
                        WHEN H.REQUEST_TYPE_ID = 72 THEN 
                            CASE 
                                WHEN H.FROM_DATE = H.TO_DATE THEN 'Mission Leave ' || ' - Date: ' || TO_CHAR(H.FROM_DATE)
                                ELSE 'Mission Leave ' || ' - From: ' || TO_CHAR(H.FROM_DATE) || ' - To: ' || TO_CHAR(H.TO_DATE)
                            END
                        WHEN H.REQUEST_TYPE_ID = 121 THEN 
                            CASE 
                                WHEN H.FROM_DATE = H.TO_DATE THEN 'Training Mission Leave' || ' - Date: ' || TO_CHAR(H.FROM_DATE)
                                ELSE 'Training Mission Leave' || ' - From: ' || TO_CHAR(H.FROM_DATE) || ' - To: ' || TO_CHAR(H.TO_DATE)
                            END
                        ELSE 'Mission Request - Other' 
                    END AS request_category,
                    TO_CHAR(H.emp_id) AS emp_id
                FROM
                    EPROMHQ.HRF_EMP_MISSION_REQUEST H
                WHERE  
                    H.emp_id = :APP_USER
                    AND EXTRACT(YEAR FROM H.FROM_DATE) = EXTRACT(YEAR FROM SYSDATE)
                    AND H.APPROVED = 1
                    AND NVL(H.DELETE_TMS, 0) != 1
                UNION ALL
                SELECT 
                    'apex-cal-black' AS css_class,
                    TO_CHAR(H.REQUEST_ID) AS request_id,
                    central.get_Emp_name(H.emp_id) AS employee_name,
                    H.FROM_DATE AS start_time,
                    H.TO_DATE + 1/24 AS end_time,
                    H.LEAVE_TYPE AS request_type,
                    CASE 
                        WHEN H.LEAVE_TYPE = 'H' THEN 
                            CASE 
                                WHEN H.FROM_DATE = H.TO_DATE THEN 'Annual Leave ' || ': ' || H.LEAVE_TYPE || ' - Date: ' || TO_CHAR(H.FROM_DATE)
                                ELSE 'Annual Leave ' || ': ' || H.LEAVE_TYPE || ' - From: ' || TO_CHAR(H.FROM_DATE) || ' - To: ' || TO_CHAR(H.TO_DATE)
                            END
                        WHEN H.LEAVE_TYPE = 'C' THEN 
                            CASE 
                                WHEN H.FROM_DATE = H.TO_DATE THEN 'Casual Leave ' || ': ' || H.LEAVE_TYPE || ' - Date: ' || TO_CHAR(H.FROM_DATE)
                                ELSE 'Casual Leave ' || ': ' || H.LEAVE_TYPE || ' - From: ' || TO_CHAR(H.FROM_DATE) || ' - To: ' || TO_CHAR(H.TO_DATE)
                            END
                        WHEN H.LEAVE_TYPE = 'RH' THEN 
                            CASE 
                                WHEN H.FROM_DATE = H.TO_DATE THEN 'Rest-Hours Leave ' || ': ' || H.LEAVE_TYPE || ' - Date: ' || TO_CHAR(H.FROM_DATE)
                                ELSE 'Rest-Hours Leave ' || ': ' || H.LEAVE_TYPE || ' - From: ' || TO_CHAR(H.FROM_DATE) || ' - To: ' || TO_CHAR(H.TO_DATE)
                            END
                        ELSE 'Leave Request - Other'
                    END AS request_category,
                    TO_CHAR(H.emp_id) AS emp_id
                FROM
                    EPROMHQ.HRF_EMP_LEAVE_REQUEST H 
                WHERE 
                    H.emp_id = :APP_USER
                    AND NVL(H.DELETE_TMS, 0) != 1
                    AND H.APPROVED = 1
                UNION ALL
                
                SELECT DISTINCT
                    CASE 
                        WHEN t.type = 'false' THEN 
                            CASE 
                                WHEN TO_CHAR(t.date_, 'HH24:MI:SS') >= '08:15:00' THEN 'u-danger'
                                ELSE 'u-color-20'
                            END
                    END AS css_class,
                    CAST(NULL AS VARCHAR2(100)) AS request_id,
                    central.get_Emp_name(t.employeenumber) AS employee_name,
                    t.date_ AS start_time,
                    t.date_ AS end_time,
                    CAST(NULL AS VARCHAR2(100)) AS request_type,
                    'Sign In' || ' : ' || TO_CHAR(t.date_, 'HH24:MI:SS') AS request_category,
                    TO_CHAR(t.employeenumber) AS emp_id
                FROM 
                    hq_elevated.TMS_EMP_TRANSACTIONS t
                JOIN 
                    first_false ff ON t.employeenumber = ff.employeenumber AND t.date_ = ff.date_
                
                UNION ALL
                
                SELECT DISTINCT
                    CASE 
                        WHEN t.type = 'true' THEN 
                            CASE 
                                WHEN TO_CHAR(t.date_, 'HH24:MI:SS') >= '11:16:00' AND TO_CHAR(t.date_, 'HH24:MI:SS') <= '15:15:00' THEN 'u-danger'
                                ELSE 'u-color-8'
                            END
                    END AS css_class,
                    CAST(NULL AS VARCHAR2(100)) AS request_id,
                    central.get_Emp_name(t.employeenumber) AS employee_name,
                    t.date_ AS start_time,
                    t.date_ AS end_time,
                    CAST(NULL AS VARCHAR2(100)) AS request_type,
                    'Sign Out' || ' : ' || TO_CHAR(t.date_, 'HH24:MI:SS') AS request_category,
                    TO_CHAR(t.employeenumber) AS emp_id
                FROM 
                    hq_elevated.TMS_EMP_TRANSACTIONS t
                JOIN 
                    last_true lt ON t.employeenumber = lt.employeenumber AND t.date_ = lt.date_
                
                UNION ALL 
                SELECT DISTINCT
                    'u-success' AS css_class,
                    '0' AS request_id,
                    NAME AS employee_name,
                    FROMDATE AS start_time,
                    TODATE + 1/24 AS end_time,
                    NULL AS request_type,
                    'Public Holiday' || ' : ' || NAME AS request_category,
                    :APP_USER AS emp_id
                FROM 
                    EPROMHQ.tms_holidays
                
                ```
        }
        layout {
            sequence: 80
            parentRegion: @region-display-selector
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
            icon: fa-chevron-right
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @it
        }
        settings {
            displayColumn: REQUEST_CATEGORY
            startDateColumn: START_TIME
            endDateColumn: END_TIME
            pkColumn: REQUEST_ID
            showTime: true
            timeFormat: 12Hour
            firstHour: 0
            multipleLineEvents: false
            calendarViewsAndNavigation: [
                month
                week
                day
                list
                navigation
            ]
            cssClass: CSS_CLASS
        }
        performance {
            lazyLoading: true
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function ( pOptions ) { 
                
                    pOptions.showNonCurrentDates = false;
                    return pOptions;
                }
                ```
        }
    )

