    pageItem P45_REQUEST_EMP_ID (
        type: selectList
        label {
            label: اختيار الموظف للطلبات
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT d.emp_name, d.emp_number
                FROM central.xxapex_hr_emp_data d
                WHERE TO_CHAR(d.emp_number) = TO_CHAR(:APP_USER)
                   OR EXISTS (
                       SELECT 1
                       FROM central.APR_APPROVAL_RESULTS_CUST_F c
                       WHERE TO_CHAR(c.approver) = TO_CHAR(:APP_USER)
                         AND TO_CHAR(c.emp_number) = TO_CHAR(d.emp_number)
                         AND c.request_type_id IN (59, 61, 72, 121, 76)
                   )
                ORDER BY CASE
                             WHEN TO_CHAR(d.emp_number) = TO_CHAR(:APP_USER) THEN 0
                             ELSE 1
                         END,
                         d.emp_name
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @unified-employee-requests
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: :App_user
        }
        sessionState {
            storage: request
        }
    )

