    region unified-employee-requests (
        name: طلبات الموظف الموحدة
        title: طلبات الموظف الموحدة
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH allowed_employees AS (
                    SELECT TO_CHAR(:APP_USER) AS emp_id
                    FROM dual
                    UNION
                    SELECT DISTINCT TO_CHAR(c.emp_number) AS emp_id
                    FROM central.APR_APPROVAL_RESULTS_CUST_F c
                    WHERE TO_CHAR(c.approver) = TO_CHAR(:APP_USER)
                      AND c.emp_number IS NOT NULL
                      AND c.request_type_id IN (59, 61, 72, 121, 76)
                ),
                selected_employee AS (
                    SELECT CASE
                               WHEN EXISTS (
                                   SELECT 1
                                   FROM allowed_employees a
                                   WHERE a.emp_id = TO_CHAR(:P45_REQUEST_EMP_ID)
                               )
                               THEN TO_CHAR(:P45_REQUEST_EMP_ID)
                               ELSE TO_CHAR(:APP_USER)
                           END AS emp_id
                    FROM dual
                )
                SELECT
                    'apex-cal-green' AS css_class,
                    h.request_id,
                    central.get_emp_name(h.emp_id) AS employee_name,
                    h.from_date AS start_time,
                    h.to_date AS end_time,
                    'LEAVE' AS request_type,
                    CASE h.leave_type
                        WHEN 'H' THEN 'إجازة سنوية'
                        WHEN 'C' THEN 'إجازة عارضة'
                        WHEN 'RH' THEN 'إجازة ساعات راحة'
                        ELSE 'إجازة'
                    END AS request_category,
                    h.emp_id
                FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST h
                CROSS JOIN selected_employee s
                WHERE TO_CHAR(h.emp_id) = s.emp_id
                  AND h.approved = 1
                  AND NVL(h.delete_tms, 0) <> 1
                  AND EXTRACT(YEAR FROM h.from_date) = NVL(TO_NUMBER(:P45_YEAR), EXTRACT(YEAR FROM SYSDATE))
                
                UNION ALL
                
                SELECT
                    'apex-cal-yellow' AS css_class,
                    h.request_id,
                    central.get_emp_name(h.emp_id) AS employee_name,
                    h.from_hour AS start_time,
                    h.to_hour AS end_time,
                    'PERMISSION' AS request_type,
                    CASE h.permission_type
                        WHEN 'PP' THEN 'إذن شخصي'
                        WHEN 'CP' THEN 'إذن عمل'
                        ELSE 'إذن'
                    END AS request_category,
                    h.emp_id
                FROM EPROMHQ.HRF_EMP_PERMISSION_REQUEST h
                CROSS JOIN selected_employee s
                WHERE TO_CHAR(h.emp_id) = s.emp_id
                  AND h.approved = 1
                  AND NVL(h.delete_tms, 0) <> 1
                  AND EXTRACT(YEAR FROM h.from_hour) = NVL(TO_NUMBER(:P45_YEAR), EXTRACT(YEAR FROM SYSDATE))
                
                UNION ALL
                
                SELECT
                    'apex-cal-blue' AS css_class,
                    h.request_id,
                    central.get_emp_name(h.emp_id) AS employee_name,
                    h.from_date AS start_time,
                    h.to_date AS end_time,
                    'MISSION' AS request_type,
                    CASE TO_CHAR(h.request_type_id)
                        WHEN '72' THEN 'مهمة داخلية'
                        WHEN '121' THEN 'مهمة خارجية'
                        ELSE 'مهمة'
                    END AS request_category,
                    h.emp_id
                FROM EPROMHQ.HRF_EMP_MISSION_REQUEST h
                CROSS JOIN selected_employee s
                WHERE TO_CHAR(h.emp_id) = s.emp_id
                  AND h.request_type_id IN (72, 121)
                  AND h.approved = 1
                  AND NVL(h.delete_tms, 0) <> 1
                  AND EXTRACT(YEAR FROM h.from_date) = NVL(TO_NUMBER(:P45_YEAR), EXTRACT(YEAR FROM SYSDATE))
                
                UNION ALL
                
                SELECT
                    'apex-cal-red' AS css_class,
                    h.request_id,
                    central.get_emp_name(h.emp_id) AS employee_name,
                    h.from_hour AS start_time,
                    h.to_hour AS end_time,
                    'OVERTIME' AS request_type,
                    'ساعات عمل إضافية' AS request_category,
                    h.emp_id
                FROM EPROMHQ.HRF_EMP_OVERTIME_REQUEST h
                CROSS JOIN selected_employee s
                WHERE TO_CHAR(h.emp_id) = s.emp_id
                  AND h.approved = 1
                  AND NVL(h.delete_tms, 0) <> 1
                  AND EXTRACT(YEAR FROM h.from_hour) = NVL(TO_NUMBER(:P45_YEAR), EXTRACT(YEAR FROM SYSDATE))
                ```
            pageItemsToSubmit: [
                P45_REQUEST_EMP_ID
                P45_YEAR
            ]
        }
        layout {
            sequence: 15
            parentRegion: @region-display-selector
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
            icon: fa-chevron-right
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            displayColumn: REQUEST_CATEGORY
            startDateColumn: START_TIME
            endDateColumn: END_TIME
            pkColumn: REQUEST_ID
            showTime: true
            timeFormat: 12Hour
            firstHour: 0
            supplementalInfo: EMPLOYEE_NAME
            multipleLineEvents: false
            showTooltip: false
            calendarViewsAndNavigation: [
                month
                navigation
                list
            ]
            createLink: {
                page: 451
                items: {
                    P451_NEW: &APEX$NEW_START_DATE.
                    P451_EMP_ID: &APP_USER.
                }
            }
            cssClass: CSS_CLASS
        }
        performance {
            lazyLoading: true
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function ( pOptions ) {
                    pOptions.showNonCurrentDates = false;
                    return pOptions;
                }
                ```
        }
    )

    region view-requests (
        name: VIEW REQUESTS
        title: &APP_TEXT$VIEW_REQUESTS.
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    t1.*, 
                    CASE t1.REQUEST_TYPE
                        WHEN 'Mission' THEN 'apex-cal-green'
                        WHEN 'Leave' THEN 'apex-cal-brown'
                        WHEN 'Overtime' THEN 'apex-cal-red'
                        WHEN 'Permission' THEN 'apex-cal-darkblue'
                        ELSE 'Unknown'
                    END AS css_class,
                    leave_req.FROM_DATE,
                    leave_req.TO_DATE
                FROM (
                    SELECT 
                        apr.*, 
                        central.get_emp_name(COALESCE(lev.EMP_ID, mis.EMP_ID)) AS EMPLOYEE_NAME,
                        CASE 
                            WHEN lev.EMP_ID IS NOT NULL THEN 'Leave'
                            WHEN mis.EMP_ID IS NOT NULL THEN 'Mission'
                            ELSE 'Unknown'
                        END AS REQUEST_TYPE
                    FROM 
                        CENTRAL.APR_LOG apr
                    LEFT JOIN 
                        EPROMHQ.HRF_EMP_LEAVE_REQUEST lev ON apr.REQUEST_ID = lev.REQUEST_ID
                    LEFT JOIN 
                        EPROMHQ.HRF_EMP_MISSION_REQUEST mis ON apr.REQUEST_ID = mis.REQUEST_ID
                    UNION ALL
                    SELECT 
                        apr.*, 
                        NULL AS EMPLOYEE_NAME,
                        NULL AS REQUEST_TYPE
                    FROM 
                        CENTRAL.APR_LOG apr
                    WHERE 
                        apr.REQUEST_ID NOT IN (
                            SELECT REQUEST_ID FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST
                            UNION
                            SELECT REQUEST_ID FROM EPROMHQ.HRF_EMP_MISSION_REQUEST
                        )
                ) t1
                LEFT JOIN (
                    SELECT REQUEST_ID, FROM_DATE, TO_DATE
                    FROM (
                        SELECT REQUEST_ID, FROM_DATE, TO_DATE
                        FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST
                        WHERE LEAVE_TYPE IN ('C', 'H', 'RH')
                        UNION ALL
                        SELECT REQUEST_ID, FROM_DATE, TO_DATE
                        FROM EPROMHQ.HRF_EMP_MISSION_REQUEST
                        WHERE Request_type_id IN ('72', '121')
                        UNION ALL
                        SELECT REQUEST_ID, NULL FROM_DATE, NULL TO_DATE
                        FROM EPROMHQ.HRF_EMP_OVERTIME_REQUEST 
                        UNION ALL
                        SELECT REQUEST_ID, NULL FROM_DATE, NULL TO_DATE
                        FROM EPROMHQ.HRF_EMP_PERMISSION_REQUEST
                    )
                ) leave_req ON t1.REQUEST_ID = leave_req.REQUEST_ID;
                
                ```
        }
        layout {
            sequence: 41
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        readOnly {
            type: always
        }
        settings {
            displayColumn: EMPLOYEE_NAME
            startDateColumn: FROM_DATE
            endDateColumn: TO_DATE
            pkColumn: ID
            supplementalInfo:
                ```html
                &REQUEST_TYPE.
                <!-- &P45_FROM_DATE.
                &P45_TO_DATE.
                &P45_PERMISSION_TIME.
                <!-- 
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Request Types</title>
                </head>
                <body>
                    <table border="1">
                        <tr>
                            <th>Request Type</th>
                        </tr>
                        // Loop through query results
                        while ($row = mysqli_fetch_assoc($result)) {
                            echo "<tr>";
                            echo "<td>";
                            // Switch statement to determine request type
                            switch ($row['REQUEST_TYPE_ID']) {
                                case 72:
                                    echo "Mission";
                                    break;
                                case 59:
                                    echo "Leave";
                                    break;
                                case 76:
                                    echo "Overtime";
                                    break;
                                case 61:
                                    echo "Permission";
                                    break;
                                default:
                                    echo "Other";
                            }
                            echo "</td>";
                            echo "</tr>";
                        }
                        ?>
                    </table>
                </body>
                </html> --> -->
                
                ```
            additionalCalendarViews: [
                list
                navigation
            ]
            cssClass: CSS_CLASS
        }
    )

