                    P451_NEW: &APEX$NEW_START_DATE.
                    P451_EMP_ID: &APP_USER.
                }
            }
            cssClass: CSS_CLASS
        }
        performance {
            lazyLoading: true
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function ( pOptions ) { 
                
                    pOptions.showNonCurrentDates = false;
                    return pOptions;
                }
                
                ```
