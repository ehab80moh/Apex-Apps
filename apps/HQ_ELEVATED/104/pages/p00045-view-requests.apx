    region بيان-الحضور-والانصراف (
        name: بيان الحضور والانصراف
        title: &APP_TEXT$STATEMENT_OF_ATTENDANCE_AND_DEPARTURE.
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CSS_CLASS,
                       REQUEST_ID,
                       EMPLOYEE_NAME,
                       START_TIME,
                       END_TIME,
                       REQUEST_TYPE,
                       REQUEST_CATEGORY,
                       EMP_ID,
                       TRUNC(SYSDATE, 'MM')
                  from CENTRAL.EMP_REQUESTS_SUMMARY s 
                  where s.EMP_ID = nvl(:P45_EMP_ID,:app_user)
                ```
            pageItemsToSubmit: P45_EMP_ID
        }
        layout {
            sequence: 10
            parentRegion: @region-display-selector
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
            icon: fa-chevron-right
        }
        advanced {
            htmlDomId: CALENDAR_REGION_ID
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @it-and-others
        }
        settings {
            displayColumn: REQUEST_CATEGORY
            startDateColumn: START_TIME
            endDateColumn: END_TIME
            showTime: true
            timeFormat: 12Hour
            firstHour: 0
            multipleLineEvents: false
            showTooltip: false
