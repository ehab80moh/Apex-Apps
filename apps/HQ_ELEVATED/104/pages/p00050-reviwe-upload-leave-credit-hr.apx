    process delete-collection (
        name: "delete collection "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                BEGIN
                    APEX_COLLECTION.DELETE_COLLECTION(
                        p_collection_name => 'CREDIT_COL'
                    );
                
                
                    COMMIT;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                
                        DBMS_OUTPUT.PUT_LINE('Error occurred: ' || SQLERRM);
                        RAISE;
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1509739431166176
        }
    )

    process merge-credit (
        name: merge credit
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                 
                BEGIN
                MERGE INTO CENTRAL.XXAPEX_LEAVE_CREDIT_HR t
                USING (
                    SELECT 
                        C001 AS EMP_ID,
                        C002 AS ANNUAL_ENTITELMENT,
                        C003 AS CASUAL_ENTITELMENT,
                        C004 AS ACCRUED_LAST_YEAR,
                        C005 AS CUT_H_BALANCE,
                        C006 AS ANNUAL_BALANCE,
                        C007 AS CASUAL_BALANCE,
                        C008 AS REST_HRS_BALANCE,
                        C009 AS CURRENTLY_PROJECT,
                        D001 AS DATE_UNTIL
                    FROM 
                        APEX_COLLECTIONS
                    WHERE 
                        COLLECTION_NAME = 'CREDIT_COL'
                ) s
                ON (t.EMP_ID = s.EMP_ID)
                WHEN MATCHED THEN 
                    UPDATE SET 
                        t.ANNUAL_CREDIT = s.ANNUAL_ENTITELMENT,
                        t.CASUAL_CREDIT = s.CASUAL_ENTITELMENT,
                        t.ACCRUED_LAST_YEAR = s.ACCRUED_LAST_YEAR,
                        t.CUT_H_BALANCE = s.CUT_H_BALANCE,
                        t.ANNUAL_BALANCE = s.ANNUAL_BALANCE,
                        t.CASUAL_BALANCE = s.CASUAL_BALANCE,
                        t.REST_HRS_BALANCE = s.REST_HRS_BALANCE,
                        t.CURRENTLY_PROJECT = s.CURRENTLY_PROJECT,
                        t.DATE_UNTIL = s.DATE_UNTIL
                WHEN NOT MATCHED THEN 
                    INSERT (
                        EMP_ID, 
                        ANNUAL_CREDIT, 
                        CASUAL_CREDIT, 
                        ACCRUED_LAST_YEAR,
                        CUT_H_BALANCE,
                        ANNUAL_BALANCE, 
                        CASUAL_BALANCE,
                        REST_HRS_BALANCE,
                        CURRENTLY_PROJECT,
                        DATE_UNTIL
                    )
                    VALUES (
                        s.EMP_ID,
                        s.ANNUAL_ENTITELMENT,
                        s.CASUAL_ENTITELMENT,
                        s.ACCRUED_LAST_YEAR,
                        s.CUT_H_BALANCE,
                        s.ANNUAL_BALANCE,
                        s.CASUAL_BALANCE,
                        s.REST_HRS_BALANCE,
                        s.CURRENTLY_PROJECT,
                        s.DATE_UNTIL
                    );
                  
                
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        DBMS_OUTPUT.PUT_LINE('Error occurred: ' || SQLERRM);
                        RAISE;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1509324881166178
        }
    )

)
