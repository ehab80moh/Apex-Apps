    region errors-️-️-️-️-️-️ (
        name: errors ☠️☠️☠️☠️☠️☠️
        title: &APP_TEXT$ERRORS.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH data AS (
                    SELECT 
                        C001 AS EMP_ID,
                        C002 AS ANNUAL_ENTITELMENT,
                        C003 AS CASUAL_ENTITELMENT,
                        C004 AS ACCRUED_LAST_YEAR,
                        C005 AS CUT_H_BALANCE,
                        C006 AS ANNUAL_BALANCE,
                        C007 AS CASUAL_BALANCE,
                        C008 AS REST_HRS_BALANCE,
                        C009 AS CURRENTLY_PROJECT,
                        D001 AS DATE_UNTIL
                    FROM 
                        APEX_COLLECTIONS
                    WHERE 
                        COLLECTION_NAME = 'CREDIT_COL'
                )
                SELECT 
                    EMP_ID,
                    ANNUAL_ENTITELMENT,
                    CASUAL_ENTITELMENT,
                    ANNUAL_BALANCE,
                    CASUAL_BALANCE
                FROM 
                    (
                    SELECT 
                        EMP_ID,
                        ANNUAL_ENTITELMENT,
                        CASUAL_ENTITELMENT,
                        ANNUAL_BALANCE,
                        CASUAL_BALANCE,
                        COUNT(*) OVER (PARTITION BY EMP_ID) AS emp_count
                    FROM 
                        data
                    ) s
                WHERE 
                    ANNUAL_ENTITELMENT IS NULL 
                    OR CASUAL_ENTITELMENT IS NULL 
                    OR ANNUAL_BALANCE IS NULL 
                    OR CASUAL_BALANCE IS NULL
                    OR emp_count > 1;
                ```
        }
        layout {
            sequence: 11
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: &APP_TEXT$NO_ERRORS.
        }

        column ANNUAL_BALANCE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ANNUAL_BALANCE.
            }
            layout {
                sequence: 40
            }
        )

