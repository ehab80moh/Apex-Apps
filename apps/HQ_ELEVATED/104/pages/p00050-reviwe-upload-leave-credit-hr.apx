page 50 (
    name: reviwe_Upload_LEAVE_CREDIT_HR
    alias: REVIWE-UPLOAD-LEAVE-CREDIT-HR
    title: &APP_TEXT$REVIWEUPLOADLEAVECREDITHR.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
