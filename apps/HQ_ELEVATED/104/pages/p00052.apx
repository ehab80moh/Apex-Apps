    region details (
        name: &APP_TEXT$ITR_PAGE52_REQUEST_DETAILS.
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with visible_task as (
                    select task_id
                      from table(apex_human_task.get_tasks(
                                   p_context => 'SINGLE_TASK',
                                   p_task_id => :P52_TASK_ID))
                ),
                request_parameter as (
                    select p.task_id,
                           max(case when p.param_static_id = 'T_REQUEST_ID'
                                    then to_number(p.param_value) end) as request_id,
                           max(case when p.param_static_id = 'T_REQUEST_TYPE_ID'
                                    then to_number(p.param_value) end) as request_type_id
                      from apex_task_parameters p
                      join visible_task t on t.task_id = p.task_id
                     group by p.task_id
                )
                select p.request_id,
                       coalesce(to_char(r.request_no), pr.request_no, to_char(p.request_id)) as request_no,
                       case when p.request_type_id = 202
                            then to_char(pr.submitted_at, 'YYYY-MM-DD')
                            else to_char(r.request_date, 'YYYY-MM-DD')
                       end as submitted_on,
                       case when p.request_type_id = 202
                            then coalesce(trim(pr.employee_name_snapshot), pr.employee_number)
                            else coalesce(trim(central.get_emp_name(r.emp_id)), r.emp_id)
                       end as employee_name,
                       case when p.request_type_id = 202 then pr.employee_number else r.emp_id end as employee_id,
                       r.emp_building as building,
                       r.emp_room as room_no,
                       case when p.request_type_id = 202 then null
                            else case lower(trim(r.criticality))
                                   when 'normal' then apex_lang.message('ITR_PAGE705_PRIORITY_NORMAL')
                                   when 'urgent' then apex_lang.message('ITR_PAGE705_PRIORITY_URGENT')
                                   else coalesce(r.criticality, apex_lang.message('ITR_PAGE52_UNAVAILABLE'))
                                 end
                       end as criticality_label,
                       case when p.request_type_id = 202
                            then apex_lang.message('MEDICAL_PRESCRIPTION_REQUEST_FORM')
                            else case d.id
                                   when 1 then apex_lang.message('ITR_SERVICE_RELOCATE')
                                   when 2 then apex_lang.message('ITR_SERVICE_UPGRADE')
                                   when 3 then apex_lang.message('ITR_SERVICE_NEW_EQUIPMENT')
                                   when 4 then apex_lang.message('ITR_SERVICE_CONSUMABLES')
                                   when 5 then apex_lang.message('ITR_SERVICE_EMAIL_ACCOUNT')
                                   when 6 then apex_lang.message('ITR_SERVICE_SOFTWARE_INSTALL')
                                   when 7 then apex_lang.message('ITR_SERVICE_SOFTWARE_DEVELOPMENT')
                                   when 8 then apex_lang.message('ITR_SERVICE_NEW_USER_ACCOUNT')
                                   when 9 then apex_lang.message('ITR_SERVICE_HARDWARE_SUPPORT')
                                   when 10 then apex_lang.message('ITR_SERVICE_SOFTWARE_SUPPORT')
                                   when 11 then apex_lang.message('ITR_SERVICE_BACKUP')
                                   when 12 then apex_lang.message('ITR_SERVICE_EDMS')
                                   when 13 then apex_lang.message('ITR_SERVICE_JOIN_DOMAIN')
                                   when 14 then apex_lang.message('ITR_SERVICE_NETWORK_ACCESS')
                                   when 15 then apex_lang.message('ITR_SERVICE_INTERNET_ACCESS')
                                   when 16 then apex_lang.message('ITR_SERVICE_FILE_SERVER_ACCESS')
                                   when 17 then apex_lang.message('ITR_SERVICE_EBS_NEW_USER')
                                   when 18 then apex_lang.message('ITR_SERVICE_EBS_RESPONSIBILITY')
                                   when 19 then apex_lang.message('ITR_SERVICE_EBS_PASSWORD_RESET')
                                   when 20 then apex_lang.message('ITR_SERVICE_EBS_BUG_REPORT')
                                   when 21 then apex_lang.message('ITR_SERVICE_EBS_CUSTOM_REPORT')
                                   when 22 then apex_lang.message('ITR_SERVICE_APEX_NEW_APPLICATION')
                                   when 23 then apex_lang.message('ITR_SERVICE_APEX_PAGE_MODIFICATION')
                                   when 24 then apex_lang.message('ITR_SERVICE_APEX_BUG_REPORT')
                                   when 25 then apex_lang.message('ITR_SERVICE_APEX_ACCESS_PERMISSION')
                                   else d.title
                                 end
                       end as service_title,
                       r.description,
                       case when p.request_type_id = 202 then pr.employee_note else r.user_comment end as user_comment
                  from request_parameter p
                  left join hq_elevated.itr_requests r
                    on r.request_id = p.request_id
                   and nvl(p.request_type_id, -1) not in (106, 202)
                  left join hq_elevated.itr_request_type_details d
                    on d.id = r.request_type_detail_id
                  left join med.md_pres_request pr
                    on pr.request_id = p.request_id
                   and p.request_type_id = 202
                 where (p.request_type_id = 202 and pr.request_id is not null)
                    or (nvl(p.request_type_id, -1) not in (106, 202) and r.request_id is not null)
                ```
            pageItemsToSubmit: P52_TASK_ID
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader
                t-Region--noUI
            ]
            cssClasses: p52-request-card
        }
        accessibility {
            landmarkType: region
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where ( :P52_REQUEST_TYPE_ID = '202'
                         and exists (
                             select 1
                               from med.md_pres_request pr
                              where pr.request_id = to_number(:P52_REQUEST_ID) ) )
                    or ( nvl(:P52_REQUEST_TYPE_ID, '-') not in ('106', '202')
                         and exists (
                             select 1
                               from hq_elevated.itr_requests r
                              where r.request_id = to_number(:P52_REQUEST_ID) ) )
                ```
        }
        componentAppearance {
            display: partial
        }
        settings {
            overline: &APP_TEXT$ITR_PAGE52_REQUEST_DETAILS.
            title: &SERVICE_TITLE.
            description:
                ```html
                <div class="p52-section-title">&APP_TEXT$ITR_PAGE52_REQUESTER.</div>
                <div class="p52-meta-grid">
                    <div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_EMPLOYEE_NAME.</span><span class="p52-meta-value">&EMPLOYEE_NAME!HTML.</span></div>
                    <div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_EMPLOYEE_ID.</span><span class="p52-meta-value">&EMPLOYEE_ID!HTML.</span></div>
                    {if BUILDING/}<div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_BUILDING.</span><span class="p52-meta-value">&BUILDING!HTML.</span></div>{endif/}
                    {if ROOM_NO/}<div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_ROOM.</span><span class="p52-meta-value">&ROOM_NO!HTML.</span></div>{endif/}
                </div>
                <div class="p52-section-title">&APP_TEXT$ITR_PAGE52_REQUEST_DETAILS.</div>
                <div class="p52-meta-grid">
                    <div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_REQUEST_NO.</span><span class="p52-meta-value">&REQUEST_NO!HTML.</span></div>
                    <div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_SUBMITTED_ON.</span><span class="p52-meta-value">&SUBMITTED_ON!HTML.</span></div>
                    {if CRITICALITY_LABEL/}<div class="p52-meta-tile"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_PRIORITY.</span><span class="p52-meta-value">&CRITICALITY_LABEL!HTML.</span></div>{endif/}
                </div>
                {if DESCRIPTION/}<div class="p52-detail-block"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_DESCRIPTION.</span><span class="p52-meta-value">&DESCRIPTION!HTML.</span></div>{endif/}
                {if USER_COMMENT/}<div class="p52-detail-block"><span class="p52-meta-label">&APP_TEXT$ITR_PAGE52_REQUESTER_NOTE.</span><span class="p52-meta-value">&USER_COMMENT!HTML.</span></div>{endif/}
                ```
        }

