            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noUI
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from med.md_pres_request pr
                 where :P52_REQUEST_TYPE_ID = '202'
                   and pr.request_id = to_number(:P52_REQUEST_ID)
                ```
