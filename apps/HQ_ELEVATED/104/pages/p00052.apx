    button medical-reject (
        buttonName: MEDICAL_REJECT
        label: &APP_TEXT$ITR_PAGE52_REJECT.
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--link
                t-Button--iconLeft
            ]
            icon: fa-times-circle-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                apex_human_task.is_allowed (
                    p_task_id   => :P52_TASK_ID,
                    p_operation => apex_human_task.c_task_op_reject )
                and :P52_REQUEST_TYPE_ID = '106'
                ```
        }
    )

