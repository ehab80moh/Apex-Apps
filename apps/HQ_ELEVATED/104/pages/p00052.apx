            ]
        }
        accessibility {
            landmarkType: form
        }
        advanced {
            htmlDomId: SUBMIT_INFO
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                apex_human_task.is_allowed (
                    p_task_id   => :P52_TASK_ID,
