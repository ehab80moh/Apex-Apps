            type: expression
            plsqlExpression:
                ```plsql
                apex_human_task.is_allowed (
                    p_task_id   => :P52_TASK_ID,
                    p_operation => apex_human_task.c_task_op_approve )
                AND NVL(:P52_REQUEST_TYPE_ID, '-') NOT IN ('106','202')
