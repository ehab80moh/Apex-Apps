    dynamicAction disable-enable-update-button (
        name: Disable/Enable Update Button
        execution {
            sequence: 10
        }
        when {
            event: keyup
            selectionType: items
            items: P52_NEW_VALUE
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @update-parameter
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @update-parameter
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-parameter (
        name: Edit Parameter
        execution {
            sequence: 10
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.parameter
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @update-parameter
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @edit-parameter
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P52_NEW_VALUE
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: apex.jQuery(this.triggeringElement).attr("data-id")
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P52_PARAM_STATIC_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: apex.jQuery(this.triggeringElement).attr("data-label")
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P52_PARAM_LABEL
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: apex.jQuery(this.triggeringElement).attr("data-value")
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: [
                    P52_PARAM_VALUE
                    P52_NEW_VALUE
                ]
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-4 (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: apex.jQuery(this.triggeringElement).attr("data-required")
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P52_IS_REQUIRED
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

