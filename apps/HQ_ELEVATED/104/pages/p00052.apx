            outputAs: text
        }
    )

    region unavailable-task (
        name: &APP_TEXT$ITR_PAGE52_UNAVAILABLE.
        title: &APP_TEXT$ITR_PAGE52_UNAVAILABLE_TITLE.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$ITR_PAGE52_UNAVAILABLE.
        }
        layout {
            sequence: 45
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--warning
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--removeHeading js-removeLandmark
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_count number;
                begin
                    select count(*)
                      into l_count
                      from table(apex_human_task.get_tasks(
                                   p_context => 'SINGLE_TASK',
                                   p_task_id => :P52_TASK_ID)) t
                      join apex_task_parameters p
                        on p.task_id = t.task_id
                       and p.param_static_id = 'T_REQUEST_TYPE_ID'
                     where to_number(p.param_value) = 106;
                
                    if l_count > 0 then
                        return false;
                    end if;
                
                    if :P52_REQUEST_TYPE_ID = '202' then
                        select count(*)
                          into l_count
                          from med.md_pres_request r
                         where r.request_id = to_number(:P52_REQUEST_ID);
                
                        return l_count = 0;
                    end if;
                
                    select count(*)
                      into l_count
                      from table(apex_human_task.get_tasks(
                                   p_context => 'SINGLE_TASK',
                                   p_task_id => :P52_TASK_ID)) t
                      join apex_task_parameters p
                        on p.task_id = t.task_id
                       and p.param_static_id = 'T_REQUEST_ID'
                      join hq_elevated.itr_requests r
                        on r.request_id = to_number(p.param_value);
                
                    return l_count = 0;
                exception
                    when others then
                        return true;
                end;
                ```
        }
    )

