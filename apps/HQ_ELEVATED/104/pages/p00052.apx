    button open-dialog-add-comment (
        buttonName: OPEN_DIALOG_ADD_COMMENT
        label: &APP_TEXT$ITR_PAGE52_ADD_COMMENT.
        layout {
            sequence: 10
            region: @comments
            slot: edit
        }
