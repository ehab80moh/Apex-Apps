page 52 (
    name: Task Details
    title: &APP_TEXT$ITR_PAGE52_TITLE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
        cssClasses: p52-it-approval
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            apex.jQuery(() => {
                document.addEventListener("click", function(event) {
                    const link = event.target.closest("a.js-prescription-review-handoff");
                    if (!link) { return; }
                    if (link.dataset.handoffReady === "Y") {
                        delete link.dataset.handoffReady;
                        return;
                    }
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    if (link.dataset.handoffBusy === "Y") { return; }
                    link.dataset.handoffBusy = "Y";
                    apex.server.process("PREPARE_PRESCRIPTION_REVIEW", {x01: apex.item("P52_TASK_ID").getValue()}, {
                        dataType: "json",
                        success: function(data) {
                            delete link.dataset.handoffBusy;
                            if (data.ready === true) { link.dataset.handoffReady = "Y"; link.click(); }
                        },
                        error: function(xhr, status, error) {
                            delete link.dataset.handoffBusy;
                            apex.message.showErrors([{type: "error", location: "page", message: "تعذر فتح المراجعة. أعد تحميل المهمة وحاول مرة أخرى.", unsafe: false}]);
                        }
                    });
                }, true);
                apex.jQuery("a.taskActionMenu").each((index, item) => {
                    const element = apex.jQuery(item);
                    const actionName = decodeURI(element.attr("href")).match(/\$([^?]+)/)[1];
                    const actionLabel = element.text();
                    apex.actions.add({
                        name: actionName,
                        label: actionLabel,
                        action: (event, element, args) => {
                            if (args.do === "submit") {
                                apex.page.submit(actionName.toUpperCase());
                            }
                            else if (args.do === "openRegion") {
                                apex.theme.openRegion(actionName.toUpperCase());
                            }
                        }
                    });
                });
            });
            ```
    }
    css {
        inline:
            ```css
            .p52-it-approval .t-Dialog-body {
                background: #f4f7fb;
            }
            .p52-summary-card,
            .p52-request-card {
                border: 1px solid #dbe5ef;
                border-radius: 16px;
                background: #fff;
                box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
                overflow: hidden;
            }
            .p52-summary-card .t-Region-body,
            .p52-request-card .t-Region-body {
                padding: 1rem;
            }
            .p52-summary-card .a-ContentRow-title,
            .p52-request-card .a-ContentRow-title {
                color: #0f172a;
                font-weight: 800;
                line-height: 1.45;
            }
            .p52-summary-card .a-ContentRow-badge {
                border-radius: 999px;
                font-weight: 800;
            }
            .p52-meta-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: .7rem;
                margin-top: .8rem;
            }
            .p52-meta-tile,
            .p52-detail-block {
                padding: .7rem .8rem;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                background: #f8fafc;
            }
            .p52-meta-label {
                display: block;
                margin-bottom: .2rem;
                color: #64748b;
                font-size: .78rem;
                font-weight: 700;
            }
            .p52-meta-value {
                color: #0f172a;
                font-size: .98rem;
                font-weight: 800;
                overflow-wrap: anywhere;
            }
            .p52-section-title {
                margin: 1rem 0 .55rem;
                color: #0f766e;
                font-size: .9rem;
                font-weight: 800;
            }
            .p52-detail-block {
                margin-top: .75rem;
                background: #fff;
                line-height: 1.65;
                white-space: pre-wrap;
            }
            .p52-action-bar {
                border-top: 1px solid #dbe5ef;
                background: rgba(255, 255, 255, .96);
                backdrop-filter: blur(8px);
            }
            .p52-action-bar .t-Button {
                border-radius: 999px;
                font-weight: 800;
            }
            .p52-it-approval :focus-visible {
                outline: 3px solid rgba(14, 165, 233, .35);
                outline-offset: 2px;
            }
            [dir="rtl"] .p52-it-approval .a-ContentRow,
            [dir="rtl"] .p52-it-approval .p52-meta-grid {
                text-align: right;
            }
            @media (max-width: 640px) {
                .p52-meta-grid {
                    grid-template-columns: 1fr;
                }
                .p52-action-bar .t-Button {
                    flex: 1 1 auto;
                }
            }
            ```
    }
