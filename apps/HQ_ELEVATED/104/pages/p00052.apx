    region history (
        name: &APP_TEXT$ITR_PAGE52_HISTORY.
        type: themeTemplateComponent/comments
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_msg,
                       event_creator,
                       event_timestamp
                  from table ( apex_human_task.get_task_history (
                                   p_task_id     => :P52_TASK_ID,
                                   p_include_all => :P52_ALL_HISTORY ) )
                 order by event_timestamp desc
                ```
            pageItemsToSubmit: [
                P52_TASK_ID
                P52_ALL_HISTORY
            ]
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        accessibility {
            landmarkType: region
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from table(apex_human_task.get_tasks(
                           p_context => 'SINGLE_TASK',
                           p_task_id => :P52_TASK_ID))
                ```
        }
        componentAppearance {
            display: report
