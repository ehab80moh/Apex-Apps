    process prepare-prescription-review (
        name: PREPARE_PRESCRIPTION_REVIEW
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 l_task number := to_number(apex_application.g_x01 default null on conversion error);
                 l_request number; l_type varchar2(30); l_source varchar2(128);
                 l_owner varchar2(255); l_state varchar2(30); l_actor varchar2(255) := v('APP_USER');
                 l_emp varchar2(30); l_target varchar2(255); l_count number;
                begin
                 if v('APP_ID')<>'104' or v('APP_PAGE_ID')<>'52' or l_task is null or trim(l_actor) is null
                    or med.apr_med_approver_task_api.has_medical_task_access(l_actor,52,l_task)<>'Y' then
                  raise_application_error(-20421,'Prescription review must use an assigned App104 medical task');
                 end if;
                 select actual_owner,state_code into l_owner,l_state from apex_tasks
                  where task_id=l_task and application_id=104 and lower(task_def_static_id)='approval-task';
                 select max(case when param_static_id='T_REQUEST_ID' then to_number(param_value default null on conversion error) end),
                        max(case when param_static_id='T_REQUEST_TYPE_ID' then trim(param_value) end),
                        max(case when param_static_id='T_REQUEST_SOURCE' then trim(param_value) end)
                   into l_request,l_type,l_source from apex_task_parameters where task_id=l_task;
                 if l_request is null or l_type is null or l_type<>'202'
                    or l_source is null or l_source<>'MED.MD_PRES_REQUEST'
                    or l_state is null or l_state not in('UNASSIGNED','ASSIGNED') then
                  raise_application_error(-20422,'Only a live prescription approval task can open this review');
                 end if;
                 l_emp:=med.apr_med_approver_task_api.resolve_actor_emp_number(l_actor);
                 l_target:=med.apr_med_approver_task_api.resolve_task_username(l_emp);
                 if l_emp is null or l_target is null
                    or nvl(med.apr_med_approver_task_api.resolve_actor_emp_number(l_target),'!')<>l_emp then
                  raise_application_error(-20423,'The reviewer must have one active medical account');
                 end if;
                 select count(*) into l_count from apex_task_participants
                  where task_id=l_task and upper(participant_type)='POTENTIAL_OWNER'
                    and upper(participant)=upper(l_target);
                 if l_count<>1 then raise_application_error(-20424,'The medical account is not a potential owner of this task');end if;
                 if l_owner is not null then
                  if upper(trim(l_owner))<>upper(trim(l_actor)) then
                   raise_application_error(-20425,'Another user owns this prescription task');
                  end if;
                  -- The shared EPROM_HQ session keeps APP_USER unchanged across104 and200.
                  -- Preserve its literal actual owner so native task completion remains valid.
                 end if;
                 apex_json.open_object;
                 apex_json.write('ready',true);
                 apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 900017852010
        }
    )

