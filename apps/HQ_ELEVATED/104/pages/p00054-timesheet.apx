    button create-time-sheet (
        buttonName: CREATE_TIME_SHEET
        label: &APP_TEXT$CREATE_TIME_SHEET.
        layout {
            sequence: 91
            slot: body
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
                t-Button--gapLeft
                t-Button--gapRight
                t-Button--gapTop
                t-Button--gapBottom
            ]
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        start_date DATE := TO_DATE(:P54_MONTH || '-01', 'YYYY-MM-DD'); -- Start of the month
                        end_date DATE := LAST_DAY(start_date);                         -- End of the month
                        v_emp_id NUMBER := :P54_EMP_ID;                                -- Employee ID
                    BEGIN
                        FOR d IN (
                            SELECT start_date + LEVEL - 1 AS work_date
                            FROM DUAL
                            CONNECT BY LEVEL <= end_date - start_date + 1
                        )
                        LOOP
                            BEGIN
                                INSERT INTO EPROMHQ.XXAPEX_TIMESHEET (
                                    EMP_ID,
                                    WORK_DATE,
                                    TIME_IN_HOUR,
                                    TIME_IN_MIN,
                                    TIME_OUT_HOUR,
                                    TIME_OUT_MIN,
                                    STANDARD_HOURS,
                                    APPROVED_OVERTIME_HOURS_BEFORE_7PM,
                                    APPROVED_OVERTIME_HOURS_AFTER_7PM,
                                    DAY_NAME
                                )
                                SELECT 
                                    v_emp_id,
                                    d.work_date,
                                    :P54_TIME_IN_HOUR,  -- TIME_IN_HOUR
                                    :P54_TIME_IN_MIN,   -- TIME_IN_MIN
                                    :P54_TIME_OUT_HOUR, -- TIME_OUT_HOUR
                                    :P54_TIME_OUT_MIN,  -- TIME_OUT_MIN
                                    NVL(:STANDARD_HOURS, 8),                  -- Default to 8 hours if null
                                    NVL(:APPROVED_OVERTIME_HOURS_BEFORE_7PM, 0), -- Default to 0 if null
                                    NVL(:APPROVED_OVERTIME_HOURS_AFTER_7PM, 0),  -- Default to 0 if null
                                    TRIM(TO_CHAR(d.work_date, 'Day'))         -- Trim to avoid padding spaces
                                FROM DUAL
                                WHERE NOT EXISTS (
                                    SELECT 1
                                    FROM EPROMHQ.XXAPEX_TIMESHEET
                                    WHERE EMP_ID = v_emp_id
                                    AND WORK_DATE = d.work_date
                                );
                            EXCEPTION
                                WHEN DUP_VAL_ON_INDEX THEN
                                    NULL;
                            END;
                        END LOOP;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P54_EMP_ID
                    P54_MONTH
                    P54_TIME_IN_HOUR
                    P54_TIME_OUT_HOUR
                    P54_TIME_IN_MIN
                    P54_TIME_OUT_MIN
                ]
            }
            execution {
                sequence: 10
                waitForResult: false
            }
        )

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @timesheet
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction calculate-the-standard-hours (
        name: "Calculate The STANDARD HOURS "
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @timesheet
            columns: [
                TIME_IN_HOUR
                TIME_IN_MIN
                TIME_OUT_HOUR
                TIME_OUT_MIN
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_time_in  DATE;
                        v_time_out DATE;
                    BEGIN
                        v_time_in := TO_DATE(:WORK_DATE || ' ' || :TIME_IN_HOUR || ':' || NVL(:TIME_IN_MIN, 0), 'YYYY-MM-DD HH24:MI');
                        v_time_out := TO_DATE(:WORK_DATE || ' ' || :TIME_OUT_HOUR || ':' || NVL(:TIME_OUT_MIN, 0), 'YYYY-MM-DD HH24:MI');
                    
                        :STANDARD_HOURS := ROUND((v_time_out - v_time_in) * 24, 2);
                    END;
                    
                    ```
                itemsToSubmit: [
                    TIME_IN_HOUR
                    TIME_IN_MIN
                    TIME_OUT_HOUR
                    TIME_OUT_MIN
                    WORK_DATE
                ]
                itemsToReturn: STANDARD_HOURS
                showProcessing: true
            }
            execution {
                sequence: 10
                stopExecutionOnError: false
                waitForResult: false
            }
        )

    )

    dynamicAction submit-using-the-page-items (
        name: SUBMIT USING THE PAGE ITEMS
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P54_EMP_ID
                P54_MONTH
            ]
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @timesheet
            plsqlExpression: :TIME_OUT_HOUR < :TIME_IN_HOUR
        }
        error {
            errorMessage: &APP_TEXT$PLEASE_ADJUST_THE_CLOCK.
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                
                BEGIN
                    MERGE INTO EPROMHQ.XXAPEX_TIMESHEET tgt
                    USING (SELECT :P54_EMP_ID AS EMP_ID, :P54_MONTH AS MONTH_VALUE FROM DUAL) src
                    ON (
                        tgt.EMP_ID IS NULL OR TRIM(TO_CHAR(tgt.WORK_DATE, 'Month')) = src.MONTH_VALUE
                       )
                    WHEN MATCHED THEN
                        UPDATE SET tgt.EMP_ID = src.EMP_ID
                    WHEN NOT MATCHED THEN
                        INSERT (EMP_ID, WORK_DATE) -- Add columns as necessary
                        VALUES (src.EMP_ID, TO_DATE(src.MONTH_VALUE, 'Month')); -- Adjust to match your table structure
                
                    COMMIT;
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 70094037411604441
        }
        serverSideCondition {
            type: never
        }
    )

    process new-2 (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    start_date DATE := TO_DATE(:P54_MONTH || '-01', 'YYYY-MM-DD');
                    end_date DATE := LAST_DAY(start_date);
                    v_emp_id NUMBER := :P54_EMP_ID;
                BEGIN
                    FOR d IN (
                        SELECT start_date + LEVEL - 1 AS work_date
                        FROM DUAL
                        CONNECT BY LEVEL <= end_date - start_date + 1
                    )
                    LOOP
                        BEGIN
                            INSERT INTO EPROMHQ.XXAPEX_TIMESHEET (
                                EMP_ID,
                                WORK_DATE,
                                TIME_IN_HOUR,
                                TIME_IN_MIN,
                                TIME_OUT_HOUR,
                                TIME_OUT_MIN,
                                STANDARD_HOURS,
                                APPROVED_OVERTIME_HOURS_BEFORE_7PM,
                                APPROVED_OVERTIME_HOURS_AFTER_7PM,
                                DAY_NAME
                            )
                            SELECT 
                                v_emp_id,
                                d.work_date,
                                :P54_TIME_IN_HOUR,  -- TIME_IN_HOUR
                                :P54_TIME_IN_MIN,   -- TIME_IN_MIN
                                :P54_TIME_OUT_HOUR, -- TIME_OUT_HOUR
                                :P54_TIME_OUT_MIN,  -- TIME_OUT_MIN
                                :STANDARD_HOURS,    -- Default STANDARD_HOURS
                                :APPROVED_OVERTIME_HOURS_BEFORE_7PM, -- Default APPROVED_OVERTIME_HOURS_BEFORE_7PM
                                :APPROVED_OVERTIME_HOURS_AFTER_7PM,  -- Default APPROVED_OVERTIME_HOURS_AFTER_7PM
                                TO_CHAR(d.work_date, 'Day')  -- Day name
                            FROM DUAL
                            WHERE NOT EXISTS (
                                SELECT 1
                                FROM EPROMHQ.XXAPEX_TIMESHEET
                                WHERE EMP_ID = v_emp_id
                                AND WORK_DATE = d.work_date
                            );
                        EXCEPTION
                            WHEN DUP_VAL_ON_INDEX THEN
                                NULL;
                        END;
                    END LOOP;
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 73290007535155738
        }
        serverSideCondition {
            type: never
        }
    )

