    region timesheet (
        name: Timesheet
        title: &APP_TEXT$TIMESHEET.
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    TIMESHEET_ID,
                    EMP_ID,
                    WORK_DATE,
                   DAY_NAME, -- Add this column for day name
                    TIME_IN_HOUR,
                    TIME_IN_MIN,
                    TIME_OUT_HOUR,
                    TIME_OUT_MIN,
                     STANDARD_HOURS,
                    APPROVED_OVERTIME_HOURS_BEFORE_7PM,
                    APPROVED_OVERTIME_HOURS_AFTER_7PM
                FROM 
                    EPROMHQ.XXAPEX_TIMESHEET
                WHERE 
                 TRIM(TO_CHAR(WORK_DATE, 'YYYY-MM')) = TRIM(UPPER(:P54_MONTH))
                 AND
                    EMP_ID = :P54_EMP_ID
                
                
                
                
                ```
        }
        layout {
            sequence: 101
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-lg
                margin-bottom-lg
                margin-left-md
                margin-right-md
            ]
        }
