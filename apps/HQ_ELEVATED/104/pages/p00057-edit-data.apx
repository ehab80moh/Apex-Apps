                t-BreadcrumbRegion--useBreadcrumbTitle
                margin-bottom-sm
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cards (
        name: Cards
        title: &APP_TEXT$CARDS.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    r.relative_person_id ,
                     ' الصفة : ' || r.relative_type AS CARD_TITLE, 
                     ' الاسم : ' || r.relative_name AS CARD_TEXT, 
                    CASE 
                        WHEN r.DATE_OF_BIRTH IS NOT NULL 
                        THEN ' تاريخ الميلاد : ' || TO_CHAR(r.DATE_OF_BIRTH, 'YYYY-MM-DD') 
                        ELSE 'برجاء تسجيل تاريخ الميلاد' 
                    END AS CARD_SUBTEXT, 
                    CASE 
                        WHEN r.INSURED = 'Y' THEN 'مؤمن عليه' 
                        ELSE 'غير مؤمن عليه' 
                    END AS CARD_BODY,
                    r.image AS CARD_IMAGE,
                    r.EMP_PERSON_ID
                FROM CENTRAL.xxapex_hr_emp_relatives r 
                WHERE r.employee_number = :APP_USER;
                
                ```
        }
        layout {
            sequence: 31
            parentRegion: @h2-تعديل-بيانات-العائلة-h
            slot: regionBody
        }
        appearance {
            template: @cards-container
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: RELATIVE_PERSON_ID
        }
        title {
            column: CARD_TITLE
        }
        subtitle {
            column: CARD_SUBTEXT
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <h3>&CARD_BODY.</h3>
                
                ```
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression: &IMAGE_DISPLAY!RAW.
        }
        media {
            source: blobColumn
            blobColumn: CARD_IMAGE
            sizing: cover
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 60
                    items: {
                        P60_RELATIVE_PERSON_ID: &RELATIVE_PERSON_ID.
                        P60_RELATIVE_PERSON_ID_1: &RELATIVE_PERSON_ID.
                        P60_EMP_ID_1: &P57_EMP_ID.
                    }
                    request: edit
                }
                linkAttributes: &RELATIVE_PERSON_ID.
            }
        )

    )

    region edit-emp-data-read-only (
        name: Edit_emp_data_READ_ONLY
        title: &APP_TEXT$EDITEMPDATAREADONLY.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                
                SELECT
                    q.comments,
                    S.SOCIAL_INSURANCE_NUM,
                    s.REGION_OF_BIRTH,
                    s.TOWN_OF_BIRTH,
                    s.LOCAL_NAME,
                    case when g.title='ENGG' THEN 'ENG' ELSE g.title END AS title,
                    d.emp_name,
                    d.national_identifier,
                    d.emp_date_of_birth,
                    d.emp_position_name,
                    d.site_code,
                    d.organization_name,
                    d.assignments_date,
                    REPLACE(d.grade_name, 'EPROM.', '') AS grade_name,
                    d.permanent_date,
                    d.excel_pos,
                    d.project,
                    d.basic_salary,
                    d.exp_date,
                    SYS.DBMS_LOB.getlength(d.image) AS image_length,
                    d.image_id,
                    d.comp_email,
                    d.pay_email,
                    d.egpc_email,
                    d.mar_stat,
                    d.prim_address,
                    a.town_or_city,
                    d.emp_number,
                    d.job_date
                FROM central.xxapex_hr_emp_data       d
                JOIN central.xxapex_hr_emp_gender     g ON g.employee_number = d.emp_number
                LEFT join central.XXAPEX_HR_EMP_SOCIAL_BIRTH s on s.EMP_NUMBER = d.emp_number
                LEFT JOIN (
                    SELECT *
                    FROM central.xxapex_hr_qualifications qq
                    WHERE qq.maon_or_not = 'Yes'
                ) q ON q.employee_number = d.emp_number
                LEFT JOIN (
                    SELECT *
                    FROM central.xxapex_hr_emp_addresses aa
                    WHERE aa.primary_add = 'Y'
                ) a ON a.employee_number = d.emp_number
                WHERE d.emp_number = :APP_USER;
                
                ```
        }
        layout {
            sequence: 21
            parentRegion: @h2-تعديل-بيانات-الموظف-h
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--large
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--fixedLabelLarge
                t-AVPList--leftAligned
            ]
        }

