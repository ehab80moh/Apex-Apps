page 57 (
    name: تعديل البيانات
    alias: EDIT-DATA
    title: &APP_TEXT$MODIFY_DATA.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $(document).ready(function() {
                $(".emp-checkbox").on("change", function() {
                    if ($(this).is(":checked")) {
                        let empName = $(this).data("empname");
                        $s("P57_Emp_NAME", empName); // Sets the APEX item value
                        $("#P57_Emp_NAME").show(); // Show the page item
                    } else {
                        $s("P57_Emp_NAME", ""); // Clear the APEX item value
                        $("#P57_Emp_NAME").hide(); // Hide the page item
                    }
                });
            });
            
            ```
    }
    css {
        inline:
            ```css
            .t-AVPList-label, 
            .t-AVPList-value {
                border-bottom: var(--ut-avp-border-width, 1px) solid #f7cece; 
                display: flex; 
                align-items: center; 
                line-height: var(--ut-avp-line-height, 1.95rem); 
                width: 10%; 
            }
            .emp-checkbox {
                margin-right: 10px;
                transform: scale(1.2); 
            }
            
            .a-CardView-mediaImg {
                border: 0;
                display: block;
                height: auto;
                max-width: 50%;}
                .t-Region-headerItems--buttons, 
            .t-Region-headerItems--title {
                display: flex;
                flex-direction: column;
                align-items: center;
                padding-inline-end: var(--ut-region-header-padding-x, 0.75rem);
                flex-wrap: nowrap;
                align-content: space-between;
                justify-content: space-between;
            }
            
            .t-AVPList--fixedLabelLarge {
            
                --ut-avp-label-width: 10.25rem;
            } 
            
            .a-CardView-items .a-CardView-items--grid {
            
                background-color: #fff7ee;
            
            
            }
            
            .a-CardView-media .a-CardView-media--body  .a-CardView-media--cover {
            
                    background-color: #ecf0f0cc;
            
            }
            
            .a-CardView{
                background-color: #fffcf4;
            box-shadow: 7px 6px 4px -2px rgba(0, 0, 0, 0.075);
            
            }
            ```
    }
    htmlHeader {
        pageHtmlBodyAttribute:
            ```
            .t-AVPList-label, .t-AVPList-value {
                border-bottom: var(--ut-avp-border-width,var(--ut-component-inner-border-width)) solid var(--ut-avp-border-color,var(--ut-component-inner-border-color));
                font-size: var(--ut-avp-font-size,.875rem);
                line-height: var(--ut-avp-line-height,2.65rem);
                margin: 0;
                padding-block-end: var(--ut-avp-padding-y,.5rem);
                padding-block-start: var(--ut-avp-padding-y,.5rem);
                padding-inline-end: var(--ut-avp-padding-x,.75rem);
                padding-inline-start: var(--ut-avp-padding-x,.75rem);
            }
            .t-Region-headerItems--buttons, 
            .t-Region-headerItems--title {
                display: flex;
                flex-direction: column;
                align-items: center;
                padding-inline-end: var(--ut-region-header-padding-x, 0.75rem);
                flex-wrap: nowrap;
                align-content: space-between;
                justify-content: space-between;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region 1-الطلبات-السابقة (
        name: 1 الطلبات السابقة
        title: &APP_TEXT$MSG_1_PREVIOUS_ORDERS.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DETAIL_ID,
                       REQUEST_ID,
                       EMP_ID,
                       FIELD_NAME,
                       NEW_VALUE,
                       OLD_VALUE,
                       "COMMENT",
                       dbms_lob.getlength(ATTACHMENT_1) as BLOB,
                       dbms_lob.getlength(ATTACHMENT_2) as ATTACHMENT_2,
                       dbms_lob.getlength(ATTACHMENT_3) as ATTACHMENT_3,
                       dbms_lob.getlength(ATTACHMENT_4) as ATTACHMENT_4,
                       CREATED_AT,
                       UPDATED_BY,
                       case when IS_FINISH =0 or IS_FINISH is null then 'لم يتم العمل عليها حتي الان'
                       when IS_FINISH =1 then 'تم انهاء التعديل'
                       end as IS_FINISH
                  from EPROMHQ.HRF_PERSONAL_EDIT_DETAILS
                 where EMP_ID = :P57_EMP_ID
                
                
                ```
            pageItemsToSubmit: P57_EMP_ID
        }
        layout {
            sequence: 10
            parentRegion: @الطلبات-السابقة-2
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 76
                items: {
                    P76_DETAIL_ID: #DETAIL_ID#
                }
                anchor: :&SESSION.::&DEBUG.:::
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 137991254119200018
        }

