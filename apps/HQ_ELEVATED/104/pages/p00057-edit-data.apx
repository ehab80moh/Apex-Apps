    process insert (
        name: INSERT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_request_id NUMBER;
                    v_existing_value VARCHAR2(500);
                    v_new_value VARCHAR2(400);
                BEGIN
                    INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DATA ("EMP_ID", "REQUEST_TYPE", "ADD_COMMENT", "UPDATED_BY")
                    VALUES (:APP_USER, 'Update', 'Automated change detection', :APP_USER)
                    RETURNING "REQUEST_ID" INTO v_request_id;
                
                
                    SELECT EMP_NAME INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER; 
                  IF (v_existing_value IS NULL AND :P57_EMP_NAME IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_EMP_NAME IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_EMP_NAME IS NOT NULL AND v_existing_value <> :P57_EMP_NAME) THEN 
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'EMP_NAME', v_existing_value, :P57_EMP_NAME, 'Name updated', :APP_USER);
                    END IF;
                
                    SELECT NATIONAL_IDENTIFIER INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                  IF (v_existing_value IS NULL AND :P57_NATIONAL_IDENTIFIER IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_NATIONAL_IDENTIFIER IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_NATIONAL_IDENTIFIER IS NOT NULL AND v_existing_value <> :P57_NATIONAL_IDENTIFIER) THEN 
                               INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'NATIONAL_IDENTIFIER', v_existing_value, :P57_NATIONAL_IDENTIFIER, 'National ID updated', :APP_USER);
                    END IF;
                
                    SELECT PROJECT INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                  IF (v_existing_value IS NULL AND :P57_PROJECT IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_PROJECT IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_PROJECT IS NOT NULL AND v_existing_value <> :P57_PROJECT) THEN 
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'PROJECT', v_existing_value, :P57_PROJECT, 'Project updated', :APP_USER);
                    END IF;
                
                    SELECT EMP_DATE_OF_BIRTH INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                  IF (v_existing_value IS NULL AND :P57_EMP_DATE_OF_BIRTH IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_EMP_DATE_OF_BIRTH IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_EMP_DATE_OF_BIRTH IS NOT NULL AND v_existing_value <> :P57_EMP_DATE_OF_BIRTH) THEN         
                       INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'EMP_DATE_OF_BIRTH', v_existing_value, :P57_EMP_DATE_OF_BIRTH, 'Date of birth updated', :APP_USER);
                    END IF;
                
                    
                    BEGIN
                        SELECT q.comments 
                        INTO v_existing_value
                        FROM CENTRAL.XXAPEX_HR_EMP_DATA D
                        LEFT JOIN (SELECT * FROM central.xxapex_hr_qualifications WHERE maon_or_not = 'Yes') q 
                            ON q.employee_number = d.emp_number
                        LEFT JOIN (SELECT * FROM central.XXAPEX_HR_EMP_ADDRESSES WHERE PRIMARY_ADD = 'Y') a
                            ON a.employee_number = d.emp_number
                        WHERE d.EMP_NUMBER = TO_NUMBER(:APP_USER);  
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN 
                            v_existing_value := NULL;  
                        WHEN OTHERS THEN 
                            v_existing_value := NULL;  
                    END;
                
                  IF (v_existing_value IS NULL AND :P57_COMMENTS IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_COMMENTS IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_COMMENTS IS NOT NULL AND v_existing_value <> :P57_COMMENTS) THEN         
                       INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, TO_NUMBER(:APP_USER), 'COMMENTS', NVL(v_existing_value, 'No Previous Comment'), :P57_COMMENTS, 'Comments updated', :APP_USER);
                    END IF;
                
                
                    SELECT MAR_STAT INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                  IF (v_existing_value IS NULL AND :P57_MAR_STAT IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_MAR_STAT IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_MAR_STAT IS NOT NULL AND v_existing_value <> :P57_MAR_STAT) THEN         INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'MAR_STAT', v_existing_value, :P57_MAR_STAT, 'Marital status updated', :APP_USER);
                    END IF;
                
                    
                    SELECT EMP_POSITION_NAME INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                       IF (v_existing_value IS NULL AND :P57_EMP_POSITION_NAME IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_EMP_POSITION_NAME IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_EMP_POSITION_NAME IS NOT NULL AND v_existing_value <> :P57_EMP_POSITION_NAME) THEN          
                       INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'EMP_POSITION_NAME', v_existing_value, :P57_EMP_POSITION_NAME, 'Position updated', :APP_USER);
                    END IF;
                
                    SELECT ASSIGNMENTS_DATE INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                       IF (v_existing_value IS NULL AND :P57_ASSIGNMENTS_DATE IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_ASSIGNMENTS_DATE IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_ASSIGNMENTS_DATE IS NOT NULL AND v_existing_value <> :P57_ASSIGNMENTS_DATE) THEN  
                          INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'ASSIGNMENTS_DATE', v_existing_value, :P57_ASSIGNMENTS_DATE, 'Assignments date updated', :APP_USER);
                    END IF;
                
                    SELECT PERMANENT_DATE INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                    IF (v_existing_value IS NULL AND :P57_PERMANENT_DATE IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_PERMANENT_DATE IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_PERMANENT_DATE IS NOT NULL AND v_existing_value <> :P57_PERMANENT_DATE) THEN
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'PERMANENT_DATE', v_existing_value, :P57_PERMANENT_DATE, 'Permanent date updated', :APP_USER);
                    END IF;
                
                
                    begin
                    SELECT COMP_EMAIL INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                       IF (v_existing_value IS NULL AND :P57_COMP_EMAIL IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_COMP_EMAIL IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_COMP_EMAIL IS NOT NULL AND v_existing_value <> :P57_COMP_EMAIL) THEN
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'COMP_EMAIL', v_existing_value, :P57_COMP_EMAIL, 'Company email updated', :APP_USER);
                    END IF;
                end;
                    SELECT PAY_EMAIL INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                      IF (v_existing_value IS NULL AND :P57_PAY_EMAIL IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_PAY_EMAIL IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_PAY_EMAIL IS NOT NULL AND v_existing_value <> :P57_PAY_EMAIL) THEN
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'PAY_EMAIL', v_existing_value, :P57_PAY_EMAIL, 'Pay email updated', :APP_USER);
                    END IF;
                
                    SELECT PRIM_ADDRESS INTO v_existing_value FROM CENTRAL.XXAPEX_HR_EMP_DATA WHERE EMP_NUMBER = :APP_USER;
                   IF (v_existing_value IS NULL AND :P57_ADDRESS IS NOT NULL)  -- New value added
                       OR (v_existing_value IS NOT NULL AND :P57_ADDRESS IS NULL)  -- Old value removed
                       OR (v_existing_value IS NOT NULL AND :P57_ADDRESS IS NOT NULL AND v_existing_value <> :P57_ADDRESS) THEN  
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                        ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                        VALUES (v_request_id, :APP_USER, 'PRIM_ADDRESS', v_existing_value, :P57_ADDRESS, 'Primary address updated', :APP_USER);
                    END IF;
                    
                    COMMIT;
                
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 89401002434998645
        }
        serverSideCondition {
            type: never
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_existing_emp_name          CENTRAL.XXAPEX_HR_EMP_DATA.EMP_NAME%TYPE;
                    v_existing_national_identifier CENTRAL.XXAPEX_HR_EMP_DATA.NATIONAL_IDENTIFIER%TYPE;
                    v_existing_project           CENTRAL.XXAPEX_HR_EMP_DATA.PROJECT%TYPE;
                    v_existing_emp_date_of_birth CENTRAL.XXAPEX_HR_EMP_DATA.EMP_DATE_OF_BIRTH%TYPE;
                    v_existing_mar_stat          CENTRAL.XXAPEX_HR_EMP_DATA.MAR_STAT%TYPE;
                    v_existing_emp_position_name CENTRAL.XXAPEX_HR_EMP_DATA.EMP_POSITION_NAME%TYPE;
                    v_existing_assignments_date  CENTRAL.XXAPEX_HR_EMP_DATA.ASSIGNMENTS_DATE%TYPE;
                    v_existing_permanent_date    CENTRAL.XXAPEX_HR_EMP_DATA.PERMANENT_DATE%TYPE;
                    v_existing_comp_email        CENTRAL.XXAPEX_HR_EMP_DATA.COMP_EMAIL%TYPE;
                    v_existing_pay_email         CENTRAL.XXAPEX_HR_EMP_DATA.PAY_EMAIL%TYPE;
                    v_existing_prim_address      CENTRAL.XXAPEX_HR_EMP_DATA.PRIM_ADDRESS%TYPE;
                    v_existing_comments          VARCHAR2(500);
                    
                    TYPE t_change IS RECORD (
                        field_name  VARCHAR2(100),
                        old_value  VARCHAR2(4000),
                        new_value  VARCHAR2(4000),
                        comment_txt VARCHAR2(100)
                    );
                    TYPE t_changes IS TABLE OF t_change;
                    l_changes t_changes := t_changes();
                    
                    v_request_id NUMBER;
                BEGIN
                    BEGIN
                        SELECT EMP_NAME, NATIONAL_IDENTIFIER, PROJECT, EMP_DATE_OF_BIRTH, MAR_STAT,
                               EMP_POSITION_NAME, ASSIGNMENTS_DATE, PERMANENT_DATE, COMP_EMAIL, PAY_EMAIL, PRIM_ADDRESS
                        INTO v_existing_emp_name, v_existing_national_identifier, v_existing_project,
                             v_existing_emp_date_of_birth, v_existing_mar_stat, v_existing_emp_position_name,
                             v_existing_assignments_date, v_existing_permanent_date, v_existing_comp_email,
                             v_existing_pay_email, v_existing_prim_address
                        FROM CENTRAL.XXAPEX_HR_EMP_DATA
                        WHERE EMP_NUMBER = :APP_USER;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            v_existing_emp_name := NULL;
                            v_existing_national_identifier := NULL;
                            v_existing_project := NULL;
                            v_existing_emp_date_of_birth := NULL;
                            v_existing_mar_stat := NULL;
                            v_existing_emp_position_name := NULL;
                            v_existing_assignments_date := NULL;
                            v_existing_permanent_date := NULL;
                            v_existing_comp_email := NULL;
                            v_existing_pay_email := NULL;
                            v_existing_prim_address := NULL;
                    END;
                
                    BEGIN
                        SELECT q.comments 
                        INTO v_existing_comments
                        FROM CENTRAL.XXAPEX_HR_EMP_DATA D
                        LEFT JOIN (SELECT * FROM central.xxapex_hr_qualifications WHERE maon_or_not = 'Yes') q 
                            ON q.employee_number = d.emp_number
                        LEFT JOIN (SELECT * FROM central.XXAPEX_HR_EMP_ADDRESSES WHERE PRIMARY_ADD = 'Y') a
                            ON a.employee_number = d.emp_number
                        WHERE d.EMP_NUMBER = TO_NUMBER(:APP_USER);  
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN 
                            v_existing_comments := NULL;  
                        WHEN OTHERS THEN 
                            v_existing_comments := NULL;  
                    END;
                
                    IF (v_existing_emp_name IS NULL AND :P57_EMP_NAME IS NOT NULL) 
                       OR (v_existing_emp_name IS NOT NULL AND :P57_EMP_NAME IS NULL) 
                       OR (v_existing_emp_name <> :P57_EMP_NAME) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('EMP_NAME', v_existing_emp_name, :P57_EMP_NAME, 'Name updated');
                    END IF;
                
                    IF (v_existing_national_identifier IS NULL AND :P57_NATIONAL_IDENTIFIER IS NOT NULL) 
                       OR (v_existing_national_identifier IS NOT NULL AND :P57_NATIONAL_IDENTIFIER IS NULL) 
                       OR (v_existing_national_identifier <> :P57_NATIONAL_IDENTIFIER) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('NATIONAL_IDENTIFIER', v_existing_national_identifier, :P57_NATIONAL_IDENTIFIER, 'National ID updated');
                    END IF;
                
                    IF (v_existing_project IS NULL AND :P57_PROJECT IS NOT NULL) 
                       OR (v_existing_project IS NOT NULL AND :P57_PROJECT IS NULL) 
                       OR (v_existing_project <> :P57_PROJECT) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PROJECT', v_existing_project, :P57_PROJECT, 'Project updated');
                    END IF;
                
                    IF (v_existing_emp_date_of_birth IS NULL AND :P57_EMP_DATE_OF_BIRTH IS NOT NULL) 
                       OR (v_existing_emp_date_of_birth IS NOT NULL AND :P57_EMP_DATE_OF_BIRTH IS NULL) 
                       OR (v_existing_emp_date_of_birth <> :P57_EMP_DATE_OF_BIRTH) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('EMP_DATE_OF_BIRTH', v_existing_emp_date_of_birth, :P57_EMP_DATE_OF_BIRTH, 'Date of birth updated');
                    END IF;
                
                    IF (v_existing_mar_stat IS NULL AND :P57_MAR_STAT IS NOT NULL) 
                       OR (v_existing_mar_stat IS NOT NULL AND :P57_MAR_STAT IS NULL) 
                       OR (v_existing_mar_stat <> :P57_MAR_STAT) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('MAR_STAT', v_existing_mar_stat, :P57_MAR_STAT, 'Marital status updated');
                    END IF;
                
                    IF (v_existing_emp_position_name IS NULL AND :P57_EMP_POSITION_NAME IS NOT NULL) 
                       OR (v_existing_emp_position_name IS NOT NULL AND :P57_EMP_POSITION_NAME IS NULL) 
                       OR (v_existing_emp_position_name <> :P57_EMP_POSITION_NAME) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('EMP_POSITION_NAME', v_existing_emp_position_name, :P57_EMP_POSITION_NAME, 'Position updated');
                    END IF;
                
                    IF (v_existing_assignments_date IS NULL AND :P57_ASSIGNMENTS_DATE IS NOT NULL) 
                       OR (v_existing_assignments_date IS NOT NULL AND :P57_ASSIGNMENTS_DATE IS NULL) 
                       OR (v_existing_assignments_date <> :P57_ASSIGNMENTS_DATE) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('ASSIGNMENTS_DATE', v_existing_assignments_date, :P57_ASSIGNMENTS_DATE, 'Assignments date updated');
                    END IF;
                
                    IF (v_existing_permanent_date IS NULL AND :P57_PERMANENT_DATE IS NOT NULL) 
                       OR (v_existing_permanent_date IS NOT NULL AND :P57_PERMANENT_DATE IS NULL) 
                       OR (v_existing_permanent_date <> :P57_PERMANENT_DATE) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PERMANENT_DATE', v_existing_permanent_date, :P57_PERMANENT_DATE, 'Permanent date updated');
                    END IF;
                
                    IF (v_existing_comp_email IS NULL AND :P57_COMP_EMAIL IS NOT NULL) 
                       OR (v_existing_comp_email IS NOT NULL AND :P57_COMP_EMAIL IS NULL) 
                       OR (v_existing_comp_email <> :P57_COMP_EMAIL) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('COMP_EMAIL', v_existing_comp_email, :P57_COMP_EMAIL, 'Company email updated');
                    END IF;
                
                    IF (v_existing_pay_email IS NULL AND :P57_PAY_EMAIL IS NOT NULL) 
                       OR (v_existing_pay_email IS NOT NULL AND :P57_PAY_EMAIL IS NULL) 
                       OR (v_existing_pay_email <> :P57_PAY_EMAIL) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PAY_EMAIL', v_existing_pay_email, :P57_PAY_EMAIL, 'Pay email updated');
                    END IF;
                
                    IF (v_existing_prim_address IS NULL AND :P57_ADDRESS IS NOT NULL) 
                       OR (v_existing_prim_address IS NOT NULL AND :P57_ADDRESS IS NULL) 
                       OR (v_existing_prim_address <> :P57_ADDRESS) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PRIM_ADDRESS', v_existing_prim_address, :P57_ADDRESS, 'Primary address updated');
                    END IF;
                
                    IF (v_existing_comments IS NULL AND :P57_COMMENTS IS NOT NULL) 
                       OR (v_existing_comments IS NOT NULL AND :P57_COMMENTS IS NULL) 
                       OR (v_existing_comments <> :P57_COMMENTS) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('COMMENTS', NVL(v_existing_comments, 'No Previous Comment'), :P57_COMMENTS, 'Comments updated');
                    END IF;
                
                    IF l_changes.COUNT > 0 THEN
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DATA ("EMP_ID", "REQUEST_TYPE", "ADD_COMMENT", "UPDATED_BY")
                        VALUES (:APP_USER, 'Update', 'Automated change detection', :APP_USER)
                        RETURNING "REQUEST_ID" INTO v_request_id;
                
                        FOR i IN 1..l_changes.COUNT LOOP
                            INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                            ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                            VALUES (
                                v_request_id,
                                :APP_USER,
                                l_changes(i).field_name,
                                l_changes(i).old_value,
                                l_changes(i).new_value,
                                l_changes(i).comment_txt,
                                :APP_USER
                            );
                        END LOOP;
                
                        COMMIT;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 92764725391853713
        }
        config {
            buildOption: @commented-out
        }
    )

