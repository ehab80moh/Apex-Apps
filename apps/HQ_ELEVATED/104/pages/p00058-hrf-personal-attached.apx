page 58 (
    name: طلب تعديل/إضافة بيان
    alias: HRF-PERSONAL-ATTACHED
    title: &APP_TEXT$REQUEST_TO_AMEND_ADD_A_STATEMENT.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region add-new-data-with-details (
        name: Add New Data with Details
        title: &APP_TEXT$ADD_NEW_DATA_WITH_DETAILS.
        type: form
        source {
            location: localDatabase
            tableOwner: EPROMHQ
            tableName: HRF_PERSONAL_EDIT_UPLOAD
        }
        layout {
            sequence: 250
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
    )

    region feild (
        name: FEILD
        title: &APP_TEXT$FEILD.
        type: form
        source {
            location: localDatabase
            tableOwner: EPROMHQ
            tableName: HRF_PERSONAL_EDIT_DETAILS
        }
        layout {
            sequence: 260
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
    )

    pageItem P58_ATTACHMENT_1 (
        type: fileUpload
        label {
            label: &P58_LABEL20.
            alignment: left
        }
        storage {
            type: appTempFiles
            fileTypes: image/*,application/pdf,application
            maxFileSize: 20000
        }
        layout {
            sequence: 90
            region: @feild
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            icon: fa-braille
            width: 30
        }
        source {
            formRegion: @feild
            column: ATTACHMENT_1
            dataType: blob
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P58_LABEL20
        }
        comments {
            comments: image/*,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/pdf,application/vnd.ms-excel,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv
        }
    )

