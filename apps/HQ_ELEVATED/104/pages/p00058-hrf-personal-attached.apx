    process new (
        name: New_2
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                
                
                DECLARE
                  v_detail_id  NUMBER;
                  v_att1       BLOB;
                  v_att2       BLOB;
                  v_att3       BLOB;
                  v_att4       BLOB;
                BEGIN
                  IF :P58_ATTACHMENT_1 IS NOT NULL THEN
                    BEGIN
                      SELECT blob_content
                      INTO   v_att1
                      FROM   apex_application_temp_files
                      WHERE  upper(name) = upper(:P58_ATTACHMENT_1);
                    EXCEPTION
                      WHEN no_data_found THEN
                        v_att1 := NULL;  -- أو ارفع رسالة
                    END;
                  END IF;
                
                  IF :P58_ATTACHMENT_2 IS NOT NULL THEN
                    BEGIN
                      SELECT blob_content INTO v_att2
                      FROM   apex_application_temp_files
                      WHERE  upper(name) = upper(:P58_ATTACHMENT_2);
                    EXCEPTION
                      WHEN no_data_found THEN
                        v_att2 := NULL;
                    END;
                  END IF;
                
                  IF :P58_ATTACHMENT_3 IS NOT NULL THEN
                    BEGIN
                      SELECT blob_content INTO v_att3
                      FROM   apex_application_temp_files
                      WHERE  upper(name) = upper(:P58_ATTACHMENT_3);
                    EXCEPTION
                      WHEN no_data_found THEN
                        v_att3 := NULL;
                    END;
                  END IF;
                
                  IF :P58_ATTACHMENT_4 IS NOT NULL THEN
                    BEGIN
                      SELECT blob_content INTO v_att4
                      FROM   apex_application_temp_files
                      WHERE  upper(name) = upper(:P58_ATTACHMENT_4);
                    EXCEPTION
                      WHEN no_data_found THEN
                        v_att4 := NULL;
                    END;
                  END IF;
                
                  INSERT INTO epromhq.hrf_personal_edit_details
                        (request_id, emp_id, field_name, new_value, old_value,
                         "COMMENT", attachment_1, attachment_2, attachment_3, attachment_4,
                         updated_by)
                  VALUES (:P58_REQUEST_ID, :P58_EMP_ID, :P58_FIELD_NAME,
                          :P58_NEW_VALUE, :P58_OLD_VALUE, :P58_COMMENT,
                          v_att1, v_att2, v_att3, v_att4,
                          :APP_USER)
                  RETURNING detail_id INTO v_detail_id;
                
                  INSERT INTO epromhq.hrf_personal_edit_upload
                        (detail_id,
                         col01, col02, col03, col04, col05,
                         col06, col07, col08, col09, col10,
                         col11, col12, col13, col14, col15,
                         col16, col17, col18, col19, col20,
                         created_by)
                  VALUES (v_detail_id,
                          :P58_COL01, :P58_COL02, :P58_COL03, :P58_COL04, :P58_COL05,
                          :P58_COL06, :P58_COL07, :P58_COL08, :P58_COL09, :P58_COL10,
                          :P58_COL11, :P58_COL12, :P58_COL13, :P58_COL14, :P58_COL15,
                          :P58_COL16, :P58_COL17, :P58_COL18, :P58_COL19, :P58_COL20,
                          :APP_USER);
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 66438205442549530
        }
        serverSideCondition {
            type: never
        }
    )

    process new-2 (
        name: New_3
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    
                    l_file_names APEX_T_VARCHAR2;
                    l_file       APEX_APPLICATION_TEMP_FILES%ROWTYPE;
                
                    
                    v_att1 BLOB;
                    v_att2 BLOB;
                    v_att3 BLOB;
                    v_att4 BLOB;
                
                    
                    v_detail_id NUMBER;
                BEGIN
                    IF :P58_ATTACHMENT_1 IS NOT NULL THEN
                        l_file_names := APEX_STRING.SPLIT(:P58_ATTACHMENT_1, ':');
                        FOR i IN 1 .. l_file_names.COUNT LOOP
                            SELECT * INTO l_file
                              FROM apex_application_temp_files
                             WHERE name = l_file_names(i);
                
                            IF i = 1 THEN
                               v_att1 := l_file.blob_content;
                            END IF;
                
                            
                
                            DELETE FROM apex_application_temp_files
                            WHERE name = l_file_names(i);
                        END LOOP;
                    END IF;
                
                    IF :P58_ATTACHMENT_2 IS NOT NULL THEN
                        l_file_names := APEX_STRING.SPLIT(:P58_ATTACHMENT_2, ':');
                        FOR i IN 1 .. l_file_names.COUNT LOOP
                            SELECT * INTO l_file
                              FROM apex_application_temp_files
                             WHERE name = l_file_names(i);
                
                            IF i = 1 THEN
                               v_att2 := l_file.blob_content;
                            END IF;
                
                            DELETE FROM apex_application_temp_files
                            WHERE name = l_file_names(i);
                        END LOOP;
                    END IF;
                
                    IF :P58_ATTACHMENT_3 IS NOT NULL THEN
                        l_file_names := APEX_STRING.SPLIT(:P58_ATTACHMENT_3, ':');
                        FOR i IN 1 .. l_file_names.COUNT LOOP
                            SELECT * INTO l_file
                              FROM apex_application_temp_files
                             WHERE name = l_file_names(i);
                
                            IF i = 1 THEN
                               v_att3 := l_file.blob_content;
                            END IF;
                
                            DELETE FROM apex_application_temp_files
                            WHERE name = l_file_names(i);
                        END LOOP;
                    END IF;
                
                    IF :P58_ATTACHMENT_4 IS NOT NULL THEN
                        l_file_names := APEX_STRING.SPLIT(:P58_ATTACHMENT_4, ':');
                        FOR i IN 1 .. l_file_names.COUNT LOOP
                            SELECT * INTO l_file
                              FROM apex_application_temp_files
                             WHERE name = l_file_names(i);
                
                            IF i = 1 THEN
                               v_att4 := l_file.blob_content;
                            END IF;
                
                            DELETE FROM apex_application_temp_files
                            WHERE name = l_file_names(i);
                        END LOOP;
                    END IF;
                
                    INSERT INTO epromhq.hrf_personal_edit_details
                          (request_id,
                           emp_id,
                           field_name,
                           new_value,
                           old_value,
                           "COMMENT",
                           attachment_1,
                           attachment_2,
                           attachment_3,
                           attachment_4,
                           updated_by)
                    VALUES (:P58_REQUEST_ID,
                            :P58_EMP_ID,
                            :P58_FIELD_NAME,
                            :P58_NEW_VALUE,
                            :P58_OLD_VALUE,
                            :P58_COMMENT,
                            v_att1,
                            v_att2,
                            v_att3,
                            v_att4,
                            :APP_USER)
                    RETURNING detail_id INTO v_detail_id;
                
                    INSERT INTO epromhq.hrf_personal_edit_upload
                          (detail_id,
                           col01, col02, col03, col04, col05,
                           col06, col07, col08, col09, col10,
                           col11, col12, col13, col14, col15,
                           col16, col17, col18, col19, col20,
                           created_by)
                    VALUES (v_detail_id,
                            :P58_COL01, :P58_COL02, :P58_COL03, :P58_COL04, :P58_COL05,
                            :P58_COL06, :P58_COL07, :P58_COL08, :P58_COL09, :P58_COL10,
                            :P58_COL11, :P58_COL12, :P58_COL13, :P58_COL14, :P58_COL15,
                            :P58_COL16, :P58_COL17, :P58_COL18, :P58_COL19, :P58_COL20,
                            :APP_USER);
                
                    COMMIT;
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        RAISE;  -- يبعت الخطأ لـ APEX عشان تشوف تفاصيله
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 66438525146549533
        }
    )

    process new-3 (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_existing_emp_name          CENTRAL.XXAPEX_HR_EMP_DATA.EMP_NAME%TYPE;
                    v_existing_national_identifier CENTRAL.XXAPEX_HR_EMP_DATA.NATIONAL_IDENTIFIER%TYPE;
                    v_existing_project           CENTRAL.XXAPEX_HR_EMP_DATA.PROJECT%TYPE;
                    v_existing_emp_date_of_birth CENTRAL.XXAPEX_HR_EMP_DATA.EMP_DATE_OF_BIRTH%TYPE;
                    v_existing_mar_stat          CENTRAL.XXAPEX_HR_EMP_DATA.MAR_STAT%TYPE;
                    v_existing_emp_position_name CENTRAL.XXAPEX_HR_EMP_DATA.EMP_POSITION_NAME%TYPE;
                    v_existing_assignments_date  CENTRAL.XXAPEX_HR_EMP_DATA.ASSIGNMENTS_DATE%TYPE;
                    v_existing_permanent_date    CENTRAL.XXAPEX_HR_EMP_DATA.PERMANENT_DATE%TYPE;
                    v_existing_comp_email        CENTRAL.XXAPEX_HR_EMP_DATA.COMP_EMAIL%TYPE;
                    v_existing_pay_email         CENTRAL.XXAPEX_HR_EMP_DATA.PAY_EMAIL%TYPE;
                    v_existing_prim_address      CENTRAL.XXAPEX_HR_EMP_DATA.PRIM_ADDRESS%TYPE;
                    v_existing_comments          VARCHAR2(500);
                    
                    TYPE t_change IS RECORD (
                        field_name  VARCHAR2(100),
                        old_value  VARCHAR2(4000),
                        new_value  VARCHAR2(4000),
                        comment_txt VARCHAR2(100)
                    );
                    TYPE t_changes IS TABLE OF t_change;
                    l_changes t_changes := t_changes();
                    
                    v_request_id NUMBER;
                BEGIN
                    BEGIN
                        SELECT EMP_NAME, NATIONAL_IDENTIFIER, PROJECT, EMP_DATE_OF_BIRTH, MAR_STAT,
                               EMP_POSITION_NAME, ASSIGNMENTS_DATE, PERMANENT_DATE, COMP_EMAIL, PAY_EMAIL, PRIM_ADDRESS
                        INTO v_existing_emp_name, v_existing_national_identifier, v_existing_project,
                             v_existing_emp_date_of_birth, v_existing_mar_stat, v_existing_emp_position_name,
                             v_existing_assignments_date, v_existing_permanent_date, v_existing_comp_email,
                             v_existing_pay_email, v_existing_prim_address
                        FROM CENTRAL.XXAPEX_HR_EMP_DATA
                        WHERE EMP_NUMBER = :APP_USER;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            v_existing_emp_name := NULL;
                            v_existing_national_identifier := NULL;
                            v_existing_project := NULL;
                            v_existing_emp_date_of_birth := NULL;
                            v_existing_mar_stat := NULL;
                            v_existing_emp_position_name := NULL;
                            v_existing_assignments_date := NULL;
                            v_existing_permanent_date := NULL;
                            v_existing_comp_email := NULL;
                            v_existing_pay_email := NULL;
                            v_existing_prim_address := NULL;
                    END;
                
                    BEGIN
                        SELECT q.comments 
                        INTO v_existing_comments
                        FROM CENTRAL.XXAPEX_HR_EMP_DATA D
                        LEFT JOIN (SELECT * FROM central.xxapex_hr_qualifications WHERE maon_or_not = 'Yes') q 
                            ON q.employee_number = d.emp_number
                        LEFT JOIN (SELECT * FROM central.XXAPEX_HR_EMP_ADDRESSES WHERE PRIMARY_ADD = 'Y') a
                            ON a.employee_number = d.emp_number
                        WHERE d.EMP_NUMBER = TO_NUMBER(:APP_USER);  
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN 
                            v_existing_comments := NULL;  
                        WHEN OTHERS THEN 
                            v_existing_comments := NULL;  
                    END;
                
                    IF (v_existing_emp_name IS NULL AND :P58_NAME IS NOT NULL) 
                       OR (v_existing_emp_name IS NOT NULL AND :P58_NAME IS NULL) 
                       OR (v_existing_emp_name <> :P58_NAME) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('EMP_NAME', v_existing_emp_name, :P58_NAME, 'Name updated');
                    END IF;
                
                    IF (v_existing_national_identifier IS NULL AND :P58_NATIONAL_IDENTIFIER IS NOT NULL) 
                       OR (v_existing_national_identifier IS NOT NULL AND :P58_NATIONAL_IDENTIFIER IS NULL) 
                       OR (v_existing_national_identifier <> :P58_NATIONAL_IDENTIFIER) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('NATIONAL_IDENTIFIER', v_existing_national_identifier, :P58_NATIONAL_IDENTIFIER, 'National ID updated');
                    END IF;
                
                    IF (v_existing_project IS NULL AND :P58_PROJECT IS NOT NULL) 
                       OR (v_existing_project IS NOT NULL AND :P58_PROJECT IS NULL) 
                       OR (v_existing_project <> :P58_PROJECT) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PROJECT', v_existing_project, :P58_PROJECT, 'Project updated');
                    END IF;
                
                    IF (v_existing_emp_date_of_birth IS NULL AND :P58_EMP_DATE_OF_BIRTH IS NOT NULL) 
                       OR (v_existing_emp_date_of_birth IS NOT NULL AND :P58_EMP_DATE_OF_BIRTH IS NULL) 
                       OR (v_existing_emp_date_of_birth <> :P58_EMP_DATE_OF_BIRTH) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('EMP_DATE_OF_BIRTH', v_existing_emp_date_of_birth, :P58_EMP_DATE_OF_BIRTH, 'Date of birth updated');
                    END IF;
                
                    IF (v_existing_mar_stat IS NULL AND :P58_MAR_STAT IS NOT NULL) 
                       OR (v_existing_mar_stat IS NOT NULL AND :P58_MAR_STAT IS NULL) 
                       OR (v_existing_mar_stat <> :P58_MAR_STAT) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('MAR_STAT', v_existing_mar_stat, :P58_MAR_STAT, 'Marital status updated');
                    END IF;
                
                    IF (v_existing_emp_position_name IS NULL AND :P58_EMP_POSITION_NAME IS NOT NULL) 
                       OR (v_existing_emp_position_name IS NOT NULL AND :P58_EMP_POSITION_NAME IS NULL) 
                       OR (v_existing_emp_position_name <> :P58_EMP_POSITION_NAME) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('EMP_POSITION_NAME', v_existing_emp_position_name, :P58_EMP_POSITION_NAME, 'Position updated');
                    END IF;
                
                    IF (v_existing_assignments_date IS NULL AND :P58_ASSIGNMENTS_DATE IS NOT NULL) 
                       OR (v_existing_assignments_date IS NOT NULL AND :P58_ASSIGNMENTS_DATE IS NULL) 
                       OR (v_existing_assignments_date <> :P58_ASSIGNMENTS_DATE) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('ASSIGNMENTS_DATE', v_existing_assignments_date, :P58_ASSIGNMENTS_DATE, 'Assignments date updated');
                    END IF;
                
                    IF (v_existing_permanent_date IS NULL AND :P58_PERMANENT_DATE IS NOT NULL) 
                       OR (v_existing_permanent_date IS NOT NULL AND :P58_PERMANENT_DATE IS NULL) 
                       OR (v_existing_permanent_date <> :P58_PERMANENT_DATE) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PERMANENT_DATE', v_existing_permanent_date, :P58_PERMANENT_DATE, 'Permanent date updated');
                    END IF;
                
                    IF (v_existing_comp_email IS NULL AND :P58_COMP_EMAIL IS NOT NULL) 
                       OR (v_existing_comp_email IS NOT NULL AND :P58_COMP_EMAIL IS NULL) 
                       OR (v_existing_comp_email <> :P58_COMP_EMAIL) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('COMP_EMAIL', v_existing_comp_email, :P58_COMP_EMAIL, 'Company email updated');
                    END IF;
                
                    IF (v_existing_pay_email IS NULL AND :P58_PAY_EMAIL IS NOT NULL) 
                       OR (v_existing_pay_email IS NOT NULL AND :P58_PAY_EMAIL IS NULL) 
                       OR (v_existing_pay_email <> :P58_PAY_EMAIL) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PAY_EMAIL', v_existing_pay_email, :P58_PAY_EMAIL, 'Pay email updated');
                    END IF;
                
                    IF (v_existing_prim_address IS NULL AND :P58_ADDRESS IS NOT NULL) 
                       OR (v_existing_prim_address IS NOT NULL AND :P58_ADDRESS IS NULL) 
                       OR (v_existing_prim_address <> :P58_ADDRESS) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('PRIM_ADDRESS', v_existing_prim_address, :P58_ADDRESS, 'Primary address updated');
                    END IF;
                
                    IF (v_existing_comments IS NULL AND :P58_COMMENTS IS NOT NULL) 
                       OR (v_existing_comments IS NOT NULL AND :P58_COMMENTS IS NULL) 
                       OR (v_existing_comments <> :P58_COMMENTS) THEN
                        l_changes.EXTEND;
                        l_changes(l_changes.LAST) := t_change('COMMENTS', NVL(v_existing_comments, 'No Previous Comment'), :P58_COMMENTS, 'Comments updated');
                    END IF;
                
                    IF l_changes.COUNT > 0 THEN
                        INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DATA ("EMP_ID", "REQUEST_TYPE", "ADD_COMMENT", "UPDATED_BY")
                        VALUES (:APP_USER, 'Update', 'Automated change detection', :APP_USER)
                        RETURNING "REQUEST_ID" INTO v_request_id;
                
                        FOR i IN 1..l_changes.COUNT LOOP
                            INSERT INTO EPROMHQ.HRF_PERSONAL_EDIT_DETAILS 
                            ("REQUEST_ID", "EMP_ID", "FIELD_NAME", "OLD_VALUE", "NEW_VALUE", "COMMENT", "UPDATED_BY") 
                            VALUES (
                                v_request_id,
                                :APP_USER,
                                l_changes(i).field_name,
                                l_changes(i).old_value,
                                l_changes(i).new_value,
                                l_changes(i).comment_txt,
                                :APP_USER
                            );
                        END LOOP;
                
                        COMMIT;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 97166189962326029
        }
        serverSideCondition {
            type: never
        }
    )

)
