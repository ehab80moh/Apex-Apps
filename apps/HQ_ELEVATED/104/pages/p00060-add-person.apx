page 60 (
    name: (إضافة / تعديل) شخص
    alias: ADD-PERSON
    title: &APP_TEXT$ADD_MODIFY_A_PERSON.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #labobo{
                font-size: 1.3em;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        title: &APP_TEXT$BUTTONS.
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region new (
        name: New
        title: &APP_TEXT$NEW.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       
                       RELATIVE_PERSON_ID,
                       EMPLOYEE_NUMBER,
                       EMPLOYEE_NAME,
                       PROJECT,
                       RELATIVE_TYPE,
                       RELATIVE_NAME,
                       IMAGE_ID,
                       IMAGE,
                       CODE,
                       INSURED,
                        DATE_OF_BIRTH
                  from central.XXAPEX_HR_EMP_RELATIVES
                  where RELATIVE_PERSON_ID = :P60_RELATIVE_PERSON_ID_1
                ```
            pageItemsToSubmit: P60_RELATIVE_PERSON_ID_1
        }
        layout {
            sequence: 61
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @commented-out
        }
    )

    region إضافة-تعديل-شخص (
        name: (إضافة / تعديل) شخص
        title: &APP_TEXT$ADD_MODIFY_A_PERSON.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    p.PERSON_ID, 
                    p.REQUEST_ID,
                    p.NAME,
                    p.DATE_OF_BIRTH,
                    p.ADD_JOB,
                    p.RELATIVE_TYPE,
                    p.INSURED,
                    p.IMAGE,
                    p.CREATED_AT,
                    p.UPDATED_BY,
                    p.RELATIVE_PERSON_ID,
                    p.EMP_ID,
                    ID_NUMBER
                FROM 
                    EPROMHQ.HRF_PERSONAL_ADD_PERSON p
                ```
        }
        layout {
            sequence: 41
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        config {
            buildOption: @commented-out
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region تفاصيل-الشخص (
        name: تفاصيل الشخص
        title: &APP_TEXT$PERSON_DETAILS.
        type: form
        source {
            location: localDatabase
            tableOwner: EPROMHQ
            tableName: HR_EMP_DEPENDENTS
        }
        layout {
            sequence: 31
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

    region ملحوظة (
        name: ملحوظة
        title: &APP_TEXT$NOTE.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$H2_H2!RAW.
        }
        layout {
            sequence: 51
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
            ]
            icon: fa-warning
        }
        serverSideCondition {
            type: request=Value
            value: edit
        }
        config {
            buildOption: @commented-out
        }
    )

    region ملحوظة-2 (
        name: ملحوظة
        title: &APP_TEXT$NOTE.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$PLUG_SOURCE_20.
        }
        layout {
            sequence: 11
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
            ]
        }
        serverSideCondition {
            type: request=Value
            value: add
        }
        config {
            buildOption: @commented-out
        }
    )

