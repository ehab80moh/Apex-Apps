    process fill (
        name: FILL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                  
                
                
                DECLARE
                    l_rel_id  VARCHAR2(50) := :P60_RELATIVE_PERSON_ID;
                BEGIN
                  :P60_EMP_ID_1 := :APP_USER;
                
                  IF l_rel_id IS NULL THEN
                    :P60_FULL_NAME_AR    := NULL;
                    :P60_MED_INS_STATUS  := NULL;
                    :P60_BIRTH_DATE      := NULL;
                    RETURN;
                  END IF;
                
                  SELECT r.RELATIVE_NAME,
                         r.INSURED,
                         r.DATE_OF_BIRTH
                  INTO   :P60_FULL_NAME_AR,
                         :P60_MED_INS_STATUS,
                         :P60_BIRTH_DATE
                  FROM   central.XXAPEX_HR_EMP_RELATIVES r
                  WHERE  r.RELATIVE_PERSON_ID = l_rel_id;
                
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    :P60_FULL_NAME_AR    := NULL;
                    :P60_MED_INS_STATUS  := NULL;
                    :P60_BIRTH_DATE      := NULL;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 137371657087152826
        }
    )

