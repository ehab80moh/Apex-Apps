    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$CANCEL.
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$CONSTRUCTION.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P60_PERSON_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: &APP_TEXT$DELETE.
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P60_PERSON_ID
        }
    )

    button go-to-page (
        buttonName: go_to_page
        label: &APP_TEXT$GO_TO_THE_IMAGE_UPLOAD_PAGE.
        layout {
            sequence: 10
            region: @ملحوظة
            slot: belowBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectOtherApp
            target: {
                app: 112
                page: 2
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: go_to_page2
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$SAVE_CHANGES.
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P60_PERSON_ID
        }
    )

    dynamicAction set-p60-lable-by-relation (
        name: Set P60_LABLE by Relation
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P60_RELATION_CODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function setLabelByRelation(){
                      // اقرأ القيمة ونظّفها
                      var v = ($v('P60_RELATION_CODE') || '').trim().toUpperCase();
                    
                      // خريطة القيم
                      var map = {
                        'SON'   : 'اضافه شهاده ميلاد',
                            'DAUGHT'   : 'اضافه شهاده ميلاد',
                        'SPOUSE': 'اضافه قسيمة الزواج',
                        'FATHER': 'اضافه البطاقه الشخصية',
                        'MOTHER': 'اضافه البطاقه الشخصية'
                      };
                    
                      // قيمة افتراضية لو مفيش تطابق
                      var text = map[v] || '';
                    
                      $("#labobo").html(text);
                    
                      // (اختياري) لمساعدتك في التشخيص
                    //   console.log('RELATION_CODE=', v, ' → LABLE=', text);
                    })();
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation phone-number-valid (
        name: Phone Number vALID
        execution {
            sequence: 22
        }
        validation {
            type: itemMatchesRegexp
            item: P60_MOBILE
            regexp: "^01\\d{9}$"
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE.
        }
