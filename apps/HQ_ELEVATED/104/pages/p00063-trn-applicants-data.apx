page 63 (
    name: "2025 برنامج التدريب الصيفي "
    alias: TRN-APPLICANTS-DATA
    title: &APP_TEXT$MSG_2025_SUMMER_INTERNSHIP_PROGRAM.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region 2025-برنامج-التدريب-الصيفي (
        name: "2025 برنامج التدريب الصيفي "
        title: &APP_TEXT$MSG_2025_SUMMER_INTERNSHIP_PROGRAM.
        type: form
        source {
            location: localDatabase
            tableOwner: EPROMHQ
            tableName: TRN_APPLICANTS_DATA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        title: &APP_TEXT$BUTTONS.
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            outputAs: text
        }
    )

