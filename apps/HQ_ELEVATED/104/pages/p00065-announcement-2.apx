    region الإعلانات-2 (
        name: الإعلانات
        title: &APP_TEXT$ADVERTISEMENTS.
        type: appTemplateComponent/news
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                
                
                
                
                SELECT
                  (
                    SELECT 
                      'f?p=' || :APP_ID || ':65:' || :APP_SESSION || ':APPLICATION_PROCESS=GET_NEWS_IMAGE:::IMAGE_ID:' || ni.image_id
                    FROM (
                      SELECT image_id
                      FROM epromhq.news_images
                      WHERE news_id = p.id
                      ORDER BY image_id
                      FETCH FIRST 1 ROWS ONLY
                    ) ni
                  ) AS news_image,
                
                  p.titel_announcement                      AS news_title,
                  '...' || SUBSTR(p.body, 1, 300)           AS news_text,
                  '...' || SUBSTR(p.body, 1, 300)           AS news_direction,
                  NULL                                      AS news_datetime,
                  TO_CHAR(p.created_at, 'DD-MON-YYYY')      AS news_text_small,
                  p.id                                      AS news_id
                
                FROM epromhq.portal_announcement_v p
                WHERE p.expire_date IS NULL OR p.expire_date > SYSDATE;
                
                ```
        }
        layout {
            sequence: 31
            slot: body
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: news_region
        }
        componentAppearance {
            display: report
        }
        settings {
            newsImages: NEWS_IMAGE
            newsText: NEWS_TEXT
            newsTitle: NEWS_TITLE
            newsImage: NEWS_IMAGE
        }

