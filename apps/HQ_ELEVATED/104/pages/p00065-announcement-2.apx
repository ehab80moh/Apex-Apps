    dynamicAction new (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // $(document).on("click", ".open-dialog", function () {
                        
                    //     apex.theme.openRegion('hamada');
                    // });
                    
                    
                    
                    $(document).on("click", ".open-dialog", function () {
                        // Step 1: Get the data attributes from the clicked button
                        var dialogTitle = $(this).attr("data-title");
                        var dialogContent = $(this).attr("data-content");
                    
                        // Step 2: Populate the dialog region dynamically
                        $(".ui-dialog-title").text(dialogTitle); // Set the dialog's title
                        $("#hamada-content").html(dialogContent); // Set the dialog's content
                    
                        // Step 3: Open the dialog region
                        apex.theme.openRegion('hamada');
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process fetch-news (
        name: Fetch news
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_cursor SYS_REFCURSOR;
                    l_html CLOB;
                    l_id NUMBER;
                    l_image VARCHAR2(4000);
                    l_title VARCHAR2(4000);
                    l_article VARCHAR2(4000);
                    l_datetime VARCHAR2(100);
                BEGIN
                    l_html := '<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">';
                
                    OPEN l_cursor FOR
                        SELECT ID, IMAGE, TITLE, ARTICLE, 
                               TO_CHAR(DATETIME, 'DD-MON-YYYY HH24:MI') AS DATETIME
                        FROM TMS_WEBSITENEWS
                        ORDER BY DATETIME DESC;
                
                    LOOP
                        FETCH l_cursor INTO l_id, l_image, l_title, l_article, l_datetime;
                        EXIT WHEN l_cursor%NOTFOUND;
                
                        l_html := l_html || '
                            <div class="border border-gray-300 rounded-lg overflow-hidden shadow-md">
                                <img src="' || l_image || '" alt="' || l_title || '" class="w-full h-48 object-cover">
                                <div class="p-4">
                                    <h3 class="text-lg font-bold text-gray-800 mb-2">' || l_title || '</h3>
                                    <p class="text-sm text-gray-500">' || l_datetime || '</p>
                                    <p class="text-gray-700 mt-4">' || DBMS_LOB.SUBSTR(l_article, 200) || '...</p>
                                    <a href="news_details_page?id=' || l_id || '" 
                                       class="text-blue-600 hover:underline mt-4 block">Read more</a>
                                </div>
                            </div>';
                    END LOOP;
                
                    l_html := l_html || '</div>';
                    CLOSE l_cursor;
                
                    HTP.P(l_html);
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 39501479443757834
        }
        serverSideCondition {
            type: never
        }
    )

)
