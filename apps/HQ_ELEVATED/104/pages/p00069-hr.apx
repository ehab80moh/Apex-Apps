page 69 (
    name: HR
    alias: HR
    title: &APP_TEXT$HR.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hr-list (
        name: HR List
        title: &APP_TEXT$HR_LIST.
        type: list
        source {
            list: @hr
        }
        layout {
            sequence: 11
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--stacked
                t-Cards--hideBody
                t-Cards--animColorFill
            ]
        }
    )

)
