    pageItem P71_MONTH (
        type: popupLov
        label {
            label: &APP_TEXT$MONTH.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    TO_CHAR(FROM_DATE, 'Month', 'NLS_DATE_LANGUAGE=ENGLISH') AS DISPLAY_VALUE,
                    TO_CHAR(FROM_DATE, 'MM') AS RETURN_VALUE
                FROM (
                    SELECT DISTINCT TRUNC(FROM_DATE, 'MM') AS FROM_DATE
                    FROM epromhq.VW_ALL_EMP_REQUESTS_V
                    WHERE EXTRACT(YEAR FROM FROM_DATE) = EXTRACT(YEAR FROM SYSDATE)
                )
                ORDER BY FROM_DATE
                
                ```
        }
        layout {
            sequence: 11
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P71_MONTH
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @جميع-الطلبات-المعلقة
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
