page 71 (
    name: جميع الطلبات المعلقة
    alias: ALL-PENDING-REQUESTS
    title: &APP_TEXT$ALL_PENDING_ORDERS.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &APP_TEXT$BREADCRUMB.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region جميع-الطلبات-المعلقة (
        name: جميع الطلبات المعلقة
        title: &APP_TEXT$ALL_PENDING_ORDERS.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select REQUEST_ID,
                       EMP_ID,
                       REQUEST_TYPE,
                       REQUEST_SUBTYPE,
                       FROM_DATE,
                       TO_DATE,
                       REASON,
                       PERMISSION_TYPE,
                       OVERTIME_DATE,
                       FROM_HOUR,
                       TO_HOUR,
                       UPLOADED_ORA,
                       TASK_IDS,
                       UPDATED_BY,
                       CREATED_AT,
                       UPLOADED_TMS,
                       APPROVED,
                       LAST_WORKING_DATE,
                       RETURN_TO_WORK_DATE,
                       COVER_PERSON,
                       LEAVE_CONTACT_ADDRESS,
                       MOBILE,
                       TMS_ID,
                       DELETE_APPROVED,
                       DELETE_REQUEST_DATE,
                       DELETE_TMS,
                       LAST_APPROVAL_DATE,
                       DESCRIPTION,
                       REQUEST_TYPE_ID
                  from EPROMHQ.VW_ALL_EMP_REQUESTS_V
                WHERE TO_CHAR(FROM_DATE, 'MM') = :P71_MONTH
                  AND EXTRACT(YEAR FROM FROM_DATE) = EXTRACT(YEAR FROM SYSDATE)
                  and APPROVED <> 3
                ```
            pageItemsToSubmit: P71_MONTH
        }
        layout {
            sequence: 21
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: &APP_TEXT$NO_DATA_FOUND_1.
            whenMoreDataFound: "&{MAX_ROW_COUNT_MESSAGE MAX_ROW_COUNT=#MAX_ROW_COUNT#}."
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 46920912249848868
        }

