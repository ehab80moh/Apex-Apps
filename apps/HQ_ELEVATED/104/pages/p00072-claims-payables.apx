    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // document.addEventListener("DOMContentLoaded", function() {
            //   const sidebar = document.getElementById("rightSidebar");
            //   const toggleButton = document.getElementById("toggleSidebar");
            
            //   if (sidebar && toggleButton) {
            //     toggleButton.addEventListener("click", function() {
            //       sidebar.classList.toggle("active");
            //     });
            //   }
            // });
            function getCheckedValues() {
                var values = [];
                $(".row_checkbox:checked").each(function () {
                    values.push($(this).val());
                });
                console.log(values); // just to check in browser console
                $s("P202_SELECTED_IDS", values.join(",")); // save into APEX item
            }
            
            // Toggle all children when header checkbox is clicked
            $(document).on("change", "#select_all", function () {
                $(".row_checkbox").prop("checked", this.checked);
                getCheckedValues();
            });
            
            // Update header checkbox and values when any row is clicked
            $(document).on("change", ".row_checkbox", function () {
                if (!this.checked) {
                    $("#select_all").prop("checked", false);
                } else if ($(".row_checkbox:checked").length === $(".row_checkbox").length) {
                    $("#select_all").prop("checked", true);
                }
                getCheckedValues();
            });
            
            
            function updateLockButtonState() {
                var claimId = apex.item("P72_MD_CLAIM_ID").getValue();
            
                $("#lock_button").prop("disabled", !claimId);
            }
            
            $(document).on("change", "#P72_MD_CLAIM_ID", function () {
                updateLockButtonState();
            });
            
            $(document).ready(function () {
                updateLockButtonState();
            });
            
            $(document)
                .off("click.lockClaim", "#lock_button")
                .on("click.lockClaim", "#lock_button", function (e) {
                    e.preventDefault();
            
                    var claimId = apex.item("P72_MD_CLAIM_ID").getValue();
            
                    if (!claimId) {
                        updateLockButtonState();
                        return;
                    }
            
                    apex.message.confirm(
                        "Are you sure you want to lock this claim? This action will mark the claim as locked.",
                        function (confirmed) {
                            if (!confirmed) {
                                return;
                            }
            
                            apex.server.process(
                                "LOCK_MD_CLAIM",
                                {
                                    x01: claimId
                                },
                                {
                                    dataType: "json",
            
                                    success: function (response) {
                                        if (response.success) {
                                            apex.message.showPageSuccess(
                                                response.message
                                            );
            
                                            $("#lock_button")
                                                .prop("disabled", true)
                                                .text("Locked");
                                        } else {
                                            apex.message.alert(response.message);
                                        }
                                    },
            
                                    error: function () {
                                        apex.message.alert(
                                            "An error occurred while locking the claim."
                                        );
                                    }
                                }
                            );
                        },
                        {
                            title: "Confirm Claim Lock",
                            style: "danger",
                            confirmLabel: "Lock Claim",
                            cancelLabel: "Cancel"
                        }
                    );
                });
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            $(document).on("keydown", function(e) {
              if (e.key === "Backspace") {
                var el = document.activeElement;
                el.value="";
              }
            });
            
            
            function highlightEditedRow() {
                var editedId = apex.item("P202_HIGHLIGHT_ID").getValue();
                var report$ = $("#Claim_Person_details");
            
                // Remove highlight from the previously edited row
                report$
                    .find("tr.last-edited-row")
                    .removeClass("last-edited-row");
            
                if (!editedId) {
                    return;
                }
            
                // Find the edit link with the matching row ID
                report$
                    .find(".js-edit-row")
                    .filter(function () {
                        return String($(this).attr("data-row-id")) === String(editedId);
                    })
                    .first()
                    .closest("tr")
                    .addClass("last-edited-row");
            }
            
            
            apex.gPageContext$
                .off("apexafterclosedialog.highlightRow")
                .on("apexafterclosedialog.highlightRow", function (event, data) {
            
                    if (
                        data &&
                        String(data.dialogPageId) === "203" &&
                        data.P203_ID
                    ) {
                        apex.item("P202_HIGHLIGHT_ID").setValue(
                            data.P203_ID
                        );
            
                        highlightEditedRow();
                    }
                });
            
            
                $("#Claim_Person_details")
                .off("apexafterrefresh.highlightEditedRow")
                .on("apexafterrefresh.highlightEditedRow", function () {
                    highlightEditedRow();
                });
            ```
