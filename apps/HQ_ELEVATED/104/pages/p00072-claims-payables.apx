            #import_btn,.custom-edit-button {
                background-color: var(--ut-palette-warning) !important;
                border-color: var(--ut-palette-warning) !important;
                color: var(--ut-palette-warning-contrast) !important;
                font-weight: 700 !important;
                box-shadow: 0 2px 4px rgba(180, 83, 9, 0.15) !important;
                border-radius: 6px !important;
            }
            #import_btn:hover,.custom-edit-button:hover {
                background-color: var(--ut-palette-warning) !important;
                border-color: var(--ut-palette-warning) !important;
                opacity: 0.9;
                transform: translateY(-1px) !important;
            }
            #details, #totals,
            #details table,#totals table,  
            #details .t-Report,#totals .t-Report {
                width: 100% !important;
            }
            #details table td,#totals table td, 
            #details table th,#totals table th {
                padding-top: 3px;   /* small space above text */
            }
            
            
            #Claim_Person_details .a-IRR-table tbody tr.last-edited-row > td {
