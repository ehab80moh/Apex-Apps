    region claim-person-details (
        name: Claim Person details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH claim_year AS (
                    SELECT distinct EXTRACT(YEAR FROM invoice_date) AS claim_year
                    FROM med.md_claim_person_summary
                    WHERE md_claim_id = :P72_MD_CLAIM_ID
                )
                ,p AS (
                    SELECT  a.person_id,
                            pgm.segment2 AS project_name,
                            a.assignment_id,
                            a.effective_start_date,
                            a.effective_end_date
                    FROM med.hr_per_all_assignments_f a
                    LEFT JOIN med.hr_pay_people_groups pgm
                        ON pgm.people_group_id = a.people_group_id
                    LEFT JOIN med.hr_per_periods_of_service ps
                        ON ps.person_id = a.person_id
                       AND ps.leaving_reason IN ('R','D','XX-14')
                       CROSS JOIN claim_year cy
                    WHERE a.effective_end_date >= TO_DATE('01-01-' || cy.claim_year, 'DD-MM-YYYY')
                      AND a.effective_start_date <= TO_DATE('31-12-' || cy.claim_year, 'DD-MM-YYYY')
                      AND (ps.actual_termination_date IS NULL
                           OR a.effective_start_date < ps.actual_termination_date)
                      AND a.person_id IS NOT NULL
                
                UNION ALL
                
                      SELECT
                            p.person_id,
                            'Dead',
                            NULL,
                            MAX(ppl.effective_start_date),
                            MAX(ppl.effective_end_date)
                        FROM (
                                SELECT 
                                    a.person_id,
                                    pgm.segment2 AS project_name,
                                    ROW_NUMBER() OVER (
                                        PARTITION BY a.person_id 
                                        ORDER BY a.effective_end_date DESC
                                    ) rn
                                FROM med.hr_per_all_assignments_f a
                                LEFT JOIN med.hr_pay_people_groups pgm
                                    ON pgm.people_group_id = a.people_group_id
                            ) p
                        JOIN med.hr_per_periods_of_service ps
                            ON ps.person_id = p.person_id
                        JOIN med.hr_per_all_people_f ppl
                            ON ppl.person_id = p.person_id
                        WHERE p.rn = 1
                          AND ps.leaving_reason = 'D'
                          group by p.person_id, p.project_name
                
                
                    UNION ALL
                
                    SELECT
                        ae.person_id,
                        'EX-EMPLOYEE',
                        NULL,
                        MIN(ae.effective_start_date),
                        MAX(ae.effective_end_date)
                    FROM med.hr_per_all_people_f ae
                    LEFT JOIN med.hr_per_periods_of_service ps
                        ON ps.person_id = ae.person_id
                       AND ps.leaving_reason IN ('R','XX-14')
                       CROSS JOIN claim_year cy
                    WHERE ae.effective_end_date >= TO_DATE('01-01-' || cy.claim_year,'DD-MM-YYYY')
                      AND ae.effective_start_date <= TO_DATE('31-12-' || cy.claim_year,'DD-MM-YYYY')
                      AND ps.actual_termination_date IS NOT NULL 
                      AND ps.actual_termination_date <= TO_DATE('31-12-' || cy.claim_year,'DD-MM-YYYY')
                      AND ae.effective_start_date >= ps.actual_termination_date
                    GROUP BY ae.person_id
                ),
                t AS (
                    SELECT *
                    FROM (
                        SELECT employee_number,
                               person_id,
                               full_name,
                               ROW_NUMBER() OVER (
                                   PARTITION BY employee_number
                                   ORDER BY effective_end_date DESC
                               ) rn
                        FROM med.hr_per_all_people_f
                    )
                    WHERE rn = 1
                ),
                e as(
                SELECT 
                    t.employee_number,
                    MAX(REGEXP_REPLACE(TRIM(t.full_name), '\s+', ' ')) AS employee_name,
                    p.project_name,
                    p.person_id,
                    p.assignment_id,
                    p.effective_start_date,
                    p.effective_end_date
                FROM p
                JOIN t ON t.person_id = p.person_id
                GROUP BY
                    t.employee_number,
                    p.project_name,
                    p.person_id,
                    p.assignment_id,
                    p.effective_start_date,
                    p.effective_end_date
                ORDER BY t.employee_number
                )
                SELECT
                ROW_NUMBER() OVER (ORDER BY cps.id) AS row_no,
                -- '<input type="checkbox" class="row_checkbox" value="' || cps.ID || '"/>' AS SELECT_ROW,
                    cps.ID,
                    CASE
                        WHEN cps.clinic_id IS NOT NULL THEN cps.clinic_id
                        ELSE cps.employee_number
                    END AS employee_number,
                
                    CASE
                        WHEN cps.clinic_id IS NOT NULL THEN c.project_name
                        ELSE NVL(
                            REGEXP_REPLACE(TRIM(t.full_name), '\s+', ' '),
                            'No Name'
                        )
                    END AS employee_name,
                
                    /* Clinic project if Clinic ID exists,
                       otherwise use the employee's project based on invoice date */
                    CASE
                        WHEN cps.clinic_id IS NOT NULL THEN c.project_name
                        ELSE NVL(e.project_name, 'Undefined')
                    END AS project,
                    ROUND(cps.covered, 2) AS covered,
                    nvl(cps.not_covered,0) AS "Not covered",
                    cps.support,
                    cps.invoice_date,
                    l.lookup_name AS patient_type_name,
                    cps.notes
                --    '<span class="t-Button t-Button--warning t-Button--small custom-edit-button" title="Edit">
                --        <span class="t-Icon fa fa-edit"></span>
                --     </span>' AS edit_icon
                -- CASE
                --     WHEN EXISTS (
                --         SELECT 1
                --         FROM MED.MD_USER_ROLES ur
                --         WHERE ur.USER_ID = TO_NUMBER(:MED_APP_USER_ID)
                --           AND ur.ROLE_ID = 1
                --     ) or (EXISTS (
                --         SELECT 1
                --         FROM MED.MD_CLAIM mc
                --         WHERE mc.ID = cps.md_claim_id
                --           AND mc.CREATED_BY = TO_NUMBER(:MED_APP_USER_ID)
                --     )
                --     AND yc.CLOSE_AT IS NULL)
                --     THEN
                --         -- disabled button
                --          '<span class="t-Button t-Button--warning t-Button--small custom-edit-button" title="Edit">
                --            <span class="t-Icon fa fa-edit"></span>
                --         </span>'
                --     ELSE
                --         -- normal enabled button
                --         ''
                -- END AS edit_icon
                
                    
                FROM med.md_claim_person_summary cps
                LEFT JOIN t
                       ON t.employee_number = cps.employee_number
                
                LEFT JOIN e
                       ON e.employee_number = cps.employee_number
                       and trunc(cps.invoice_date) between e.effective_start_date and e.effective_end_date
                LEFT JOIN med.md_lookup l
                       ON l.id = cps.patient_type
                /* Clinic integration */
                LEFT JOIN med.clinics c
                    ON c.clinic_id = cps.clinic_id
                LEFT JOIN med.hr_per_contact_relationships rp
                       ON rp.contact_person_id = cps.person_id
                LEFT JOIN med.apps_hr_lookups hr
                       ON hr.lookup_code = rp.contact_type
                LEFT JOIN MED.MD_YEAR_CONTROL yc
                       ON yc.CLAIM_YEAR = EXTRACT(YEAR FROM cps.invoice_date)
                WHERE cps.md_claim_id = :P72_MD_CLAIM_ID
                ORDER BY cps.id
                
                ```
            pageItemsToSubmit: P72_MD_CLAIM_ID
        }
