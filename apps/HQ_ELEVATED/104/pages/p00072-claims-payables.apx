            /* ===== Base Style (applies to all buttons) ===== */
             #toggleSidebar .t-Button.btn-pdf,
             #toggleSidebar .t-Button.btn-excel {
              flex: 0 0 auto;         
              white-space: nowrap;  
              padding: 10px 18px;
              color: #fff !important;
              font-size: 14px;
              font-weight: 600;
              border: none;
              border-radius: 8px;
              box-shadow: 0 3px 6px rgba(0,0,0,0.1);
              transition: all 0.2s ease-in-out;
              cursor: pointer;
            }
            
            /* ===== Toggle Button (Blue) ===== */
             #toggleSidebar .t-Button.btn-pdf {
              background: var(--ut-palette-primary);
            }
            
             #toggleSidebar .t-Button.btn-pdf:hover {
              background: var(--ut-palette-primary);
              opacity: 0.9;
              transform: translateY(-2px);
              box-shadow: 0 6px 10px rgba(0,0,0,0.15);
            }
            
            /* ===== Excel Download Button (Green) ===== */
             #toggleSidebar .t-Button.btn-excel {
              background: var(--ut-palette-success); /* Excel-inspired green */
            }
            
             #toggleSidebar .t-Button.btn-excel:hover {
              background: var(--ut-palette-success);
              opacity: 0.9;
              transform: translateY(-2px);
              box-shadow: 0 6px 10px rgba(0,0,0,0.15);
            }
            
            
            /* Collapsible right sidebar */
            #rightSidebar {
              position: fixed;
              top: 0;
              right: -300px; 
              width: 300px;
              height: 100%;
              background-color: var(--a-gv-background-color);
              box-shadow: -2px 0 5px rgba(0,0,0,0.2);
              transition: right 0.3s ease;
              z-index: 1050; 
              padding: 15px;
              
            }
            
            /* When active */
            #rightSidebar.active {
              right: 0;
            }
            
            /* Optional: style for the toggle button */
            #toggleSidebar,#details,#totals ,#special_limit{
              /* position: fixed;
              top: 20px;
              right: 20px;
              z-index: 1100; */
            background: var(--a-gv-background-color);
            border: 1px solid var(--a-gv-border-color);
            border-radius: 8px;
            }
            .big-font {
