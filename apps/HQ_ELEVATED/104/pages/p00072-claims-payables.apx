    dynamicAction aop-set-1-excel (
        name: AOP SET 1 EXCEL
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: #btnAex, #btnBex, #btnCex
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: NULL;
                itemsToSubmit: [
                    P72_BTN_VALUE
                    P72_MD_CLAIM_ID
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var btnId = this.triggeringElement.id;
                    var valueToSend;
                    
                    if (btnId === "btnAex") {
                        valueToSend = "MIDOR";
                    }
                    else if (btnId === "btnBex") {
                        valueToSend = "MIDOR - OVER";
                    }
                    else if (btnId === "btnCex") {
                        valueToSend = "MIDOR - EXTENSION";
                    }
                    
                    apex.item("P72_BTN_VALUE").setValue(valueToSend);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P72_BTN_VALUE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-be-apexrnd-aop-da (
            action: plugin/ucApexOfficePrintAopDa
            settings {
                templateType: filenameWithPathRelativeToAopServer
                templateSource3: C:\aop_24_2\reports\claims_details_payables.xlsx
                dataType: plSqlFunctionReturningJson
                dataSource2: RETURN med.REP_AOP_FINANCE_PKG.GET_FINANCE_PAYABLES(p_claim_id => :P72_MD_CLAIM_ID, p_btn_value => :P72_BTN_VALUE);
                initPlSqlCode: aop_api_pkg.g_output_filename := 'مطالبة -- Claim' ||'('||'&P72_BTN_VALUE.' ||')';
                outputType: excelXlsx
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

