    region all-totals (
        name: All Totals
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- SELECT 
                --     NVL(SUM(cps.COVERED),0)     AS "TOTAL_COVERED",
                --     NVL(SUM(cps.NOT_COVERED),0) AS "TOTAL_NOT_COVERED",
                --     NVL(SUM(cps.COVERED),0) + NVL(SUM(cps.NOT_COVERED),0) AS "GRAND_TOTAL",
                --     NVL(NVL(c.Amount,0) - (NVL(SUM(cps.COVERED),0) + NVL(SUM(cps.NOT_COVERED),0)),0) AS "Total amount - Grand Total = " 
                -- FROM MED.MD_CLAIM c
                -- JOIN MED.MD_CLAIM_PERSON_SUMMARY cps
                --     ON c.ID = cps.MD_CLAIM_ID
                -- WHERE c.ID = :P202_MD_CLAIM_ID
                -- group by c.Amount;
                SELECT 
                    ROUND(NVL(SUM(cps.COVERED), 0), 2) AS "TOTAL_COVERED",
                    ROUND(NVL(SUM(cps.NOT_COVERED), 0), 2) AS "TOTAL_NOT_COVERED",
                    ROUND(
                        NVL(SUM(cps.COVERED), 0) + NVL(SUM(cps.NOT_COVERED), 0),
                        2
                    ) AS "GRAND_TOTAL",
                    ROUND(
                        NVL(c.Amount, 0)
                        - ( NVL(SUM(cps.COVERED), 0) + NVL(SUM(cps.NOT_COVERED), 0) ),
                        2
                    ) AS "Total amount - Grand Total ="
                FROM MED.MD_CLAIM c
                JOIN MED.MD_CLAIM_PERSON_SUMMARY cps
                    ON c.ID = cps.MD_CLAIM_ID
                WHERE c.ID = :P72_MD_CLAIM_ID
                GROUP BY c.Amount;
                
                ```
