    process lock-md-claim (
        name: LOCK_MD_CLAIM
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_claim_id     NUMBER;
                    v_employee_person_id  NUMBER;
                    v_lock_flag    NUMBER;
                BEGIN
                    IF apex_application.g_x01 IS NULL THEN
                        apex_json.open_object;
                        apex_json.write('success', FALSE);
                        apex_json.write('message', 'Please select a claim first.');
                        apex_json.close_object;
                
                    ELSIF :APP_USER IS NULL and :med_app_user_id IS NULL THEN
                        apex_json.open_object;
                        apex_json.write('success', FALSE);
                        apex_json.write(
                            'message',
                            'Employee ID is missing. The claim was not locked.'
                        );
                        apex_json.close_object;
                
                    ELSE
                        v_claim_id := TO_NUMBER(apex_application.g_x01);
                        v_employee_person_id := nvl(TO_NUMBER(:APP_USER),:med_app_user_id);
                
                        UPDATE MED.MD_CLAIM
                           SET LOCK_FLAG = 1,
                               LOCKED_BY = v_employee_person_id,
                               LOCKED_AT = SYSDATE
                         WHERE ID = v_claim_id
                           AND NVL(LOCK_FLAG, 0) = 0;
                
                        IF SQL%ROWCOUNT = 1 THEN
                            apex_json.open_object;
                            apex_json.write('success', TRUE);
                            apex_json.write('message', 'Claim locked successfully.');
                            apex_json.close_object;
                        ELSE
                            BEGIN
                                SELECT NVL(LOCK_FLAG, 0)
                                  INTO v_lock_flag
                                  FROM MED.MD_CLAIM
                                 WHERE ID = v_claim_id;
                
                                apex_json.open_object;
                                apex_json.write('success', FALSE);
                
                                IF v_lock_flag = 1 THEN
                                    apex_json.write(
                                        'message',
                                        'This claim is already locked.'
                                    );
                                ELSE
                                    apex_json.write(
                                        'message',
                                        'The claim could not be locked.'
                                    );
                                END IF;
                
                                apex_json.close_object;
                
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    apex_json.open_object;
                                    apex_json.write('success', FALSE);
                                    apex_json.write('message', 'Claim not found.');
                                    apex_json.close_object;
                            END;
                        END IF;
                    END IF;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_json.open_object;
                        apex_json.write('success', FALSE);
                        apex_json.write(
                            'message',
                            'Unable to lock the claim: ' || SQLERRM
                        );
                        apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 82166800351809625
        }
    )

)
