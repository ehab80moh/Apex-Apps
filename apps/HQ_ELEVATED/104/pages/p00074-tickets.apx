            heading {
                heading: &APP_TEXT$FIRST_ATTACHMENT.
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            appearance {
                viewFileAs: inline
            }
            blobAttributes {
                tableOwner: EPROMHQ
                tableName: IIS_TICKETS
                blobColumn: ATTACHED_FILE
                primaryKeyColumn1: TICKET_ID
                filenameColumn: ATTACHED_FILE_NAME
            }
            sorting {
                sortable: false
