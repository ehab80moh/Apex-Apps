    pageItem P74_CATEGORY (
        type: selectList
        label {
            label: &APP_TEXT$CLASSIFICATION_OF_THE_PROBLEM.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                  CASE 
                    WHEN APEX_UTIL.GET_SESSION_LANG = 'ar-ae' THEN 
                      DISPLAY_AR
                    ELSE 
                      DISPLAY_EN
                  END AS DISPLAY_VALUE,
                  RETURN_VALUE
                FROM (
                  SELECT
                    'مشاكل الدخول'                      AS DISPLAY_AR,
                    'Login Issues'                      AS DISPLAY_EN,
                    'LOGIN_ISSUES'                      AS RETURN_VALUE
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'مشاكل البيانات',
                    'Data Issues',
                    'DATA_ISSUES'
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'مشاكل تقديم الطلبات',
                    'Application Submission Issues',
                    'APPLICATION_ISSUES'
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'مشاكل إشعارات أو تتبع الطلبات',
                    'Notification or Tracking Issues',
                    'NOTIFICATION_ISSUES'
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'مشاكل تقنية أو أعطال',
                    'Technical Problems or Errors',
                    'TECHNICAL_ISSUES'
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'مشاكل صلاحيات أو وصول',
                    'Access or Permission Issues',
                    'ACCESS_ISSUES'
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'مشاكل واجهة المستخدم أو اللغة',
                    'UI or Language Issues',
                    'UI_ISSUES'
                  FROM DUAL
                  UNION ALL
                  SELECT
                    'استفسارات عامة',
                    'General Inquiries',
                    'GENERAL_INQUIRIES'
                  FROM DUAL
                )
                
                ```
        }
        layout {
            sequence: 10
            region: @دعم-فني
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @دعم-فني
            column: CATEGORY
            dataType: varchar2
        }
    )

