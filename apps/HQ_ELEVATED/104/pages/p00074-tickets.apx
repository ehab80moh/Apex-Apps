    process initialize-form-tickets (
        name: Initialize form TICKETS
        type: formInitialization
        formRegion: @دعم-فني
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 55150083786564947
        }
    )

    process notification-and-sms (
        name: notification and sms
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                
                  
                
                
                
                
                
                DECLARE
                  TYPE emp_list_t IS TABLE OF NUMBER;
                  emp_ids emp_list_t;
                
                  P_TITLE     VARCHAR2(200);
                  P_BODY      VARCHAR2(4000);
                  P_APP_ID    NUMBER := 175;
                  P_PAGE_ID   NUMBER := 5;
                  P_TASK_ID   VARCHAR2(200) := :P74_TICKET_ID;
                  P_STATUS    NUMBER := 0;
                  P_INITIATOR VARCHAR2(200);
                  V_DATE      VARCHAR2(100);
                BEGIN
                  SELECT EMP
                  BULK COLLECT INTO emp_ids
                  FROM EPROMHQ.IIS_SUPPORT_EMPS
                  WHERE IS_DEVOLEPER <> 1;
                
                  P_TITLE     := TO_CHAR(NVL(:P74_TITLE, ''));
                  P_INITIATOR := TO_CHAR(NVL(:App_user, ''));
                
                  V_DATE := TO_CHAR(
                              CASE 
                                WHEN REGEXP_LIKE(:P74_CREATION_DATE, '^\d{2,4}[-/]\d{1,2}[-/]\d{1,4}$') 
                                THEN TO_DATE(:P74_CREATION_DATE, 'YYYY-MM-DD') 
                                ELSE SYSDATE 
                              END,
                              'DD-MM-YYYY'
                            );
                
                
                  P_BODY := 'Ticket #' || :P74_TICKET_ID || ' - ' || P_TITLE ||
                            ' For Employee ' || NVL(:P74_EMP_ID, 'Unknown') ||
                            ' | Date: ' || V_DATE || '.';
                
                
                  FOR i IN 1 .. emp_ids.COUNT LOOP
                    CENTRAL.XXAPEX_EMP_NOTIFICATIONS.ADD_NOTIFICATION(
                      P_EMP_ID     => TO_CHAR(emp_ids(i)),
                      P_TITLE      => P_TITLE,
                      P_BODY       => P_BODY,
                      P_APP_ID     => P_APP_ID,
                      P_PAGE_ID    => P_PAGE_ID,
                      P_TASK_ID    => P_TASK_ID,
                      P_STATUS     => P_STATUS,
                      P_INITIATOR  => P_INITIATOR
                    );
                  END LOOP;
                
                
                END;
                
                ```
        }
        execution {
