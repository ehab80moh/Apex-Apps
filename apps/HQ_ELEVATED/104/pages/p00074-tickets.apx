    region iis-tickets (
        name: IIS_TICKETS
        title: &APP_TEXT$TICKETS.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TICKET_ID,
                    ROW_NUMBER() OVER (PARTITION BY EMP_ID ORDER BY CREATION_DATE) AS NUM,
                       TITLE,
                       DESCRIPTION,
                       STATUS,
                       PRIORITY,
                       CATEGORY,
                       CREATED_BY,
                       ASSIGNED_TO,
                       CREATION_DATE,
                       LAST_UPDATE_DATE,
                       RESOLUTION_NOTE,
                       CLOSED_DATE,
                       EMP_ID,
                       ESCALATION,
                       dbms_lob.getlength(ATTACHED_FILE) AS ATTACHED_FILE,
                       dbms_lob.getlength(ATTACHED_FILE2) AS ATTACHED_FILE2,
                       ATTACHED_DATE,
                       ATTACHED_FILE_NAME,
                       ATTACHED_FILE_NAME2
                  from EPROMHQ.IIS_TICKETS
                  WHERE EMP_ID = :APP_USER
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                js-headingLevel-3
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ASSIGNED_TO (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

        column ATTACHED_DATE (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

        column ATTACHED_FILE (
            reportColumnQueryId: 16
            derivedColumn: N
