page 75 (
    name: تعديل بيانات العائلة
    alias: EDIT-FAMILY-DATA
    title: &APP_TEXT$EDIT_FAMILY_DATA.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        title: &APP_TEXT$BUTTONS.
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region تعديل-بيانات-العائلة (
        name: تعديل بيانات العائلة
        title: &APP_TEXT$EDIT_FAMILY_DATA.
        type: form
        source {
            location: localDatabase
            tableOwner: EPROMHQ
            tableName: HR_EMP_DEPENDENTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P75_BIRTH_DATE (
