    process new (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_exists NUMBER;
                BEGIN
                
                
                
                
                  SELECT COUNT(*)
                    INTO v_exists
                    FROM epromhq.eng_syndicate_log
                   WHERE app_user_name = :APP_USER;
                
                  IF v_exists = 1 THEN
                 SELECT id
                    INTO :P77_ID
                    FROM epromhq.eng_syndicate_log
                   WHERE app_user_name = :APP_USER
                   ORDER BY created_at DESC, id DESC
                   FETCH FIRST 1 ROW ONLY;
                
                  END IF;
                
                 
                
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    :P77_ID := NULL;
                  WHEN OTHERS THEN
                    raise_application_error(-20001, 'ENG_SYNDICATE_LOG error: ' || SQLERRM);
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 230280219428722733
        }
    )

