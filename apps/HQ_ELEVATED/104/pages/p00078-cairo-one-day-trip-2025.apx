    validation validation (
        name: Validation
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                NOT EXISTS (
                  SELECT 1 
                  FROM Epromhq.PRF_ONE_DAY_TRIP_REQUEST
                  WHERE EMPLOYEE_NUMBER = :P78_EMPLOYEE_NUMBER
                )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_APPLICATION_HAS_ALREADY_BEEN_SUBMITTED_AND_CANNOT_BE_APPLIED_AGAIN.
        }
    )

