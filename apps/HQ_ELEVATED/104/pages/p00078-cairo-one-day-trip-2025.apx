            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--stretch
                t-Button--padLeft
                t-Button--padRight
                t-Button--gapTop
                t-Button--gapBottom
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from Epromhq.PRF_ONE_DAY_TRIP_REQUEST
                where EMPLOYEE_NUMBER = :APP_USER;
                ```
        }
    )

