                t-Button--large
                t-Button--danger
                t-Button--stretch
                t-Button--padTop
                t-Button--padBottom
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                exists(
                select 1 from epromhq.HR_EMPLOYEE_AND_FAMILY_INFO
                where emp_id = :P79_EMP_ID)
                ```
        }
    )

    validation check-phone (
        name: CHECK PHONE
        execution {
            sequence: 20
        }
        validation {
            type: itemMatchesRegexp
            item: P79_PHONE_MOBILE
            regexp: "^01\\d{9}$"
        }
        error {
            errorMessage: &APP_TEXT$PLEASE_ENTER_THE_MOBILE_NUMBER_CORRECTLY.
            associatedItem: @P79_PHONE_MOBILE
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation don-t-dublicate (
        name: DON'T DUBLICATE
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                NOT EXISTS (
                  SELECT 1 
                  FROM Epromhq.HR_EMPLOYEE_AND_FAMILY_INFO
                  WHERE EMP_ID = :P79_EMP_ID
                )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_APPLICATION_HAS_ALREADY_BEEN_SUBMITTED_AND_CANNOT_BE_APPLIED_AGAIN.
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valid-on-emp-name (
        name: Valid on emp name
        execution {
            sequence: 30
        }
        validation {
            language: sql
            sqlExpression: LENGTH(TRIM(:P79_EMP_NAME)) > 0
        }
        error {
            errorMessage: &APP_TEXT$EMPLOYEE_NAME_CANNOT_BE_EMPTY.
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valid-on-emp-phone (
        name: Valid on emp phone
        execution {
            sequence: 40
        }
        validation {
            language: sql
            sqlExpression: LENGTH(TRIM(:P79_PHONE_MOBILE)) > 0
