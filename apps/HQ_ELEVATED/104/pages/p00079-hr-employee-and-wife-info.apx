    button create (
        buttonName: CREATE
        label: &APP_TEXT$PRESENTATION.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$CONFIRM_MESSAGE.
            style: warning
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                
                select 1 from epromhq.HR_EMPLOYEE_AND_FAMILY_INFO
                where emp_id = :App_user
                ```
        }
    )

    button delete (
        buttonName: Delete
