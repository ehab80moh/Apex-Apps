    process add-new-number-phones-to-the-hr-emp-data (
        name: ADD New Number Phones to the HR_emp_DATA
        type: invokeApi
        invoke {
            type: plsqlProcedureOrFunction
            owner: CENTRAL
            procedureOrFunction: PRC_FILL_EMP_CONTACT_FROM_VIEW
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 129203023741200606
        }
        serverSideCondition {
            whenButtonPressed: @add-new-number-phones-the-hr-emp-data
        }
    )

    process clear-items (
        name: clear items
        type: clearSessionState
        execution {
            sequence: 70
