    process create-user-2 (
        name: create user
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  l_emp_id   CENTRAL.EMP_CRIDS.EMP_ID%TYPE := :P81_EMP_ID;
                  l_new_pass VARCHAR2(20) := LPAD(TRUNC(DBMS_RANDOM.VALUE(0, 99999999)), 8, '0');
                  l_exists   NUMBER;
                BEGIN
                  SELECT COUNT(*) INTO l_exists
                  FROM CENTRAL.EMP_CRIDS
                  WHERE emp_id = l_emp_id;
                
                  IF l_exists = 0 THEN
                    INSERT INTO CENTRAL.EMP_CRIDS (emp_id, pass, password_changed)
                    VALUES (l_emp_id, l_new_pass, 'N');
                
                  END IF;
                
                EXCEPTION
                  WHEN DUP_VAL_ON_INDEX THEN
                    NULL;
                  WHEN OTHERS THEN
                    apex_error.add_error(
                      p_message          => 'Error while creating credentials: '||SQLERRM,
                      p_display_location => apex_error.c_inline_in_notification
                    );
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 136077179039759606
        }
        serverSideCondition {
            whenButtonPressed: @create-user
        }
    )

