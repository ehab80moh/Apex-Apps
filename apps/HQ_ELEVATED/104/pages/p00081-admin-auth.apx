    region اضافه-تأكيد-الدخول (
        name: اضافه تأكيد الدخول
        title: &APP_TEXT$ADD_LOGIN_CONFIRMATION.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                SELECT
                    c.EMP_NUMBER,
                    e.emp_id,
                    e.mobile,
                    e.comp_email,
                    e.mobile_confirmed
                FROM
                    CENTRAL.EMP_AUTH_VIEW c
                JOIN
                    central.emp_contact e ON c.emp_number = e.emp_id
                WHERE
                    c.EMP_NUMBER = :P81_EMP_ID;
                
                ```
        }
        layout {
            sequence: 100
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        messages {
            whenNoDataFound: &APP_TEXT$NO_USER_FOUND_PLEASE_CREATE_FROM_THE_BUTTON.
        }

