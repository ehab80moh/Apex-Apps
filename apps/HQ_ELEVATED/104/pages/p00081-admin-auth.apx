    process merge-into-central-emp-contact (
        name: MERGE INTO CENTRAL.EMP_CONTACT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                MERGE INTO CENTRAL.EMP_CONTACT e
                USING (SELECT * FROM DUAL) s
                ON (e.EMP_ID = :P81_EMP_ID)
                WHEN MATCHED THEN
                  UPDATE SET
                
                    e.MOBILE = :P81_MOBILE,
                    e.COMP_EMAIL = :P81_COMP_EMAIL,
                    e.PERSONAL_EMAIL = :P81_PERSONAL_EMAIL
                WHEN NOT MATCHED THEN
                  INSERT (EMP_ID, MOBILE, COMP_EMAIL, PERSONAL_EMAIL)
                  VALUES (:P81_EMP_ID, :P81_MOBILE, :P81_COMP_EMAIL, :P81_PERSONAL_EMAIL);
                
                
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: "&{THAT_BEEN_ADD_TO_EMP_P81EMPID_NUMBER_P81MOBILE P81_EMP_ID=&P81_EMP_ID. P81_MOBILE=&P81_MOBILE.}."
        }
        advanced {
            executionMappingIdentifier: 13434782350683502
        }
        serverSideCondition {
            whenButtonPressed: @add
        }
    )

    process send-reset-mail (
        name: SEND RESET MAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Declare 
                v_code varchar2(20);
                v_emp_name varchar2(99);
                begin
                
                  v_code := central.SET_EMP_REST_CODE(
                    P_EMP_ID => :P81_EMP_ID
                  );
                
                select emp_name
                into v_emp_name
                           from central.xxapex_hr_emp_data
                          where emp_number = :P81_EMP_ID
                          AND (
                TRIM(COMP_EMAIL) = TRIM(:P81_MAIL_SELECT)
                OR TRIM(PAY_EMAIL) = TRIM(:P81_MAIL_SELECT)
                          )
                          ;
                
                    apex_mail.send (
                        p_from               => 'apex@eprom.com.eg',
                        p_to                 => :P81_MAIL_SELECT,
                        p_template_static_id => 'PASSWORD_RESET',
                        p_placeholders       => '{' ||
                        '    "EMP_NAME":' || apex_json.stringify( v_emp_name ) ||
                        '   ,"EMP_ID":'   || apex_json.stringify( :P81_EMP_ID ) ||
                        '   ,"NEW_PASS":' || apex_json.stringify( v_code ) ||
                        '}' );
                
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &APP_TEXT$SENT_MAIL_TO_USER_SUCCESS_.
        }
        error {
            errorMessage: &APP_TEXT$ERROR_SENDING_MAIL_WRONG_EMAIL_OR_OTHER_ERROR.
        }
        advanced {
            executionMappingIdentifier: 7598211562161427
        }
        serverSideCondition {
            whenButtonPressed: @send-password-reset-mail
        }
    )

    process unlock-user (
        name: UNLOCK USER
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    DELETE FROM CENTRAL.LOGIN_AUTH_LOG 
                    WHERE ROWID IN (
                        SELECT ROWID 
                        FROM CENTRAL.LOGIN_AUTH_LOG 
                        WHERE USERNAME = :P81_EMP_ID
                        ORDER BY LOGIN_DATE DESC -- Assuming there is a column like LOG_DATE to determine the order of rows
                        FETCH FIRST 10 ROWS ONLY
                    );
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 69752803619175246
        }
        serverSideCondition {
            whenButtonPressed: @unlock-user
        }
    )

)
