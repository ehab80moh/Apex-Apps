    process create-account-on-central-emp-contact (
        name: Create account on central.emp_contact
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                SELECT MOBILE, COMP_EMAIL, PERSONAL_EMAIL 
                INTO :P81_MOBILE,:P81_COMP_EMAIL,:P81_PERSONAL_EMAIL
                 FROM CENTRAL.EMP_CONTACT WHERE EMP_ID = :P81_EMP_ID;
                    EXCEPTION WHEN NO_DATA_FOUND THEN
                 NULL;
                 END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13436214816683517
        }
    )

