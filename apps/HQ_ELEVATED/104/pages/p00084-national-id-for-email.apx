page 84 (
    name: national id for email
    alias: NATIONAL-ID-FOR-EMAIL
    title: &APP_TEXT$NATIONAL_ID_FOR_EMAIL_1.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @it
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &APP_TEXT$BREADCRUMB.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region national-id-for-email (
        name: national id for email
        title: &APP_TEXT$NATIONAL_ID_FOR_EMAIL_1.
        type: interactiveReport
        source {
            location: localDatabase
            tableName: XX_DC_NATIONAL_IDS
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 31947592983586633
        }

        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID (
            type: link
            heading {
                heading: edit
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            link {
                target: {
                    page: 85
                    items: {
                        P85_ID: #ID#
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NATIONAL_ID (
            type: plainText
            heading {
                heading: National Id
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: &APP_TEXT$NATIONAL_ID_FOR_EMAIL_1.
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMAIL (
                sequence: 2
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn NATIONAL_ID (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: create
        label: Create
        layout {
            sequence: 10
            region: @national-id-for-email
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
            }
        }
    )

)
