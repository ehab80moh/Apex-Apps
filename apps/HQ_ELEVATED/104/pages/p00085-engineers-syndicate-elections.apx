                        SET COMMITTEE      = :P85_COMMITTEE,
                            ESTIMATED_TIME = :P85_ESTIMATED_TIME
                        WHERE EMP_NUMBER   = :P85_EMP_NUMBER;
                    END IF;
                
                    IF SQL%ROWCOUNT = 0 THEN
                        INSERT INTO epromhq.ENGINEERS_ELECTIONS
                        (
                            EMP_NUMBER,
                            COMMITTEE,
                            ESTIMATED_TIME,
                            CREATED_AT
                        )
                        VALUES
                        (
                            :P85_EMP_NUMBER,
                            CASE
                                WHEN :P85_COMMITTEE_1 IS NOT NULL
                                THEN :P85_COMMITTEE || ' - ' || :P85_COMMITTEE_1
                                ELSE :P85_COMMITTEE
                            END,
                            :P85_ESTIMATED_TIME,
                            TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI')
                        );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
