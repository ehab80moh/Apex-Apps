    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                SELECT id,
                EMP_NUMBER,
                       COMMITTEE,
                       ESTIMATED_TIME,
                       CREATED_AT
                INTO
                :P85_ID,
                       :P85_EMP_NUMBER,    
                       :P85_COMMITTEE,
                       :P85_ESTIMATED_TIME,
                       :P85_CREATED_AT
                FROM Epromhq.ENGINEERS_ELECTIONS
                WHERE EMP_NUMBER = :APP_USER
                ORDER BY ID DESC
                FETCH FIRST 1 ROWS ONLY;
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 275914455146700138
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :app_user in (select emp_number from epromhq.ENGINEERS_ELECTIONS);
        }
    )

    process new-2 (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                
                
                
                
                BEGIN
                    UPDATE epromhq.ENGINEERS_ELECTIONS
                    SET COMMITTEE = ' '
                    WHERE EMP_NUMBER = :P85_EMP_NUMBER;
                
                    IF :P85_COMMITTEE_1 IS NOT NULL THEN
                        UPDATE epromhq.ENGINEERS_ELECTIONS
                        SET COMMITTEE      = :P85_COMMITTEE || ' - ' || :P85_COMMITTEE_1,
                            ESTIMATED_TIME = :P85_ESTIMATED_TIME
                        WHERE EMP_NUMBER   = :P85_EMP_NUMBER;
                
                    ELSIF :P85_COMMITTEE_1 IS NULL 
                       AND :P85_COMMITTEE IS NOT NULL THEN
                        UPDATE epromhq.ENGINEERS_ELECTIONS
                        SET COMMITTEE      = :P85_COMMITTEE,
                            ESTIMATED_TIME = :P85_ESTIMATED_TIME
                        WHERE EMP_NUMBER   = :P85_EMP_NUMBER;
                    END IF;
                
                    IF SQL%ROWCOUNT = 0 THEN
                        INSERT INTO epromhq.ENGINEERS_ELECTIONS
                        (
                            EMP_NUMBER,
                            COMMITTEE,
                            ESTIMATED_TIME,
                            CREATED_AT
                        )
                        VALUES
                        (
                            :P85_EMP_NUMBER,
                            CASE
                                WHEN :P85_COMMITTEE_1 IS NOT NULL
                                THEN :P85_COMMITTEE || ' - ' || :P85_COMMITTEE_1
                                ELSE :P85_COMMITTEE
                            END,
                            :P85_ESTIMATED_TIME,
                            TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI')
                        );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 275915286328700146
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotNull
            item: P85_ID
        }
    )

