        source {
            plsqlCode:
                ```plsql
                
                
                
                
                
                BEGIN
                    UPDATE epromhq.ENGINEERS_ELECTIONS
                    SET COMMITTEE = ' '
                    WHERE EMP_NUMBER = :P85_EMP_NUMBER;
                
                    IF :P85_COMMITTEE_1 IS NOT NULL THEN
