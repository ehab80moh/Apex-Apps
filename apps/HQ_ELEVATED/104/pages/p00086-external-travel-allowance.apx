    region بدل-انتقالات-داخلية (
        name: بدل انتقالات داخلية
        title: &APP_TEXT$INTERNAL_TRANSPORTATION_ALLOWANCE.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH movements AS (
                    SELECT
                        e.request_id,
                        LISTAGG(
                            NVL(TO_CHAR(e.date_from, 'DD-MM-YYYY'), '-'),
                            CHR(10) ON OVERFLOW TRUNCATE '...' WITH COUNT
                        ) WITHIN GROUP (ORDER BY e.date_from, e.expense_id) AS movement_date,
                        LISTAGG(
                            NVL(REPLACE(REPLACE(e.mission, CHR(13), ' '), CHR(10), ' '), '-'),
                            CHR(10) ON OVERFLOW TRUNCATE '...' WITH COUNT
                        ) WITHIN GROUP (ORDER BY e.date_from, e.expense_id) AS movement_description
                    FROM EPROMHQ.TRV_EXPENSE e
                    GROUP BY e.request_id
                )
                SELECT 
                '<input type="checkbox" class="row_checkbox" value="' || a.request_id || '"/>' AS select_row,
                  a.REQUEST_ID,
                  a.EMP_ID,
                  a.EMP_ID Emp_name,
                  x.SITE_CODE,
                  x.PROJECT,
                  x.MAIN_DEPARTMENT,
                  a.TRIP_PURPOSE,
                  a.TRIP_LOCATION,
                  mv.movement_date,
                  mv.movement_description,
                  a.DATE_FROM,
                  a.DATE_TO,
                TRUNC((a.date_to - a.date_from) + 1) AS number_days,
                  a.CREATED_AT,
                  a.PER_DIEM_RATE,
                  a.TOTAL_ALLOWANCE,
                  a.MEAL,
                  a.TRAVEL_EXPENSE,
                  a.DELETE_APPROVAL_CAR,
                  a.DELETE_APPROVAL_HOTEL,
                  a.DELETE_APPROVAL_FINANCE,
                  a.LAST_APPROVAL_DATE,
                  a.STATUS,
                  a.TASK_IDS,
                  a.APPROVAL_MANAGER,
                  a.APPROVAL_CAR,
                  a.APPROVAL_HOTEL,
                  a.APPROVAL_FINANCE,
                  A.REQUEST_TYPE_ID,
                  Date_of_disbursement,
                  DATE_OF_ADMINISTRATOR,
                  null as attached_file,
                      CASE
                        WHEN a.approval_manager = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_manager = '0' THEN '❌تم الرفض'
                        WHEN a.approval_manager = '2' OR a.approval_manager IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_manager
                    END AS approval_manager_msg,
                
                    -- a.approval_car,
                
                    CASE
                        WHEN a.approval_car = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_car = '2' THEN '❌تم الرفض'
                        WHEN a.approval_car = '0' OR a.approval_car IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_car
                    END AS approval_car_msg,
                    
                    CASE
                        WHEN a.approval_finance = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_finance = '2' THEN '❌تم الرفض'
                        WHEN a.approval_finance = '0' OR a.approval_finance IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_finance
                    END AS approval_finance_msg,
                
                  CASE
                    WHEN NVL(a.APPROVAL_MANAGER,0) = 1
                     AND NVL(a.APPROVAL_CAR,0)     = 1
                     AND NVL(a.APPROVAL_FINANCE,0) = 1
                    THEN '✔ تم الصرف'
                
                    ELSE '⏳ قيد المراجعة'
                  END AS REQUEST_FINAL_STATUS
                
                FROM EPROMHQ.TRV_ALLOWANCE a left join central.xxapex_hr_emp_data x on a.emp_id = x.emp_number
                LEFT JOIN movements mv ON mv.request_id = a.request_id
                WHERE A.REQUEST_TYPE_ID = 33
                  AND a.APPROVAL_MANAGER = 1
                  and a.APPROVAL_CAR = 1
                  AND NVL(a.DELETE_APPROVAL_CAR,0)  <> 1
                  AND NVL(a.DELETE_APPROVAL_HOTEL,0)<> 1
                --   AND( APPROVAL_FINANCE is null or APPROVAL_FINANCE <> 1 )
                    --   and a.request_id not in (select REQUEST_ID from EPROMHQ.TRV_ALLOWANCE_HOTELS)
                -- and a.DATE_OF_ADMINISTRATOR is null
                AND  x.SITE_CODE = :EMP_SITE
                  AND :APP_USER IN (SELECT EMP_NUMBER FROM CENTRAL.APR_STATIC_APPROVAL_SITE)
                ```
        }
        layout {
            sequence: 60
            parentRegion: @region-display-selector
            slot: tabs
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 337563079460735233
        }

