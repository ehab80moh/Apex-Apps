page 86 (
    name: بدل انتقالات خارجيه
    alias: EXTERNAL-TRAVEL-ALLOWANCE
    title: &APP_TEXT$FOREIGN_TRANSFER_ALLOWANCE.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            function getCheckedValues() {
              var values = [];
              $(".row_checkbox:checked").each(function () {
                values.push($(this).val());
              });
              $s("P73_SELECTED_IDS", values.join(","));
            }
            
            // Toggle all when header checkbox clicked
            $(document).on("change", "#select_all", function () {
              $(".row_checkbox").prop("checked", this.checked);
              getCheckedValues();
            });
            
            // Update header checkbox + item when any row checkbox changes
            $(document).on("change", ".row_checkbox", function () {
              if (!this.checked) {
                $("#select_all").prop("checked", false);
              } else if ($(".row_checkbox:checked").length === $(".row_checkbox").length) {
                $("#select_all").prop("checked", true);
              }
              getCheckedValues();
            });
            
            ```
    }
    css {
        inline:
            ```css
            
            .row_checkbox {
                transform: scale(1.5); 
                margin: 10px;
            }
            
            
            .row_checkbox {
                width: 20px;
                height: 20px;
                cursor: pointer;
            }
            
            td[headers="MOVEMENT_DATE"],
            td[headers="MOVEMENT_DESCRIPTION"] {
                white-space: pre;
                vertical-align: top;
            }
            
            #select_all {
              transform: scale(1.5);
              margin-right: 8px;
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

