    region بدل-انتقالات-خارجيه-2 (
        name: بدل انتقالات خارجيه
        title: &APP_TEXT$FOREIGN_TRANSFER_ALLOWANCE.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH movements AS (
                    SELECT
                        e.request_id,
                        LISTAGG(
                            NVL(TO_CHAR(e.date_from, 'DD-MM-YYYY'), '-'),
                            CHR(10) ON OVERFLOW TRUNCATE '...' WITH COUNT
                        ) WITHIN GROUP (ORDER BY e.date_from, e.expense_id) AS movement_date,
                        LISTAGG(
                            NVL(REPLACE(REPLACE(e.mission, CHR(13), ' '), CHR(10), ' '), '-'),
                            CHR(10) ON OVERFLOW TRUNCATE '...' WITH COUNT
                        ) WITHIN GROUP (ORDER BY e.date_from, e.expense_id) AS movement_description
                    FROM EPROMHQ.TRV_EXPENSE e
                    GROUP BY e.request_id
                ),
                exp AS (
                    SELECT
                        ht.request_id,
                
                        MAX(CASE WHEN UPPER(TRIM(ht.type_of_hotel)) = 'B.B' THEN 1 ELSE 0 END) AS bb_75_flag,
                        MAX(CASE WHEN UPPER(TRIM(ht.type_of_hotel)) = 'H.B' THEN 1 ELSE 0 END) AS hb_50_flag,
                        MAX(CASE WHEN UPPER(TRIM(ht.type_of_hotel)) = 'S.A' THEN 1 ELSE 0 END) AS sa_100_flag,
                
                        SUM(
                            CASE
                                WHEN REGEXP_LIKE(TRIM(ht.number_of_days), '^\d+(\.\d+)?$')
                                THEN TO_NUMBER(TRIM(ht.number_of_days))
                                ELSE 0
                            END
                        ) AS hotel_days,
                
                        LISTAGG(
                            TRIM(ht.type_of_hotel) || ' - ' || TRIM(ht.number_of_days) || ' يوم',
                            ' / '
                        ) WITHIN GROUP (ORDER BY ht.type_of_hotel) AS hotel_details
                
                    FROM EPROMHQ.TRV_ALLOWANCE_HOTELS ht
                    GROUP BY ht.request_id
                )
                SELECT
                    '<input type="checkbox" class="row_checkbox" value="' || a.request_id || '"/>' AS select_row,
                    a.request_id,
                    a.emp_id,
                    h.emp_name AS emp_name,
                    h.site_code,
                    h.project,
                    TO_NUMBER(REGEXP_SUBSTR(TRIM(h.current_grade), '\d+$')) AS grade_num,
                    a.trip_purpose,
                    a.trip_location,
                    mv.movement_date,
                    mv.movement_description,
                    a.date_from,
                    a.start_time,
                    a.date_to,
                    a.end_time,
                    TRUNC((a.date_to - a.date_from) + 1) AS number_days,
                    CAST(NULL AS NUMBER) AS per_diem_rate,
                
                    NVL(ex.bb_75_flag, 0) AS bb_75,
                    NVL(ex.hb_50_flag, 0) AS hb_50,
                    NVL(ex.sa_100_flag, 0) AS sa_100,
                
                    CASE
                        WHEN NVL(ex.sa_100_flag, 0) = 1 THEN 'S.A 100%'
                        WHEN NVL(ex.hb_50_flag, 0)  = 1 THEN 'H.B 50%'
                        WHEN NVL(ex.bb_75_flag, 0)  = 1 THEN 'B.B 75%'
                        ELSE NULL
                    END AS hotel_plan,
                
                    NVL(ex.hotel_days, 0) AS hotel_days,
                
                    ex.hotel_details AS hotel_details,
                
                    CAST(NULL AS NUMBER) AS total_allowance,
                    CAST(NULL AS VARCHAR2(100)) AS meal,
                    CAST(NULL AS NUMBER) AS travel_expense,
                    a.last_approval_date,
                    a.status,
                    a.task_ids,
                    a.approval_manager,
                
                    CASE
                        WHEN a.approval_manager = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_manager = '0' THEN '❌تم الرفض'
                        WHEN a.approval_manager = '2' OR a.approval_manager IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_manager
                    END AS approval_manager_msg,
                
                    a.approval_car,
                
                    CASE
                        WHEN a.approval_car = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_car = '2' THEN '❌تم الرفض'
                        WHEN a.approval_car = '0' OR a.approval_car IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_car
                    END AS approval_car_msg,
                
                    a.approval_hotel,
                
                    CASE
                        WHEN a.approval_hotel = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_hotel = '2' THEN '❌تم الرفض'
                        WHEN a.approval_hotel = '0' OR a.approval_hotel IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_hotel
                    END AS approval_hotel_msg,
                
                    CASE
                        WHEN a.approval_finance = '1' THEN '✅تمت الموافقة'
                        WHEN a.approval_finance = '2' THEN '❌تم الرفض'
                        WHEN a.approval_finance = '0' OR a.approval_finance IS NULL THEN '⏳في انتظار الاعتماد'
                        ELSE a.approval_finance
                    END AS approval_finance_msg,
                
                    a.date_of_disbursement AS date_of_disbursement,
                    CAST(NULL AS VARCHAR2(4000)) AS attached_file,
                
                    CASE
                        WHEN NVL(a.delete_approval_car, 0)     = 1
                          OR NVL(a.delete_approval_hotel, 0)   = 1
                          OR NVL(a.delete_approval_finance, 0) = 1
                          OR a.approval_manager = '0'
                          OR a.approval_car = '2'
                          OR a.approval_hotel = '2'
                          OR a.approval_finance = '2'
                          OR a.status = 'TERMINATED'
                        THEN '❌ مرفوض'
                
                        WHEN NVL(a.approval_manager, 0) = 1
                         AND NVL(a.approval_car, 0)     = 1
                         AND NVL(a.approval_hotel, 0)   = 1
                         AND NVL(a.approval_finance, 0) = 1
                        THEN '✅ تم الصرف'
                
                        ELSE '⏳ قيد المراجعة'
                    END AS request_final_status,
                
                    NULL AS cancel,
                    a.approval_finance,
                    CAST(NULL AS NUMBER) AS net_amount,
                    a.date_of_administrator
                
                FROM EPROMHQ.TRV_ALLOWANCE a
                
                LEFT JOIN movements mv
                       ON mv.request_id = a.request_id
                
                LEFT JOIN exp ex
                       ON ex.request_id = a.request_id
                
                LEFT JOIN CENTRAL.XXAPEX_HR_EMP_DATA h
                       ON h.emp_number = a.emp_id
                
                WHERE a.request_type_id = '47'
                  AND NVL(a.status, 'PENDING') NOT IN ('DELETED')
                  AND (
                      h.site_code IN (
                          SELECT s.site_code 
                          FROM central.apr_static_approval_site s 
                          WHERE s.emp_number = :APP_USER
                            AND s.admin_job_type IN ('car_admin', 'hotel_admin')
                      )
                      OR (
                          :EMP_SITE IS NOT NULL 
                          AND h.site_code = :EMP_SITE
                          AND EXISTS (
                              SELECT 1 
                              FROM central.apr_static_approval_site s 
                              WHERE s.emp_number = :APP_USER
                                AND s.admin_job_type IN ('car_admin', 'hotel_admin')
                          )
                      )
                  )
                ```
        }
