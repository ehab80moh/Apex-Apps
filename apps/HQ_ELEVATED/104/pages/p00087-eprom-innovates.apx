page 87 (
    name: مسابقة إيبروم تبتكر
    alias: EPROM-INNOVATES
    title: &APP_TEXT$PORTAL_PAGE_87_TITLE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
        cssClasses: sug-idea-page
    }
    dialog {
        width: 500
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .sug-idea-page .t-Dialog-body{background:#f6f8fb}
            .sug-idea-page .t-Region{border:0;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.08)}
            .sug-idea-page .t-Form-labelContainer label{font-weight:700}
            .sug-idea-page .sug-section-note{padding:12px 16px;border-radius:8px;background:#eef6ff;color:#1f456e;border-inline-start:4px solid #2f80ed}
            .sug-idea-page .apex-item-display-only{font-weight:700;color:#243447}
            .sug-idea-page textarea{min-height:118px}
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        title: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region idea-submission (
        name: Idea Submission
        title: نموذج تقديم الفكرة
        type: form
        source {
            location: localDatabase
            tableName: SUG_IDEA_SUBMISSIONS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Form--large
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: add
        }
    )

    region previous-submissions (
        name: طلباتي السابقة
        title: طلباتي السابقة
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idea_title,
                       decode(participation_type, 'INDIVIDUAL', 'فردي', 'GROUP', 'جماعي', participation_type) as participation_type_display,
                       created_at
                  from hq_elevated.sug_idea_submissions
                 where created_by = :APP_USER
                 order by created_at desc
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column CREATED_AT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: تاريخ التقديم
                alignment: center
            }
            layout {
                sequence: 30
            }
            appearance {
                formatMask: YYYY-MM-DD HH24:MI
            }
        )

        column IDEA_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: عنوان الفكرة
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PARTICIPATION_TYPE_DISPLAY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

    )

    pageItem P87_ADDED_VALUE (
        type: textField
        label {
            label: القيمة المضافة المتوقعة
            alignment: left
        }
        layout {
            sequence: 160
            region: @idea-submission
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 100
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        source {
            formRegion: @idea-submission
            column: ADDED_VALUE
            dataType: varchar2
        }
    )

