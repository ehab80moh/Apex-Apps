    process download-contest-file (
        name: Download Contest File
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                   l_mime_type   VARCHAR2(255);
                   l_blob        BLOB;
                   l_file_name   VARCHAR2(2000);
                BEGIN
                   SELECT mime_type, file_data, file_name
                     INTO l_mime_type, l_blob, l_file_name
                     FROM hq_elevated.attachment
                    WHERE file_name = 'EPROM_INOOVATION_CONTEST.pdf'
                    ORDER BY created_on DESC
                    FETCH FIRST 1 ROW ONLY;
                
                   owa_util.mime_header(l_mime_type, FALSE);
                   htp.p('Content-length: ' || DBMS_LOB.getlength(l_blob));
                   htp.p('Content-Disposition: attachment; filename="' || l_file_name || '"');
                   owa_util.http_header_close;
                
                   wpg_docload.download_file(l_blob);
                   apex_application.stop_apex_engine;
                EXCEPTION
                   WHEN OTHERS THEN
                      apex_application.stop_apex_engine;
                END;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32008651329328832
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DOWNLOAD_CONTEST_PDF
        }
    )

    process populate-emp-details (
        name: Populate Logged In Employee Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P87_SUBMISSION_ID IS NULL AND :APP_USER IS NOT NULL THEN
                        :P87_EMP_NUMBER := :APP_USER;
                        :P87_STATUS := 'SUBMITTED';
                        
                        -- Fetch name, job title, project, department from xxapex_hr_emp_data
                        BEGIN
                            SELECT emp_name, emp_position_name, project, main_department,
                                   coalesce(comp_email, pay_email, egpc_email)
                              INTO :P87_EMP_NAME, :P87_JOB_TITLE, :P87_PROJECT_NAME, :P87_DEPARTMENT_NAME,
                                   :P87_EMAIL_ADDRESS
                              FROM central.xxapex_hr_emp_data
                             WHERE to_char(emp_number) = :APP_USER
                             FETCH FIRST 1 ROW ONLY;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                NULL;
                        END;
                        
                        -- Fetch mobile number from emp_contact
                        BEGIN
                            SELECT mobile
                              INTO :P87_MOBILE_NUMBER
                              FROM central.emp_contact
                             WHERE emp_id = :APP_USER
                             FETCH FIRST 1 ROW ONLY;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                NULL;
                        END;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 31974224911732233
        }
    )

