        }
    )

    dynamicAction toggle-conditional-fields (
        name: Toggle Conditional Fields
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P87_APPLICATION_DOMAIN
                P87_HAS_RISKS
                P87_PARTICIPATION_TYPE
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      apex.item("P87_APPLICATION_DOMAIN_OTHER").node.closest(".t-Form-fieldContainer").style.display =
                        $v("P87_APPLICATION_DOMAIN") === "OTHER" ? "" : "none";
                      apex.item("P87_RISK_DETAILS").node.closest(".t-Form-fieldContainer").style.display =
                        $v("P87_HAS_RISKS") === "Y" ? "" : "none";
                      apex.item("P87_TEAM_MEMBERS").node.closest(".t-Form-fieldContainer").style.display =
                        $v("P87_PARTICIPATION_TYPE") === "GROUP" ? "" : "none";
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation require-declarations (
        name: Require declarations
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: :P87_DECLARE_OWN_WORK = 'Y' AND :P87_DECLARE_CORRECT_INFO = 'Y' AND :P87_DECLARE_CONFIDENTIALITY = 'Y' AND :P87_DECLARE_COMPANY_RIGHTS = 'Y'
        }
        error {
            errorMessage: يجب الموافقة على جميع الإقرارات قبل إرسال الفكرة.
        }
    )

    validation require-other-domain (
        name: Require other domain
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P87_APPLICATION_DOMAIN <> 'OTHER' OR TRIM(:P87_APPLICATION_DOMAIN_OTHER) IS NOT NULL
        }
        error {
            errorMessage: يرجى كتابة مجال التطبيق الآخر.
        }
    )

    validation require-risk-details (
        name: Require risk details
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: :P87_HAS_RISKS <> 'Y' OR TRIM(:P87_RISK_DETAILS) IS NOT NULL
        }
        error {
            errorMessage: يرجى توضيح مخاطر التنفيذ.
        }
    )

