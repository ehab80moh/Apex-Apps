    dynamicAction set-selected-ids (
        name: set_selected_ids
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @print-report
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var ids = [];
                    
                    $("input[name='f01']:checked").each(function () {
                        ids.push($(this).val());
                    });
                    
                    $s("P88_SELECTED_IDS", ids.join(":"));
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P88_SELECTED_IDS
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action plugin-be-apexrnd-aop-da (
            action: plugin/ucApexOfficePrintAopDa
            settings {
                templateType: filenameWithPathRelativeToAopServer
                templateSource3: C:\aop_24_2\reports\eprom_innovates_submissions.docx
                dataType: plSqlFunctionReturningJson
                dataSource2: RETURN EPROM_INNOVATES_SUBMISSIONS_AOP.GET_IDEA_SUBMISSIONS_JSON(:P88_SELECTED_IDS);
                initPlSqlCode:
                    ```plsql
                    aop_api_pkg.g_output_batch_selector := 'submissions';
                    aop_api_pkg.g_output_batch_condition := ':P88_SELECTED_IDS';
                    ```
                outputType: pdfPdf
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

