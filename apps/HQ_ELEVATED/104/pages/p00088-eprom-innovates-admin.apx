page 88 (
    name: إدارة مسابقة إيبروم تبتكر
    alias: EPROM-INNOVATES-ADMIN
    title: &APP_TEXT$PORTAL_PAGE_88_TITLE.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $(document).on("click mousedown", "#select_all_rows", function(e) {
                e.stopPropagation();
            });
            
            $(document).on("change", "#select_all_rows", function() {
            
                $("input[name='f01']").prop(
                    "checked",
                    this.checked
                );
            
            });
            
            $(document).on("change", "input[name='f01']", function() {
            
                var total = $("input[name='f01']").length;
                var checked = $("input[name='f01']:checked").length;
            
                $("#select_all_rows").prop(
                    "checked",
                    total === checked
                );
            
            });
            ```
    }
    security {
        authorizationScheme: @eprom-innovates
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region submissions (
        name: submissions
        title: طلبات مسابقة إيبروم تبتكر
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_item.checkbox2(
                        p_idx        => 1,
                        p_value      => submission_id
                    ) as select_row,
                    SUBMISSION_ID,
                       EMP_NUMBER,
                       EMP_NAME,
                       JOB_TITLE,
                       PROJECT_NAME,
                       DEPARTMENT_NAME,
                       MOBILE_NUMBER,
                       EMAIL_ADDRESS,
                       decode(PARTICIPATION_TYPE, 'INDIVIDUAL', 'فردي', 'GROUP', 'جماعي', PARTICIPATION_TYPE) as PARTICIPATION_TYPE_DISPLAY,
                       TEAM_MEMBERS,
                       IDEA_TITLE,
                       APPLICATION_DOMAIN,
                       APPLICATION_DOMAIN_OTHER,
                       IDEA_DESCRIPTION,
                       PROBLEM_STATEMENT,
                       EXPECTED_RETURN,
                       ADDED_VALUE,
                       HAS_RISKS,
                       RISK_DETAILS,
                       START_REQUIREMENTS,
                       STRATEGY_ALIGNMENT,
                       STATUS,
                       CREATED_BY,
                       CREATED_AT
                  from hq_elevated.sug_idea_submissions
                 order by CREATED_AT desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 89
                items: {
                    P89_SUBMISSION_ID: \#SUBMISSION_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="View Details" class="fa fa-search" title="View Details"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: لا توجد طلبات مقدمة حالياً.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 36314213938026925
        }

