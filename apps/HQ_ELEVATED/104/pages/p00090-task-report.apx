page 90 (
    name: task_report
    alias: TASK-REPORT
    title: &APP_TEXT$TASKREPORT.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @super-duper
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region apex-task-comments (
        name: apex_task_comments
        title: &APP_TEXT$APEXTASKCOMMENTS.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from apex_task_comments
                where task_id=:P90_TASK_ID
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @single-task-search
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column APPLICATION_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$APPLICATION_ID.
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
