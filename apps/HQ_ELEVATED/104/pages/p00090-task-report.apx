    region single-task-search (
        name: single task search
        title: &APP_TEXT$SINGLE_TASK_SEARCH.
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P90_TASK_ID (
        type: textField
        label {
            label: &APP_TEXT$TASK_ID.
            alignment: left
        }
        settings {
            submitWhenEnterPressed: true
        }
        layout {
            sequence: 10
            region: @single-task-search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancel-task (
        buttonName: cancel_task
        label: &APP_TEXT$CANCEL_TASK.
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: "&{TASK_P90_TASK_ID_HAS_BEEN_CANCELLED P90_TASK_ID=&P90_TASK_ID.}."
        }
    )

    button full-task-log (
        buttonName: full_task_log
        label: &APP_TEXT$FULL_TASK_LOG.
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapBottom
            ]
            icon: fa-list-ul
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 91
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: submit
        label: &APP_TEXT$SUBMIT.
        layout {
            sequence: 10
            region: @single-task-search
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process approve (
        name: approve
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    apex_human_task.approve_task(
                        p_task_id => :P90_TASK_ID);
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 75288400857913719
        }
        serverSideCondition {
            type: never
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                            apex_session.create_session(p_app_id => 105, p_page_id => 1, p_username => '3199');  
                  apex_approval.cancel_task(p_task_id => :P90_TASK_ID);
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 33233787771096410
        }
        serverSideCondition {
            whenButtonPressed: @cancel-task
        }
    )

)
