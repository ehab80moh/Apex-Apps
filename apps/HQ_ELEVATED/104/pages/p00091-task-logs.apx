page 91 (
    name: TASK Logs
    alias: TASK-LOGS
    title: &APP_TEXT$TASK_LOGS.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region task-logs (
        name: TASK Logs
        title: &APP_TEXT$TASK_LOGS.
        type: interactiveReport
        source {
            location: localDatabase
            tableOwner: EPROMHQ
            tableName: TASK_FULL_DETAILS_LOG
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: &APP_TEXT$NO_DATA_FOUND_1.
            whenMoreDataFound: "&{MAX_ROW_COUNT_MESSAGE MAX_ROW_COUNT=#MAX_ROW_COUNT#}."
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 51849480479287099
        }

        column ACTUAL_OWNER (
            type: plainText
            heading {
                heading: &APP_TEXT$ACTUAL_OWNER.
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column APPLICATION_ID (
            type: plainText
            heading {
                heading: &APP_TEXT$APPLICATION_ID_1.
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column APPLICATION_NAME (
