    pageItem P106_EMP_PROJECT (
        type: displayOnly
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_EMPLOYEE_PROJECT.
            alignment: left
        }
        layout {
            sequence: 60
            region: @requester-card
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
