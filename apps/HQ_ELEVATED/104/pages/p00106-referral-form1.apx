                        ELSIF l_original_sqlcode = -20021 THEN
                            RAISE_APPLICATION_ERROR(
                                -20021,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_DUPLICATE_IN_PROGRESS')
