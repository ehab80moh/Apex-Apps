                        ELSIF l_original_sqlcode IN (-20056, -20057, -20058) THEN
                            RAISE_APPLICATION_ERROR(
                                -20058,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_SELECTIONS_MISMATCH')
                            );
                        ELSE
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_SUBMISSION_ERROR')
                            );
                        END IF;
                END;
