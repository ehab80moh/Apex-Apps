    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$MEDICAL_REFERRAL_CANCEL.
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @awesome-text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button submit (
        buttonName: SUBMIT
        label: &APP_TEXT$MEDICAL_REFERRAL_SUBMIT.
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @awesome-text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$MEDICAL_REFERRAL_SUBMIT_CONFIRM.
            style: warning
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction toggle-hospital-speciality (
        name: Show specialty only for hospital
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P106_REQUEST_TYPES
        }

        action native-toggle-speciality (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                        var isHospital = apex.item('P106_REQUEST_TYPES').getValue() === 'HOSPITAL';
                        var speciality = apex.item('P106_SPECIALITY_ID');
                        if (!speciality) {
                            return;
                        }
                        if (isHospital) {
                            speciality.show();
                        } else {
                            speciality.setValue('');
                            speciality.hide();
                        }
                    }());
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation hospital-speciality-required (
        name: Hospital speciality is required
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    RETURN :P106_REQUEST_TYPES <> 'HOSPITAL'
                       OR :P106_SPECIALITY_ID IS NOT NULL;
                END;
                ```
        }
        error {
            errorMessage: &APP_TEXT$MEDICAL_REFERRAL_SPECIALITY_REQUIRED.
            displayLocation: inlineWithField
            associatedItem: @P106_SPECIALITY_ID
        }
    )

    validation medical-provider-types-allowed (
        name: Medical provider type combination is allowed
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    MED.MD_REFERAL_EXT_PKG.VALIDATE_REQUEST_TYPES(:P106_REQUEST_TYPES);
                    RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: &APP_TEXT$MEDICAL_REFERRAL_PROVIDER_TYPE_COMBINATION_ERROR.
            displayLocation: inlineWithField
            associatedItem: @P106_REQUEST_TYPES
        }
    )

    process close-dialog (
        name: Close dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: &APP_TEXT$MEDICAL_REFERRAL_SUBMISSION_SUCCESS.
        }
        advanced {
            executionMappingIdentifier: 52397285322261979
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SUBMIT
        }
    )

    process initialize-requester-card (
        name: Initialize requester card
        type: formInitialization
        formRegion: @requester-card
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52397078494261978
        }
    )

    process initialize-requester-key (
        name: Initialize requester key
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P106_EMP_NUMBER := :APP_USER;
                END;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52718336707854217
        }
    )

    process submit-medical-referral (
        name: Submit medical referral
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_referal_id       NUMBER;
                    l_workflow_id      NUMBER;
                    l_approver_list    VARCHAR2(240);
                    l_duplicate_id     VARCHAR2(100);
                    l_duplicate_date   VARCHAR2(30);
                    l_original_sqlcode PLS_INTEGER;
                    l_original_sqlerrm VARCHAR2(4000);
                BEGIN
                    MED.MD_REFERAL_WF_PKG.CREATE_REQUEST(
                        P_APP_USER      => :APP_USER,
                        P_PERSON_ID     => :P106_PERSON_ID,
                        P_LETTER_DATE   => TRUNC(SYSDATE),
                        P_PROVIDER_ID   => :P106_PROVIDER_ID,
                        P_SPECIALITY_ID => CASE
                                               WHEN :P106_REQUEST_TYPES = 'HOSPITAL'
                                               THEN :P106_SPECIALITY_ID
                                               ELSE '0'
                                           END,
                        P_REQUIREMENT_ID => MED.MD_REFERAL_RULES_PKG.DEFAULT_REQUIREMENT_ID(),
                        P_ADMISSION      => NVL(:P106_ADMISSION, 'N/A'),
                        P_REFERAL_ID     => l_referal_id
                    );
                
                    IF TRIM(:P106_ADMISSION) IS NULL THEN
                        UPDATE MED.MD_REFERAL
                           SET ADMISSION = NULL
                         WHERE ID = l_referal_id;
                
                        UPDATE MED.MD_REFERAL_FLOW
                           SET ADMISSION_SNAPSHOT = NULL
                         WHERE REFERAL_ID = l_referal_id;
                    END IF;
                
                    MED.MD_REFERAL_EXT_PKG.INITIALIZE_REQUEST(
                        P_REFERAL_ID      => l_referal_id,
                        P_TYPES           => :P106_REQUEST_TYPES,
                        P_APP_USER        => :APP_USER,
                        P_TEMP_FILES_ITEM => :P106_SUPPORTING_FILES
                    );
                
                    -- CREATE_REQUEST resolves the verified employee route before creating a pending request.
                
                    l_workflow_id := APEX_WORKFLOW.START_WORKFLOW(
                        P_APPLICATION_ID => 104,
                        P_STATIC_ID      => 'GENERIC_APPROVAL_WF',
                        P_PARAMETERS     => APEX_WORKFLOW.T_WORKFLOW_PARAMETERS(
                            1 => APEX_WORKFLOW.T_WORKFLOW_PARAMETER(
                                STATIC_ID => 'P_REQUEST_ID',
                                STRING_VALUE => TO_CHAR(l_referal_id)
                            ),
                            2 => APEX_WORKFLOW.T_WORKFLOW_PARAMETER(
                                STATIC_ID => 'P_REQUEST_SOURCE',
                                STRING_VALUE => 'MED.MD_REFERAL'
                            ),
                            3 => APEX_WORKFLOW.T_WORKFLOW_PARAMETER(
                                STATIC_ID => 'P_REQUEST_TITLE',
                                STRING_VALUE => APEX_LANG.MESSAGE('MEDICAL_REFERRAL_WORKFLOW_TITLE')
                            ),
                            4 => APEX_WORKFLOW.T_WORKFLOW_PARAMETER(
                                STATIC_ID => 'P_REQUEST_TYPE_ID',
                                STRING_VALUE => '106'
                            ),
                            5 => APEX_WORKFLOW.T_WORKFLOW_PARAMETER(
                                STATIC_ID => 'P_EMP_ID',
                                STRING_VALUE => MED.MD_REFERAL_WF_PKG.REQUEST_EMP_ID(l_referal_id)
                            ),
                            6 => APEX_WORKFLOW.T_WORKFLOW_PARAMETER(
                                STATIC_ID => 'P_EMP_NAME',
                                STRING_VALUE => MED.MD_REFERAL_WF_PKG.REQUEST_EMP_NAME(l_referal_id)
                            )
                        )
                    );
                
                    MED.MD_REFERAL_WF_PKG.ATTACH_WORKFLOW(l_referal_id, l_workflow_id);
                EXCEPTION
                    WHEN OTHERS THEN
                        l_original_sqlcode := SQLCODE;
                        l_original_sqlerrm := SQLERRM;
                
                        APEX_DEBUG.ERROR(
                            'Page 106 referral submit failed. SQLCODE=' ||
                            TO_CHAR(l_original_sqlcode) ||
                            '; SQLERRM=' || SUBSTR(l_original_sqlerrm, 1, 3000) ||
                            '; BACKTRACE=' ||
                            SUBSTR(DBMS_UTILITY.FORMAT_ERROR_BACKTRACE, 1, 1000)
                        );
                
                        IF l_original_sqlcode IN (-20012, -20014, -20015) THEN
                            RAISE_APPLICATION_ERROR(
                                -20012,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_EMPLOYEE_MISSING')
                            );
                        ELSIF l_original_sqlcode = -20013 THEN
                            RAISE_APPLICATION_ERROR(
                                -20013,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_DATE_BOUNDS_ERROR')
                            );
                        ELSIF l_original_sqlcode IN (-20016, -20037) THEN
                            RAISE_APPLICATION_ERROR(
                                -20016,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_SYSTEM_CONFIGURATION_ERROR')
                            );
                        ELSIF l_original_sqlcode = -20017 THEN
                            RAISE_APPLICATION_ERROR(
                                -20017,
                                APEX_LANG.MESSAGE('MEDICAL_REFERRAL_BENEFICIARY_NOT_COVERED')
                            );
                        ELSIF l_original_sqlcode = -20018 THEN
                            RAISE_APPLICATION_ERROR(
