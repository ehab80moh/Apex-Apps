                        ELSIF l_original_sqlcode = -20022 THEN
                            l_duplicate_id := REGEXP_SUBSTR(
                                l_original_sqlerrm,
                                'Duplicate medical referral ([0-9]+) dated ([0-9]{4}-[0-9]{2}-[0-9]{2})',
                                1,
                                1,
                                NULL,
                                1
                            );
                            l_duplicate_date := REGEXP_SUBSTR(
