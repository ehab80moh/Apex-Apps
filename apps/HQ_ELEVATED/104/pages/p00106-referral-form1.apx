page 106 (
    name: &APP_TEXT$MEDICAL_REFERRAL_TITLE.
    alias: REFERRAL-FORM1
    title: &APP_TEXT$MEDICAL_REFERRAL_TITLE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            html, body, .t-Dialog-body {
                overflow: hidden !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 50
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region confirmation (
        name: &APP_TEXT$MEDICAL_REFERRAL_CONFIRMATION_TITLE.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$MEDICAL_REFERRAL_CONFIRMATION_TEXT.
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
            ]
            icon: fa-check-circle-o
        }
    )

    region request-details (
        name: تقديم طلب خطاب علاج
        title: &APP_TEXT$MEDICAL_REFERRAL_REQUEST_FORM.
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @awesome-region
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region requester-card (
        name: &APP_TEXT$MEDICAL_REFERRAL_REQUESTER_DETAILS.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.emp_name,
                       e.emp_number,
                       e.excel_pos as emp_position,
                       e.organization_name as emp_organization,
                       nvl(e.project, e.fin_project) as emp_project
                  from central.xxapex_hr_emp_data e
                 where upper(trim(e.emp_number)) = upper(trim(:APP_USER))
                ```
            pageItemsToSubmit: APP_USER
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent14
                t-Region--noBorder
                t-Region--scrollBody
            ]
            icon: fa-user
        }
        advanced {
            customAttributes: style="display:none;"
        }
    )

    region validity-feedback (
        name: &APP_TEXT$MEDICAL_REFERRAL_AVAILABLE_FROM.
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
            ]
        }
    )

