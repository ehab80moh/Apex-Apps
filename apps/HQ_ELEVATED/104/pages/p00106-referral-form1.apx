        }
    )

    pageItem P106_LETTER_DATE (
        type: displayOnly
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_LETTER_DATE.
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @request-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: SYSDATE
        }
        help {
            helpText: &APP_TEXT$MEDICAL_REFERRAL_DATE_BOUNDS_HELP.
        }
    )

    pageItem P106_PERSON_ID (
        type: selectList
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_BENEFICIARY.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from (
                        select apex_lang.message('MEDICAL_REFERRAL_BENEFICIARY_EMPLOYEE', e.emp_name) as display_value,
                               0 as return_value,
                               0 as sort_order
                          from central.xxapex_hr_emp_data e
                         where upper(trim(e.emp_number)) = upper(trim(:APP_USER))
                        union all
                        select r.relative_name || ' - ' || r.relative_type as display_value,
                               r.relative_person_id as return_value,
                               1 as sort_order
                          from med.emp_relative_new r
                         where upper(trim(r.employee_number)) = upper(trim(:APP_USER))
                           and nvl(r.insured, 'N') = 'Y'
                       )
                 order by sort_order, display_value
                ```
        }
        layout {
            sequence: 10
            region: @request-details
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P106_PROVIDER_ID (
        type: selectList
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_PROVIDER.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.provider_name as display_value,
                       p.provider_id as return_value
                  from med.md_healthcare_provider p
                 where p.provider_origin = 'LOCAL_CONTRACT'
                   and p.active_yn = 'Y'
                   and p.contract_start_date is not null
                   and trunc(p.contract_start_date) <= trunc(sysdate)
                   and (p.contract_end_date is null
                        or trunc(p.contract_end_date) >= trunc(sysdate))
                   and p.provider_type <> 'PHARMACY'
                   and p.provider_type in (
                           select trim(column_value)
                             from table(apex_string.split(:P106_REQUEST_TYPES, ':'))
                       )
                   and (
                           instr(':' || :P106_REQUEST_TYPES || ':', ':RADIOLOGY_CENTER:') = 0
                           or instr(':' || :P106_REQUEST_TYPES || ':', ':LAB:') = 0
                           or p.provider_type = 'RADIOLOGY_CENTER'
                       )
                   and med.md_referal_wf_pkg.provider_is_available(
                           p.provider_id,
                           trunc(sysdate)
                       ) = 'Y'
                 order by p.provider_name
                ```
        }
        cascadingLov {
            parentItems: P106_REQUEST_TYPES
            itemsToSubmit: P106_REQUEST_TYPES
        }
        layout {
            sequence: 40
            region: @request-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P106_REQUEST_TYPES (
        type: selectList
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_PROVIDER_TYPE.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_LAB') as display_value, 'LAB' as return_value from dual
                union all
                select apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_DENTAL_CLINIC'), 'DENTAL_CLINIC' from dual
                union all
                select apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_HOSPITAL'), 'HOSPITAL' from dual
                union all
                select apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_PHYSIOTHERAPY'), 'PHYSIOTHERAPY' from dual
                union all
                select apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_RADIOLOGY_CENTER'), 'RADIOLOGY_CENTER' from dual
                union all
                select apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_OPHTHALMOLOGY'), 'OPHTHALMOLOGY' from dual
                 order by display_value
                ```
        }
        layout {
            sequence: 30
            region: @request-details
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P106_REQUIREMENT_ID (
        type: displayOnly
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_REQUIREMENT.
            alignment: left
