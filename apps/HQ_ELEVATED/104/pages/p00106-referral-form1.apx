    pageItem P106_SPECIALITY_ID (
        type: selectList
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_SPECIALITY.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(name) as display_value,
                       min(id) as return_value
                  from med.md_speciality
                 where trim(name) is not null
                 group by trim(name)
                 order by trim(name)
                ```
            nullDisplayValue: &APP_TEXT$PLEASE_SELECT.
        }
        layout {
            sequence: 50
            region: @request-details
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P106_SUPPORTING_FILES (
