            .p107-email-cancel {
              min-height: 2.85rem;
              border-radius: .65rem;
            }
            
            .p107-dialog__actions {
              display: flex;
              flex-wrap: wrap;
              gap: .5rem;
              justify-content: flex-start;
              margin: 0;
              padding: 0;
            }
            
            .p107-share-url-row {
              display: flex;
              gap: .5rem;
              align-items: stretch;
            }
            
            .p107-share-url-row input {
              flex: 1;
              direction: ltr;
              text-align: left;
            }
            
            @media (max-width: 640px) {
              .p107-actions {
                min-width: 0;
              }
            
              .p107-action {
                flex: 1 1 calc(50% - .35rem);
              }
            
              .p107-action--cancel {
                margin-inline-start: 0;
              }
            
              #p107-email-dialog {
                width: calc(100vw - 1rem);
                max-height: calc(100vh - 1rem);
                border-radius: .85rem;
              }
            
              #p107-email-dialog .p107-dialog__form {
                max-height: calc(100vh - 1rem);
              }
            
              .p107-email-dialog__hero,
              .p107-email-dialog__body,
              .p107-email-dialog__footer {
                padding-inline: 1rem;
              }
            
              .p107-email-dialog__hero {
                align-items: flex-start;
                padding-block: 1rem;
              }
            
              .p107-email-dialog__icon {
                flex-basis: 2.6rem;
                width: 2.6rem;
                height: 2.6rem;
              }
            
              .p107-email-dialog__hero h2 {
                font-size: 1.15rem;
              }
            
              .p107-email-link-card {
                align-items: stretch;
                flex-direction: column;
              }
            
              .p107-email-link-card__actions .t-Button {
                flex: 1 1 50%;
              }
            
              .p107-email-dialog__footer {
                flex-direction: column-reverse;
              }
            
              #p107-email-open-client,
              .p107-email-cancel {
                width: 100%;
              }
            
              .p107-prescription-dialog__footer {
                flex-direction: column-reverse;
              }
            
              .p107-prescription-dialog__footer .t-Button {
                width: 100%;
              }
            }
            #p107-sms-dialog {width:min(520px,calc(100vw - 32px));padding:0;border:1px solid #dbe3ec;border-radius:16px;box-shadow:0 16px 48px #0003;color:inherit;}
            #p107-sms-dialog::backdrop {background:#10233780;}
            #p107-sms-dialog .p107-email-dialog__body {padding:22px;display:grid;gap:12px;}
            #p107-sms-mobile {width:100%;box-sizing:border-box;padding:12px;border:1px solid #bac8d7;border-radius:8px;font-size:16px;}
            #p107-sms-error {color:#b42318;margin:0;}
            .p107-action--sms {background:#f2f7ff;border-color:#b7d0ee;}
            ```
