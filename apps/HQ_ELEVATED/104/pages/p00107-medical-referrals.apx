            ```javascript-browser
            function p107EmailPattern(value) {
              return /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$/.test(value);
            }
            
            function p107DecodeHtmlEntities(value) {
              const decoder = document.createElement('textarea');
              let decoded = String(value || '');
            
              for (let pass = 0; pass < 2; pass += 1) {
                decoder.innerHTML = decoded;
            
                if (decoder.value === decoded) {
                  break;
                }
            
                decoded = decoder.value;
              }
            
              return decoded;
            }
            
            function p107DownloadUrl(referalId) {
              return apex.server.url({
                p_request: 'DOWNLOAD_MEDICAL_REFERRAL',
                x01: referalId
              });
            }
            
            function p107EmailDraftUrl(referalId, recipient) {
            
              apex.item('P107_REFERAL_ID').setValue(referalId);
              apex.item('P107_EMAIL_RECIPIENT').setValue(recipient);
            
              return apex.server.url({
                p_request: 'DOWNLOAD_MEDICAL_EMAIL_DRAFT',
                pageItems: '#P107_REFERAL_ID,#P107_EMAIL_RECIPIENT,#P107_EMAIL_URL'
              });
            }
            
            function p107CancelMedicalReferral(referalId) {
            
              if (
                !window.confirm(
                  apex.lang.getMessage('MEDICAL_REFERRAL_CANCEL_CONFIRMATION')
                )
              ) {
                return false;
              }
            
              apex.server.process(
                'CANCEL_MEDICAL_REFERRAL',
                {
                  x01: referalId
                },
                {
                  dataType: 'text',
            
                  success: function () {
                    window.location.reload();
                  },
            
                  error: function () {
                    apex.message.alert(
                      apex.lang.getMessage('P107_ACTION_ERROR')
                    );
                  }
                }
              );
            
              return false;
            }
            
            function p107OpenShareDialog() {
            
              const dialog = document.getElementById('p107-share-dialog');
              const urlInput = document.getElementById('p107-share-url');
            
              const publicUrl =
                apex.item('P107_PUBLIC_URL').getValue();
            
              if (!dialog || !urlInput || !publicUrl) {
                return;
              }
            
              urlInput.value = publicUrl;
            
              dialog.showModal();
            }
            
            function p107ShareViaWhatsApp() {
            
              const publicUrl =
                apex.item('P107_PUBLIC_URL').getValue();
            
              const message =
                apex.lang.getMessage('MEDICAL_REFERRAL_SHARE');
            
              if (!publicUrl) {
                return;
              }
            
              window.open(
                'https://wa.me/?text=' +
                  encodeURIComponent(
                    message + ' ' + publicUrl
                  ),
                '_blank',
                'noopener,noreferrer'
              );
            }
            
            async function p107ShareMedicalReferral() {
            
              const publicUrl =
                apex.item('P107_PUBLIC_URL').getValue();
            
              const referalId =
                apex.item('P107_REFERAL_ID').getValue();
            
              const downloadUrl =
                p107DownloadUrl(referalId);
            
              const message =
                apex.lang.getMessage('MEDICAL_REFERRAL_SHARE');
            
              if (!publicUrl) {
                return;
              }
            
              if (
                navigator.share &&
                window.File &&
                downloadUrl
              ) {
                try {
            
                  const response = await fetch(
                    downloadUrl,
                    {
                      credentials: 'same-origin'
                    }
                  );
            
                  const contentType =
                    (
                      response.headers.get('Content-Type') || ''
                    ).toLowerCase();
            
                  if (
                    response.ok &&
                    contentType.indexOf('application/pdf') === 0
                  ) {
            
                    const blob =
                      await response.blob();
            
                    const file =
                      new File(
                        [blob],
                        'medical-referral.pdf',
                        {
                          type: 'application/pdf'
                        }
                      );
            
                    if (
                      !navigator.canShare ||
                      navigator.canShare({
                        files: [file]
                      })
                    ) {
            
                      await navigator.share({
                        title: message,
                        text: message,
                        url: publicUrl,
                        files: [file]
                      });
            
                      return;
                    }
                  }
            
                } catch (error) {
            
                  if (
                    error &&
                    error.name === 'AbortError'
                  ) {
                    return;
                  }
                }
              }
            
              p107ShareViaWhatsApp();
            }
            
            function p107OpenEmailDialog() {
            
              const dialog =
                document.getElementById(
                  'p107-email-dialog'
                );
            
              const recipient =
                document.getElementById(
                  'p107-email-recipient'
                );
            
              if (!dialog || !recipient) {
                return;
              }
            
              recipient.value =
                apex
                  .item('P107_EMAIL_RECIPIENT')
                  .getValue() || '';
            
              p107SetEmailDialogContext();
              p107RefreshEmailPreview();
            
              dialog.showModal();
            
              window.requestAnimationFrame(
                function () {
                  recipient.focus();
                }
              );
            }
            
            function p107RefreshEmailPreview() {
            
              const recipientElement =
                document.getElementById(
                  'p107-email-recipient'
                );
            
              if (!recipientElement) {
                return;
              }
            
              const recipient =
                recipientElement.value.trim();
            
              const emailUrl =
                p107DecodeHtmlEntities(
                  apex
                    .item('P107_EMAIL_URL')
                    .getValue()
                );
            
              const previewRecipient =
                document.getElementById(
                  'p107-email-preview-recipient'
                );
            
              const previewBody =
                document.getElementById(
                  'p107-email-preview-body'
                );
            
              const previewLink =
                document.getElementById(
                  'p107-email-preview-link'
                );
            
              if (previewRecipient) {
                previewRecipient.textContent =
                  recipient || '—';
              }
            
              if (previewBody) {
                previewBody.textContent =
                  p107EmailDocumentType() === 'PRESCRIPTION'
                    ? apex.lang.getMessage(
                        'MEDICAL_REFERRAL_EMAIL_PREVIEW_BODY'
                      )
                    : apex.lang.getMessage(
                        'MEDICAL_REFERRAL_EMAIL_PREVIEW_BODY'
                      );
              }
            
              if (previewLink) {
            
                previewLink.href =
                  emailUrl || '#';
            
                previewLink.setAttribute(
                  'aria-disabled',
                  emailUrl ? 'false' : 'true'
                );
              }
            }
            
            async function p107CopyEmailLink() {
            
              const emailUrl =
                p107DecodeHtmlEntities(
                  apex
                    .item('P107_EMAIL_URL')
                    .getValue()
                );
            
              const copyButton =
                document.getElementById(
                  'p107-email-copy-link'
                );
            
              const copyLabel =
                copyButton
                  ? copyButton.querySelector(
                      '.t-Button-label'
                    )
                  : null;
            
              if (
                !emailUrl ||
                !copyButton ||
                !copyLabel
              ) {
            
                apex.message.alert(
                  apex.lang.getMessage(
                    'P107_ACTION_ERROR'
                  )
                );
            
                return;
              }
            
              let copied = false;
            
              try {
            
                if (
                  navigator.clipboard &&
                  window.isSecureContext
                ) {
            
                  await navigator.clipboard.writeText(
                    emailUrl
                  );
            
                  copied = true;
                }
            
              } catch (ignore) {
            
                copied = false;
              }
            
              if (!copied) {
            
                const temporaryField =
                  document.createElement(
                    'textarea'
                  );
            
                temporaryField.value =
                  emailUrl;
            
                temporaryField.setAttribute(
                  'readonly',
                  ''
                );
            
                temporaryField.className =
                  'u-VisuallyHidden';
            
                document.body.appendChild(
                  temporaryField
                );
            
                temporaryField.select();
            
                copied =
                  document.execCommand('copy');
            
                temporaryField.remove();
              }
            
              if (copied) {
            
                const originalLabel =
                  copyLabel.textContent;
            
                copyButton.classList.add(
                  'is-copied'
                );
            
                copyLabel.textContent =
                  apex.lang.getMessage(
                    'MEDICAL_REFERRAL_PERSONAL_EMAIL_COPIED'
                  );
            
                window.setTimeout(
                  function () {
            
                    copyButton.classList.remove(
                      'is-copied'
                    );
            
                    copyLabel.textContent =
                      originalLabel;
            
                  },
                  1800
                );
              }
            }
            function p107PrescriptionActionError() {
              apex.message.alert(
                apex.lang.getMessage('P107_PRESCRIPTION_ACTION_ERROR')
              );
            }
            
            function p107OpenPrescriptionEmail(requestId) {
              const dialog = document.getElementById('p107-prescription-email-dialog');
              const recipient = document.getElementById('p107-prescription-email-recipient');
            
              if (!dialog || !recipient || !requestId) {
                return false;
              }
            
              dialog.dataset.requestId = String(requestId);
              recipient.value = '';
              recipient.setCustomValidity('');
              dialog.showModal();
            
              window.requestAnimationFrame(function () {
                recipient.focus();
              });
            
              return false;
            }
            
            function p107SendPrescriptionEmail() {
              const dialog = document.getElementById('p107-prescription-email-dialog');
              const recipient = document.getElementById('p107-prescription-email-recipient');
              const requestId = dialog ? dialog.dataset.requestId : '';
              const value = recipient ? recipient.value.trim() : '';
            
              if (!dialog || !recipient || !requestId || !p107EmailPattern(value)) {
                if (recipient) {
                  recipient.setCustomValidity(
                    apex.lang.getMessage('MEDICAL_REFERRAL_EMAIL_INVALID')
                  );
                  recipient.reportValidity();
                  recipient.focus();
                }
                return false;
              }
            
              recipient.setCustomValidity('');
              apex.server.process(
                'LEGACY_SEND_PRESCRIPTION_EMAIL',
                { x01: requestId, x02: value },
                {
                  dataType: 'json',
                  success: function (data) {
                    if (!data || data.success !== true) {
                      p107PrescriptionActionError();
                      return;
                    }
            
                    dialog.close();
                    apex.message.showPageSuccess(
                      apex.lang.getMessage('P107_PRESCRIPTION_EMAIL_SENT')
                    );
                  },
                  error: p107PrescriptionActionError
                }
              );
            
              return false;
            }
            
            /* Shared email-dialog context for both medical referrals and prescriptions. */
            function p107EmailDocumentType() {
              return apex.item('P107_EMAIL_DOCUMENT_TYPE').getValue() || 'MEDICAL_REFERRAL';
            }
            
            function p107SetEmailDialogContext() {
              const isPrescription = p107EmailDocumentType() === 'PRESCRIPTION';
              const title = document.getElementById('p107-email-title');
              const help = document.querySelector('#p107-email-dialog .p107-email-dialog__hero p');
              const secureTitle = document.getElementById('p107-email-secure-title');
              const secureHelp = document.querySelector('#p107-email-dialog .p107-email-link-card__status p');
              const previewTitle = document.getElementById('p107-email-preview-title');
              const openClient = document.querySelector('#p107-email-open-client .t-Button-label');
            
              if (isPrescription) {
                if (title) title.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_PRESCRIPTION_TITLE');
                if (help) help.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_PRESCRIPTION_DESCRIPTION');
                if (secureTitle) secureTitle.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_PRESCRIPTION_LINK_READY');
                if (secureHelp) secureHelp.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_PRESCRIPTION_LINK_HELP');
                if (previewTitle) previewTitle.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_PRESCRIPTION_PREVIEW');
                if (openClient) openClient.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_OPEN_DRAFT');
              } else {
                if (secureTitle) secureTitle.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_MEDICAL_LINK_READY');
                if (secureHelp) secureHelp.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_MEDICAL_LINK_HELP');
                if (previewTitle) previewTitle.textContent = apex.lang.getMessage('P107_EMAIL_DIALOG_MEDICAL_PREVIEW');
              }
            }
            /* Later function declaration intentionally replaces the legacy simple prescription dialog. */
            function p107OpenPrescriptionEmail(requestId) {
              if (!requestId) {
                return false;
              }
            
              apex.server.process(
                'PREPARE_PRESCRIPTION_EMAIL_DIALOG',
                { x01: requestId },
                {
                  dataType: 'json',
                  success: function (data) {
                    const url = data && data.url ? p107DecodeHtmlEntities(data.url) : '';
                    if (!url) {
                      p107PrescriptionActionError();
                      return;
                    }
            
                    apex.item('P107_EMAIL_DOCUMENT_TYPE').setValue('PRESCRIPTION');
                    apex.item('P107_PRESCRIPTION_ID').setValue(String(requestId));
                    apex.item('P107_EMAIL_URL').setValue(url);
                    apex.item('P107_EMAIL_RECIPIENT').setValue(data.recipient || '');
                    p107OpenEmailDialog();
                  },
                  error: p107PrescriptionActionError
                }
              );
            
              return false;
            }
            
            function p107OpenPrescriptionShare(requestId) {
              const dialog = document.getElementById('p107-prescription-share-dialog');
              const urlInput = document.getElementById('p107-prescription-share-url');
            
              if (!dialog || !urlInput || !requestId) {
                return false;
              }
            
              urlInput.value = '';
              dialog.dataset.requestId = String(requestId);
              apex.server.process(
                'PREPARE_PRESCRIPTION_SHARE',
                { x01: requestId },
                {
                  dataType: 'json',
                  success: function (data) {
                    const url = data && data.url ? p107DecodeHtmlEntities(data.url) : '';
            
                    if (!url) {
                      p107PrescriptionActionError();
                      return;
                    }
            
                    urlInput.value = url;
                    dialog.showModal();
                  },
                  error: p107PrescriptionActionError
                }
              );
            
              return false;
            }
            
            async function p107SharePrescriptionUrl() {
              const urlInput = document.getElementById('p107-prescription-share-url');
              const url = urlInput ? urlInput.value : '';
            
              if (!url) {
                p107PrescriptionActionError();
                return;
              }
            
              if (navigator.share) {
                try {
                  await navigator.share({
                    title: apex.lang.getMessage('P107_PRESCRIPTION_SHARE_TITLE'),
                    text: apex.lang.getMessage('P107_PRESCRIPTION_SHARE_LINK_TEXT'),
                    url: url
                  });
                  return;
                } catch (error) {
                  if (error && error.name === 'AbortError') {
                    return;
                  }
                }
              }
            
              try {
                await navigator.clipboard.writeText(url);
                apex.message.showPageSuccess(
                  apex.lang.getMessage('MEDICAL_REFERRAL_PERSONAL_EMAIL_COPIED')
                );
              } catch (ignore) {
                urlInput.focus();
                urlInput.select();
                document.execCommand('copy');
              }
            }
            
            async function p107CopyPrescriptionShareUrl() {
              const urlInput = document.getElementById('p107-prescription-share-url');
            
              if (!urlInput || !urlInput.value) {
                p107PrescriptionActionError();
                return;
              }
            
              try {
                await navigator.clipboard.writeText(urlInput.value);
                apex.message.showPageSuccess(
                  apex.lang.getMessage('MEDICAL_REFERRAL_PERSONAL_EMAIL_COPIED')
                );
              } catch (ignore) {
                urlInput.focus();
                urlInput.select();
                document.execCommand('copy');
              }
            }
            function p107SmsText(key) {
              var ar = /^ar/i.test(document.documentElement.lang || '');
              var text = {
                title: ['Send PDF link by SMS', '\u0625\u0631\u0633\u0627\u0644 \u0631\u0627\u0628\u0637 PDF \u0628\u0631\u0633\u0627\u0644\u0629 SMS'],
                mobile: ['Recipient mobile number', '\u0631\u0642\u0645 \u0645\u0648\u0628\u0627\u064a\u0644 \u0627\u0644\u0645\u0633\u062a\u0644\u0645'],
                help: ['The recipient can verify and download the approved PDF. You may change the mobile number before sending.', '\u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0645\u0633\u062a\u0644\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u0646\u062f \u0627\u0644\u0645\u0639\u062a\u0645\u062f \u0648\u062a\u0646\u0632\u064a\u0644\u0647. \u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u0628\u0627\u064a\u0644 \u0642\u0628\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644.'],
                send: ['Send SMS', '\u0625\u0631\u0633\u0627\u0644 SMS'],
                cancel: ['Cancel', '\u0625\u0644\u063a\u0627\u0621'],
                invalid: ['Enter a valid Egyptian mobile number.', '\u0627\u0643\u062a\u0628 \u0631\u0642\u0645 \u0645\u0648\u0628\u0627\u064a\u0644 \u0645\u0635\u0631\u064a \u0635\u062d\u064a\u062d.'],
                error: ['SMS could not be sent. Check the number and document validity, then try again.', '\u062a\u0639\u0630\u0631 \u0625\u0631\u0633\u0627\u0644 SMS. \u0631\u0627\u062c\u0639 \u0627\u0644\u0631\u0642\u0645 \u0648\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u060c \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.'],
                gateway: ['The SMS service is unavailable or did not accept the message. Please try again later.', '\u062e\u062f\u0645\u0629 SMS \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629 \u0623\u0648 \u0644\u0645 \u062a\u0642\u0628\u0644 \u0627\u0644\u0631\u0633\u0627\u0644\u0629. \u062d\u0627\u0648\u0644 \u0644\u0627\u062d\u0642\u064b\u0627.'],
                success: ['SMS accepted for delivery to ', '\u062a\u0645 \u0642\u0628\u0648\u0644 \u0631\u0633\u0627\u0644\u0629 SMS \u0644\u0644\u0625\u0631\u0633\u0627\u0644 \u0625\u0644\u0649 ']
              };
              return (text[key] || [key, key])[ar ? 1 : 0];
            }
            function p107OpenSms(kind, id) {
              apex.server.process('PREPARE_DOCUMENT_SMS', {x01: kind, x02: id}, {
                dataType: 'json', success: function(data) {
                  var dialog = document.getElementById('p107-sms-dialog');
                  if (!data.success || !dialog) { apex.message.alert(p107SmsText('error')); return; }
                  dialog.dataset.documentKind = kind;
                  dialog.dataset.documentId = id;
                  dialog.querySelectorAll('[data-sms-label]').forEach(function(el) { el.textContent = p107SmsText(el.dataset.smsLabel); });
                  document.getElementById('p107-sms-mobile').value = data.mobile || '';
                  document.getElementById('p107-sms-error').textContent = '';
                  document.getElementById('p107-sms-send').disabled = false;
                  dialog.showModal();
                  document.getElementById('p107-sms-mobile').focus();
                }, error: function() { apex.message.alert(p107SmsText('error')); }
              });
            }
            function p107SendSms() {
              var dialog = document.getElementById('p107-sms-dialog');
              var input = document.getElementById('p107-sms-mobile');
              var error = document.getElementById('p107-sms-error');
              var mobile = input.value.trim().replace(/[+ ()-]/g, '');
              if (/^20\d{10}$/.test(mobile)) { mobile = '0' + mobile.slice(2); }
              if (!/^01[0125]\d{8}$/.test(mobile)) { error.textContent = p107SmsText('invalid'); input.focus(); return; }
              var send = document.getElementById('p107-sms-send');
              if (send.disabled) { return; }
              send.disabled = true;
              error.textContent = '';
              apex.server.process('SEND_DOCUMENT_SMS', {x01: dialog.dataset.documentKind, x02: dialog.dataset.documentId, x03: mobile}, {
                dataType: 'json', success: function(data) {
                  send.disabled = false;
                  if (!data.success) { error.textContent = p107SmsText(data.errorCode === 'GATEWAY_UNAVAILABLE' ? 'gateway' : 'error'); return; }
                  dialog.close();
                  apex.message.showPageSuccess(p107SmsText('success') + data.mobile);
                }, error: function() { send.disabled = false; error.textContent = p107SmsText('error'); }
              });
            }
