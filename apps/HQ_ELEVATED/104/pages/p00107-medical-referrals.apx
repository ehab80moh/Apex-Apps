                  const dialog = document.getElementById('p107-email-dialog');
                  if (dialog) {
                    dialog.close();
                  }
                }
              );
            }
            
            if (p107EmailRecipient) {
            
              p107EmailRecipient.addEventListener(
                'input',
                p107RefreshEmailPreview
              );
            
              p107EmailRecipient.addEventListener(
                'input',
                function () {
                  this.setCustomValidity('');
                }
              );
            }
            
            const p107EmailCopyLink =
              document.getElementById(
                'p107-email-copy-link'
              );
            
            if (p107EmailCopyLink) {
            
              p107EmailCopyLink.addEventListener(
                'click',
                p107CopyEmailLink
              );
            }
            
            const p107NativeShare =
              document.getElementById(
                'p107-share-native'
              );
            
            if (p107NativeShare) {
            
              p107NativeShare.addEventListener(
                'click',
                p107ShareMedicalReferral
              );
            }
            
            const p107WhatsAppShare =
              document.getElementById(
                'p107-share-whatsapp'
              );
            
            if (p107WhatsAppShare) {
            
              p107WhatsAppShare.addEventListener(
                'click',
                p107ShareViaWhatsApp
              );
            }
            
            const p107CopyShare =
              document.getElementById(
                'p107-share-copy'
              );
            
            if (p107CopyShare) {
            
              p107CopyShare.addEventListener(
                'click',
                async function () {
            
                  const urlInput =
                    document.getElementById(
                      'p107-share-url'
                    );
            
                  if (!urlInput) {
                    return;
                  }
            
                  try {
            
                    await navigator.clipboard.writeText(
                      urlInput.value
                    );
            
                    apex.message.showPageSuccess(
                      apex.lang.getMessage(
                        'MEDICAL_REFERRAL_PERSONAL_EMAIL_COPIED'
                      )
                    );
            
                  } catch (ignore) {
            
                    urlInput.focus();
            
                    urlInput.select();
            
                    document.execCommand(
                      'copy'
                    );
                  }
                }
              );
            }
            
            const p107PrescriptionEmailSend =
              document.getElementById('p107-prescription-email-send');
            
            if (p107PrescriptionEmailSend) {
              p107PrescriptionEmailSend.addEventListener(
                'click',
                p107SendPrescriptionEmail
              );
            }
            
            const p107PrescriptionShareCopy =
              document.getElementById('p107-prescription-share-copy');
            
            if (p107PrescriptionShareCopy) {
              p107PrescriptionShareCopy.addEventListener(
                'click',
                p107CopyPrescriptionShareUrl
              );
            }
            
            const p107PrescriptionShareNative =
              document.getElementById('p107-prescription-share-native');
            
            if (p107PrescriptionShareNative) {
              p107PrescriptionShareNative.addEventListener(
                'click',
                p107SharePrescriptionUrl
              );
            }
            
            document.addEventListener('click', function (event) {
              const emailLink = event.target && event.target.closest
                ? event.target.closest('.p107-prescription-email-action')
                : null;
              const shareLink = event.target && event.target.closest
                ? event.target.closest('.p107-prescription-share-action')
                : null;
            
              if (emailLink) {
                event.preventDefault();
                p107OpenPrescriptionEmail(emailLink.dataset.prescriptionId);
              } else if (shareLink) {
                event.preventDefault();
                p107OpenPrescriptionShare(shareLink.dataset.prescriptionId);
              }
            });
            document.addEventListener('click', function(event) {
              var action = event.target.closest('.p107-sms-action');
              if (action) {
                event.preventDefault();
                p107OpenSms(action.dataset.documentKind, action.dataset.documentId);
              }
            });
            document.getElementById('p107-sms-send').addEventListener('click', p107SendSms);
            document.getElementById('p107-sms-cancel').addEventListener('click', function() {
              if (!document.getElementById('p107-sms-send').disabled) { document.getElementById('p107-sms-dialog').close(); }
            });
            document.getElementById('p107-sms-dialog').addEventListener('cancel', function(event) {
              if (document.getElementById('p107-sms-send').disabled) { event.preventDefault(); }
            });
            ```
    }
