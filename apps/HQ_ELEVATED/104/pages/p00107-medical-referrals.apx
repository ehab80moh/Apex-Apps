    process download-prescription-email-draft (
        name: DOWNLOAD_PRESCRIPTION_EMAIL_DRAFT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_request_id NUMBER := TO_NUMBER(NVL(APEX_APPLICATION.G_X01, :P107_PRESCRIPTION_ID));
                    l_recipient VARCHAR2(500) := TRIM(NVL(APEX_APPLICATION.G_X02, :P107_EMAIL_RECIPIENT));
                    l_public_url VARCHAR2(4000) := TRIM(:P107_EMAIL_URL);
                    l_subject VARCHAR2(1000);
                    l_body_text VARCHAR2(4000);
                    l_request_no VARCHAR2(100);
                BEGIN
                    IF l_request_id IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20302, APEX_LANG.MESSAGE('P107_PRESCRIPTION_REQUEST_NOT_IDENTIFIED'));
                    END IF;
                
                    IF l_public_url IS NULL THEN
                        med.md_pres_document_pkg.create_share_url(
                            p_request_id => l_request_id,
                            p_app_user => :APP_USER,
                            p_public_url => l_public_url
                        );
                    END IF;
                
                    SELECT request_no
                      INTO l_request_no
                      FROM med.md_pres_request
                     WHERE request_id = l_request_id;
                
                    l_subject := 'EPROM - Prescription ' || l_request_no;
                    l_body_text :=
                        'Please find attached the approved EPROM prescription.' || CHR(10) ||
                        'Open the secure verification link: ' || l_public_url;
                
                    med.md_pres_document_pkg.download_employee_email_draft(
                        p_request_id => l_request_id,
                        p_app_user => :APP_USER,
                        p_recipient => l_recipient,
                        p_public_url => l_public_url,
                        p_subject => l_subject,
                        p_body_text => l_body_text
                    );
                END;
                ```
        }
        execution {
            sequence: 75
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 65386952471397899
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DOWNLOAD_PRESCRIPTION_EMAIL_DRAFT
        }
    )

    process prepare-document-sms (
        name: PREPARE_DOCUMENT_SMS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_kind VARCHAR2(20) := UPPER(TRIM(APEX_APPLICATION.G_X01));
                    l_id NUMBER := TO_NUMBER(APEX_APPLICATION.G_X02);
                    l_owner VARCHAR2(128);
                    l_mobile VARCHAR2(99);
                    l_count NUMBER;
                BEGIN
                    IF l_kind = 'REFERRAL' THEN
                        SELECT emp_id_snapshot INTO l_owner FROM med.md_referal_flow WHERE referal_id=l_id;
                        IF med.md_referal_wf_pkg.employee_document_allowed(l_id,:APP_USER)<>'Y' THEN
                            RAISE_APPLICATION_ERROR(-20490,'This medical document is not available for SMS sharing.');
                        END IF;
                    ELSIF l_kind = 'PRESCRIPTION' THEN
                        SELECT employee_number INTO l_owner FROM med.md_pres_request WHERE request_id=l_id AND status IN ('APPROVED','PARTIALLY_APPROVED');
                        SELECT COUNT(*) INTO l_count FROM med.md_pres_document
                         WHERE request_id=l_id AND token_status='ACTIVE' AND pdf_blob IS NOT NULL;
                        IF l_count=0 THEN RAISE_APPLICATION_ERROR(-20490,'The approved PDF is unavailable.');END IF;
                    ELSE
