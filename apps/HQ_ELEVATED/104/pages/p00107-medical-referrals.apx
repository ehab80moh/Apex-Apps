    region email-dialog (
        name: &APP_TEXT$MEDICAL_REFERRAL_EMAIL.
        type: staticContent
        source {
            htmlCode:
                ```html
                <dialog id="p107-email-dialog" aria-labelledby="p107-email-title">
                  <form method="dialog" class="p107-dialog__form">
                    <header class="p107-email-dialog__hero">
                      <span class="p107-email-dialog__icon fa fa-envelope" aria-hidden="true"></span>
                      <div>
                        <h2 id="p107-email-title">&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_TITLE.</h2>
                        <p>&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_HELP.</p>
                      </div>
                    </header>
                    <div class="p107-email-dialog__body p107-email-preview">
                      <section class="p107-email-field-card">
                        <div class="p107-email-field-card__heading">
                          <span class="p107-email-step" aria-hidden="true">1</span>
                          <label for="p107-email-recipient">&APP_TEXT$MEDICAL_REFERRAL_EMAIL_RECIPIENT.</label>
                        </div>
                        <input id="p107-email-recipient" type="email" maxlength="500" autocomplete="email" inputmode="email" placeholder="name@example.com" required>
                        <span class="p107-email-field-card__hint">&APP_TEXT$MEDICAL_REFERRAL_EMAIL_HELP.</span>
                      </section>
                      <section class="p107-email-link-card" aria-labelledby="p107-email-secure-title">
                        <div class="p107-email-link-card__status">
                          <span class="p107-email-link-card__icon fa fa-shield" aria-hidden="true"></span>
                          <div>
                            <h3 id="p107-email-secure-title">&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_SECURE_READY.</h3>
                            <p>&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_SECURE_HELP.</p>
                          </div>
                        </div>
                        <div class="p107-email-link-card__actions">
                          <a id="p107-email-preview-link" class="t-Button t-Button--small p107-email-preview__link" href="#" target="_blank" rel="noopener noreferrer"><span class="t-Icon t-Icon--left fa fa-external-link" aria-hidden="true"></span><span class="t-Button-label">&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_OPEN_LINK.</span></a>
                          <button id="p107-email-copy-link" class="t-Button t-Button--small" type="button"><span class="t-Icon t-Icon--left fa fa-copy" aria-hidden="true"></span><span class="t-Button-label">&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_COPY_LINK.</span></button>
                        </div>
                      </section>
                      <section class="p107-email-message-card" aria-live="polite" aria-labelledby="p107-email-preview-title">
                        <div class="p107-email-message-card__heading">
                          <span class="fa fa-comment-o" aria-hidden="true"></span>
                          <h3 id="p107-email-preview-title">&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_PREVIEW.</h3>
                        </div>
                        <div class="p107-email-message-card__recipient"><span>&APP_TEXT$MEDICAL_REFERRAL_EMAIL_RECIPIENT.:</span><strong id="p107-email-preview-recipient">—</strong></div>
                        <p id="p107-email-preview-body">—</p>
                      </section>
                    </div>
                    <footer class="p107-email-dialog__footer">
                      <button class="t-Button p107-email-cancel" type="button">&APP_TEXT$MEDICAL_REFERRAL_CANCEL.</button>
                      <button class="t-Button t-Button--hot" type="button" id="p107-email-open-client"><span class="t-Icon t-Icon--left fa fa-envelope-open" aria-hidden="true"></span><span class="t-Button-label">&APP_TEXT$MEDICAL_REFERRAL_PERSONAL_EMAIL_OPEN_CLIENT.</span></button>
                    </footer>
                  </form>
                </dialog>
                <dialog id="p107-sms-dialog" aria-labelledby="p107-sms-title">
                  <form method="dialog" class="p107-dialog__form" onsubmit="event.preventDefault();p107SendSms();">
                    <header class="p107-email-dialog__hero"><span class="p107-email-dialog__icon fa fa-commenting-o" aria-hidden="true"></span><div><h2 id="p107-sms-title" data-sms-label="title">Send PDF link by SMS</h2></div></header>
                    <div class="p107-email-dialog__body">
                      <p data-sms-label="help">The recipient can verify and download the approved PDF.</p>
                      <label for="p107-sms-mobile" data-sms-label="mobile">Recipient mobile number</label>
                      <input id="p107-sms-mobile" type="tel" maxlength="25" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="01xxxxxxxxx" required>
                      <p id="p107-sms-error" role="alert" aria-live="assertive"></p>
                    </div>
                    <footer class="p107-email-dialog__footer"><button id="p107-sms-cancel" class="t-Button" type="button" data-sms-label="cancel">Cancel</button><button id="p107-sms-send" class="t-Button t-Button--hot" type="button" data-sms-label="send">Send SMS</button></footer>
                  </form>
                </dialog>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader
                t-Region--noUI
            ]
