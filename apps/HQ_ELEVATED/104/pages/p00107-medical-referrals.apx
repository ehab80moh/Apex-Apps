    region employee-prescription-requests (
        name: &APP_TEXT$P107_PRESCRIPTION_REQUESTS_TITLE.
        title: &APP_TEXT$P107_PRESCRIPTION_REQUESTS_TITLE.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.request_id,
                       r.created_at,
                       case r.request_kind
                           when 'MONTHLY' then '<span class="t-Badge t-Badge--subtle t-Badge--info">'||apex_escape.html(apex_lang.message('P107_PRESCRIPTION_MONTHLY'))||'</span>'
                           else '<span class="t-Badge t-Badge--subtle t-Badge--success">'||apex_escape.html(apex_lang.message('P107_PRESCRIPTION_ONE_TIME'))||'</span>'
                       end request_category,
                       r.request_no,
                       r.beneficiary_name_snapshot beneficiary_name,
                       r.beneficiary_person_id,
                       case
                           when r.status='APPROVED' then '<span class="t-Badge t-Badge--subtle t-Badge--success">'||apex_escape.html(apex_lang.message('P107_STATUS_APPROVED'))||'</span>'
                           when r.status='PARTIALLY_APPROVED' then '<span class="t-Badge t-Badge--subtle t-Badge--warning">'||apex_escape.html(apex_lang.message('P107_STATUS_PARTIALLY_APPROVED'))||'</span>'
                           when r.status='REJECTED' then '<span class="t-Badge t-Badge--subtle t-Badge--danger">'||apex_escape.html(apex_lang.message('P107_STATUS_REJECTED'))||'</span>'
                           when r.status='CANCELLED' then '<span class="t-Badge t-Badge--subtle t-Badge--danger">'||apex_escape.html(apex_lang.message('P107_STATUS_CANCELLED'))||'</span>'
                           else '<span class="t-Badge t-Badge--subtle t-Badge--warning">'||apex_escape.html(apex_lang.message('P107_STATUS_DOCTOR_REVIEW'))||'</span>'
                       end status_label,
                       (select case
                                  when count(*)=0 then to_char(unistr('\2014'))
                                  else '<div class="p107-dispense-info">'||
                                       listagg(
                                           '<div class="p107-dispense-info__item"><strong class="p107-dispense-info__medicine">'||apex_escape.html(i.medicine_name_snapshot)||'</strong>'||
                                           '<span class="t-Badge t-Badge--subtle '||
                                           case
                                               when i.doctor_decision='PENDING' then 't-Badge--warning'
                                               when i.doctor_decision='REJECTED' then 't-Badge--danger'
                                               when i.dispense_mode='DAILY' then 't-Badge--info'
                                               when i.dispense_mode='PHARMACY' then 't-Badge--success'
                                               else 't-Badge--danger'
                                           end||'">'||
                                           case
                                               when i.doctor_decision='PENDING' then apex_escape.html(apex_lang.message('P107_ITEM_STATUS_PENDING'))
                                               when i.doctor_decision='REJECTED' then apex_escape.html(apex_lang.message('P107_ITEM_STATUS_REJECTED'))
                                               when i.dispense_mode='DAILY' then apex_escape.html(apex_lang.message('P107_DISPENSE_DAILY'))
                                               when i.dispense_mode='PHARMACY' then apex_escape.html(apex_lang.message('P107_DISPENSE_PHARMACY'))||': '||apex_escape.html(nvl(i.pharmacy_name_snapshot, apex_lang.message('P107_VALUE_UNSPECIFIED')))
                                               when i.dispense_mode='NOT_DISPENSED' then apex_escape.html(apex_lang.message('P107_DISPENSE_NOT_ISSUED'))
                                               else apex_escape.html(apex_lang.message('P107_VALUE_UNSPECIFIED'))
                                           end||'</span></div>',
                                           ''
                                       ) within group(order by i.line_no)||
                                       '</div>'
                              end
                         from med.md_pres_request_item i
                        where i.request_id=r.request_id) dispense_info,
                       (select listagg(case when i.doctor_decision='REJECTED' then i.medicine_name_snapshot||': '||i.rejection_reason when i.dispense_mode='NOT_DISPENSED' then i.medicine_name_snapshot||': '||i.not_dispensed_reason end, apex_lang.message('P107_LIST_SEPARATOR')) within group(order by i.line_no) from med.md_pres_request_item i where i.request_id=r.request_id) doctor_reasons,
                       '<a class="t-Button t-Button--small p107-action p107-action--details" href="'||apex_escape.html_attribute(apex_util.prepare_url(apex_page.get_url(p_page=>112,p_items=>'P112_REQUEST_ID',p_values=>to_char(r.request_id)),p_checksum_type=>'SESSION'))||'"><span class="t-Icon t-Icon--left fa fa-info-circle" aria-hidden="true"></span><span class="t-Button-label">'||apex_escape.html(apex_lang.message('P107_OPEN_DETAILS'))||'</span></a>' details,
                       r.document_status,
                       case
                         when r.status in ('APPROVED','PARTIALLY_APPROVED')
                          and r.document_status='READY' then
                           '<div class="p107-actions p107-prescription-actions" role="group" aria-label="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_ACTIONS'))||'">' ||
                           '<a class="t-Button t-Button--small p107-action p107-action--download" title="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_DOWNLOAD_TITLE'))||'" aria-label="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_DOWNLOAD_TITLE'))||'" target="_blank" rel="noopener noreferrer" href="'||apex_escape.html_attribute(apex_util.prepare_url(apex_page.get_url(p_page=>107,p_request=>'DOWNLOAD_PRESCRIPTION',p_items=>'P107_PRESCRIPTION_ID',p_values=>to_char(r.request_id)),p_checksum_type=>'SESSION'))||'"><span class="t-Icon t-Icon--left fa fa-download" aria-hidden="true"></span><span class="t-Button-label">'||apex_escape.html(apex_lang.message('P107_DOWNLOAD_PDF'))||'</span></a>' ||
                           '<a class="t-Button t-Button--small p107-action p107-action--email p107-prescription-email-action" title="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_EMAIL_ACTION'))||'" aria-label="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_EMAIL_ACTION'))||'" href="#" data-prescription-id="'||to_char(r.request_id)||'"><span class="t-Icon t-Icon--left fa fa-envelope" aria-hidden="true"></span><span class="t-Button-label">'||apex_escape.html(apex_lang.message('P107_SEND_BY_EMAIL'))||'</span></a>' ||
                           '<a class="t-Button t-Button--small p107-action p107-action--sms p107-sms-action" href="#" title="SMS" aria-label="SMS" data-document-kind="PRESCRIPTION" data-document-id="'||to_char(r.request_id)||'"><span class="t-Icon t-Icon--left fa fa-commenting-o" aria-hidden="true"></span><span class="t-Button-label">SMS</span></a>' ||
                           '<a class="t-Button t-Button--small p107-action p107-action--share p107-prescription-share-action" title="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_SHARE_ACTION'))||'" aria-label="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_SHARE_ACTION'))||'" href="#" data-prescription-id="'||to_char(r.request_id)||'"><span class="t-Icon t-Icon--left fa fa-share-alt" aria-hidden="true"></span><span class="t-Button-label">'||apex_escape.html(apex_lang.message('MEDICAL_REFERRAL_SHARE'))||'</span></a></div>'
                         else
                           '<div class="p107-actions p107-prescription-actions" role="group" aria-label="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_ACTIONS'))||'"><span class="t-Button t-Button--small p107-action p107-action--disabled is-disabled" aria-disabled="true" title="'||apex_escape.html_attribute(apex_lang.message('P107_PRESCRIPTION_ACTIONS_AFTER_APPROVAL'))||'"><span class="t-Icon t-Icon--left fa fa-lock" aria-hidden="true"></span><span class="t-Button-label">'||apex_escape.html(apex_lang.message('P107_PRESCRIPTION_ACTIONS_AFTER_APPROVAL'))||'</span></span></div>'
                       end actions
                  from med.md_pres_request r
                 where upper(trim(r.employee_number))=upper(trim(:APP_USER))
                 order by r.created_at desc, r.request_id desc
