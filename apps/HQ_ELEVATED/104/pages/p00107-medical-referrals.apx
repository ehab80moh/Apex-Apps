    process send-document-sms (
        name: SEND_DOCUMENT_SMS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_kind VARCHAR2(20) := UPPER(TRIM(APEX_APPLICATION.G_X01));
                    l_id NUMBER := TO_NUMBER(APEX_APPLICATION.G_X02);
                    l_mobile VARCHAR2(99) := TRIM(APEX_APPLICATION.G_X03);
                    l_owner VARCHAR2(128);
                    l_url VARCHAR2(4000);
                    l_prefix VARCHAR2(200);
                    l_message VARCHAR2(4000);
                    l_result NUMBER;
                    l_recent NUMBER;
                    l_count NUMBER;
                BEGIN
                    IF l_mobile IS NULL OR NOT REGEXP_LIKE(l_mobile,'^[+0-9 ()-]+$') THEN
                        RAISE_APPLICATION_ERROR(-20491,'Enter a valid Egyptian mobile number.');
                    END IF;
                    l_mobile:=REGEXP_REPLACE(l_mobile,'[+ ()-]','');
                    IF SUBSTR(l_mobile,1,2)='20' AND LENGTH(l_mobile)=12 THEN
                        l_mobile:='0'||SUBSTR(l_mobile,3);
                    END IF;
                    IF NOT REGEXP_LIKE(l_mobile,'^01[0125][0-9]{8}$') THEN
                        RAISE_APPLICATION_ERROR(-20491,'Enter a valid Egyptian mobile number.');
                    END IF;
                    IF l_kind='REFERRAL' THEN
                        SELECT emp_id_snapshot INTO l_owner FROM med.md_referal_flow WHERE referal_id=l_id;
                        IF NVL(med.md_referal_wf_pkg.employee_document_allowed(l_id,:APP_USER),'N')<>'Y' THEN
                            RAISE_APPLICATION_ERROR(-20490,'This medical document is not available for SMS sharing.');
                        END IF;
                        l_prefix:='EPROM: Medical referral #'||TO_CHAR(l_id)||CHR(10);
                    ELSIF l_kind='PRESCRIPTION' THEN
                        SELECT employee_number INTO l_owner FROM med.md_pres_request WHERE request_id=l_id AND status IN ('APPROVED','PARTIALLY_APPROVED');
                        SELECT COUNT(*) INTO l_count FROM med.md_pres_document
                         WHERE request_id=l_id AND token_status='ACTIVE' AND pdf_blob IS NOT NULL;
                        IF l_count=0 THEN RAISE_APPLICATION_ERROR(-20490,'The approved PDF is unavailable.');END IF;
                        l_prefix:='EPROM: Prescription #'||TO_CHAR(l_id)||CHR(10);
                    ELSE
                        RAISE_APPLICATION_ERROR(-20490,'Invalid medical document type.');
                    END IF;
                    IF l_owner IS NULL OR :APP_USER IS NULL OR UPPER(TRIM(l_owner))<>UPPER(TRIM(:APP_USER)) THEN
                        RAISE_APPLICATION_ERROR(-20490,'This medical document belongs to another employee.');
                    END IF;
                    SELECT COUNT(*) INTO l_recent FROM central.sms_log
                     WHERE send_date>SYSDATE-60/86400
                       AND SUBSTR(msg,1,LENGTH(l_prefix))=l_prefix
                       AND DBMS_LOB.COMPARE(mob,TO_CLOB(l_mobile))=0;
                    IF l_recent>0 THEN
                        RAISE_APPLICATION_ERROR(-20492,'Please wait one minute before resending this document to the same number.');
                    END IF;
                    SAVEPOINT p107_sms_share;
                    IF l_kind='REFERRAL' THEN
                        med.md_referal_wf_pkg.create_employee_share_url(l_id,:APP_USER,l_url);
                    ELSE
                        med.md_pres_document_pkg.create_share_url(l_id,:APP_USER,l_url);
                    END IF;
                    IF l_url IS NULL OR SUBSTR(l_url,1,8)<>'https://' THEN
                        RAISE_APPLICATION_ERROR(-20490,'A secure medical document URL could not be prepared.');
                    END IF;
                    l_message:=l_prefix||l_url;
                    -- Existing supported sender accepts one recipient and records the provider response.
                    -- Unlike SEND_SINGLE on server42, this route actually calls the SMS gateway.
                    BEGIN
                        l_result:=central.sms_pkg.send_multi(MSG=>l_message,MOBILES=>TO_CLOB(l_mobile));
                    EXCEPTION WHEN OTHERS THEN
                        -- The shared sender logs only completed HTTP responses. Record transport failures
                        -- through its existing autonomous logger without committing document changes.
                        central.log_sms_attempt(P_MSG=>l_message,P_MOB=>l_mobile,
                            P_LOG=>TO_CLOB('ERROR '||SQLCODE||': '||SUBSTR(SQLERRM,1,2000)||' [PAGE107_DOCUMENT_SMS]'));
                        ROLLBACK TO p107_sms_share;
                        l_result:=0;
                    END;
                    IF NVL(l_result,0)<>1 THEN
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success',FALSE);
                        APEX_JSON.WRITE('errorCode','GATEWAY_UNAVAILABLE');
                        APEX_JSON.CLOSE_OBJECT;
                        RETURN;
                    END IF;
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('success',TRUE);
                    APEX_JSON.WRITE('mobile',SUBSTR(l_mobile,1,3)||'*****'||SUBSTR(l_mobile,-3));
                    APEX_JSON.CLOSE_OBJECT;
                END;
                ```
        }
        execution {
            sequence: 95
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99010410720261012
        }
    )

