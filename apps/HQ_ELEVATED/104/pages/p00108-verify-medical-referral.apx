    button download-public-document (
        buttonName: DOWNLOAD
        label: &APP_TEXT$MEDICAL_REFERRAL_DOWNLOAD.
        layout {
            sequence: 10
            region: @verification-actions
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-download
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 108
                items: {
                    P108_TOKEN: &P108_TOKEN.
                }
                request: DOWNLOAD
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P108_LIVE_STATUS = 'VALID'
        }
    )

    process capture-public-client-context (
        name: CAPTURE_PUBLIC_CONTEXT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_safe_device_json CLOB;
                    l_safe_visitor_id  VARCHAR2(128);
                BEGIN
                    med.md_referal_wf_pkg.sanitize_public_context(
                        p_device_json => apex_application.g_x01,
                        p_visitor_id => apex_application.g_x02,
                        p_safe_device_json => l_safe_device_json,
                        p_safe_visitor_id => l_safe_visitor_id
                    );
                
                    apex_collection.create_or_truncate_collection(
                        p_collection_name => 'P108_PUBLIC_CONTEXT'
                    );
                    apex_collection.add_member(
                        p_collection_name => 'P108_PUBLIC_CONTEXT',
                        p_c001 => l_safe_device_json,
                        p_c002 => l_safe_visitor_id
                    );
                    sys.htp.p('{"success":true}');
                END;
                ```
        }
        execution {
            sequence: 1
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 52401768410262022
        }
    )

    process download-public-medical-referral-document (
        name: Download public medical referral document
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    med.md_referal_wf_pkg.download_public_document(
                        p_token => :P108_TOKEN,
                        p_device_json => :P108_DEVICE_JSON,
                        p_visitor_id => :P108_VISITOR_ID
                    );
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52402079003262022
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DOWNLOAD
        }
    )

    process load-public-client-context (
        name: Load public client context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P108_CONTEXT_READY := 'N';
                    IF apex_collection.collection_exists('P108_PUBLIC_CONTEXT') THEN
                        BEGIN
                            SELECT c001, c002
                              INTO :P108_DEVICE_JSON, :P108_VISITOR_ID
                              FROM apex_collections
                             WHERE collection_name = 'P108_PUBLIC_CONTEXT'
                               AND seq_id = 1;
                            :P108_CONTEXT_READY := 'Y';
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                NULL;
                        END;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52401876437262022
        }
    )

    process resolve-public-medical-referral-token (
        name: Resolve public medical referral token
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    med.md_referal_wf_pkg.resolve_public_token(
                        p_token => :P108_TOKEN,
                        p_device_json => :P108_DEVICE_JSON,
                        p_visitor_id => :P108_VISITOR_ID,
                        p_referal_id => :P108_REFERAL_ID,
                        p_beneficiary_name => :P108_BENEFICIARY_NAME,
                        p_provider_name => :P108_PROVIDER_NAME,
                        p_speciality_name => :P108_SPECIALITY_NAME,
                        p_letter_date => :P108_LETTER_DATE,
                        p_available_from => :P108_AVAILABLE_FROM,
                        p_valid_to => :P108_VALID_TO,
                        p_live_status => :P108_LIVE_STATUS,
                        p_file_name => :P108_FILE_NAME
                    );
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52401999618262022
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P108_CONTEXT_READY = 'Y'
        }
    )

)
