page 108 (
    name: &APP_TEXT$MEDICAL_REFERRAL_VERIFY_TITLE.
    alias: VERIFY-MEDICAL-REFERRAL
    title: &APP_TEXT$MEDICAL_REFERRAL_VERIFY_TITLE.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function p108ClientContext() {
              const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
              const network = connection ? {
                effectiveType: connection.effectiveType || null,
                downlink: connection.downlink || null,
                rtt: connection.rtt || null,
                saveData: connection.saveData === true
              } : null;
              return JSON.stringify({
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || null,
                screen: { width: window.screen.width, height: window.screen.height },
                viewport: { width: window.innerWidth, height: window.innerHeight },
                pixelRatio: window.devicePixelRatio || 1,
                platform: navigator.platform || null,
                maxTouchPoints: navigator.maxTouchPoints || 0,
                language: navigator.language || null,
                network: network
              });
            }
            
            function p108VisitorId() {
              const key = 'medical-referral-visitor-id';
              let visitorId = window.sessionStorage.getItem(key);
              if (!visitorId) {
                visitorId = window.crypto && window.crypto.randomUUID ?
                  window.crypto.randomUUID() : String(Date.now()) + '-' + String(Math.random()).slice(2);
                window.sessionStorage.setItem(key, visitorId);
              }
              return visitorId;
            }
            
            function p108CaptureClientContext() {
              apex.server.process(
                'CAPTURE_PUBLIC_CONTEXT',
                {
                  x01: p108ClientContext(),
                  x02: p108VisitorId()
                },
                { dataType: 'json' }
              ).done(function() {
                apex.submit({ request: 'VERIFY_CONTEXT', showWait: true });
              }).fail(function() {
                apex.message.showErrors([{
                  type: 'error',
                  location: 'page',
                  message: apex.lang.getMessage('P107_ACTION_ERROR'),
                  unsafe: false
                }]);
              });
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            if (apex.item('P108_CONTEXT_READY').getValue() !== 'Y') {
              p108CaptureClientContext();
            }
            ```
    }
