    pageItem P109_LAB_ITEMS (
        type: selectMany
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_LABORATORY_ITEMS.
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
            useDefaults: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(regexp_replace(
                           case
                               when lower(v('APP_LANGUAGE')) like 'en%' then coalesce(c.name_en, c.name_ar)
                               else coalesce(c.name_ar, c.name_en)
                           end,
                           '\[[^]]*\]', ''
                       )) display_value,
                       c.exam_id return_value
                  from med.md_referal_exam_catalog c
                 where c.provider_category = 'LABORATORY'
                   and c.active_yn = 'Y'
                 order by c.display_order, c.exam_id
                ```
        }
        layout {
            sequence: 50
            region: @doctor-selection-workspace
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select listagg(to_char(i.exam_id), ':') within group (order by i.exam_id)
                  from med.md_referal_request_item i
                  join med.md_referal_exam_catalog c on c.exam_id = i.exam_id
                 where i.referal_id = :P109_REFERAL_ID
                   and c.provider_category = 'LABORATORY'
                ```
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from med.md_referal_request_category where referal_id = :P109_REFERAL_ID and provider_category = 'LAB' and :P109_TASK_ID is not null and NVL(:P109_CAN_REVIEW, 'N') = 'Y'
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

    pageItem P109_RADIOLOGY_FILTER (
        type: selectList
        label {
            label: &APP_TEXT$P109_MODALITY_HEADING.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from (
                    select apex_lang.message('APEXIR_ALL') display_value, 'ALL' return_value, 1 sort_order from dual
                    union all
                    select apex_lang.message('P109_MODALITY_CT'), 'CT', 2 from dual
                    union all
                    select apex_lang.message('P109_MODALITY_XRAY'), 'X_RAY', 3 from dual
                    union all
                    select apex_lang.message('P109_MODALITY_MRI'), 'MRI', 4 from dual
                  )
                 order by sort_order
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @doctor-selection-workspace
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            cssClasses: p109-filter-item
        }
        default {
            type: static
            staticValue: ALL
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from med.md_referal_request_category where referal_id = :P109_REFERAL_ID and provider_category in ('MEDICAL_CENTER','RADIOLOGY_CENTER') and :P109_TASK_ID is not null and NVL(:P109_CAN_REVIEW, 'N') = 'Y'
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

    pageItem P109_RADIOLOGY_ITEMS (
        type: selectMany
        label {
            label: &APP_TEXT$MEDICAL_REFERRAL_RADIOLOGY_ITEMS.
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
            useCache: false
            useDefaults: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(regexp_replace(
                           case
                               when lower(v('APP_LANGUAGE')) like 'en%' then coalesce(c.name_en, c.name_ar)
                               else coalesce(c.name_ar, c.name_en)
                           end,
                           '\[[^]]*\]', ''
                       )) display_value,
                       c.exam_id return_value
                  from med.md_referal_exam_catalog c
                 where c.provider_category = 'RADIOLOGY'
                   and c.active_yn = 'Y'
                   and (nvl(:P109_RADIOLOGY_FILTER, 'ALL') = 'ALL'
                        or c.modality = :P109_RADIOLOGY_FILTER
                        or to_char(c.exam_id) in (
                            select trim(column_value)
                              from table(apex_string.split(:P109_RADIOLOGY_ITEMS, ':'))
                        ))
                 order by c.modality, c.display_order, c.exam_id
                ```
        }
        cascadingLov {
            parentItems: P109_RADIOLOGY_FILTER
            itemsToSubmit: [
                P109_RADIOLOGY_FILTER
                P109_RADIOLOGY_ITEMS
            ]
            parentRequired: false
        }
        layout {
            sequence: 60
            region: @doctor-selection-workspace
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select listagg(to_char(i.exam_id), ':') within group (order by i.exam_id)
                  from med.md_referal_request_item i
                  join med.md_referal_exam_catalog c on c.exam_id = i.exam_id
                 where i.referal_id = :P109_REFERAL_ID
                   and c.provider_category = 'RADIOLOGY'
                ```
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from med.md_referal_request_category where referal_id = :P109_REFERAL_ID and provider_category in ('MEDICAL_CENTER','RADIOLOGY_CENTER') and :P109_TASK_ID is not null and NVL(:P109_CAN_REVIEW, 'N') = 'Y'
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

