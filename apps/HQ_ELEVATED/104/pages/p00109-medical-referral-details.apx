    region selected-examination-summary (
        name: Selected examination summary
        title: &APP_TEXT$P109_SELECTED_EXAMS_TITLE.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with selected_ids as (
                    select to_number(trim(column_value)) exam_id
                      from table(apex_string.split(nvl(:P109_LAB_ITEMS, ' '), ':'))
                     where regexp_like(trim(column_value), '^[0-9]+$')
                       and nvl(:P109_CAN_REVIEW, 'N') = 'Y'
                    union
                    select to_number(trim(column_value)) exam_id
                      from table(apex_string.split(nvl(:P109_RADIOLOGY_ITEMS, ' '), ':'))
                     where regexp_like(trim(column_value), '^[0-9]+$')
                       and nvl(:P109_CAN_REVIEW, 'N') = 'Y'
                    union
                    select i.exam_id
                      from med.md_referal_request_item i
                     where i.referal_id = :P109_REFERAL_ID
                       and nvl(:P109_CAN_REVIEW, 'N') <> 'Y'
                )
                select case c.provider_category
                           when 'LABORATORY' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_LAB')
                           when 'RADIOLOGY' then
                               case
                                   when exists (
                                       select 1
                                         from med.md_referal_request_category rc
                                        where rc.referal_id = :P109_REFERAL_ID
                                          and rc.provider_category = 'RADIOLOGY_CENTER'
                                   ) then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_RADIOLOGY_CENTER')
                                   else apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_MEDICAL_CENTER')
                               end
                       end selection_group,
                       case c.modality
                           when 'CT' then apex_lang.message('P109_MODALITY_CT')
                           when 'X_RAY' then apex_lang.message('P109_MODALITY_XRAY')
                           when 'MRI' then apex_lang.message('P109_MODALITY_MRI')
                           else null
                       end modality_name,
                       case
                           when regexp_like(c.source_code, '[0-9]+$')
                           then regexp_substr(c.source_code, '[0-9]+$')
                           else null
                       end exam_code,
                       coalesce(
                           case when lower(v('APP_LANGUAGE')) like 'en%' then c.name_en else c.name_ar end,
                           c.name_en,
                           c.name_ar
                       ) examination_name,
                       c.display_order sort_order,
                       c.exam_id
                  from selected_ids s
                  join med.md_referal_exam_catalog c on c.exam_id = s.exam_id
                 where exists (
                       select 1
                         from med.md_referal_request_category rc
                        where rc.referal_id = :P109_REFERAL_ID
                          and ((rc.provider_category = 'LAB' and c.provider_category = 'LABORATORY')
                            or (rc.provider_category in ('MEDICAL_CENTER','RADIOLOGY_CENTER') and c.provider_category = 'RADIOLOGY'))
                 )
                 order by selection_group, modality_name, sort_order, c.exam_id
                ```
            pageItemsToSubmit: [
                P109_LAB_ITEMS
                P109_RADIOLOGY_ITEMS
                P109_CAN_REVIEW
                P109_TASK_ID
                P109_REFERAL_ID
            ]
        }
        layout {
            sequence: 40
            slot: contentBody
            columnSpan: 12
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: p109-selection-summary
        }
        advanced {
            htmlDomId: p109_selected_examination_summary
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from med.md_referal_request_category where referal_id = :P109_REFERAL_ID and provider_category in ('LAB','MEDICAL_CENTER','RADIOLOGY_CENTER')
        }
        security {
            authorizationScheme: @medical-referral-request-viewer
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: &APP_TEXT$P109_SELECTED_EXAMS_EMPTY.
        }

        column EXAMINATION_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$P109_EXAMINATION_HEADING.
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column EXAM_CODE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: &APP_TEXT$P109_CODE_HEADING.
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column EXAM_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column MODALITY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: &APP_TEXT$P109_MODALITY_HEADING.
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column SELECTION_GROUP (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$P109_CATEGORY_HEADING.
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column SORT_ORDER (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

    )

    region selected-provider-types (
        name: Selected medical provider types
        title: &APP_TEXT$MEDICAL_REFERRAL_PROVIDER_TYPES.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case provider_category
                           when 'MEDICAL_CENTER' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_MEDICAL_CENTER')
                           when 'LAB' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_LAB')
                           when 'DENTAL_CLINIC' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_DENTAL_CLINIC')
                       when 'PHYSIOTHERAPY' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_PHYSIOTHERAPY')
                       when 'RADIOLOGY_CENTER' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_RADIOLOGY_CENTER')
                       when 'OPHTHALMOLOGY' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_OPHTHALMOLOGY')
                       when 'HOSPITAL' then apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_HOSPITAL')
                           else apex_lang.message('MEDICAL_REFERRAL_PROVIDER_TYPE_HOSPITAL')
                       end as provider_type,
                       provider_category
                  from med.md_referal_request_category
                 where referal_id = :P109_REFERAL_ID
                 order by provider_category
                ```
            pageItemsToSubmit: P109_REFERAL_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--scrollBody
                t-Form--xlarge
                t-Form--stretchInputs
            ]
            cssClasses: p109-provider-card
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column PROVIDER_CATEGORY (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column PROVIDER_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$MEDICAL_REFERRAL_PROVIDER_TYPE.
            }
            layout {
                sequence: 10
            }
        )

    )

