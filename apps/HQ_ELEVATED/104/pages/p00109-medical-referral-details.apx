                t-Form-fieldContainer--xlarge
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select requirement_id
                  from med.md_referal_flow
                 where referal_id = :P109_REFERAL_ID
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: NVL(:P109_CAN_REVIEW, 'N') = 'Y' AND :P109_TASK_ID IS NOT NULL
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
