            type: rowsReturned
            sqlQuery: select 1 from med.md_referal_attachment a where a.referal_id = :P109_REFERAL_ID and med.md_referal_ext_pkg.attachment_allowed(a.attachment_id, :APP_USER, :P109_TASK_ID) = 'Y'
        }
