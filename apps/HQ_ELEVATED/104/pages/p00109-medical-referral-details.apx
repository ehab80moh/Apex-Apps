    process claim (
        name: Auto claim before medical decision
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P109_TASK_ID IS NULL
                       OR :REQUEST IS NULL
                       OR :REQUEST NOT IN ('APPROVE', 'REJECT_CONFIRM')
                       OR NOT apex_authorization.is_authorized(
                                  p_authorization_name => 'Medical_Referral_Task_Reviewer') THEN
                        raise_application_error(-20426, 'This medical task is not available to the current reviewer.');
                    END IF;
                
                    IF :REQUEST = 'REJECT_CONFIRM' AND TRIM(:P109_REJECT_REASON) IS NULL THEN
                        raise_application_error(-20428,
                            apex_lang.message('MEDICAL_REFERRAL_REJECTION_REASON_REQUIRED'));
                    END IF;
                
                    IF apex_human_task.is_allowed(
                           p_task_id => :P109_TASK_ID,
                           p_operation => apex_human_task.c_task_op_claim) THEN
                        apex_human_task.claim_task(p_task_id => :P109_TASK_ID);
                    END IF;
                
                    IF :REQUEST = 'APPROVE' THEN
                        IF NOT apex_human_task.is_allowed(
                                   p_task_id => :P109_TASK_ID,
                                   p_operation => apex_human_task.c_task_op_approve) THEN
                            raise_application_error(-20427, 'This medical task cannot be approved by the current reviewer.');
                        END IF;
                    ELSE
                        IF NOT apex_human_task.is_allowed(
                                   p_task_id => :P109_TASK_ID,
                                   p_operation => apex_human_task.c_task_op_reject) THEN
                            raise_application_error(-20429, 'This medical task cannot be rejected by the current reviewer.');
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 52406788039262064
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,REJECT_CONFIRM
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

    process load-medical-admin-state (
        name: Load medical admin state
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P109_IS_MEDICAL_ADMIN := 'N';
                    :P109_CAN_REVIEW := 'N';
                    IF apex_authorization.is_authorized(
                           p_authorization_name => 'Medical_Team') THEN
                        :P109_IS_MEDICAL_ADMIN := 'Y';
                    END IF;
                    IF apex_authorization.is_authorized(p_authorization_name => 'Medical_Referral_Task_Reviewer') THEN
                        :P109_CAN_REVIEW := 'Y';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52406505305262064
        }
    )

