                    IF NVL(UPPER(TRIM(l_owner)), CHR(0)) <> NVL(UPPER(TRIM(:APP_USER)), CHR(1))
                       AND NOT apex_authorization.is_authorized(p_authorization_name=>'Medical_Team')
