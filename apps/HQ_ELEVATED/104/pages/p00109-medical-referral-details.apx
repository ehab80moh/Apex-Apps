    region medical-detail-warning (
        name: Detailed examination warning
        type: staticContent
        source {
            htmlCode: <div class="t-Alert t-Alert--warning">&P109_DETAIL_WARNING!HTML.</div>
        }
        layout {
            sequence: 45
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: p109_medical_detail_warning
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P109_TASK_ID IS NULL
                       OR NVL(:P109_CAN_REVIEW, 'N') <> 'Y'
                       OR :P109_DETAIL_WARNING IS NULL THEN
                        RETURN FALSE;
                    END IF;
                    BEGIN
                        RETURN apex_human_task.is_allowed(
                                   p_task_id   => :P109_TASK_ID,
                                   p_operation => apex_human_task.c_task_op_approve)
                            OR apex_human_task.is_allowed(
                                   p_task_id   => :P109_TASK_ID,
                                   p_operation => apex_human_task.c_task_op_claim);
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN FALSE;
                        WHEN OTHERS THEN
                            IF SQLCODE = -1403 THEN
                                RETURN FALSE;
                            END IF;
                            RAISE;
                    END;
                END;
                ```
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

    region medical-referral-attachments (
        name: Supporting attachments
        title: &APP_TEXT$MEDICAL_REFERRAL_SUPPORTING_FILES.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.attachment_id,
                       a.original_filename,
                       a.mime_type,
                       a.file_size,
                       apex_page.get_url(
                           p_application => 104,
                           p_page        => 110,
                           p_items       => 'P110_ATTACHMENT_ID,P110_TASK_ID,P110_DISPOSITION',
                           p_values      => a.attachment_id || ',' || :P109_TASK_ID || ',INLINE'
                       ) as view_url,
                       apex_page.get_url(
                           p_application => 104,
                           p_page        => 110,
                           p_items       => 'P110_ATTACHMENT_ID,P110_TASK_ID,P110_DISPOSITION',
                           p_values      => a.attachment_id || ',' || :P109_TASK_ID || ',DOWNLOAD'
                       ) as download_url
                  from med.md_referal_attachment a
                 where a.referal_id = :P109_REFERAL_ID
                   and med.md_referal_ext_pkg.attachment_allowed(
                           a.attachment_id, :APP_USER, :P109_TASK_ID
                       ) = 'Y'
                 order by a.uploaded_at, a.attachment_id
                ```
            pageItemsToSubmit: [
                P109_REFERAL_ID
                P109_TASK_ID
