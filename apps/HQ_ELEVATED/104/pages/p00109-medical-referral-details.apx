page 109 (
    name: medical-referral-details
    alias: MEDICAL-REFERRAL-DETAILS
    title: &APP_TEXT$MEDICAL_REFERRAL_REQUEST_DETAILS.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
        cssClasses: p109-review-dialog
    }
    dialog {
        width: 550
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            (function () {
                var feedbackActive = false;
            
                function preserveRadiologySelections() {
                    var filter = document.getElementById('P109_RADIOLOGY_FILTER');
                    var select = document.getElementById('P109_RADIOLOGY_ITEMS');
                    if (!filter || !select) {
                        return;
                    }
                    var item = apex.item('P109_RADIOLOGY_ITEMS');
                    var values = getSelectionValues('P109_RADIOLOGY_ITEMS');
                    var displayValues = values.map(function (value) {
                        return item.displayValueFor(value);
                    });
                    apex.jQuery(select).one('apexafterrefresh.p109Filter', function () {
                        item.setValue(values, displayValues, true);
                    });
                }
            
                function getSelectionValues(itemName) {
                    var item = apex.item(itemName);
                    var value;
                    if (!item) {
                        return [];
                    }
                    value = item.getValue();
                    if (Array.isArray(value)) {
                        return value.filter(function (entry) {
                            return entry !== null && entry !== '';
                        });
                    }
                    return String(value || '').split(':').filter(function (entry) {
                        return entry !== '';
                    });
                }
            
                function clearSelectionFeedback() {
                    var feedback = document.getElementById('p109_selection_feedback');
                    if (!feedback) {
                        return;
                    }
                    feedback.className = 'p109-selection-feedback';
                    feedback.innerHTML = '';
                }
            
                function renderSelectionFeedback(state) {
                    var feedback = document.getElementById('p109_selection_feedback');
                    var adminItem = apex.item('P109_CAN_REVIEW');
                    var warningRegion = document.getElementById('p109_medical_detail_warning');
                    var lists;
                    var selectedCount;
                    var missingCount;
                    if (!feedback || !adminItem || String(adminItem.getValue() || '') !== 'Y') {
                        return;
                    }
            
                    if (!feedbackActive && state !== 'loading') {
                        clearSelectionFeedback();
                        return;
                    }
            
                    lists = ['P109_LAB_ITEMS', 'P109_RADIOLOGY_ITEMS'].map(function (itemName) {
                        var item = apex.item(itemName);
                        var node = item && item.node;
                        return {
                            item: itemName,
                            available: !!(node || document.getElementById(itemName)),
                            values: getSelectionValues(itemName)
                        };
                    }).filter(function (entry) {
                        return entry.available;
                    });
                    selectedCount = lists.reduce(function (total, entry) {
                        return total + entry.values.length;
                    }, 0);
                    missingCount = lists.filter(function (entry) {
                        return entry.values.length === 0;
                    }).length;
            
                    if (lists.length === 0) {
                        clearSelectionFeedback();
                        return;
                    }
            
                    if (warningRegion) {
                        warningRegion.style.display = feedbackActive ? 'none' : '';
                    }
            
                    var feedbackMessage;
                    if (state === 'loading') {
                        feedbackMessage = {
                            icon: 'fa-refresh',
                            title: 'P109_SELECTION_LOADING_TITLE',
                            description: 'P109_SELECTION_LOADING_DESCRIPTION'
                        };
                    } else if (selectedCount === 0 || missingCount > 0) {
                        feedbackMessage = {
                            icon: 'fa-exclamation-triangle',
                            title: 'P109_SELECTION_INCOMPLETE_TITLE',
                            description: 'P109_SELECTION_INCOMPLETE_DESCRIPTION'
                        };
                    } else {
                        feedbackMessage = {
                            icon: 'fa-check-circle',
                            title: 'P109_SELECTION_READY_TITLE',
                            description: 'P109_SELECTION_READY_DESCRIPTION'
                        };
                    }
            
                    var feedbackState = state === 'loading' ? 'loading' :
                        (selectedCount === 0 || missingCount > 0 ? 'warning' : 'success');
                    feedback.className = 'p109-selection-feedback p109-selection-feedback--' + feedbackState;
                    feedback.innerHTML = '<span class="t-Icon fa ' + feedbackMessage.icon + '" aria-hidden="true"></span><div class="p109-selection-feedback-text"><strong></strong><span></span></div>';
                    var feedbackText = feedback.querySelectorAll('.p109-selection-feedback-text > strong, .p109-selection-feedback-text > span');
                    if (feedbackText.length === 2) {
                        feedbackText[0].textContent = apex.lang.getMessage(feedbackMessage.title);
                        feedbackText[1].textContent = apex.lang.getMessage(feedbackMessage.description);
                    }
                }
            
                window.p109SelectionFeedback = {
                    showLoading: function () {
                        feedbackActive = true;
                        renderSelectionFeedback('loading');
                    },
                    render: function () {
                        renderSelectionFeedback('ready');
                    }
                };
            
                apex.jQuery(function () {
                    var radiologyFilter = document.getElementById('P109_RADIOLOGY_FILTER');
                    if (radiologyFilter) {
                        // Capture the selected IDs before the native cascading LOV clears them.
                        radiologyFilter.addEventListener('change', preserveRadiologySelections, true);
                    }
                    apex.jQuery(document).on('apexafterrefresh', '#p109_selected_examination_summary', function () {
                        window.p109SelectionFeedback.render();
                    });
                });
            }());
            ```
    }
