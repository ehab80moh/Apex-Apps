                        RAISE_APPLICATION_ERROR(-20442, 'لا يمكنك فتح بيانات هذا الطلب.');
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND OR TOO_MANY_ROWS OR VALUE_ERROR THEN
                        RAISE_APPLICATION_ERROR(-20442, 'تعذر تحديد الطلب. افتحه مجددًا من قائمة الطلبات.');
                END;
