    button approve (
        buttonName: APPROVE
        label: &APP_TEXT$ITR_PAGE52_APPROVE.
        layout {
            sequence: 20
            region: @action-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P109_TASK_ID IS NULL OR NVL(:P109_CAN_REVIEW, 'N') <> 'Y' THEN
                        RETURN FALSE;
                    END IF;
                    BEGIN
                        RETURN apex_human_task.is_allowed(
                                   p_task_id   => :P109_TASK_ID,
                                   p_operation => apex_human_task.c_task_op_approve)
                            OR apex_human_task.is_allowed(
                                   p_task_id   => :P109_TASK_ID,
                                   p_operation => apex_human_task.c_task_op_claim);
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN FALSE;
                        WHEN OTHERS THEN
                            IF SQLCODE = -1403 THEN
                                RETURN FALSE;
                            END IF;
                            RAISE;
                    END;
                END;
                ```
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

