    validation medical-task-context-authorized (
        name: Medical task context authorized
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                with visible_task as (
                    select task_id
                      from table(apex_human_task.get_tasks(
                               p_context => 'SINGLE_TASK',
                               p_task_id => :P109_TASK_ID))
                ),
                task_parameter as (
                    select max(case when param_static_id = 'T_REQUEST_ID' then to_number(param_value) end) as T_REQUEST_ID,
                           max(case when param_static_id = 'T_REQUEST_TYPE_ID' then to_number(param_value) end) as T_REQUEST_TYPE_ID
                      from apex_task_parameters
                     where task_id = :P109_TASK_ID
                )
                select 1
                  from task_parameter p
                 where p.T_REQUEST_ID = :P109_REFERAL_ID
                   and p.T_REQUEST_TYPE_ID = 106
                   and exists (select 1 from visible_task)
                   and med.apr_med_approver_task_api.has_medical_task_access(:APP_USER,52,:P109_TASK_ID) = 'Y'
                ```
        }
        error {
            errorMessage: &APP_TEXT$MEDICAL_REFERRAL_APPROVAL_TASK_UNAVAILABLE.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CLAIM,APPROVE,REJECT_CONFIRM
        }
    )

    process admin-cancel (
        name: Cancel request by task initiator
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_task_id NUMBER;
                    l_workflow_id NUMBER;
                    l_workflow_state VARCHAR2(30);
                BEGIN
                    -- Repeat ownership and request binding on the server, including forged submits.
                SELECT t.task_id INTO l_task_id
                  FROM med.md_referal_flow flow
                  JOIN apex_tasks t ON t.application_id = 104
                                  AND LOWER(t.task_def_static_id) = 'approval-task'
                 WHERE flow.referal_id = :P109_REFERAL_ID
                   AND flow.status = 'PENDING_APPROVAL'
                   AND UPPER(TRIM(flow.emp_id_snapshot)) = UPPER(TRIM(:APP_USER))
                   AND UPPER(TRIM(t.initiator)) = UPPER(TRIM(:APP_USER))
                   AND t.state_code NOT IN ('COMPLETED','CANCELLED','CANCELED','ERRORED','FAILED')
                   AND (:P109_TASK_ID IS NULL OR t.task_id = :P109_TASK_ID)
                   AND (flow.current_task_id IS NULL OR flow.current_task_id = t.task_id)
                   AND EXISTS (SELECT 1 FROM apex_task_parameters p WHERE p.task_id=t.task_id
                                AND p.param_static_id='T_REQUEST_TYPE_ID' AND TRIM(p.param_value)='106')
                   AND EXISTS (SELECT 1 FROM apex_task_parameters p WHERE p.task_id=t.task_id
                                AND p.param_static_id='T_REQUEST_ID'
                                AND TO_NUMBER(p.param_value DEFAULT NULL ON CONVERSION ERROR)=flow.referal_id);
                    IF NOT apex_human_task.is_allowed(p_task_id=>l_task_id,
                                                     p_operation=>apex_human_task.c_task_op_cancel) THEN
                        RAISE_APPLICATION_ERROR(-20439, 'إلغاء الطلب متاح لمقدم المهمة فقط قبل اكتمالها.');
                    END IF;
                    SELECT workflow_id INTO l_workflow_id
                      FROM med.md_referal_flow WHERE referal_id=:P109_REFERAL_ID;
                    IF l_workflow_id IS NOT NULL THEN
                        SELECT state_code INTO l_workflow_state FROM apex_workflows
                         WHERE application_id=104 AND workflow_id=l_workflow_id;
                        IF l_workflow_state NOT IN ('ACTIVE','SUSPENDED','FAULTED') THEN
                            RAISE_APPLICATION_ERROR(-20441, 'مسار الطلب لم يعد مفتوحًا للإلغاء.');
                        END IF;
                        -- Termination cancels its waiting task. Do not cancel that task twice.
                        apex_workflow.terminate(p_instance_id=>l_workflow_id);
                    ELSE
                        apex_human_task.cancel_task(p_task_id=>l_task_id);
                    END IF;
                    -- Native on-cancel action updates the clinical request; retain the entered reason.
                    UPDATE med.md_referal_flow
                       SET status_reason = TRIM(:P109_ADMIN_CANCEL_REASON),
                           cancelled_by = TRIM(:APP_USER)
                     WHERE referal_id = :P109_REFERAL_ID AND status = 'CANCELLED'
                       AND UPPER(TRIM(emp_id_snapshot)) = UPPER(TRIM(:APP_USER));
                    IF SQL%ROWCOUNT <> 1 THEN
                        RAISE_APPLICATION_ERROR(-20440, 'تعذر تأكيد إلغاء الطلب. أعد فتحه وحاول مرة أخرى.');
                    END IF;
                    :P109_TASK_ID := NULL;
                    :P109_CAN_REVIEW := 'N';
                EXCEPTION
                    WHEN NO_DATA_FOUND OR TOO_MANY_ROWS THEN
                        RAISE_APPLICATION_ERROR(-20439, 'إلغاء الطلب متاح لمقدم المهمة فقط قبل اكتمالها.');
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 52407024862262064
        }
        serverSideCondition {
            whenButtonPressed: @admin-cancel-confirm
        }
        security {
            authorizationScheme: mustNotBePublicUser
        }
        comments {
            comments:
                ```
                owner: MED
                package: MD_REFERAL_WF_PKG
                procedureOrFunction: CANCEL_TASK (native on-cancel action)
                ```
        }
    )

