    region administrative-cancel-dialog (
        name: Requester cancellation
        title: &APP_TEXT$MEDICAL_REFERRAL_CANCEL.
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="p109-destructive-note" role="note" aria-label="&APP_TEXT$MEDICAL_REFERRAL_CANCEL.">
                    <span class="t-Icon fa fa-exclamation-triangle" aria-hidden="true"></span>
                    <div>
                        <strong>&APP_TEXT$MEDICAL_REFERRAL_CANCEL_CONFIRMATION.</strong>
                        أدخل سبب الإلغاء. يظهر هذا الإجراء لمقدم المهمة فقط قبل اكتمالها.
                    </div>
                </div>
                ```
        }
        layout {
            sequence: 100
            slot: contentBody
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size600x400
                t-Form--stretchInputs
            ]
            cssClasses: p109-admin-cancel-dialog
        }
        advanced {
            htmlDomId: p109_administrative_cancel_dialog
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT t.task_id
                  FROM med.md_referal_flow flow
                  JOIN apex_tasks t ON t.application_id = 104
                                  AND LOWER(t.task_def_static_id) = 'approval-task'
                 WHERE flow.referal_id = :P109_REFERAL_ID
                   AND flow.status = 'PENDING_APPROVAL'
                   AND UPPER(TRIM(flow.emp_id_snapshot)) = UPPER(TRIM(:APP_USER))
                   AND UPPER(TRIM(t.initiator)) = UPPER(TRIM(:APP_USER))
                   AND t.state_code NOT IN ('COMPLETED','CANCELLED','CANCELED','ERRORED','FAILED')
                   AND (:P109_TASK_ID IS NULL OR t.task_id = :P109_TASK_ID)
                   AND (flow.current_task_id IS NULL OR flow.current_task_id = t.task_id)
                   AND EXISTS (SELECT 1 FROM apex_task_parameters p WHERE p.task_id=t.task_id
                                AND p.param_static_id='T_REQUEST_TYPE_ID' AND TRIM(p.param_value)='106')
                   AND EXISTS (SELECT 1 FROM apex_task_parameters p WHERE p.task_id=t.task_id
                                AND p.param_static_id='T_REQUEST_ID'
                                AND TO_NUMBER(p.param_value DEFAULT NULL ON CONVERSION ERROR)=flow.referal_id)
                ```
        }
        security {
            authorizationScheme: mustNotBePublicUser
        }
    )

