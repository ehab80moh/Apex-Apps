    process save-doctor-selections (
        name: Save doctor examination selections
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_lab_requested       PLS_INTEGER;
                    l_radiology_requested PLS_INTEGER;
                    l_lab_exam_ids        VARCHAR2(4000) := :P109_LAB_ITEMS;
                    l_radiology_exam_ids  VARCHAR2(4000) := :P109_RADIOLOGY_ITEMS;
                BEGIN
                    SELECT COUNT(CASE WHEN provider_category = 'LAB' THEN 1 END),
                           COUNT(CASE WHEN provider_category IN ('MEDICAL_CENTER','RADIOLOGY_CENTER') THEN 1 END)
                      INTO l_lab_requested,
                           l_radiology_requested
                      FROM MED.MD_REFERAL_REQUEST_CATEGORY
                     WHERE referal_id = :P109_REFERAL_ID;
                
                    IF l_lab_requested = 0 THEN
                        l_lab_exam_ids := NULL;
                    END IF;
                
                    IF l_radiology_requested = 0 THEN
                        l_radiology_exam_ids := NULL;
                    END IF;
                
                    MED.MD_REFERAL_EXT_PKG.SAVE_DOCTOR_SELECTIONS(
                        P_REFERAL_ID         => :P109_REFERAL_ID,
                        P_LAB_EXAM_IDS       => l_lab_exam_ids,
                        P_RADIOLOGY_EXAM_IDS => l_radiology_exam_ids,
                        P_ACTOR              => :APP_USER
                    );
                END;
                ```
        }
        execution {
            sequence: 35
        }
        advanced {
            executionMappingIdentifier: 58707304050439205
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
        security {
            authorizationScheme: @medical-referral-task-reviewer
        }
    )

    process validate-request-context (
        name: Validate exact request before decision
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_request_id NUMBER;
                    l_owner VARCHAR2(128);
                    l_initiator VARCHAR2(128);
                BEGIN
                    -- A task is the authoritative source of its request, never the previous drawer.
                    IF :P109_TASK_ID IS NOT NULL THEN
                        SELECT TO_NUMBER(rp.param_value DEFAULT NULL ON CONVERSION ERROR), t.initiator
                          INTO l_request_id, l_initiator
                          FROM apex_tasks t
                          JOIN apex_task_parameters rp ON rp.task_id=t.task_id
                                                      AND rp.param_static_id='T_REQUEST_ID'
                         WHERE t.task_id=TO_NUMBER(:P109_TASK_ID)
                           AND t.application_id=104
                           AND LOWER(t.task_def_static_id)='approval-task'
                           AND EXISTS (SELECT 1 FROM apex_task_parameters tp
                                        WHERE tp.task_id=t.task_id
                                          AND tp.param_static_id='T_REQUEST_TYPE_ID'
                                          AND TRIM(tp.param_value)='106');
                        IF l_request_id IS NULL THEN
                            RAISE_APPLICATION_ERROR(-20442, 'تعذر تحديد الطلب المرتبط بالمهمة.');
                        END IF;
                        SELECT emp_id_snapshot INTO l_owner FROM med.md_referal_flow
                         WHERE referal_id=l_request_id;
                        IF NVL(UPPER(TRIM(l_owner)), CHR(0)) <> NVL(UPPER(TRIM(:APP_USER)), CHR(1))
                           OR NVL(UPPER(TRIM(l_initiator)), CHR(0)) <> NVL(UPPER(TRIM(:APP_USER)), CHR(1)) THEN
                            IF NVL(med.apr_med_approver_task_api.has_medical_task_access(
                                       :APP_USER, 52, TO_NUMBER(:P109_TASK_ID)), 'N') <> 'Y' THEN
                                RAISE_APPLICATION_ERROR(-20442, 'لا يمكنك فتح بيانات هذه المهمة.');
                            END IF;
                        END IF;
                        IF :P109_REFERAL_ID IS NULL OR TO_NUMBER(:P109_REFERAL_ID) <> l_request_id THEN
                            RAISE_APPLICATION_ERROR(-20442, 'تغير سياق الطلب. افتح المهمة مجددًا قبل اتخاذ القرار.');
                        END IF;
                    END IF;
                    IF :P109_REFERAL_ID IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20442, 'اختر الطلب من قائمة الطلبات لعرض بياناته.');
                    END IF;
                    SELECT emp_id_snapshot INTO l_owner FROM med.md_referal_flow
