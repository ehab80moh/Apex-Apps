            buttonTemplate: @awesome-text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times-circle-o
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
            }
        )

