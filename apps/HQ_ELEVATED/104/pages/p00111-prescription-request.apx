    button submit (
        buttonName: SUBMIT
        label: &APP_TEXT$P111_SUBMIT.
        layout {
            sequence: 10
            region: @prescription-action-bar
            slot: create
        }
        appearance {
            buttonTemplate: @awesome-text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-paper-plane
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction show-prescription-instructions (
        name: Show prescription instructions
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.prescriptionRequestPage.openInstructions();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction toggle-monthly-section (
        name: Toggle monthly medicines region
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P111_REQUEST_KIND
        }
        clientSideCondition {
            type: item=value
            item: P111_REQUEST_KIND
            value: MONTHLY
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @monthly-medicines
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @monthly-medicines
            }
            execution {
                sequence: 10
            }
        )

    )

    validation monthly-selection-required (
        name: Monthly medicine selection required
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                (
                    nvl(:P111_REQUEST_KIND, 'ONE_TIME') <> 'MONTHLY'
                    or not exists (
                        select 1
                          from med.emp_monthly_meds
                         where emp_id = :P111_EMPLOYEE_NUMBER
                           and (expiration_date is null or expiration_date >= trunc(sysdate))
                    )
                    or trim(:P111_MONTHLY_MED_IDS) is not null
                )
                ```
        }
        error {
            errorMessage: &APP_TEXT$P111_MONTHLY_MEDICINE_REQUIRED.
            associatedItem: @P111_MONTHLY_MED_IDS
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process submit-prescription-request (
        name: Submit prescription request
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_request_id number;
                    l_workflow_id number;
                    l_item_id number;
                    l_attachment_id number;
                    l_names apex_t_varchar2;
                    l_file apex_application_temp_files%rowtype;
                    l_ids apex_t_varchar2;
                    l_notes apex_t_varchar2;
                    l_extra_lines apex_t_varchar2;
                    l_extra_parts apex_t_varchar2;
                    l_note varchar2(1000);
                    l_equals pls_integer;
                    l_active_monthly_count number;
                    l_approver_list varchar2(240);
                    function p111_parse_payload_number(
                        p_value varchar2,
                        p_field_label varchar2,
                        p_allow_decimal boolean default false
                    ) return number is
                        l_value varchar2(1000);
                        l_pattern varchar2(100);
                    begin
                        l_value := translate(regexp_replace(p_value, '(^[[:space:]]+)|([[:space:]]+$)', ''), '٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹', '01234567890123456789');
                        if p_allow_decimal then
                            l_value := replace(replace(l_value, '٫', '.'), ',','.');
                            l_pattern := '^[0-9]{1,38}([.][0-9]{1,12})?$';
                        else
                            l_pattern := '^[0-9]{1,38}$';
                        end if;
                        if l_value is null or not regexp_like(l_value, l_pattern) or length(replace(l_value, '.', '')) > 38 then
                            raise_application_error(-20212, APEX_LANG.MESSAGE('P111_MEDICINE_PAYLOAD_INVALID') || ' ' || p_field_label || ' ' || APEX_LANG.MESSAGE('P111_NUMERIC_INPUT_SUFFIX'));
                        end if;
                        return to_number(l_value, '99999999999999999999999999999999999999D999999999999', 'NLS_NUMERIC_CHARACTERS=''.,''');
                    exception
                        when value_error then
                            raise_application_error(-20212, APEX_LANG.MESSAGE('P111_MEDICINE_PAYLOAD_INVALID') || ' ' || p_field_label || ' ' || APEX_LANG.MESSAGE('P111_NUMERIC_INPUT_SUFFIX'));
                    end p111_parse_payload_number;
                begin
                    central.apr_med_site_approval_pkg.ensure_route(
                        p_emp_number => :P111_EMPLOYEE_NUMBER,
                        p_request_type_id => 202,
                        p_actor => :APP_USER,
                        p_approver_list => l_approver_list
                    );
                    med.md_pres_request_pkg.create_request(:APP_USER,:P111_EMPLOYEE_NUMBER,:P111_REQUEST_KIND,:P111_BENEFICIARY_KEY,null,:P111_EMPLOYEE_NOTE,l_request_id);
                    if :P111_MONTHLY_MED_IDS is not null then
                        l_ids:=apex_string.split(replace(:P111_MONTHLY_MED_IDS,' ',''),',');
                        for i in 1..l_ids.count loop
                            l_note:=null;
                            if :P111_MONTHLY_NOTES is not null then
                                l_notes:=apex_string.split(:P111_MONTHLY_NOTES,chr(10));
                                for n in 1..l_notes.count loop
                                    l_equals:=instr(l_notes(n),'=');
                                    if l_equals>1 and trim(substr(l_notes(n),1,l_equals-1))=trim(l_ids(i)) then l_note:=trim(substr(l_notes(n),l_equals+1)); exit; end if;
                                end loop;
                            end if;
                            if trim(l_ids(i)) is not null then med.md_pres_request_pkg.add_item(l_request_id,:APP_USER,null,null,null,p111_parse_payload_number(l_ids(i),APEX_LANG.MESSAGE('P111_MEDICINE_NUMBER_FIELD')),l_note,l_item_id); end if;
                        end loop;
                    end if;
                    if :P111_EXTRA_MED_LINES is not null then
                        l_extra_lines:=apex_string.split(:P111_EXTRA_MED_LINES,chr(10));
                        for i in 1..l_extra_lines.count loop
                            if trim(l_extra_lines(i)) is not null then
                                l_extra_parts:=apex_string.split(l_extra_lines(i),'|');
                                if l_extra_parts.count >= 1 and trim(l_extra_parts(1)) is not null then
                                    med.md_pres_request_pkg.add_item(
                                        l_request_id,
                                        :APP_USER,
                                        p111_parse_payload_number(l_extra_parts(1),APEX_LANG.MESSAGE('P111_MEDICINE_NUMBER_FIELD')),
                                        case when l_extra_parts.count >= 2 and trim(l_extra_parts(2)) is not null then p111_parse_payload_number(l_extra_parts(2),APEX_LANG.MESSAGE('P111_UNIT_FIELD')) end,
                                        case when l_extra_parts.count >= 3 and trim(l_extra_parts(3)) is not null then p111_parse_payload_number(l_extra_parts(3),APEX_LANG.MESSAGE('P111_QUANTITY_FIELD'),true) end,
                                        null,
                                        null,
                                        l_item_id
                                    );
                                end if;
                            end if;
                        end loop;
                    elsif :P111_MED_ID is not null then
                        l_extra_lines:=apex_string.split(replace(:P111_MED_ID,':',','),',');
                        for i in 1..l_extra_lines.count loop
                            if trim(l_extra_lines(i)) is not null then
                                med.md_pres_request_pkg.add_item(
                                    l_request_id,
                                    :APP_USER,
                                    p111_parse_payload_number(l_extra_lines(i),APEX_LANG.MESSAGE('P111_MEDICINE_NUMBER_FIELD')),
                                    case when :P111_UNIT_ID is not null then p111_parse_payload_number(:P111_UNIT_ID,APEX_LANG.MESSAGE('P111_UNIT_FIELD')) end,
                                    case when :P111_QUANTITY is not null then p111_parse_payload_number(:P111_QUANTITY,APEX_LANG.MESSAGE('P111_QUANTITY_FIELD'),true) else 1 end,
                                    null,
                                    null,
                                    l_item_id
                                );
                            end if;
                        end loop;
                    end if;
                    if :P111_ATTACHMENTS is not null then
                        l_names:=apex_string.split(:P111_ATTACHMENTS,':');
                        for i in 1..l_names.count loop
                            select * into l_file from apex_application_temp_files where name=l_names(i);
                            med.md_pres_request_pkg.attach_file(l_request_id,:APP_USER,l_file.filename,l_file.mime_type,l_file.blob_content,'CAMERA',l_attachment_id);
                        end loop;
                    end if;
                    select count(*)
                      into l_active_monthly_count
                      from med.emp_monthly_meds
                     where emp_id=:P111_EMPLOYEE_NUMBER
                       and (expiration_date is null or expiration_date>=trunc(sysdate));
                    begin
                        med.md_pres_request_pkg.submit_request(
                            l_request_id,
                            :APP_USER,
                            case when upper(:P111_REQUEST_KIND)='MONTHLY' and l_active_monthly_count>0 then 'Y' else 'N' end
                        );
                    exception
                        when others then
                            if sqlcode=-20211 then
                                raise_application_error(-20211,APEX_LANG.MESSAGE('P111_ATTACHMENT_VALIDATION_ERROR'));
                            end if;
                            raise;
                    end;
                
                    l_workflow_id := apex_workflow.start_workflow(
                        p_application_id => 104,
                        p_static_id => 'GENERIC_APPROVAL_WF',
                        p_parameters => apex_workflow.t_workflow_parameters(
                            1 => apex_workflow.t_workflow_parameter(static_id=>'P_REQUEST_ID',string_value=>to_char(l_request_id)),
                            2 => apex_workflow.t_workflow_parameter(static_id=>'P_REQUEST_SOURCE',string_value=>'MED.MD_PRES_REQUEST'),
                            3 => apex_workflow.t_workflow_parameter(static_id=>'P_REQUEST_TITLE',string_value=>APEX_LANG.MESSAGE('P111_PRESCRIPTION_REQUEST_WORKFLOW_TITLE')),
                            4 => apex_workflow.t_workflow_parameter(static_id=>'P_REQUEST_TYPE_ID',string_value=>'202'),
                            5 => apex_workflow.t_workflow_parameter(static_id=>'P_EMP_ID',string_value=>:P111_EMPLOYEE_NUMBER),
                            6 => apex_workflow.t_workflow_parameter(static_id=>'P_EMP_NAME',string_value=>central.get_emp_name(:P111_EMPLOYEE_NUMBER))
                        ),
                        p_initiator => :P111_EMPLOYEE_NUMBER,
                        p_detail_pk => to_char(l_request_id)
                    );
                    med.md_pres_request_pkg.attach_workflow(l_request_id,l_workflow_id);
                    :P111_REQUEST_ID:=l_request_id;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 64377011828241181
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Open prescription request details
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 112
                items: {
                    P112_REQUEST_ID: &P111_REQUEST_ID.
                }
            }
        }
    )

)
