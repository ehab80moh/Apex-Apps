    dynamicAction show-success-message (
        name: Show Success Message
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    
                    var dialogData = this.data || {};
                    var successMessage = dialogData.successMessage;
                    var messageText = typeof successMessage === "string"
                        ? successMessage
                        : successMessage && successMessage.text;
                    
                    if ( messageText ) {
                        apex.message.showPageSuccess(messageText);
                    }
                                
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process create-collection (
        name: create collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION(p_collection_name => 'USER_TASKS');
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 118244782537841130
        }
        serverSideCondition {
            whenButtonPressed: @approve-all
        }
    )

)
