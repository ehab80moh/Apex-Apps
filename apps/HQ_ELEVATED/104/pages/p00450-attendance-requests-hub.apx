page 450 (
    name: سجل الحضور والطلبات الموحد
    alias: ATTENDANCE-REQUESTS-HUB
    title: سجل الحضور والطلبات الموحد
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
                        /* ==========================================================================
                           Executive Icon Hub - Page 450 Styling
                           ========================================================================== */
            
                        /* RTL & Layout Foundations */
                        body {
                            background-color: #f8fafc;
                        }
            
                        /* 1. Header Profile & Filter Card */
                        .hub-header-container {
                            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                            border-radius: 18px;
                            padding: 1.5rem 2rem;
                            color: #ffffff;
                            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15);
                            margin-bottom: 1.5rem;
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            flex-wrap: wrap;
                            gap: 1.5rem;
                        }
            
                        .hub-profile-section {
                            display: flex;
                            align-items: center;
                            gap: 1.25rem;
                        }
            
                        .hub-profile-avatar {
                            width: 68px;
                            height: 68px;
                            border-radius: 50%;
                            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
                            border: 3px solid rgba(255, 255, 255, 0.25);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.85rem;
                            color: #ffffff;
                            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
                            overflow: hidden;
                            flex-shrink: 0;
                        }
            
                        .hub-avatar-img {
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            border-radius: 50%;
                            display: block;
                        }
            
                        .hub-profile-details {
                            display: flex;
                            flex-direction: column;
                            gap: 0.35rem;
                        }
            
                        .hub-profile-title {
                            font-size: 1.35rem;
                            font-weight: 800;
                            color: #ffffff;
                            margin: 0;
                            letter-spacing: -0.01em;
                        }
            
                        .hub-profile-meta {
                            display: flex;
                            align-items: center;
                            gap: 0.75rem;
                            flex-wrap: wrap;
                        }
            
                        .hub-badge-code {
                            background: rgba(255, 255, 255, 0.12);
                            border: 1px solid rgba(255, 255, 255, 0.2);
                            padding: 0.25rem 0.75rem;
                            border-radius: 9999px;
                            font-size: 0.82rem;
                            font-weight: 600;
                            color: #cbd5e1;
                        }
            
                        .hub-badge-role {
                            background: rgba(59, 130, 246, 0.25);
                            border: 1px solid rgba(59, 130, 246, 0.4);
                            padding: 0.25rem 0.75rem;
                            border-radius: 9999px;
                            font-size: 0.82rem;
                            font-weight: 600;
                            color: #93c5fd;
                        }
            
                        .hub-badge-dept {
                            background: rgba(16, 185, 129, 0.2);
                            border: 1px solid rgba(16, 185, 129, 0.35);
                            padding: 0.25rem 0.75rem;
                            border-radius: 9999px;
                            font-size: 0.82rem;
                            font-weight: 600;
                            color: #a7f3d0;
                        }
            
                        /* 2. Unified Request & Balance Hub (4 Cards Grid) */
                        .hub-cards-grid {
                            display: grid;
                            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                            gap: 1.25rem;
                            margin-bottom: 1.75rem;
                        }
            
                        .hub-kpi-card {
                            background: #ffffff;
                            border-radius: 16px;
                            border: 1px solid #e2e8f0;
                            padding: 1.25rem 1.35rem;
                            box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05);
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
                            position: relative;
                            overflow: hidden;
                        }
            
                        .hub-kpi-card:hover {
                            transform: translateY(-4px);
                            box-shadow: 0 12px 24px -4px rgba(15, 23, 42, 0.1);
                            border-color: #cbd5e1;
                        }
            
                        .hub-card-top {
                            display: flex;
                            align-items: center;
                            gap: 0.9rem;
                            margin-bottom: 1rem;
                        }
            
                        .hub-card-icon-box {
                            width: 48px;
                            height: 48px;
                            border-radius: 12px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.35rem;
                            flex-shrink: 0;
                        }
            
                        .hub-icon--blue {
                            background: #eff6ff;
                            color: #2563eb;
                            border: 1px solid #bfdbfe;
                        }
            
                        .hub-icon--teal {
                            background: #f0fdfa;
                            color: #0d9488;
                            border: 1px solid #99f6e4;
                        }
            
                        .hub-icon--emerald {
                            background: #ecfdf5;
                            color: #059669;
                            border: 1px solid #a7f3d0;
                        }
            
                        .hub-icon--amber {
                            background: #fffbeb;
                            color: #d97706;
                            border: 1px solid #fde68a;
                        }
            
                        .hub-card-meta {
                            display: flex;
                            flex-direction: column;
                        }
            
                        .hub-card-title {
                            font-size: 1.05rem;
                            font-weight: 700;
                            color: #0f172a;
                            line-height: 1.2;
                        }
            
                        .hub-card-subtitle {
                            font-size: 0.78rem;
                            color: #64748b;
                            margin-top: 0.2rem;
                        }
            
                        .hub-card-body {
                            margin-bottom: 1rem;
                        }
            
                        .hub-card-stat {
                            display: flex;
                            align-items: baseline;
                            gap: 0.35rem;
                            margin-bottom: 0.75rem;
                        }
            
                        .hub-stat-num {
                            font-size: 2.3rem;
                            font-weight: 800;
                            color: #0f172a;
                            line-height: 1;
                            letter-spacing: -0.02em;
                        }
            
                        .hub-stat-unit {
                            font-size: 0.95rem;
                            font-weight: 600;
                            color: #64748b;
                        }
            
                        .hub-card-tags {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 0.4rem;
                        }
            
                        .hub-tag {
                            display: inline-flex;
                            align-items: center;
                            padding: 0.22rem 0.6rem;
                            border-radius: 9999px;
                            font-size: 0.75rem;
                            font-weight: 700;
                        }
            
                        .hub-tag--blue { background: #dbeafe; color: #1e40af; }
                        .hub-tag--blue-subtle { background: #eff6ff; color: #3b82f6; border: 1px solid #dbeafe; }
                        .hub-tag--teal { background: #ccfbf1; color: #115e59; }
                        .hub-tag--teal-subtle { background: #f0fdfa; color: #0d9488; border: 1px solid #ccfbf1; }
                        .hub-tag--emerald { background: #d1fae5; color: #065f46; }
                        .hub-tag--emerald-subtle { background: #ecfdf5; color: #059669; border: 1px solid #d1fae5; }
                        .hub-tag--amber { background: #fef3c7; color: #92400e; }
                        .hub-tag--gray { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
            
                        .hub-card-footer {
                            padding-top: 0.75rem;
                            border-top: 1px solid #f1f5f9;
                            font-size: 0.8rem;
                            color: #64748b;
                            display: flex;
                            align-items: center;
                            gap: 0.4rem;
                        }
            
                        /* 3. Statement Table Badges & Layout */
                        #attendance-statement .t-Region-header {
                            background: #1e293b;
                            color: #ffffff;
                            border-top-left-radius: 14px;
                            border-top-right-radius: 14px;
                            padding: 0.9rem 1.5rem;
                        }
            
                        #attendance-statement .t-Region-title {
                            color: #ffffff !important;
                            font-weight: 700 !important;
                            font-size: 1.15rem !important;
                        }
            
                        .hub-time-badge {
                            display: inline-flex;
                            align-items: center;
                            gap: 0.4rem;
                            padding: 0.35rem 0.75rem;
                            border-radius: 8px;
                            font-size: 0.88rem;
                            font-weight: 700;
                            white-space: nowrap;
                        }
            
                        .hub-time--ontime {
                            background: #ecfdf5;
                            color: #065f46;
                            border: 1px solid #a7f3d0;
                        }
            
                        .hub-time--late {
                            background: #fef2f2;
                            color: #991b1b;
                            border: 1px solid #fecaca;
                        }
            
                        .hub-time--ontime-out {
                            background: #eff6ff;
                            color: #1e40af;
                            border: 1px solid #bfdbfe;
                        }
            
                        .hub-time--early {
                            background: #fffbeb;
                            color: #92400e;
                            border: 1px solid #fde68a;
                        }
            
                        .hub-time--empty {
                            background: #f8fafc;
                            color: #94a3b8;
                            border: 1px dashed #cbd5e1;
                        }
            
                        .hub-duration-badge {
                            display: inline-block;
                            padding: 0.35rem 0.75rem;
                            border-radius: 8px;
                            font-size: 0.88rem;
                            font-weight: 700;
                            background: #f1f5f9;
                            color: #334155;
                            border: 1px solid #e2e8f0;
                        }
            
                        .hub-duration--none {
                            background: transparent;
                            color: #94a3b8;
                            border: none;
                        }
            
                        .hub-status-badge {
                            display: inline-flex;
                            align-items: center;
                            padding: 0.35rem 0.85rem;
                            border-radius: 9999px;
                            font-size: 0.82rem;
                            font-weight: 700;
                            white-space: nowrap;
                        }
            
                        .hub-status--success {
                            background: #dcfce7;
                            color: #166534;
                        }
            
                        .hub-status--warning {
                            background: #fef3c7;
                            color: #92400e;
                        }
            
                        .hub-status--request {
                            background: #e0e7ff;
                            color: #3730a3;
                            border: 1px solid #c7d2fe;
                        }
            
                        .hub-status--absent {
                            background: #fee2e2;
                            color: #b91c1c;
                        }
            
                        .hub-status--rest {
                            background: #f1f5f9;
                            color: #475569;
                        }
            
                        .hub-status--pending {
                            background: #eff6ff;
                            color: #1e40af;
                        }
            
                        /* Table Row Enhancements */
                        #attendance-statement .t-Report-report {
                            border-collapse: separate;
                            border-spacing: 0;
                            width: 100%;
                        }
            
                        #attendance-statement .t-Report-report th {
                            background: #f8fafc;
                            color: #475569;
                            font-weight: 700;
                            font-size: 0.88rem;
                            padding: 0.85rem 1rem;
                            border-bottom: 2px solid #e2e8f0;
                        }
            
                        #attendance-statement .t-Report-report td {
                            padding: 0.85rem 1rem;
                            border-bottom: 1px solid #edf2f7;
                            vertical-align: middle;
                        }
            
                        #attendance-statement .t-Report-report tr:hover td {
                            background-color: #f0f7ff;
                        }
            
                        /* Borderless wrapper for Profile Card and Unified Requests Hub */
                        #EMP_PROFILE_CARD .t-Report-colHead,
                        #EMP_PROFILE_CARD thead,
                        #EMP_PROFILE_CARD .t-Report-tableWrap,
                        #EMP_PROFILE_CARD .t-Report-wrap,
                        #UNIFIED_REQUESTS_HUB .t-Report-colHead,
                        #UNIFIED_REQUESTS_HUB thead,
                        #UNIFIED_REQUESTS_HUB .t-Report-tableWrap,
                        #UNIFIED_REQUESTS_HUB .t-Report-wrap {
                            border: none !important;
                            box-shadow: none !important;
                            background: transparent !important;
                        }
            
                        #EMP_PROFILE_CARD thead,
                        #UNIFIED_REQUESTS_HUB thead {
                            display: none !important;
                        }
            
                        #EMP_PROFILE_CARD table,
                        #EMP_PROFILE_CARD td,
                        #UNIFIED_REQUESTS_HUB table,
                        #UNIFIED_REQUESTS_HUB td {
                            border: none !important;
                            padding: 0 !important;
                            background: transparent !important;
                        }
            ```
    }
    security {
        authorizationScheme: @erc-self-services
    }

    region attendance-statement (
        name: بيان الحضور والانصراف وسجل البصمات
        title: بيان الحضور والانصراف وسجل البصمات اليومية
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                                WITH selected_period AS (
                                    SELECT
                                        TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY'))) AS selected_year,
                                        NVL(:P450_MONTH, 'ALL') AS selected_month
                                    FROM dual
                                ), period_bounds AS (
                                    SELECT
                                        CASE
                                            WHEN selected_month = 'ALL' THEN
                                                TO_DATE(TO_CHAR(selected_year) || '0101', 'YYYYMMDD')
                                            ELSE
                                                TO_DATE(TO_CHAR(selected_year) || LPAD(selected_month, 2, '0') || '01', 'YYYYMMDD')
                                        END AS period_start,
                                        ADD_MONTHS(
                                            CASE
                                                WHEN selected_month = 'ALL' THEN
                                                    TO_DATE(TO_CHAR(selected_year) || '0101', 'YYYYMMDD')
                                                ELSE
                                                    TO_DATE(TO_CHAR(selected_year) || LPAD(selected_month, 2, '0') || '01', 'YYYYMMDD')
                                            END,
                                            CASE WHEN selected_month = 'ALL' THEN 12 ELSE 1 END
                                        ) AS period_end
                                    FROM selected_period
                                ), calendar_days AS (
                                    SELECT period_start + LEVEL - 1 AS log_date
                                    FROM period_bounds
                                    CONNECT BY LEVEL <= period_end - period_start
                                ), daily_summary AS (
                                    SELECT
                                        TRUNC(s.start_time) AS log_date,
                                        MIN(CASE WHEN s.request_category LIKE 'Sign In%' THEN s.start_time END) AS sign_in_time,
                                        MAX(CASE WHEN s.request_category LIKE 'Sign Out%' THEN s.start_time END) AS sign_out_time,
                                        MAX(CASE WHEN s.request_category LIKE 'Sign In%' AND s.css_class = 'u-danger' THEN 1 ELSE 0 END) AS is_late,
                                        MAX(CASE WHEN s.request_category LIKE 'Sign Out%' AND s.css_class = 'u-danger' THEN 1 ELSE 0 END) AS is_early_departure
                                    FROM CENTRAL.EMP_REQUESTS_SUMMARY s
                                    CROSS JOIN period_bounds p
                                    WHERE s.emp_id = NVL(:P450_EMP_ID, :APP_USER)
                                      AND s.start_time >= p.period_start
                                      AND s.start_time < p.period_end
                                    GROUP BY TRUNC(s.start_time)
                                ), request_rows AS (
                                    SELECT s.start_time, s.end_time, s.request_category
                                    FROM CENTRAL.EMP_REQUESTS_SUMMARY s
                                    CROSS JOIN period_bounds p
                                    WHERE s.emp_id = NVL(:P450_EMP_ID, :APP_USER)
                                      AND s.start_time < p.period_end
                                      AND NVL(s.end_time, s.start_time) >= p.period_start
                                      AND s.request_category NOT LIKE 'Sign In%'
                                      AND s.request_category NOT LIKE 'Sign Out%'
                                ), request_days AS (
                                    SELECT
                                        d.log_date,
                                        LISTAGG(DISTINCT r.request_category, ' | ') WITHIN GROUP (ORDER BY r.request_category) AS request_categories
                                    FROM calendar_days d
                                    JOIN request_rows r
                                      ON r.start_time < d.log_date + 1
                                     AND NVL(r.end_time, r.start_time) >= d.log_date
                                    GROUP BY d.log_date
                                )
                                SELECT
                                    d.log_date,
                                    TO_CHAR(d.log_date, 'FMDay, DD/MM/YYYY', 'NLS_DATE_LANGUAGE=ARABIC') AS formatted_day,
                                    -- Check In HTML
                                    CASE
                                        WHEN sign_in_time IS NOT NULL THEN
                                            '<span class="hub-time-badge ' || (CASE WHEN is_late = 1 THEN 'hub-time--late' ELSE 'hub-time--ontime' END) || '">' ||
                                            '<i class="fa fa-sign-in" aria-hidden="true"></i> ' ||
                                            TO_CHAR(sign_in_time, 'HH12:MI AM', 'NLS_DATE_LANGUAGE=ARABIC') ||
                                            '</span>'
                                        ELSE '<span class="hub-time-badge hub-time--empty">-</span>'
                                    END AS check_in_html,
                                    -- Check Out HTML
                                    CASE
                                        WHEN sign_out_time IS NOT NULL THEN
                                            '<span class="hub-time-badge ' || (CASE WHEN is_early_departure = 1 THEN 'hub-time--early' ELSE 'hub-time--ontime-out' END) || '">' ||
                                            '<i class="fa fa-sign-out" aria-hidden="true"></i> ' ||
                                            TO_CHAR(sign_out_time, 'HH12:MI AM', 'NLS_DATE_LANGUAGE=ARABIC') ||
                                            '</span>'
                                        ELSE '<span class="hub-time-badge hub-time--empty">-</span>'
                                    END AS check_out_html,
                                    -- Duration HTML
                                    CASE
                                        WHEN sign_in_time IS NOT NULL AND sign_out_time IS NOT NULL AND sign_out_time > sign_in_time THEN
                                            '<span class="hub-duration-badge">' ||
                                            TRUNC((sign_out_time - sign_in_time) * 24) || ' س و ' || 
                                            ROUND(MOD((sign_out_time - sign_in_time) * 24 * 60, 60)) || ' د' ||
                                            '</span>'
                                        ELSE '<span class="hub-duration-badge hub-duration--none">-</span>'
                                    END AS duration_html,
                                    -- Status HTML
                                    CASE
                                        WHEN r.request_categories IS NOT NULL THEN
                                            '<span class="hub-status-badge hub-status--request">' || r.request_categories || '</span>'
                                        WHEN d.log_date > TRUNC(SYSDATE) THEN
                                            '<span class="hub-status-badge hub-status--pending">لم يأتِ اليوم بعد</span>'
                                        WHEN TO_CHAR(d.log_date, 'DY', 'NLS_DATE_LANGUAGE=ENGLISH') IN ('FRI', 'SAT') THEN
                                            '<span class="hub-status-badge hub-status--rest">عطلة أسبوعية</span>'
                                        WHEN d.log_date = TRUNC(SYSDATE) AND sign_in_time IS NULL AND sign_out_time IS NULL THEN
                                            '<span class="hub-status-badge hub-status--pending">اليوم جارٍ</span>'
                                        WHEN sign_in_time IS NULL AND sign_out_time IS NULL THEN
                                            '<span class="hub-status-badge hub-status--absent">غياب</span>'
                                        WHEN sign_in_time IS NULL THEN
                                            '<span class="hub-status-badge hub-status--warning">بصمة حضور ناقصة</span>'
                                        WHEN sign_out_time IS NULL AND d.log_date < TRUNC(SYSDATE) THEN
                                            '<span class="hub-status-badge hub-status--warning">بصمة انصراف ناقصة</span>'
                                        WHEN sign_in_time IS NOT NULL AND is_late = 1 THEN
                                            '<span class="hub-status-badge hub-status--warning">حضور متأخر</span>'
                                        WHEN sign_in_time IS NOT NULL THEN
                                            '<span class="hub-status-badge hub-status--success">حضور نظامي</span>'
                                    END AS status_html
                                FROM calendar_days d
                                LEFT JOIN daily_summary s ON s.log_date = d.log_date
                                LEFT JOIN request_days r ON r.log_date = d.log_date
                                ORDER BY d.log_date ASC;
                ```
            pageItemsToSubmit: [
                P450_EMP_ID
                P450_YEAR
                P450_MONTH
            ]
        }
        layout {
