    region emp-profile-card (
        name: بطاقة بيانات الموظف
        title: بطاقة بيانات الموظف
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH emp_info AS (
                    SELECT 
                        d.emp_number,
                        NVL(d.emp_name, central.get_emp_name(NVL(:P450_EMP_ID, :APP_USER))) AS emp_name,
                        NVL(d.emp_position_name, 'موظف') AS emp_position_name,
                        NVL(d.organization_name, 'EPROM HQ') AS organization_name
                    FROM DUAL
                    LEFT JOIN central.xxapex_hr_emp_data d
                      ON d.emp_number = NVL(:P450_EMP_ID, :APP_USER)
                )
                SELECT 
                    '<div class="hub-header-container">' ||
                    '  <div class="hub-profile-section">' ||
                    '    <div class="hub-profile-avatar">' ||
                    '      <img src="f?p=' || :APP_ID || ':0:' || :APP_SESSION || ':APPLICATION_PROCESS=GET_EMP_AVATAR:::IMAGE_ID:' || NVL(:P450_EMP_ID, :APP_USER) || '" alt="صورة الموظف" class="hub-avatar-img" onerror="this.style.display=''none'';this.nextElementSibling.style.display=''flex'';" />' ||
                    '      <div class="hub-avatar-fallback" style="display:none;"><i class="fa fa-user"></i></div>' ||
                    '    </div>' ||
                    '    <div class="hub-profile-details">' ||
                    '      <h2 class="hub-profile-title">' || apex_escape.html(emp_name) || '</h2>' ||
                    '      <div class="hub-profile-meta">' ||
                    '        <span class="hub-badge-code"><i class="fa fa-id-card-o"></i> كود الموظف: ' || apex_escape.html(NVL(:P450_EMP_ID, :APP_USER)) || '</span>' ||
                    '        <span class="hub-badge-role"><i class="fa fa-briefcase"></i> ' || apex_escape.html(emp_position_name) || '</span>' ||
                    '        <span class="hub-badge-dept"><i class="fa fa-building-o"></i> ' || apex_escape.html(organization_name) || '</span>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '  </div>' ||
                    '</div>' AS profile_card_html
                FROM emp_info;
                ```
            pageItemsToSubmit: P450_EMP_ID
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: EMP_PROFILE_CARD
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }

        column PROFILE_CARD_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$NBSP.
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region unified-requests-hub (
        name: سجل الأرصدة والطلبات الموحدة
        title: سجل الأرصدة والطلبات الموحدة
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH emp_summary AS (
                    SELECT 
                        -- Leaves
                        (SELECT NVL(SUM(CASE WHEN LEAVE_TYPE IN ('H','C','RH') THEN (TRUNC(TO_DATE) - TRUNC(FROM_DATE) + 1) ELSE 0 END), 0)
                         FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS total_leave_days,
                        (SELECT NVL(SUM(TRUNC(TO_DATE) - TRUNC(FROM_DATE) + 1), 0)
                         FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND LEAVE_TYPE = 'H' AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS annual_days,
                        (SELECT NVL(SUM(TRUNC(TO_DATE) - TRUNC(FROM_DATE) + 1), 0)
                         FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND LEAVE_TYPE = 'C' AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS casual_days,
                        (SELECT NVL(SUM(TRUNC(TO_DATE) - TRUNC(FROM_DATE) + 1), 0)
                         FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND LEAVE_TYPE = 'RH' AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS rest_leave_days,
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_LEAVE_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS total_leave_reqs,
                           
                        -- Missions
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_MISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS mission_count,
                        (SELECT NVL(SUM(TRUNC(TO_DATE) - TRUNC(FROM_DATE) + 1), 0)
                         FROM EPROMHQ.HRF_EMP_MISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS mission_days,
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_MISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND REQUEST_TYPE_ID = 72 AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS work_mission_count,
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_MISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND REQUEST_TYPE_ID = 121 AND EXTRACT(YEAR FROM FROM_DATE) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS training_mission_count,
                           
                        -- Permissions
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_PERMISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_HOUR) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS perm_count,
                        (SELECT NVL(ROUND(SUM((TO_HOUR - FROM_HOUR) * 24), 1), 0)
                         FROM EPROMHQ.HRF_EMP_PERMISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_HOUR) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS perm_hours,
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_PERMISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND PERMISSION_TYPE = 'PP' AND EXTRACT(YEAR FROM FROM_HOUR) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS personal_perm_count,
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_PERMISSION_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND PERMISSION_TYPE = 'CP' AND EXTRACT(YEAR FROM FROM_HOUR) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS work_perm_count,
                           
                        -- Overtime / Rest Hours
                        (SELECT COUNT(*)
                         FROM EPROMHQ.HRF_EMP_OVERTIME_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_HOUR) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS overtime_count,
                        (SELECT NVL(ROUND(SUM(ABS((TO_HOUR - FROM_HOUR) * 24)), 1), 0)
                         FROM EPROMHQ.HRF_EMP_OVERTIME_REQUEST 
                         WHERE EMP_ID = NVL(:P450_EMP_ID, :APP_USER) AND APPROVED = 1 AND NVL(DELETE_TMS, 0) != 1 
                           AND EXTRACT(YEAR FROM FROM_HOUR) = TO_NUMBER(NVL(:P450_YEAR, TO_CHAR(SYSDATE, 'YYYY')))) AS overtime_hours
                    FROM DUAL
                )
                SELECT 
                    '<div class="hub-cards-grid">' ||
                    -- Card 1: Vacations
                    '  <div class="hub-kpi-card hub-card--vacations">' ||
                    '    <div class="hub-card-top">' ||
                    '      <div class="hub-card-icon-box hub-icon--blue"><i class="fa fa-calendar-check-o" aria-hidden="true"></i></div>' ||
                    '      <div class="hub-card-meta">' ||
                    '        <div class="hub-card-title">سجل الإجازات</div>' ||
                    '        <div class="hub-card-subtitle">الاعتيادية والعارضة والراحة</div>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-body">' ||
                    '      <div class="hub-card-stat"><span class="hub-stat-num">' || total_leave_days || '</span><span class="hub-stat-unit">يوم</span></div>' ||
                    '      <div class="hub-card-tags">' ||
                    '        <span class="hub-tag hub-tag--blue">سنوي: ' || annual_days || '</span>' ||
                    '        <span class="hub-tag hub-tag--blue-subtle">عارضة: ' || casual_days || '</span>' ||
                    '        <span class="hub-tag hub-tag--gray">راحة: ' || rest_leave_days || '</span>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-footer"><i class="fa fa-file-text-o"></i> إجمالي الطلبات: ' || total_leave_reqs || ' طلب معتمد</div>' ||
                    '  </div>' ||
                
                    -- Card 2: Missions
                    '  <div class="hub-kpi-card hub-card--missions">' ||
                    '    <div class="hub-card-top">' ||
                    '      <div class="hub-card-icon-box hub-icon--teal"><i class="fa fa-briefcase" aria-hidden="true"></i></div>' ||
                    '      <div class="hub-card-meta">' ||
                    '        <div class="hub-card-title">المأموريات والمهام</div>' ||
                    '        <div class="hub-card-subtitle">مهام العمل والتدريب الخارجي</div>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-body">' ||
                    '      <div class="hub-card-stat"><span class="hub-stat-num">' || mission_count || '</span><span class="hub-stat-unit">مأمورية</span></div>' ||
                    '      <div class="hub-card-tags">' ||
                    '        <span class="hub-tag hub-tag--teal">عمل: ' || work_mission_count || '</span>' ||
                    '        <span class="hub-tag hub-tag--teal-subtle">تدريب: ' || training_mission_count || '</span>' ||
                    '        <span class="hub-tag hub-tag--gray">إجمالي: ' || mission_days || ' يوم</span>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-footer"><i class="fa fa-check-circle-o"></i> إجمالي الأيام: ' || mission_days || ' يوم عمل</div>' ||
                    '  </div>' ||
                
                    -- Card 3: Permissions
                    '  <div class="hub-kpi-card hub-card--permissions">' ||
                    '    <div class="hub-card-top">' ||
                    '      <div class="hub-card-icon-box hub-icon--emerald"><i class="fa fa-clock-o" aria-hidden="true"></i></div>' ||
                    '      <div class="hub-card-meta">' ||
                    '        <div class="hub-card-title">الأذونات الرسمية</div>' ||
                    '        <div class="hub-card-subtitle">أذونات العمل والشخصية</div>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-body">' ||
                    '      <div class="hub-card-stat"><span class="hub-stat-num">' || perm_count || '</span><span class="hub-stat-unit">إذن معتمد</span></div>' ||
                    '      <div class="hub-card-tags">' ||
                    '        <span class="hub-tag hub-tag--emerald">شخصي: ' || personal_perm_count || '</span>' ||
                    '        <span class="hub-tag hub-tag--emerald-subtle">عمل: ' || work_perm_count || '</span>' ||
                    '        <span class="hub-tag hub-tag--gray">إجمالي: ' || perm_hours || ' ساعة</span>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-footer"><i class="fa fa-clock-o"></i> إجمالي الساعات: ' || perm_hours || ' س مستهلكة</div>' ||
                    '  </div>' ||
                
                    -- Card 4: Rest Hours / Overtime
                    '  <div class="hub-kpi-card hub-card--overtime">' ||
                    '    <div class="hub-card-top">' ||
                    '      <div class="hub-card-icon-box hub-icon--amber"><i class="fa fa-hourglass-half" aria-hidden="true"></i></div>' ||
                    '      <div class="hub-card-meta">' ||
                    '        <div class="hub-card-title">بدل الساعات والراحة</div>' ||
                    '        <div class="hub-card-subtitle">ساعات العمل الإضافي وبدل الراحة</div>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-body">' ||
                    '      <div class="hub-card-stat"><span class="hub-stat-num">' || overtime_hours || '</span><span class="hub-stat-unit">ساعة</span></div>' ||
                    '      <div class="hub-card-tags">' ||
                    '        <span class="hub-tag hub-tag--amber">طلبات: ' || overtime_count || '</span>' ||
                    '        <span class="hub-tag hub-tag--gray">رصيد إضافي معتمد</span>' ||
                    '      </div>' ||
                    '    </div>' ||
                    '    <div class="hub-card-footer"><i class="fa fa-hourglass-end"></i> إجمالي الطلبات: ' || overtime_count || ' طلب معتمد</div>' ||
                    '  </div>' ||
                    '</div>' AS hub_html
                FROM emp_summary;
                ```
            pageItemsToSubmit: [
                P450_EMP_ID
                P450_YEAR
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: UNIFIED_REQUESTS_HUB
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }

        column HUB_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$NBSP.
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P450_EMP_ID (
        type: selectList
        label {
            label: اختيار الموظف
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @approvals
            displayExtraValues: false
            nullDisplayValue: &APP_TEXT$_SELECT_EMPLOYEE_.
        }
        layout {
            sequence: 10
            region: @emp-filters-toolbar
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
        sessionState {
            storage: request
        }
    )

    pageItem P450_MONTH (
        type: selectList
        label {
            label: الشهر
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:عرض كل شهور السنة;ALL,يناير (01);01,فبراير (02);02,مارس (03);03,أبريل (04);04,مايو (05);05,يونيو (06);06,يوليو (07);07,أغسطس (08);08,سبتمبر (09);09,أكتوبر (10);10,نوفمبر (11);11,ديسمبر (12);12
        }
        layout {
            sequence: 30
            region: @emp-filters-toolbar
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 3
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: ALL
        }
        sessionState {
            storage: request
        }
    )

    pageItem P450_YEAR (
        type: selectList
        label {
            label: السنة
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:2026;2026,2025;2025,2024;2024,2023;2023
        }
        layout {
            sequence: 20
            region: @emp-filters-toolbar
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 3
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: TO_CHAR(SYSDATE, 'YYYY')
        }
        sessionState {
            storage: request
        }
    )

    button refresh-data (
        buttonName: REFRESH_DATA
        label: تحديث
        layout {
            sequence: 40
            region: @emp-filters-toolbar
            slot: next
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--padLeft
                t-Button--padRight
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    dynamicAction refresh-on-button-click (
        name: Refresh_On_Button_Click
        execution {
            sequence: 40
        }
        when {
            selectionType: button
            button: @refresh-data
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        central.REFRESH_EMP_REQUESTS_SUMMARY2(NVL(:P450_EMP_ID, :APP_USER));
                    END;
                    ```
                itemsToSubmit: P450_EMP_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-card (
            action: refresh
            affectedElements {
                selectionType: region
                region: @emp-profile-card
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-hub (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unified-requests-hub
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-statement (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendance-statement
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-on-emp-change (
        name: Refresh_On_Emp_Change
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P450_EMP_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        central.REFRESH_EMP_REQUESTS_SUMMARY2(NVL(:P450_EMP_ID, :APP_USER));
                    END;
                    ```
                itemsToSubmit: P450_EMP_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-card (
            action: refresh
            affectedElements {
                selectionType: region
                region: @emp-profile-card
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-hub (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unified-requests-hub
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-statement (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendance-statement
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-on-month-change (
        name: Refresh_On_Month_Change
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P450_MONTH
        }

        action native-refresh-statement (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendance-statement
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-on-year-change (
        name: Refresh_On_Year_Change
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P450_YEAR
        }

        action native-refresh-hub (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unified-requests-hub
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-statement (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendance-statement
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process sync-summary (
        name: SYNC_SUMMARY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    central.REFRESH_EMP_REQUESTS_SUMMARY2(NVL(:P450_EMP_ID, :APP_USER));
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 69672901897391569
        }
    )

)
