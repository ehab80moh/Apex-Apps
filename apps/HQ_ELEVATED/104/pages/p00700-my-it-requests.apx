page 700 (
    name: my-it-requests
    alias: MY-IT-REQUESTS
    title: &APP_TEXT$PORTAL_PAGE_700_TITLE.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region user-it-requests (
        name: &APP_TEXT$ITR_UI_MY_IT_REQUESTS.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.REQUEST_ID,
                       r.REQUEST_NO,
                       r.DESCRIPTION,
                       r.REQUEST_DATE,
                       t.name as CATEGORY_NAME,
                       d.title as SUBCATEGORY_NAME,
                       r.CRITICALITY,
                       case
                           when r.STATUS = 10 then apex_lang.message('ITR_PAGE705_STATUS_PENDING_APPROVAL')
                           when r.STATUS = 20 then apex_lang.message('ITR_PAGE705_STATUS_APPROVED_PENDING_ASSIGNMENT')
                           when r.STATUS = 100 then apex_lang.message('ITR_PAGE705_STATUS_ASSIGNED')
                           when r.STATUS = 110 then apex_lang.message('ITR_PAGE705_STATUS_IN_PROGRESS')
                           when r.STATUS = 120 then apex_lang.message('ITR_PAGE705_STATUS_ON_HOLD')
                           when r.STATUS = 130 then apex_lang.message('ITR_PAGE705_STATUS_AWAITING_VERIFICATION')
                           when r.STATUS = 140 then apex_lang.message('ITR_PAGE705_STATUS_REJECTED')
                           when r.STATUS = 150 then apex_lang.message('ITR_PAGE705_STATUS_COMPLETED')
                           when r.STATUS = 160 then apex_lang.message('CANCELLED')
                           else apex_lang.message('ITR_PAGE705_STATUS_UNKNOWN')
                       end as STATUS_LABEL,
                       r.STATUS,
                       r.ASSIGNED_TO,
                       r.COMPLETE_DATE,
                       case
                           when r.STATUS = 130 then apex_lang.message('ITR_NEXT_VERIFY')
                           when r.STATUS = 10 then apex_lang.message('ITR_NEXT_APPROVAL')
                           when r.STATUS = 20 then apex_lang.message('ITR_NEXT_COORDINATOR')
                           when r.STATUS = 110 then apex_lang.message('ITR_NEXT_TECHNICIAN')
                           when r.STATUS = 120 then apex_lang.message('ITR_NEXT_REASSIGN')
                           when r.STATUS = 100 and q.POSITION_NO is not null then
                               apex_lang.message('ITR_NEXT_QUEUE', TO_CHAR(q.POSITION_NO), TO_CHAR(q.QUEUE_TOTAL))
                           when r.STATUS = 100 then apex_lang.message('ITR_NEXT_TEAM')
                           else apex_lang.message('ITR_NEXT_NONE')
                       end as QUEUE_STATUS
                  from ITR_REQUESTS r
                  left join ITR_REQUEST_TYPES t on r.REQUEST_TYPE = t.id
                  left join ITR_REQUEST_TYPE_DETAILS d on r.REQUEST_TYPE_DETAIL_ID = d.id
                  left join (
                      SELECT qi.REQUEST_ID,
                             ROW_NUMBER() OVER (PARTITION BY qi.QUEUE_ID
                                 ORDER BY qi.QUEUE_POSITION, qi.ENQUEUED_DATE, qi.QUEUE_ITEM_ID) AS POSITION_NO,
                             COUNT(*) OVER (PARTITION BY qi.QUEUE_ID) AS QUEUE_TOTAL
                        FROM ITR_TEAM_QUEUE_ITEMS qi
                        JOIN ITR_REQUESTS qr ON qr.REQUEST_ID = qi.REQUEST_ID
                       WHERE qi.QUEUE_STATUS IN ('TEAM_PENDING', 'MEMBER_ASSIGNED', 'IN_PROGRESS')
                         AND qr.STATUS IN (100, 110)
                         AND qr.ASSIGNED_TEAM_ID = qi.TEAM_ID
                  ) q ON q.REQUEST_ID = r.REQUEST_ID
                 where r.EMP_ID = :APP_USER
                 order by r.REQUEST_DATE desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 705
                items: {
                    P705_REQUEST_ID: \#REQUEST_ID#\
                }
                clearCache: 705
            }
            linkIcon: <span class="fa fa-search-plus" aria-hidden="true" title="View Details"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 34503358361985381
        }

        column ASSIGNED_TO (
            type: plainTextBasedOnLov
            heading {
                heading: &APP_TEXT$ITR_UI_ASSIGNED_TO.
            }
            lov {
                lov: @itr-review-member-names
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_CATEGORY.
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CRITICALITY (
            type: plainTextBasedOnLov
            heading {
                heading: &APP_TEXT$ITR_UI_CRITICALITY.
            }
            lov {
                lov: @itr-review-priorities
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_DESCRIPTION.
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column QUEUE_STATUS (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_QUEUE_POSITION.
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column REQUEST_DATE (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_REQUEST_DATE.
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column REQUEST_ID (
            type: hidden
            heading {
                heading: &APP_TEXT$ITR_UI_REQUEST_ID.
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column REQUEST_NO (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_REQUEST_NO.
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column STATUS_LABEL (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_STATUS.
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column SUBCATEGORY_NAME (
            type: plainText
            heading {
                heading: &APP_TEXT$ITR_UI_SUBCATEGORY.
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ASSIGNED_TO (
                sequence: 9
            )

            displayColumn CATEGORY_NAME (
                sequence: 5
            )

            displayColumn CRITICALITY (
                sequence: 7
            )

            displayColumn DESCRIPTION (
                sequence: 3
            )

            displayColumn QUEUE_STATUS (
                sequence: 10
            )

            displayColumn REQUEST_DATE (
                sequence: 4
            )

            displayColumn REQUEST_ID (
                sequence: 1
            )

            displayColumn REQUEST_NO (
                sequence: 2
            )

            displayColumn STATUS_LABEL (
                sequence: 8
            )

            displayColumn SUBCATEGORY_NAME (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$ITR_UI_SUBMIT_NEW_IT_REQUEST.
        layout {
            sequence: 10
            region: @user-it-requests
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-file-new
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 701
                clearCache: 701
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-report (
        name: Refresh Report on Modal Close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-it-requests
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-it-requests
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
