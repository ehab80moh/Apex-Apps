    process resolve-task-context (
        name: Resolve Task Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_task_id NUMBER;
                    l_requested_id NUMBER := TO_NUMBER(:P705_REQUEST_ID);
                    l_task_request_id NUMBER;
                BEGIN
                    IF :P705_TASK_ID IS NOT NULL THEN
                        SELECT TO_NUMBER(p.param_value) INTO l_task_request_id
                          FROM TABLE(apex_human_task.get_tasks(
                               p_context => 'SINGLE_TASK', p_task_id => TO_NUMBER(:P705_TASK_ID))) vt
                          JOIN apex_tasks a ON a.task_id = vt.task_id AND a.application_id = 104
                          JOIN apex_task_parameters p ON p.task_id = a.task_id
                           AND p.application_id = a.application_id AND p.param_static_id = 'T_REQUEST_ID';
                        IF l_requested_id IS NOT NULL AND l_requested_id <> l_task_request_id THEN
                            RAISE_APPLICATION_ERROR(-20204, apex_lang.message('ITR_REVIEW_UNAVAILABLE'));
                        END IF;
                        :P705_REQUEST_ID := l_task_request_id;
                    END IF;
                
                    :P705_TASK_ID := NULL;
                    :P705_T_ID := NULL;
                
                    IF :P705_REQUEST_ID IS NOT NULL THEN
                        BEGIN
                            SELECT task_id
                              INTO l_task_id
                              FROM (
                                    SELECT t.task_id
                                      FROM apex_tasks t
                                     WHERE t.application_id = 104
                                       AND t.task_def_static_id = 'gen-wf-action'
                                       AND t.detail_pk = TO_CHAR(:P705_REQUEST_ID)
                                       AND t.state_code IN ('UNASSIGNED', 'ASSIGNED')
                                       AND EXISTS (
                                             SELECT 1
                                               FROM apex_task_participants p
                                              WHERE p.application_id = t.application_id
                                                AND p.task_id = t.task_id
                                                AND p.participant = :APP_USER
                                           )
                                     ORDER BY t.created_on DESC
                                   )
                             WHERE ROWNUM = 1;
                
                            :P705_TASK_ID := l_task_id;
                            :P705_T_ID := apex_human_task.get_task_parameter_value(
                                p_task_id          => l_task_id,
                                p_param_static_id  => 'T_ID',
                                p_ignore_not_found => TRUE
                            );
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                NULL;
                        END;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 34427601145321384
        }
    )

)
