            label: &APP_TEXT$ITR_PAGE705_SUGGESTED_TEAM.
        }
        layout {
            sequence: 10
            region: @coordinator-actions
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            cssClasses: p705-team-suggestion
        }
    )

    pageItem P705_TASK_ID (
        type: hidden
        layout {
            sequence: 20
            region: @hidden-items
            slot: regionBody
        }
    )

    pageItem P705_TECH_COMMENT (
        type: textarea
        label {
            label: &APP_TEXT$ITR_PAGE705_TECH_COMMENT.
        }
        layout {
            sequence: 20
            region: @comments-region
            slot: regionBody
            columnSpan: 12
            columnCssClasses: p705-notes-field
        }
        appearance {
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @request-info
            column: TECH_COMMENT
            dataType: varchar2
        }
        serverSideCondition {
            type: expression
            plsqlExpression: (:P705_T_ID = 'ITR_TECHNICIAN_WORK' and :P705_IS_TEAM_MEMBER = 'Y') or (:P705_T_ID = 'ITR_USER_VERIFICATION' and :P705_EMP_ID = :APP_USER)
        }
        readOnly {
            type: item=value
            item: P705_T_ID
            value: ITR_USER_VERIFICATION
        }
    )

    pageItem P705_T_ID (
        type: hidden
