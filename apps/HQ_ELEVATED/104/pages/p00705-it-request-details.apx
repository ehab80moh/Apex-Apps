    process load-roles-and-suggestions (
        name: Load Roles and Suggestions
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  v_count number;
                  v_prev_username varchar2(100);
                  v_prev_name varchar2(200);
                begin
                  select count(*) into v_count
                    from ITR_TEAM_MEMBERS tm
                   where tm.username = :APP_USER
                     and upper(trim(tm.role)) = 'COORDINATOR';
                
                  if v_count > 0 then
                    :P705_IS_COORDINATOR := 'Y';
                  else
                    :P705_IS_COORDINATOR := 'N';
                  end if;
                
                  if :P705_ASSIGNED_TEAM_ID is not null then
                    select count(*) into v_count
                      from ITR_TEAM_MEMBERS tm
                     where tm.username = :APP_USER
                       and tm.team_id = :P705_ASSIGNED_TEAM_ID
                       and upper(tm.role) in ('LEADER', 'COORDINATOR');
                
                    if v_count > 0 then
                      :P705_IS_TEAM_LEADER := 'Y';
                    else
                      :P705_IS_TEAM_LEADER := 'N';
                    end if;
                  else
                    :P705_IS_TEAM_LEADER := 'N';
                  end if;
                
                  if :P705_ASSIGNED_TEAM_ID is not null then
                    select count(*) into v_count
                      from ITR_TEAM_MEMBERS tm
                     where tm.username = :APP_USER
                       and tm.team_id = :P705_ASSIGNED_TEAM_ID;
                
                    if v_count > 0 then
                      :P705_IS_TEAM_MEMBER := 'Y';
                    else
                      :P705_IS_TEAM_MEMBER := 'N';
                    end if;
                  else
                    :P705_IS_TEAM_MEMBER := 'N';
                  end if;
                
                  begin
                    select name
                      into :P705_SUGGESTED_TEAM_NAME
                      from ITR_TEAMS
                     where id = :P705_SUGGESTED_TEAM_ID;
                  exception
                    when no_data_found then
                      :P705_SUGGESTED_TEAM_NAME := null;
                  end;
                
                  if :P705_STATUS = 120 then
                    begin
                      select worker_id into v_prev_username
                        from (
                            select worker_id
                              from ITR_REQUEST_WORKERS
                             where request_id = :P705_REQUEST_ID
                               and status_id = 3
                             order by start_date desc
                        ) where rownum = 1;
                
                      select coalesce(hr.emp_name, tm.member_name, tm.username)
                        into v_prev_name
                        from ITR_TEAM_MEMBERS tm
                        left join CENTRAL.XXAPEX_HR_EMP_DATA hr
                          on to_char(hr.emp_number) = to_char(tm.username)
                       where tm.username = v_prev_username
                         and rownum = 1;
                
                      :P705_PREV_WORKER_USERNAME := v_prev_username;
                      :P705_PREV_WORKER_NAME := v_prev_name;
                      :P705_PREV_WORKER_DISPLAY := v_prev_name || ' (' || v_prev_username || ') - ' || apex_lang.message('ITR_REVIEW_PREVIOUS_WORKER');
                    exception
                      when no_data_found then
                        :P705_PREV_WORKER_USERNAME := null;
                        :P705_PREV_WORKER_NAME := null;
                        :P705_PREV_WORKER_DISPLAY := null;
                    end;
                  end if;
                
                  :P705_STATUS_LABEL := case
                     when :P705_STATUS = 10 then apex_lang.message('ITR_PAGE705_STATUS_PENDING_APPROVAL')
                     when :P705_STATUS = 20 then apex_lang.message('ITR_PAGE705_STATUS_APPROVED_PENDING_ASSIGNMENT')
                     when :P705_STATUS = 100 then apex_lang.message('ITR_PAGE705_STATUS_ASSIGNED')
                     when :P705_STATUS = 110 then apex_lang.message('ITR_PAGE705_STATUS_IN_PROGRESS')
                     when :P705_STATUS = 120 then apex_lang.message('ITR_PAGE705_STATUS_ON_HOLD')
                     when :P705_STATUS = 130 then apex_lang.message('ITR_PAGE705_STATUS_AWAITING_VERIFICATION')
                     when :P705_STATUS = 140 then apex_lang.message('ITR_PAGE705_STATUS_REJECTED')
                     when :P705_STATUS = 150 then apex_lang.message('ITR_PAGE705_STATUS_COMPLETED')
                     when :P705_STATUS = 160 then apex_lang.message('CANCELLED')
                     else apex_lang.message('ITR_PAGE705_STATUS_UNKNOWN')
                  end;
                
                  :P705_CRITICALITY_LABEL := case lower(trim(:P705_CRITICALITY))
                     when 'normal' then apex_lang.message('ITR_PAGE705_PRIORITY_NORMAL')
                     when 'urgent' then apex_lang.message('ITR_PAGE705_PRIORITY_URGENT')
                     else :P705_CRITICALITY
                  end;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 34426810848321382
        }
    )

