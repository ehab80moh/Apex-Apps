page 705 (
    name: request-details
    alias: IT-REQUEST-DETAILS
    title: &APP_TEXT$ITR_PAGE705_TITLE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function p705ResizeNotes(textarea) {
                textarea.style.height = "auto";
                textarea.style.height = textarea.scrollHeight + "px";
            }
            
            apex.jQuery(function ($) {
                const selector = ".p705-notes-field textarea";
                $(selector).each(function () {
                    p705ResizeNotes(this);
                });
                $(document).on("input", selector, function () {
                    p705ResizeNotes(this);
                });
            });
            ```
    }
    css {
        inline:
            ```css
            .t-Region.p705-shell {
                border: 1px solid var(--ut-component-border-color);
                border-radius: 16px;
                box-shadow: none;
                overflow: hidden;
                background: var(--ut-region-background-color);
            }
            .p705-shell .t-Region-header {
                background: var(--ut-region-header-background-color);
                color: var(--ut-region-header-text-color);
                border: 0;
            }
            .p705-shell .t-Region-title {
                font-weight: 700;
                letter-spacing: .01em;
            }
            .p705-shell .t-Form-label {
                font-weight: 700;
                color: var(--ut-body-text-color);
            }
            .p705-shell .t-Form-inputContainer,
            .p705-shell .display_only {
                color: var(--ut-body-text-color);
            }
            .p705-summary-item {
                padding-block: .25rem;
            }
            .p705-status-item .display_only,
            .p705-criticality-item .display_only {
                display: inline-flex;
                align-items: center;
                min-height: 2.25rem;
                padding: .4rem .85rem;
                border-radius: 999px;
                font-weight: 800;
                background: var(--ut-component-background-color);
                color: var(--ut-palette-primary);
                border: 1px solid var(--ut-component-border-color);
            }
            .p705-request-card .t-Region-body {
                padding: .8rem 1rem;
                background: linear-gradient(180deg, var(--ut-region-background-color) 0%, var(--ut-component-background-color) 160%);
            }
            .p705-request-card .p705-meta-item {
                margin-block: .2rem;
                padding: .45rem .65rem;
                border: 1px solid var(--ut-component-border-color);
                border-radius: 12px;
                background: var(--ut-component-background-color);
            }
            .p705-request-card .p705-meta-item .t-Form-label {
                color: var(--ut-body-text-color);
                font-size: .78rem;
            }
            .p705-request-card .p705-meta-item .display_only {
                font-size: .98rem;
                font-weight: 700;
            }
            .p705-request-card .p705-description-item .display_only {
                display: block;
                min-height: 3.25rem;
                padding: .7rem .85rem;
                border: 1px solid var(--ut-component-border-color);
                border-radius: 12px;
                background: var(--ut-region-background-color);
                line-height: 1.6;
                white-space: pre-wrap;
            }
            .p705-action-bar {
                display: flex;
                flex-wrap: wrap;
                gap: .6rem;
                justify-content: flex-end;
                padding: .75rem;
                background: var(--ut-component-background-color);
                border-top: 1px solid var(--ut-component-border-color);
            }
            .p705-action-bar .t-Button {
                border-radius: 999px;
                font-weight: 700;
            }
            .p705-coordinator-card {
                border-inline-start: 4px solid var(--ut-palette-primary) !important;
            }
            .p705-team-suggestion .display_only {
                display: flex;
                align-items: center;
                min-height: 3rem;
                padding: .75rem 1rem;
                border: 1px solid var(--ut-component-border-color);
                border-radius: 12px;
                background: linear-gradient(135deg, var(--ut-component-background-color), var(--ut-region-background-color));
                color: var(--ut-body-text-color);
                font-size: 1.05rem;
                font-weight: 800;
            }
            .p705-notes-field textarea {
                width: 100%;
                min-height: 4.5rem;
                overflow-y: auto;
                resize: vertical !important;
                border-radius: 12px;
                line-height: 1.5;
            }
            .p705-shell .t-Region-body {
                padding-block: .65rem;
            }
            .p705-shell .t-Form-fieldContainer {
                margin-block-end: .35rem;
            }
            .p705-shell :focus-visible {
                outline: 3px solid var(--ut-component-border-color);
                outline-offset: 2px;
            }
            [dir="rtl"] .p705-action-bar {
                justify-content: flex-start;
            }
            @media (max-width: 640px) {
                .p705-shell .t-Form-fieldContainer {
                    grid-column: 1 / -1 !important;
                }
                .p705-action-bar .t-Button {
                    flex: 1 1 100%;
                }
            }
            ```
    }
    security {
        authorizationScheme: @it-request-viewer
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }

    region buttons (
        name: Actions
        type: staticContent
        layout {
            sequence: 50
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
            cssClasses: p705-action-bar
        }
    )

    region cancel-request-dialog (
        name: Cancel Request
        title: Cancel IT Request
        type: staticContent
        layout {
            sequence: 35
            slot: contentBody
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size600x400
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: p705_cancel_request_dialog
        }
        serverSideCondition {
            type: expression
            plsqlExpression: itr_request_action_pkg.can_perform('CANCEL', :P705_REQUEST_ID, :P705_TASK_ID, :APP_USER)
        }
    )

    region cancel-request-dialog-buttons (
        name: Cancel Request Dialog Buttons
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @cancel-request-dialog
            slot: regionBody
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region comments-region (
        name: Comments & Notes
        title: &APP_TEXT$ITR_PAGE705_COMMENTS_NOTES.
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: p705-shell
        }
        serverSideCondition {
            type: expression
            plsqlExpression: (:P705_IS_COORDINATOR = 'Y' and :P705_REQUEST_ID is not null and :P705_STATUS not in (140, 150, 160)) or ((:P705_IS_TEAM_MEMBER = 'Y' or :P705_T_ID = 'ITR_USER_VERIFICATION') and :P705_T_ID in ('ITR_COORDINATOR_TRIAGE', 'ITR_TEAM_LEADER_ASSIGNMENT', 'ITR_TECHNICIAN_WORK', 'ITR_USER_VERIFICATION'))
        }
    )

    region coordinator-actions (
        name: Coordinator Assignment & Actions
        title: &APP_TEXT$ITR_PAGE705_COORDINATOR_ACTIONS.
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
            ]
            cssClasses: [
                p705-shell
                p705-coordinator-card
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P705_IS_COORDINATOR = 'Y' and :P705_TASK_ID is not null and :P705_T_ID = 'ITR_COORDINATOR_TRIAGE'
        }
    )

    region hidden-items (
        name: Hidden Items
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
    )

    region request-info (
        name: Request Information
        title: &APP_TEXT$ITR_PAGE705_REQUEST_INFO.
        type: form
        source {
            location: localDatabase
            tableName: ITR_REQUESTS
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
            cssClasses: [
                p705-shell
                p705-request-card
            ]
        }
    )

    region team-leader-actions (
        name: Team Leader Assignment
        title: "&{Team_Leader_Assignment}."
        type: staticContent
        layout {
            sequence: 45
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
            ]
            cssClasses: p705-shell
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P705_IS_TEAM_LEADER = 'Y' and :P705_TASK_ID is not null and :P705_T_ID = 'ITR_TEAM_LEADER_ASSIGNMENT'
        }
    )

    pageItem P705_ASSIGNED_TEAM_ID (
        type: selectList
        label {
            label: &APP_TEXT$ITR_PAGE705_ASSIGN_TEAM.
        }
        lov {
            type: sqlQuery
            sqlQuery: select name as d, id as r from ITR_TEAMS order by name
        }
        layout {
            sequence: 20
            region: @coordinator-actions
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @request-info
            column: ASSIGNED_TEAM_ID
            dataType: number
        }
    )

    pageItem P705_ASSIGNED_TO (
        type: selectList
        label {
            label: &APP_TEXT$ITR_PAGE705_ASSIGN_MEMBER.
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select coalesce(hr.emp_name, tm.member_name, tm.username)
                       || ' (' || tm.username || ')' as d,
                       tm.username as r
                  from ITR_TEAM_MEMBERS tm
                  left join CENTRAL.XXAPEX_HR_EMP_DATA hr
                    on to_char(hr.emp_number) = to_char(tm.username)
                 where tm.team_id = :P705_ASSIGNED_TEAM_ID
                 order by coalesce(hr.emp_name, tm.member_name, tm.username)
                ```
        }
        cascadingLov {
            parentItems: P705_ASSIGNED_TEAM_ID
            itemsToSubmit: P705_ASSIGNED_TEAM_ID
        }
        layout {
            sequence: 30
            region: @team-leader-actions
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @request-info
            column: ASSIGNED_TO
            dataType: varchar2
        }
    )

    pageItem P705_CANCEL_REASON (
        type: textarea
        label {
            label: Cancellation Reason
        }
        layout {
            sequence: 10
            region: @cancel-request-dialog
            slot: regionBody
            columnSpan: 12
        }
        validation {
            maxLength: 500
        }
    )

    pageItem P705_CRITICALITY (
        type: hidden
        layout {
            sequence: 90
            region: @hidden-items
