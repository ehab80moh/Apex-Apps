    button assign (
        buttonName: ASSIGN
        label: &APP_TEXT$ITR_PAGE705_ASSIGN_TRANSFER.
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-share-alt
        }
        serverSideCondition {
            type: expression
            plsqlExpression: itr_request_action_pkg.can_perform('ASSIGN_TEAM', :P705_REQUEST_ID, :P705_TASK_ID, :APP_USER)
        }
    )

    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$ITR_PAGE705_CLOSE.
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button claim (
        buttonName: CLAIM
        label: &APP_TEXT$ITR_PAGE705_CLAIM.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-hand-paper-o
        }
        serverSideCondition {
            type: expression
            plsqlExpression: itr_request_action_pkg.can_perform('CLAIM', :P705_REQUEST_ID, :P705_TASK_ID, :APP_USER)
        }
    )

    button close-cancel-dialog (
        buttonName: CLOSE_CANCEL_DIALOG
        label: Close
        layout {
            sequence: 10
            region: @cancel-request-dialog-buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button confirm-cancel (
        buttonName: CONFIRM_CANCEL
        label: Confirm Cancellation
        layout {
            sequence: 20
            region: @cancel-request-dialog-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-ban
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Cancel this IT request? This action cannot be undone.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: itr_request_action_pkg.can_perform('CANCEL', :P705_REQUEST_ID, :P705_TASK_ID, :APP_USER)
        }
    )

    button coordinator-cancel (
        buttonName: COORDINATOR_CANCEL
        label: "&{Cancel_Request}."
        layout {
            sequence: 80
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-ban
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            plsqlExpression: itr_request_action_pkg.can_perform('CANCEL', :P705_REQUEST_ID, :P705_TASK_ID, :APP_USER)
        }
    )

    button coordinator_complete (
        buttonName: COORDINATOR_COMPLETE
        label: &APP_TEXT$ITR_PAGE705_FORCE_COMPLETE.
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
