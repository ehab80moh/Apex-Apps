        serverSideCondition {
            type: expression
            plsqlExpression: :P705_IS_COORDINATOR = 'Y' and  :P705_T_ID = 'ITR_COORDINATOR_TRIAGE'
        }
    )

    pageItem P705_PREV_WORKER_DISPLAY (
        type: displayOnly
        label {
            label: &APP_TEXT$ITR_PAGE705_PREVIOUS_WORKER.
        }
        layout {
            sequence: 40
            region: @coordinator-actions
            slot: regionBody
            columnSpan: 12
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P705_PREV_WORKER_USERNAME is not null and :P705_T_ID = 'ITR_TECHNICIAN_WORK'
        }
    )

    pageItem P705_PREV_WORKER_NAME (
        type: hidden
        layout {
            sequence: 40
            region: @hidden-items
            slot: regionBody
        }
    )

    pageItem P705_PREV_WORKER_USERNAME (
        type: hidden
        layout {
            sequence: 50
            region: @hidden-items
            slot: regionBody
        }
    )

    pageItem P705_REQUEST_DATE (
        type: displayOnly
        label {
            label: &APP_TEXT$ITR_PAGE705_REQUEST_DATE.
        }
        layout {
            sequence: 40
            region: @request-info
            slot: regionBody
            startNewRow: false
            columnSpan: 6
            columnCssClasses: p705-meta-item
        }
        source {
            formRegion: @request-info
            column: REQUEST_DATE
            dataType: date
        }
    )

    pageItem P705_REQUEST_ID (
        type: hidden
        layout {
            sequence: 10
            region: @hidden-items
            slot: regionBody
        }
        source {
            formRegion: @request-info
            column: REQUEST_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P705_REQUEST_NO (
        type: hidden
        layout {
            sequence: 70
            region: @hidden-items
            slot: regionBody
        }
        source {
            formRegion: @request-info
            column: REQUEST_NO
            dataType: number
        }
    )

    pageItem P705_STATUS (
        type: hidden
        layout {
            sequence: 60
            region: @hidden-items
            slot: regionBody
        }
        source {
            formRegion: @request-info
            column: STATUS
            dataType: number
        }
    )

    pageItem P705_STATUS_LABEL (
        type: displayOnly
        label {
            label: &APP_TEXT$ITR_PAGE705_STATUS.
        }
        layout {
            sequence: 10
            region: @request-info
            slot: regionBody
            columnSpan: 6
            columnCssClasses: [
                p705-summary-item
                p705-status-item
            ]
        }
    )

    pageItem P705_SUGGESTED_TEAM_ID (
        type: hidden
        layout {
            sequence: 80
            region: @hidden-items
            slot: regionBody
        }
        source {
            formRegion: @request-info
            column: SUGGESTED_TEAM_ID
            dataType: number
        }
    )

    pageItem P705_SUGGESTED_TEAM_NAME (
        type: displayOnly
