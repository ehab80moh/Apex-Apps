    pageItem P705_EMP_ID (
        type: displayOnly
        label {
            label: &APP_TEXT$ITR_PAGE705_REQUESTER.
        }
        layout {
            sequence: 30
            region: @request-info
            slot: regionBody
            columnSpan: 6
            columnCssClasses: p705-meta-item
        }
        source {
            formRegion: @request-info
            column: EMP_ID
            dataType: varchar2
        }
    )

    pageItem P705_EMP_INTERNAL_NUMBER (
        type: displayOnly
        label {
            label: الرقم الداخلي
        }
        layout {
            sequence: 65
            region: @request-info
            slot: regionBody
            columnSpan: 6
            columnCssClasses: p705-meta-item
        }
        source {
            formRegion: @request-info
            column: EMP_INTERNAL_NUMBER
            dataType: varchar2
        }
    )

    pageItem P705_EMP_ROOM (
        type: displayOnly
        label {
            label: &APP_TEXT$ITR_PAGE705_ROOM.
        }
        layout {
            sequence: 60
            region: @request-info
            slot: regionBody
            startNewRow: false
            columnSpan: 6
            columnCssClasses: p705-meta-item
        }
        source {
            formRegion: @request-info
            column: EMP_ROOM
            dataType: varchar2
        }
    )

    pageItem P705_IS_COORDINATOR (
        type: hidden
        layout {
            sequence: 20
            region: @hidden-items
            slot: regionBody
        }
    )

    pageItem P705_IS_TEAM_LEADER (
        type: hidden
        layout {
            sequence: 25
            region: @hidden-items
            slot: regionBody
        }
    )

    pageItem P705_IS_TEAM_MEMBER (
        type: hidden
        layout {
            sequence: 30
            region: @hidden-items
            slot: regionBody
        }
    )

    pageItem P705_IT_NOTE (
        type: textarea
        label {
            label: &APP_TEXT$ITR_PAGE705_INTERNAL_NOTE.
        }
        layout {
            sequence: 30
            region: @comments-region
            slot: regionBody
            columnSpan: 12
            columnCssClasses: p705-notes-field
        }
