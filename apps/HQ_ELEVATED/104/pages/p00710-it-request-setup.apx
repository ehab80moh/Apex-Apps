page 710 (
    name: IT Request Setup
    alias: IT-REQUEST-SETUP
    title: &APP_TEXT$ITR_UI_IT_REQUEST_SETUP.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @it-request-setup-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: &APP_TEXT$ITR_UI_BREADCRUMB.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region setup-actions (
        name: &APP_TEXT$ITR_UI_IT_REQUEST_SETUP_AREAS.
        type: staticContent
        source {
            htmlCode: <p>&APP_TEXT$ITR_SETUP_GUIDANCE.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
    )

    region setup-health (
        name: &APP_TEXT$ITR_UI_SETUP_HEALTH.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select apex_lang.message('ITR_SETUP_HEALTH_TEAMS') as area, to_char(count(*)) as total from ITR_TEAMS union all select apex_lang.message('ITR_SETUP_HEALTH_TEAM_MEMBERS'), to_char(count(*)) from ITR_TEAM_MEMBERS union all select apex_lang.message('ITR_SETUP_HEALTH_REQUEST_TYPES'), to_char(count(*)) from ITR_REQUEST_TYPES union all select apex_lang.message('ITR_SETUP_HEALTH_TEAMS_MISSING_LEADER_COORDINATOR'), to_char(count(*)) from (select t.id from ITR_TEAMS t left join ITR_TEAM_MEMBERS tm on tm.team_id = t.id and upper(tm.role) in ('LEADER','COORDINATOR') group by t.id having count(tm.id) = 0) order by 1
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: &APP_TEXT$ITR_UI_NO_DATA_FOUND.
        }

        column AREA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_AREA.
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column TOTAL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_TOTAL.
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

    )

    button manage-request-types (
        buttonName: MANAGE-REQUEST-TYPES
        label: &APP_TEXT$ITR_UI_MANAGE_REQUEST_TYPES.
        layout {
            sequence: 20
            region: @setup-actions
            slot: next
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 715
                clearCache: 715
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button manage-teams (
        buttonName: MANAGE-TEAMS
        label: &APP_TEXT$ITR_UI_MANAGE_TEAMS.
        layout {
            sequence: 10
            region: @setup-actions
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 711
                clearCache: 711
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button setup-validation (
        buttonName: SETUP-VALIDATION
        label: &APP_TEXT$ITR_UI_SETUP_VALIDATION.
        layout {
            sequence: 30
            region: @setup-actions
            slot: next
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 719
                clearCache: 719
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
