page 711 (
    name: IT Teams
    alias: IT-TEAMS
    title: &APP_TEXT$ITR_UI_IT_TEAMS.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @it-request-setup-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: &APP_TEXT$ITR_UI_BREADCRUMB.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region teams-report (
        name: &APP_TEXT$ITR_UI_TEAMS.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select t.id, t.name, t.description, count(tm.id) as member_count, count(case when upper(tm.role) in ('LEADER','COORDINATOR') then 1 end) as leader_capable_count from ITR_TEAMS t left join ITR_TEAM_MEMBERS tm on tm.team_id = t.id group by t.id, t.name, t.description order by t.name
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: &APP_TEXT$ITR_UI_NO_DATA_FOUND.
        }

        column DESCRIPTION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_DESCRIPTION.
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: &APP_TEXT$ITR_UI_ID.
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 712
                    items: {
                        P712_ID: #ID#
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
        )

        column LEADER_CAPABLE_COUNT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_LEADER_CAPABLE_COUNT.
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column MEMBER_COUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_MEMBER_COUNT.
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
        )

        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: &APP_TEXT$ITR_UI_NAME.
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 713
                    items: {
                        P713_TEAM_ID: #ID#
                    }
                }
                linkText: #NAME#
            }
        )

    )

    button new-team (
        buttonName: NEW-TEAM
        label: &APP_TEXT$ITR_UI_NEW_TEAM.
        layout {
            sequence: 10
            region: @teams-report
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 712
                clearCache: 712
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-teams-report-on-close (
        name: Refresh on Dialog Close (teams-report)
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @teams-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @teams-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
