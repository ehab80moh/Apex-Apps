page 714 (
    name: IT Team Member Form
    alias: IT-TEAM-MEMBER-FORM
    title: &APP_TEXT$ITR_UI_IT_TEAM_MEMBER_FORM.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @it-request-setup-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Form
        type: form
        source {
            location: localDatabase
            tableName: ITR_TEAM_MEMBERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P714_EMP_ID (
        type: textField
        label {
            label: &APP_TEXT$ITR_UI_EMP_ID.
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @form
            column: EMP_ID
            dataType: varchar2
        }
    )

    pageItem P714_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P714_MEMBER_NAME (
        type: textField
        label {
            label: &APP_TEXT$ITR_UI_MEMBER_NAME.
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form
            column: MEMBER_NAME
            dataType: varchar2
        }
    )

    pageItem P714_ROLE (
        type: selectList
        label {
            label: &APP_TEXT$ITR_UI_ROLE.
        }
        lov {
            type: staticValues
            staticValues: STATIC:&APP_TEXT$ITR_UI_ROLE_LEADER.;LEADER,&APP_TEXT$ITR_UI_ROLE_COORDINATOR.;COORDINATOR,&APP_TEXT$ITR_UI_ROLE_MEMBER.;MEMBER
            nullDisplayValue: - Select role -
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ROLE
            dataType: varchar2
        }
    )

    pageItem P714_TEAM_ID (
        type: selectList
        label {
            label: &APP_TEXT$ITR_UI_TEAM_ID.
        }
        lov {
            type: sqlQuery
            sqlQuery: select name d, id r from ITR_TEAMS order by name
            nullDisplayValue: - Select team -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: TEAM_ID
            dataType: number
        }
    )

    pageItem P714_USERNAME (
        type: textField
        label {
            label: &APP_TEXT$ITR_UI_USERNAME.
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @form
            column: USERNAME
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$ITR_UI_CANCEL.
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$ITR_UI_CREATE.
        layout {
            sequence: 40
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P714_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: &APP_TEXT$ITR_UI_DELETE.
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this row?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P714_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$ITR_UI_APPLY_CHANGES.
        layout {
            sequence: 30
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P714_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation member-username-is-unique-in-team (
        name: Member username is unique in team
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery: select 1 from ITR_TEAM_MEMBERS where TEAM_ID = :P714_TEAM_ID and upper(USERNAME) = upper(:P714_USERNAME) and ID <> nvl(:P714_ID, -1)
        }
        error {
            errorMessage: &APP_TEXT$ITR_UI_THIS_USERNAME_IS_ALREADY_ASSIGNED_TO_THE_SELECTED_TEAM.
            associatedItem: @P714_USERNAME
        }
    )

    validation only-one-explicit-team-leader (
        name: Only one explicit team leader
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_leader_count number;
                begin
                    select count(*)
                      into l_leader_count
                      from ITR_TEAM_MEMBERS
                     where TEAM_ID = :P714_TEAM_ID
                       and upper(ROLE) = 'LEADER'
                       and ID <> nvl(:P714_ID, -1);
                
                    return :P714_ROLE <> 'LEADER' or l_leader_count = 0;
                end;
                ```
        }
        error {
            errorMessage: &APP_TEXT$ITR_UI_EACH_TEAM_CAN_HAVE_ONLY_ONE_EXPLICIT_LEADER_EXISTING_COORDINATOR_MEMBERS_REMAIN_LEADER_CAPABLE.
            associatedItem: @P714_ROLE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 50020253303420236
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 50020309956420236
        }
    )

    process process-form-form (
        name: Process form form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 50020416573420236
        }
    )

)
