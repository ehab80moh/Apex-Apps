page 715 (
    name: IT Request Types
    alias: IT-REQUEST-TYPES
    title: &APP_TEXT$ITR_UI_IT_REQUEST_TYPES.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @it-request-setup-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: &APP_TEXT$ITR_UI_BREADCRUMB.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region request-types-report (
        name: Request Types
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select t.id, t.name, t.descr, count(d.id) as detail_count from ITR_REQUEST_TYPES t left join ITR_REQUEST_TYPE_DETAILS d on d.request_type_id = t.id group by t.id, t.name, t.descr order by t.name
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: &APP_TEXT$ITR_UI_NO_DATA_FOUND.
        }

        column DESCR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_DESCRIPTION.
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column DETAIL_COUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_DETAIL_COUNT.
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: &APP_TEXT$ITR_UI_ID.
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 716
                    items: {
                        P716_ID: #ID#
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
        )

        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: &APP_TEXT$ITR_UI_NAME.
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 717
                    items: {
                        P717_REQUEST_TYPE_ID: #ID#
                    }
                }
                linkText: #NAME#
            }
        )

    )

    button new-request-type (
        buttonName: NEW-REQUEST-TYPE
        label: &APP_TEXT$ITR_UI_NEW_REQUEST_TYPE.
        layout {
            sequence: 10
            region: @request-types-report
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 716
                clearCache: 716
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-request-types-report-on-close (
        name: Refresh on Dialog Close (request-types-report)
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @request-types-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @request-types-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
