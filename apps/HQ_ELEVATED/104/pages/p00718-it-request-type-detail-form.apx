page 718 (
    name: IT Request Type Detail Form
    alias: IT-REQUEST-TYPE-DETAIL-FORM
    title: &APP_TEXT$ITR_UI_IT_REQUEST_TYPE_DETAIL_FORM.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @it-request-setup-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Form
        type: form
        source {
            location: localDatabase
            tableName: ITR_REQUEST_TYPE_DETAILS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P718_DESCR (
        type: textField
        label {
            label: &APP_TEXT$ITR_UI_DESCR.
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @form
            column: DESCR
            dataType: varchar2
        }
    )

    pageItem P718_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P718_REQUEST_TYPE_ID (
        type: selectList
        label {
            label: &APP_TEXT$ITR_UI_REQUEST_TYPE_ID.
        }
        lov {
            type: sqlQuery
            sqlQuery: select name d, id r from ITR_REQUEST_TYPES order by name
            nullDisplayValue: - Select request type -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: REQUEST_TYPE_ID
            dataType: number
        }
    )

    pageItem P718_SUGGESTED_TEAM_ID (
        type: selectList
        label {
            label: &APP_TEXT$ITR_UI_SUGGESTED_TEAM_ID.
        }
        lov {
            type: sqlQuery
            sqlQuery: select name d, id r from ITR_TEAMS order by name
            nullDisplayValue: - No suggested team -
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: SUGGESTED_TEAM_ID
            dataType: number
        }
    )

    pageItem P718_TITLE (
        type: textField
        label {
            label: &APP_TEXT$ITR_UI_TITLE.
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @form
            column: TITLE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$ITR_UI_CANCEL.
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$ITR_UI_CREATE.
        layout {
            sequence: 40
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P718_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: &APP_TEXT$ITR_UI_DELETE.
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this row?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P718_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$ITR_UI_APPLY_CHANGES.
        layout {
            sequence: 30
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P718_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation request-detail-title-is-unique (
        name: Request detail title is unique
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery: select 1 from ITR_REQUEST_TYPE_DETAILS where REQUEST_TYPE_ID = :P718_REQUEST_TYPE_ID and upper(TITLE) = upper(:P718_TITLE) and ID <> nvl(:P718_ID, -1)
        }
        error {
            errorMessage: &APP_TEXT$ITR_UI_THIS_REQUEST_DETAIL_ALREADY_EXISTS_FOR_THE_SELECTED_REQUEST_TYPE.
            associatedItem: @P718_TITLE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 50025615581420289
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 50025777267420289
        }
    )

    process process-form-form (
        name: Process form form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 50025869774420289
        }
    )

)
