page 719 (
    name: IT Request Setup Validation
    alias: IT-REQUEST-SETUP-VALIDATION
    title: &APP_TEXT$ITR_UI_IT_REQUEST_SETUP_VALIDATION.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @it-request-setup-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: &APP_TEXT$ITR_UI_BREADCRUMB.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region setup-validation-report (
        name: &APP_TEXT$ITR_UI_CONFIGURATION_ISSUES.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_lang.message('ITR_UI_TEAMS') as issue_type, t.id as record_id, t.name as entity_name,
                       apex_lang.message('ITR_SETUP_NO_LEADER') as issue_description
                  from ITR_TEAMS t
                 where not exists (select 1 from ITR_TEAM_MEMBERS tm where tm.team_id=t.id and upper(trim(tm.role)) in ('LEADER','COORDINATOR'))
                union all
                select apex_lang.message('ITR_UI_IT_REQUEST_TYPES'), t.id, t.name, apex_lang.message('ITR_SETUP_NO_DETAILS')
                  from ITR_REQUEST_TYPES t
                 where not exists (select 1 from ITR_REQUEST_TYPE_DETAILS d where d.request_type_id=t.id)
                union all
                select apex_lang.message('ITR_UI_SUBCATEGORY'), d.id, d.title, apex_lang.message('ITR_SETUP_NO_SUGGESTED_TEAM')
                  from ITR_REQUEST_TYPE_DETAILS d
                 where d.SUGGESTED_TEAM_ID is null
                union all
                select apex_lang.message('ITR_UI_SUBCATEGORY'), d.id, d.title, apex_lang.message('ITR_SETUP_TEAM_NOT_READY')
                  from ITR_REQUEST_TYPE_DETAILS d
                 where d.SUGGESTED_TEAM_ID is not null
                   and not exists (select 1 from ITR_TEAM_MEMBERS tm where tm.team_id=d.SUGGESTED_TEAM_ID and upper(trim(tm.role)) in ('LEADER','COORDINATOR'))
                union all
                select apex_lang.message('ITR_UI_ROLE_MEMBER'), min(tm.id), t.name, apex_lang.message('ITR_SETUP_DUPLICATE_MEMBER')
                  from ITR_TEAM_MEMBERS tm join ITR_TEAMS t on t.id=tm.team_id
                 group by tm.team_id, t.name, tm.username having count(*)>1
                order by issue_type, entity_name
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: &APP_TEXT$ITR_UI_NO_DATA_FOUND.
        }

        column ENTITY_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_ENTITY_NAME.
            }
            layout {
                sequence: 30
            }
        )

        column ISSUE_DESCRIPTION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_ISSUE_DESCRIPTION.
            }
            layout {
                sequence: 40
            }
        )

        column ISSUE_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_ISSUE_TYPE.
            }
            layout {
                sequence: 10
            }
        )

        column RECORD_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: &APP_TEXT$ITR_UI_RECORD_ID.
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
        )

    )

)
