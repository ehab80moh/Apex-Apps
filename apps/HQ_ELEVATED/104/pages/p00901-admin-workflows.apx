page 901 (
    name: admin workflows
    alias: ADMIN-WORKFLOWS
    title: &APP_TEXT$PORTAL_PAGE_901_TITLE.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region admin-workflows (
        name: admin workflows
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region admin-workflows-report (
        name: Admin Workflows - Report
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select workflow_id,
                       workflow_def_name,
                       workflow_def_app_name,
                       title,
                       initiator,
                       state_code,
                       created_on,
                       created_ago,
                       created_ago_hours,
                       last_updated_on,
                       badge_text,
                       badge_state
                  from table ( apex_workflow.get_workflows (
                                   p_context => 'ADMIN_WORKFLOWS'
                                   --, p_application_id => :APP_ID
                                   ) )
                ```
            optimizerHint: APEX$USE_NO_GROUPING_SETS
        }
        orderBy {
            type: item
            item: {
                itemName: P901_SORT_BY
                orderBys: {
                    CREATED_ON: created_on desc
                    LAST_UPDATED_ON: last_updated_on desc
                }
            }
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @cards-container
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            description:
                ```html
                <strong>&WORKFLOW_DEF_NAME!HTML.</strong>
                {if INITIATOR/}
                    <span role="separator" aria-label="&middot;"> &middot; </span>
                    &{APEX.WORKFLOW.INITIATED_BY_USER_SINCE 0=&INITIATOR!HTML. 1=&CREATED_AGO.}.
                {endif/}
                ```
            displayBadge: true
        }
        plugin-badge {
            label: State
            value: BADGE_TEXT
            state: BADGE_STATE
        }
        plugin-appearance {
            applyThemeColors: false
        }
        pagination {
            type: scroll
        }
        entityTitle {
            singular: workflow
            plural: workflows
        }
        messages {
            whenNoDataFound: No Workflows
            noDataFoundIcon: fa-workflow fa-lg
        }

        column BADGE_STATE (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column BADGE_TEXT (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: BADGE_TEXT
                dataType: varchar2
            }
        )

        column CREATED_AGO (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CREATED_AGO
                dataType: varchar2
            }
        )

        column CREATED_AGO_HOURS (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CREATED_AGO_HOURS
                dataType: number
            }
        )

        column CREATED_ON (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: CREATED_ON
                dataType: timestampWithTimeZone
            }
            appearance {
                formatMask: SINCE
            }
        )

        column INITIATOR (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: INITIATOR
                dataType: varchar2
            }
        )

        column LAST_UPDATED_ON (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: LAST_UPDATED_ON
                dataType: timestampWithTimeZone
            }
            appearance {
                formatMask: SINCE
            }
        )

        column STATE_CODE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: STATE_CODE
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column WORKFLOW_DEF_APP_NAME (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: WORKFLOW_DEF_APP_NAME
                dataType: varchar2
            }
        )

        column WORKFLOW_DEF_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: WORKFLOW_DEF_NAME
                dataType: varchar2
            }
        )

        column WORKFLOW_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: WORKFLOW_ID
                dataType: number
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 902
                    items: {
                        P902_WORKFLOW_ID: &WORKFLOW_ID.
                    }
                    action: resetPagination
                }
            }
        )

        action resume (
            position: primaryActions
            template: button
            label: Resume
            layout {
                sequence: 30
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&WORKFLOW_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-play-circle u-success-text
                cssClasses: resume
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :state_code = 'SUSPENDED'
            }
        )

        action suspend (
            position: primaryActions
            template: button
            label: Suspend
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&WORKFLOW_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-pause-circle u-warning-text
                cssClasses: suspend
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :state_code in ('ACTIVE','FAULTED')
            }
        )

        action terminate (
            position: primaryActions
            template: button
            label: Terminate
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&WORKFLOW_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-times u-danger-text
                cssClasses: terminate
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :state_code in ('ACTIVE','FAULTED','SUSPENDED')
            }
        )

    )

    region admin-workflows-smart-filters (
        name: Admin Workflows - Smart Filters
        type: smartFilters
        source {
            filteredRegion: @admin-workflows-report
        }
        layout {
            sequence: 10
            parentRegion: @admin-workflows
            slot: searchFieldAndSmartFilters
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P901_APPLICATION (
            type: checkboxGroup
            label {
                label: Application
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            suggestions {
                type: dynamic
            }
            source {
                databaseColumn: WORKFLOW_DEF_APP_NAME
            }
        )

        filter P901_INITIATED (
            type: range
            label {
                label: Initiated
            }
            settings {
                selectMultiple: true
            }
            lov {
                type: sharedComponent
                lov: @workflow-console-lov-initiated
            }
            layout {
                sequence: 90
            }
            suggestions {
                type: dynamic
            }
            source {
                databaseColumn: CREATED_AGO_HOURS
                dataType: number
            }
        )

        filter P901_INITIATOR (
            type: checkboxGroup
            label {
                label: Initiator
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 80
            }
            suggestions {
                type: dynamic
            }
            source {
                databaseColumn: INITIATOR
            }
        )

        filter P901_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
        )

        filter P901_STATE (
            type: checkboxGroup
            label {
                label: State
            }
            lov {
                type: sharedComponent
                lov: @workflow-console-lov-workflow-state
            }
            layout {
                sequence: 50
            }
            listEntries {
                sortByTopCounts: false
            }
            suggestions {
                type: dynamic
            }
            source {
                databaseColumn: STATE_CODE
            }
        )

        filter P901_TYPE (
            type: checkboxGroup
            label {
                label: Type
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            suggestions {
                type: dynamic
            }
            source {
                databaseColumn: WORKFLOW_DEF_NAME
            }
        )

    )

    pageItem P901_SORT_BY (
        type: selectList
        label {
            label: Sort By
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Create Date;CREATED_ON,Last Update;LAST_UPDATED_ON
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @admin-workflows-report
            slot: sortOrder
            alignment: left
            labelColumnSpan: 0
        }
        appearance {
            template: @hidden
            templateOptions: #DEFAULT#
            icon: fa-sort-amount-desc
            height: 1
        }
        advanced {
            cssClasses: mnw160
            warnOnUnsavedChanges: ignore
        }
        source {
            type: staticValue
            staticValue: LAST_UPDATED_ON
        }
        sessionState {
            storage: user
        }
    )

    pageItem P901_WORKFLOW_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh-admin-workflows-report (
        name: Refresh - Admin Workflows - Report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @admin-workflows-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-smart-filters
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction resume (
        name: Resume
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.resume
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    apex_workflow.resume (
                        p_instance_id => :P901_WORKFLOW_ID );
                    ```
                itemsToSubmit: P901_WORKFLOW_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-smart-filters
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-report
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.dataset.id
            }
            affectedElements {
                selectionType: items
                items: P901_WORKFLOW_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-show-success-message (
            action: showSuccessMessage
            settings {
                message: "&{APEXAPP.WORKFLOW_CONSOLE.PROCESS.RESUME.SUCCESS_MESSAGE}."
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction suspend (
        name: Suspend
        execution {
            sequence: 10
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.suspend
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    apex_workflow.suspend (
                        p_instance_id => :P901_WORKFLOW_ID );
                    ```
                itemsToSubmit: P901_WORKFLOW_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-smart-filters
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-report
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.dataset.id
            }
            affectedElements {
                selectionType: items
                items: P901_WORKFLOW_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-show-success-message (
            action: showSuccessMessage
            settings {
                message: "&{APEXAPP.WORKFLOW_CONSOLE.PROCESS.SUSPEND.SUCCESS_MESSAGE}."
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction terminate (
        name: Terminate
        execution {
            sequence: 30
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.terminate
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    apex_workflow.terminate (
                        p_instance_id => :P901_WORKFLOW_ID );
                    ```
                itemsToSubmit: P901_WORKFLOW_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-smart-filters
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @admin-workflows-report
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.dataset.id
            }
            affectedElements {
                selectionType: items
                items: P901_WORKFLOW_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-show-success-message (
            action: showSuccessMessage
            settings {
                message: "&{APEXAPP.WORKFLOW_CONSOLE.PROCESS.TERMINATE.SUCCESS_MESSAGE}."
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

)
