page 902 (
    name: admin workflows form
    title: &APP_TEXT$PORTAL_PAGE_902_TITLE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }

    region activities (
        name: Activities
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select activity_id,
                       type,
                       name,
                       state,
                       error_message,
                       due_on,
                       retry_count,
                       start_time,
                       end_time,
                       branch_name,
                       initcap(state) as badge_text,
                       case state
                           when 'WAITING'    then 'danger'
                           when 'COMPLETED'  then 'success'
                           when 'TERMINATED' then 'warning'
                           when 'FAULTED'    then 'danger'
                       end as badge_state,
                       ( select max(workflow_id)
                           from apex_workflows w
                          where w.parent_workflow_id = :P902_WORKFLOW_ID
                            and w.parent_activity_id = a.activity_id ) as invoked_workflow_id,
                       ( select count(activity_id)
                           from apex_workflow_activities wa
                          where wa.workflow_id = :P902_WORKFLOW_ID
                            and wa.parent_id = a.activity_id ) as parallel_branches
                  from apex_workflow_activities a
                 where workflow_id = :P902_WORKFLOW_ID
                   and (   (parent_id is null and :P902_PARENT_ACTIVITY_ID is null) 
                        or (parent_id =  :P902_PARENT_ACTIVITY_ID))
                ```
            pageItemsToSubmit: [
                P902_WORKFLOW_ID
                P902_PARENT_ACTIVITY_ID
            ]
        }
        orderBy {
            type: staticValue
            orderByClause: start_time
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            overline:
                ```html
                {if BRANCH_NAME/}
                   <strong>
                    &BRANCH_NAME.
                   </strong>
                {endif/}
                ```
            title: &NAME.
            description: &ERROR_MESSAGE.
            miscellaneous:
                ```html
                {case STATE/}
                    {when COMPLETED/}
                        &{APEX.WORKFLOW.COMPLETED_SINCE 0=&END_TIME.}.
                    {otherwise/}
                        &{APEX.WORKFLOW.STARTED_SINCE 0=&START_TIME.}.
                {endcase/}
                {if DUE_ON/}
                    <span role="separator" aria-label="&middot;"> &middot; </span>
                    &{APEX.WORKFLOW.DUE_SINCE 0=&DUE_ON.}.
                {endif/}
                {if RETRY_COUNT/}
                    {case RETRY_COUNT/}
                        {when 0/}
                        {when 1/}
                        <span role="separator" aria-label="&middot;"> &middot; </span>
                            &{APEX.WORKFLOW.RETRY_COUNT.EQUALS_ONE 0=&RETRY_COUNT.}.
                        {otherwise/}
                        <span role="separator" aria-label="&middot;"> &middot; </span>
                            &{APEX.WORKFLOW.RETRY_COUNT.NOT_EQUALS_ONE 0=&RETRY_COUNT.}.
                    {endcase/}
                {endif/}
                ```
            displayBadge: true
        }
        plugin-badge {
            label: Status
            value: BADGE_TEXT
            state: BADGE_STATE
            style: outline
        }
        pagination {
            entitiesPerPage: 10
        }

        column ACTIVITY_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ACTIVITY_ID
                dataType: number
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column BADGE_TEXT (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: BADGE_TEXT
                dataType: varchar2
            }
        )

        column BRANCH_NAME (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: BRANCH_NAME
                dataType: varchar2
            }
        )

        column DUE_ON (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DUE_ON
                dataType: timestampWithTimeZone
            }
            appearance {
                formatMask: SINCE
            }
        )

        column END_TIME (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: END_TIME
                dataType: timestampWithTimeZone
            }
            appearance {
                formatMask: SINCE
            }
        )

        column ERROR_MESSAGE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ERROR_MESSAGE
                dataType: varchar2
            }
        )

        column INVOKED_WORKFLOW_ID (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: INVOKED_WORKFLOW_ID
                dataType: number
            }
        )

        column NAME (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column PARALLEL_BRANCHES (
            layout {
                sequence: 140
            }
            source {
                databaseColumn: PARALLEL_BRANCHES
                dataType: number
            }
        )

        column RETRY_COUNT (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: RETRY_COUNT
                dataType: number
            }
        )

        column START_TIME (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: START_TIME
                dataType: timestampWithTimeZone
            }
            appearance {
                formatMask: SINCE
            }
        )

        column STATE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: STATE
                dataType: varchar2
            }
        )

        column TYPE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TYPE
                dataType: varchar2
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: class="audit" data-id="&ACTIVITY_ID." aria-haspopup="dialog"
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :PARALLEL_BRANCHES = 0 and :INVOKED_WORKFLOW_ID is null
            }
        )

        action action-2 (
            position: titleLink
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 902
                    items: {
                        P902_WORKFLOW_ID: &INVOKED_WORKFLOW_ID.
                    }
                    clearCache: 902
                    action: resetPagination
                }
            }
            serverSideCondition {
                type: itemIsNotNull
                item: INVOKED_WORKFLOW_ID
            }
        )

        action action-3 (
            position: titleLink
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 902
                    items: {
                        P902_PARENT_ACTIVITY_ID: &ACTIVITY_ID.
                    }
                }
            }
            serverSideCondition {
                type: itemIsNotZero
                item: PARALLEL_BRANCHES
            }
        )

    )

    region activity-audit (
