            plsqlCode:
                ```plsql
                apex_workflow.update_variables (
                    p_instance_id    => :P902_WORKFLOW_ID,
                    p_changed_params => apex_workflow.t_workflow_parameters (
                        1 => apex_workflow.t_workflow_parameter (
                                static_id    => :P902_VARIABLE_ID,
                                string_value => :P902_NEW_VALUE ) ) );
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Variable updated
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
