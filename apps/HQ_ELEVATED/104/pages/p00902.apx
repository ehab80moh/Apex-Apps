    dynamicAction activity-audit (
        name: Activity Audit
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.audit
        }

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @activity-audit
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @activity-audit
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: apex.jQuery(this.triggeringElement).attr("data-id")
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P902_ACTIVITY_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

