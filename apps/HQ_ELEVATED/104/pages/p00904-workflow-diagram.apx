page 904 (
    name: workflow diagram
    alias: WORKFLOW-DIAGRAM
    title: &APP_TEXT$PORTAL_PAGE_904_TITLE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region diagram (
        name: diagram
        type: workflowDiagram
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            workflowId: P904_WF_ID
        }
    )

    pageItem P904_WF_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

)
