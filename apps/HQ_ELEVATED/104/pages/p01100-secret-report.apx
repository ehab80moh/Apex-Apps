        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 2076412 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPLOYEE_NUMBER (
                sequence: 1
            )

            displayColumn EMP_NO (
                sequence: 4
