            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column GENERAL_DEPARTMENT (
            type: plainText
            heading {
                heading: &APP_TEXT$GENERAL_DEPARTMENT.
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column GRADE (
            type: plainText
            heading {
                heading: &APP_TEXT$GRADE.
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column JOB (
