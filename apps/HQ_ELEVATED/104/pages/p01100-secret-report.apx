page 1100 (
    name: secret report
    alias: SECRET-REPORT
    title: &APP_TEXT$SECRET_REPORT.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employees-list (
        name: Employees List
        title: &APP_TEXT$EMPLOYEES_LIST.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    employee_number,
                    full_name,
                    pos,
                    project,
                    employee_number AS EMP_NO
                FROM xxsecret_main_emp_data
                ORDER BY project desc, employee_number
                
                ```
        }
        layout {
            sequence: 51
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column EMPLOYEE_NUMBER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$EMPLOYEE_NUMBER.
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column EMP_NO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: &APP_TEXT$EMP_NO.
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression: "&{COLUMN_HTML_EXPRESSION EMPLOYEE_NUMBER=#EMPLOYEE_NUMBER#}!RAW."
            }
            sorting {
                sortable: false
            }
        )

        column FULL_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: &APP_TEXT$FULL_NAME.
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column POS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: &APP_TEXT$POS.
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column PROJECT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$PROJECT.
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region employees-list-2 (
        name: Employees List
        title: &APP_TEXT$EMPLOYEES_LIST.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    employee_number,
                    full_name,
                    pos Job,
                    Current_position,
                    project,
                    grade,
                    exp_y "EXPERIENCE",
                    cont_type Contract_type,
                    gdept general_department,
                    employee_number AS EMP_NO
                FROM xxsecret_main_emp_data
                ORDER BY  employee_number
                ```
        }
        layout {
            sequence: 41
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 205311752424615407
        }

        column CONTRACT_TYPE (
            type: plainText
            heading {
                heading: &APP_TEXT$CONTRACT_TYPE.
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

