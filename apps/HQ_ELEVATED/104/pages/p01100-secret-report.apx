    pageItem P1100_EMP_NUMBER (
        type: textField
        label {
            label: &APP_TEXT$EMP_NUMBER.
            alignment: left
        }
        layout {
            sequence: 11
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button show-report (
        buttonName: show_report
        label: &APP_TEXT$SHOW_REPORT.
        layout {
            sequence: 21
            slot: body
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        advanced {
            htmlDomId: sh-rp-btn
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P1100_EMP_NUMBER
            }
            execution {
                sequence: 10
            }
        )

        triggerAction plugin-be-apexrnd-aop-da (
            action: plugin/ucApexOfficePrintAopDa
            settings {
                templateType: filenameWithPathRelativeToAopServer
                templateSource3: C:\aop_24_2\reports\secret_report.docx
                dataSource: SELECT 'file1' AS "filename", CURSOR( SELECT CURSOR ( SELECT E.EMPLOYEE_NUMBER AS EMPLOYEE_NUMBER, E.NATIONAL_IDENTIFIER AS NATIONAL_IDENTIFIER, E.FULL_NAME AS FULL_NAME, E.CONT_TYPE AS CONT_TYPE, E.AGE_YEARS AS AGE_YEARS, E.RELIGION AS RELIGION, E.NATIONALITY AS NATIONALITY, E.EMAIL AS EMAIL, E.OIL_SECTOR_JOIN AS OIL_SECTOR_JOIN, E.MAR_STAT AS MAR_STAT, E.MOBILE AS MOBILE, E.HOME_PHONE AS HOME_PHONE, E.POS AS POS, E.CURRENT_POSITION AS CURRENT_POSITION, E.GDEPT AS GDEPT, E.PROJECT AS PROJECT, E.LAST_2_YEARS AS LAST_2_YEARS, E.LAST_3_YEARS AS LAST_3_YEARS, E.LAST_4_YEARS AS LAST_4_YEARS, E."last_4_years_txt" AS LAST_4_YEARS_TXT, E."last_3_years_txt" AS LAST_3_YEARS_TXT, E."last_2_years_txt" AS LAST_2_YEARS_TXT, E.EXP_Y AS EXP_Y, E.EXP_M AS EXP_M, E.EXP_D AS EXP_D, TO_CHAR(E.DATE_OF_BIRTH, 'DD/MM/YYYY') AS DATE_OF_BIRTH, E.FINANCIAL_LOADING AS FINANCIAL_LOADING, E.ASSIGNED_GRADE AS ASSIGNED_GRADE, E.NADB_GRADE AS NADB_GRADE, E.ASSIGNED_POSITION AS ASSIGNED_POSITION, E.NADB_POSITION AS NADB_POSITION, E.GRADE AS GRADE, E.YEARS_FROM_GADE_DATE AS YEARS_FROM_GADE_DATE, TO_CHAR(E.JOB_DATE, 'DD/MM/YYYY') AS JOB_DATE, TO_CHAR(E.GRADE_DATE, 'DD/MM/YYYY') AS GRADE_DATE, E.DELGATION_DATE AS DELGATION_DATE, E.PRIMARY_ADDRESS AS PRIMARY_ADDRESS, DECODE(E.HAS_ACTIVE_DISCIPLINARY_ACTION, 'N', 'لا يوجد', 'يوجد') AS HAS_D_ACTION, DECODE(E.HAS_ACTIVE_DISCIPLINARY_ACTION, 'N', '', 'مُرفق شهادة مُعتمدة') AS HAS_D_ACTION_TXT, E.HAS_LONG_LEAVE AS HAS_LONG_LEAVE, TO_CHAR(TO_DATE('2026-01-01', 'YYYY-MM-DD'), 'Month YYYY', 'NLS_DATE_LANGUAGE = ARABIC') AS FORMATTED_DATE, CURSOR ( SELECT R.RELATIVE_NATIONAL_ID AS RELATIVE_RELATIVE_NATIONAL_ID, R.RELATION_STATUS AS RELATIVE_RELATION_STATUS, R.SEX AS RELATIVE_SEX, R.DATE_OF_BIRTH AS RELATIVE_DATE_OF_BIRTH, R.RELATIVE_AGE AS RELATIVE_AGE, R.RELATIVE_TYPE AS RELATIVE_TYPE, R.RELATIVE_NAME AS RELATIVE_NAME, R.CONTACT_TYPE AS CONTACT_TYPE FROM XXSECRET_EMP_RELATIVES R WHERE R.EMPLOYEE_NUMBER = E.EMPLOYEE_NUMBER AND R.RELATION_STATUS = 'Active' AND R.CONTACT_TYPE = 'S') AS "SPOUSES", CURSOR ( SELECT R.RELATIVE_NATIONAL_ID AS RELATIVE_RELATIVE_NATIONAL_ID, R.RELATION_STATUS AS RELATIVE_RELATION_STATUS, R.SEX AS RELATIVE_SEX, R.DATE_OF_BIRTH AS RELATIVE_DATE_OF_BIRTH, R.RELATIVE_AGE AS RELATIVE_AGE, R.RELATIVE_TYPE AS RELATIVE_TYPE, R.RELATIVE_NAME AS RELATIVE_NAME, R.CONTACT_TYPE AS CONTACT_TYPE FROM XXSECRET_EMP_RELATIVES R WHERE R.EMPLOYEE_NUMBER = E.EMPLOYEE_NUMBER AND R.RELATION_STATUS = 'Active' AND R.CONTACT_TYPE NOT IN ( 'S', 'JP_FT', 'JP_MT' ) ) AS "SONS", CURSOR ( SELECT Q.QUALIFICATION_ESTABLISHMENT AS QUALIFICATION_ESTABLISHMENT, Q.QUALIFICATION_NAME AS QUALIFICATION_NAME, Q.QUALIFICATION_TITLE AS QUALIFICATION_TITLE, Q.QUALIFICATION_GRADE AS QUALIFICATION_GRADE, TO_CHAR(Q.QUALIFICATION_AWARDED_DATE, 'DD/MM/YYYY') AS QUALIFICATION_AWARDED_DATE, Q.QUALIFICATION_CATEGORY AS QUALIFICATION_CATEGORY, Q.QUALIFICATION_COMMENTS AS QUALIFICATION_COMMENTS FROM XXSECRET_EMP_QUALIFICATIONS Q WHERE Q.EMP_NUM = E.EMPLOYEE_NUMBER ) AS "QUALS", CURSOR ( SELECT PV.EMPLOYER_NAME, PV.JOB_NAME, TO_CHAR(PV.START_DATE, 'DD/MM/YYYY') START_DATE, TO_CHAR(PV.END_DATE, 'DD/MM/YYYY') END_DATE FROM XXSECRET_EMP_PREV_EMPLOYERS PV WHERE PV.EMPLOYEE_NUMBER = E.EMPLOYEE_NUMBER ) AS "PRV", CURSOR ( SELECT PR.JOB_TITLE, PR.ASSIGNMENT_CATEGORY, PR.GENERAL_DEPARTMENT, PR.APPOINTMENT_DATE, PR.APPOINTMENT_END FROM XXSECRET_EMP_CAREER_PROGRESS PR WHERE PR.EMPLOYEE_NUMBER = E.EMPLOYEE_NUMBER ) AS "PRG", CURSOR ( SELECT UP.C_TYPE_DESC, UP.NAME, TO_CHAR(UP.DATE_START, 'DD/MM/YYYY') DATE_START, TO_CHAR(UP.DATE_END, 'DD/MM/YYYY') DATE_END FROM XXSECRET_UNPAID_ABSENCE UP WHERE UP.EMPLOYEE_NUMBER = E.EMPLOYEE_NUMBER ) AS "UPA" FROM XXSECRET_MAIN_EMP_DATA E WHERE TO_CHAR(E.EMPLOYEE_NUMBER) = :P1100_EMP_NUMBER ) AS "EMPLOYEES" FROM DUAL ) AS "data" FROM DUAL;
                initPlSqlCode:
                    ```plsql
                    aop_api_pkg.g_output_filename         := '&P1100_EMP_NUMBER.';
                    
                    ```
                outputType: wordDocx
            }
            execution {
                sequence: 20
            }
            comments {
                comments: https://www.webtoolkitonline.com/sql-minifier.html
            }
        )

    )

