            columnSpan: 2
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    button apply-filters (
        buttonName: APPLY_FILTERS
        label: عرض الموظفين
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            buttonTemplate: @awesome-text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
    )

    button show-report (
        buttonName: show_report
        label: تحميل عقد Word
        layout {
            sequence: 30
            slot: body
            columnSpan: 4
        }
        appearance {
            buttonTemplate: @awesome-text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: triggerAction
        }
        advanced {
            htmlDomId: sh-rp-btn
        }

        triggerAction print-contract (
            action: plugin/ucApexOfficePrintAopDa
            settings {
                templateType: filenameWithPathRelativeToAopServer
                templateSource3: C:\aop_24_2\reports\permanent_contract.docx
                dataType: plSqlFunctionReturningSql
                dataSource2:
                    ```plsql
                    DECLARE
                     l_source CLOB;
                     l_first PLS_INTEGER;
                     l_last PLS_INTEGER;
                    BEGIN
                     SELECT region_source INTO l_source FROM apex_application_page_regions
                     WHERE application_id = TO_NUMBER(V('APP_ID')) AND page_id = 1101
                       AND region_static_id = 'employees-list';
                     l_first := DBMS_LOB.INSTR(l_source, '/*CONTRACT_DATA_BEGIN*/');
                     l_last := DBMS_LOB.INSTR(l_source, '/*CONTRACT_DATA_END*/');
                     IF l_first = 0 OR l_last <= l_first THEN
                       RAISE_APPLICATION_ERROR(-20006, 'Contract report SQL markers are missing.');
                     END IF;
                     l_first := l_first + LENGTH('/*CONTRACT_DATA_BEGIN*/');
                     RETURN 'WITH eligible AS (' || DBMS_LOB.SUBSTR(l_source, l_last-l_first, l_first)
                            || ')' || CHR(10) || q'~SELECT 'permanent_contract_' || q.emp_num || '_' || TO_CHAR(q.effdate, 'YYYYMMDD') AS "filename",
                    CURSOR(
                    SELECT q.emp_num AS "emp_num", q.full_name AS "full_name",
                    q.national_identifier AS "national_identifier", q.nationality AS "nationality",
                    q.insu_no AS "insu_no", q.project AS "project", q.birthda AS "birthda",
                    q.qual AS "qual", q.job AS "job", q.gdept AS "gdept", q.address AS "address",
                    TO_CHAR(q.basic_sal, 'FM999G999G999G990D00', 'NLS_NUMERIC_CHARACTERS=''.,''') AS "basic_sal",
                    q.basic_salary AS "basic_salary",
                    CASE q.grade
                    WHEN '01' THEN 'الأول' WHEN '02' THEN 'الثاني' WHEN '03' THEN 'الثالث'
                    WHEN '04' THEN 'الرابع' WHEN '05' THEN 'الخامس' WHEN '06' THEN 'السادس'
                    WHEN '07' THEN 'السابع' WHEN '08' THEN 'الثامن' WHEN '09' THEN 'التاسع'
                    WHEN '10' THEN 'العاشر' ELSE q.grade END AS "grade_text",
                    CASE TO_CHAR(q.step)
                    WHEN '1' THEN 'الأولى' WHEN '2' THEN 'الثانية' WHEN '3' THEN 'الثالثة'
                    WHEN '4' THEN 'الرابعة' WHEN '5' THEN 'الخامسة' WHEN '6' THEN 'السادسة'
                    WHEN '7' THEN 'السابعة' WHEN '8' THEN 'الثامنة' WHEN '9' THEN 'التاسعة'
                    WHEN '10' THEN 'العاشرة' ELSE TO_CHAR(q.step) END AS "step_text",
                    TO_CHAR(q.contract_start_date, 'fmDAY', 'NLS_DATE_LANGUAGE=ARABIC') AS "contract_day",
                    CASE TO_CHAR(q.contract_start_date, 'DD') WHEN '01' THEN 'الأول'
                    ELSE TO_CHAR(q.contract_start_date, 'FMDD') END || ' من ' ||
                    TO_CHAR(q.contract_start_date, 'fmMONTH', 'NLS_DATE_LANGUAGE=ARABIC') ||
                    ' عام ' || TO_CHAR(q.contract_start_date, 'YYYY') || 'م' AS "contract_date"
                    FROM dual
                    ) AS "data"
                    FROM eligible q
                    WHERE q.emp_num = TRIM(:P1101_EMP_NUMBER)~';
                    END;
                    ```
                initPlSqlCode: aop_api_pkg.g_output_filename := 'permanent_contract_' || V('P1101_EMP_NUMBER');
                outputType: wordDocx
            }
            execution {
                sequence: 20
            }
        )

        triggerAction validate-selection (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    l_date DATE;
                    l_count PLS_INTEGER;
                    BEGIN
                    BEGIN
                    l_date := TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY');
                    IF l_date IS NULL THEN
                    RAISE VALUE_ERROR;
                    END IF;
                    EXCEPTION WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20001, 'أدخل تاريخ السريان بالصيغة dd-mm-yyyy.');
                    END;
                    IF TRIM(:P1101_EMP_NUMBER) IS NULL OR NOT REGEXP_LIKE(TRIM(:P1101_EMP_NUMBER), '^[0-9]+$') THEN
                    RAISE_APPLICATION_ERROR(-20002, 'اختر رقم الموظف المراد طباعة عقده.');
                    END IF;
                    SELECT COUNT(*) INTO l_count
                    FROM (
                    SELECT pap.employee_number AS emp_num
                    FROM
                    apps.per_all_people_f@prod pap,
                    apps.per_all_assignments_f@prod pas,
                    apps.per_contracts_f@prod con,
                    apps.per_grades@prod grd,
                    apps.hr_locations_all@prod loc,
                    apps.fnd_lookup_values@prod n,
                    apps.per_qualifications_v@prod pql,
                    apps.per_qualification_types_v@prod pqt
                    WHERE
                    pap.person_id = pas.person_id(+)
                    AND pas.grade_id = grd.grade_id(+)
                    AND pas.location_id = loc.location_id(+)
                    AND pap.person_id = con.person_id(+)
                    AND pap.person_id = pql.person_id(+)
                    AND pql.qualification_type_id = pqt.qualification_type_id(+)
                    AND (pap.nationality = n.lookup_code AND n.lookup_type LIKE 'NATION%' AND n.source_lang LIKE 'AR')
                    AND pql.attribute1(+) LIKE 'Yes'
                    AND pap.current_employee_flag LIKE 'Y'
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') BETWEEN pap.effective_start_date AND pap.effective_end_date
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') BETWEEN pas.effective_start_date AND pas.effective_end_date
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') BETWEEN con.effective_start_date AND con.effective_end_date
                    AND con.status LIKE 'A-ACTIVE'
                    AND apps.xxeprom_person.get_emp_contract_type_us@prod(pap.person_id, SYSDATE) LIKE 'Permanent'
                    AND apps.xxeprom_person.get_emp_contract_type@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) IS NOT NULL
                    AND apps.xxeprom_person.get_emp_contract_start_date@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) >= SYSDATE - 90
                    AND grd.name NOT LIKE '%ERC%'
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') - 1 >= ADD_MONTHS(pap.start_date, 12)
                    AND (
                    (:P1101_EMPLOYEE_SET IS NULL AND :P1101_EMPLOYEE_SET_1 IS NULL AND :P1101_EMPLOYEE_SET_2 IS NULL AND :P1101_EMPLOYEE_SET_3 IS NULL)
                    OR (:P1101_EMPLOYEE_SET IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET || ',' LIKE '%,' || pap.employee_number || ',%')
                    OR (:P1101_EMPLOYEE_SET_1 IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET_1 || ',' LIKE '%,' || pap.employee_number || ',%')
                    OR (:P1101_EMPLOYEE_SET_2 IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET_2 || ',' LIKE '%,' || pap.employee_number || ',%')
                    OR (:P1101_EMPLOYEE_SET_3 IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET_3 || ',' LIKE '%,' || pap.employee_number || ',%')
                    )
                    ) q
                    WHERE q.emp_num = TRIM(:P1101_EMP_NUMBER);
                    IF l_count = 0 THEN
                    RAISE_APPLICATION_ERROR(-20003, 'الموظف لا يستوفي شروط الاستعلام في تاريخ السريان ومجموعات الاختيار المحددة.');
                    ELSIF l_count > 1 THEN
                    RAISE_APPLICATION_ERROR(-20004, 'الاستعلام أعاد أكثر من سجل للموظف؛ راجع بيانات العقود والمؤهلات قبل الطباعة.');
                    END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P1101_EFFECTIVE_DATE
                    P1101_EMPLOYEE_SET
                    P1101_EMPLOYEE_SET_1
                    P1101_EMPLOYEE_SET_2
                    P1101_EMPLOYEE_SET_3
                    P1101_EMP_NUMBER
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction print-row (
        name: Print row contract
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action bind-print-button (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click.contract1101', '.sh-rp', function () {
                        $s('P1101_EMP_NUMBER', String($(this).attr('data-id')));
                        $('#sh-rp-btn').trigger('click');
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

