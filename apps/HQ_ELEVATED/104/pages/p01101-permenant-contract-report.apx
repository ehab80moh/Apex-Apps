page 1101 (
    name: Permenant Contract Report
    alias: PERMENANT-CONTRACT-REPORT
    title: عقود العمل غير محددة المدة
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employees-list (
        name: Employees List
        title: الموظفون المستوفون لشروط العقد
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT q.emp_num AS employee_number, q.full_name, q.job AS job, q.project, q.emp_num AS emp_num,q.start_date,q.contract_start_date,q.qual
                FROM (
                /*CONTRACT_DATA_BEGIN*/
                SELECT
                    TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') AS effdate,
                    pap.employee_number AS emp_num,
                    pap.full_name,
                    pap.start_date,
                    pap.national_identifier,
                    n.meaning AS nationality,
                    apps.xxeprom_person.get_insurance_number@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) AS insu_no,
                    LTRIM(RTRIM(apps.remove_hamza_trim@prod(pas.ass_attribute13))) AS project,
                    TO_CHAR(pap.date_of_birth, 'dd/mm/yyyy') || 'م  - ' || pap.region_of_birth || ' / ' || pap.town_of_birth AS birthda,
                    pql.comments AS qual,
                    CASE TO_CHAR(apps.xxeprom_person.get_emp_contract_start_date@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')), 'MM')
                        WHEN '01' THEN 'الأول من يناير' WHEN '02' THEN 'الأول من فبراير' WHEN '03' THEN 'الأول من مارس'
                        WHEN '04' THEN 'الأول من أبريل' WHEN '05' THEN 'الأول من مايو' WHEN '06' THEN 'الأول من يونيو'
                        WHEN '07' THEN 'الأول من يوليو' WHEN '08' THEN 'الأول من أغسطس' WHEN '09' THEN 'الأول من سبتمبر'
                        WHEN '10' THEN 'الأول من أكتوبر' WHEN '11' THEN 'الأول من نوفمبر' WHEN '12' THEN 'الأول من ديسمبر'
                    END || ' عام ' || TO_CHAR(apps.xxeprom_person.get_emp_contract_start_date@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')), 'YYYY') || 'م' AS con_date,
                    SUBSTR(grd.name, INSTR(grd.name, '.') + 1) AS grade,
                    apps.xxeprom_assignment.get_step_num@prod(pas.assignment_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) AS step,
                    apps.xxeprom_payroll2.xxhr_get_eprom_basic_new_perme@prod(
                        SUBSTR(grd.name, INSTR(grd.name, '.') + 1),
                        apps.xxeprom_assignment.get_step_num@prod(pas.assignment_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')),
                        TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')
                    ) AS basic_sal,
                    apps.xxeprom_hr_general.number_to_arabic@prod(
                        apps.xxeprom_payroll2.xxhr_get_eprom_basic_new_perme@prod(
                            SUBSTR(grd.name, INSTR(grd.name, '.') + 1),
                            apps.xxeprom_assignment.get_step_num@prod(pas.assignment_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')),
                            TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')
                        )
                    ) AS basic_salary,
                    pas.ass_attribute8 AS job,
                    pas.ass_attribute12 AS gdept,
                    apps.xxeprom_person.get_primary_address@prod(pap.person_id, SYSDATE) AS address,
                    -- Additional projection for the template; original eligibility is unchanged.
                    apps.xxeprom_person.get_emp_contract_start_date@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) AS contract_start_date
                FROM
                    apps.per_all_people_f@prod pap,
                    apps.per_all_assignments_f@prod pas,
                    apps.per_contracts_f@prod con,
                    apps.per_grades@prod grd,
                    apps.hr_locations_all@prod loc,
                    apps.fnd_lookup_values@prod n,
                    apps.per_qualifications_v@prod pql,
                    apps.per_qualification_types_v@prod pqt
                WHERE
                    pap.person_id = pas.person_id(+)
                    AND pas.grade_id = grd.grade_id(+)
                    AND pas.location_id = loc.location_id(+)
                    AND pap.person_id = con.person_id(+)
                    AND pap.person_id = pql.person_id(+)
                    AND pql.qualification_type_id = pqt.qualification_type_id(+)
                    AND (pap.nationality = n.lookup_code AND n.lookup_type LIKE 'NATION%' AND n.source_lang LIKE 'AR')
                    AND pql.attribute1(+) LIKE 'Yes'
                    AND pap.current_employee_flag LIKE 'Y'
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') BETWEEN pap.effective_start_date AND pap.effective_end_date
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') BETWEEN pas.effective_start_date AND pas.effective_end_date
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') BETWEEN con.effective_start_date AND con.effective_end_date
                    AND con.status LIKE 'A-ACTIVE'
                    AND apps.xxeprom_person.get_emp_contract_type_us@prod(pap.person_id, SYSDATE) LIKE 'Permanent'
                    AND apps.xxeprom_person.get_emp_contract_type@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) IS NOT NULL
                    AND apps.xxeprom_person.get_emp_contract_start_date@prod(pap.person_id, TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY')) >= SYSDATE - 90
                    AND grd.name NOT LIKE '%ERC%'
                    AND TO_DATE(:P1101_EFFECTIVE_DATE, 'FXDD-MM-YYYY') - 1 >= ADD_MONTHS(pap.start_date, 12)
                    AND (
                        (:P1101_EMPLOYEE_SET IS NULL AND :P1101_EMPLOYEE_SET_1 IS NULL AND :P1101_EMPLOYEE_SET_2 IS NULL AND :P1101_EMPLOYEE_SET_3 IS NULL)
                        OR (:P1101_EMPLOYEE_SET IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET || ',' LIKE '%,' || pap.employee_number || ',%')
                        OR (:P1101_EMPLOYEE_SET_1 IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET_1 || ',' LIKE '%,' || pap.employee_number || ',%')
                        OR (:P1101_EMPLOYEE_SET_2 IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET_2 || ',' LIKE '%,' || pap.employee_number || ',%')
                        OR (:P1101_EMPLOYEE_SET_3 IS NOT NULL AND ',' || :P1101_EMPLOYEE_SET_3 || ',' LIKE '%,' || pap.employee_number || ',%')
                    )
                /*CONTRACT_DATA_END*/
                ) q
                ORDER BY q.emp_num
                
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CONTRACT_START_DATE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Contract Start Date
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column EMPLOYEE_NUMBER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &APP_TEXT$EMPLOYEE_NUMBER.
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column EMP_NUM (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: &APP_TEXT$EMP_NO.
                alignment: center
            }
            layout {
                sequence: 110
            }
            columnFormatting {
                htmlExpression: <button type='button' class='t-Button t-Button--small sh-rp' data-id='#EMPLOYEE_NUMBER#'>Word</button>
            }
            sorting {
                sortable: false
            }
        )

        column FULL_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: &APP_TEXT$FULL_NAME.
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column JOB (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column PROJECT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: &APP_TEXT$PROJECT.
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column QUAL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Qual
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column START_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Start Date
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P1101_EFFECTIVE_DATE (
        type: textField
        label {
            label: تاريخ السريان (dd-mm-yyyy)
            alignment: left
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
            column: 1
            columnSpan: 1
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 50
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        default {
            type: expression
            plsqlExpression: TO_CHAR(TRUNC(SYSDATE), 'DD-MM-YYYY')
        }
    )

    pageItem P1101_EMPLOYEE_SET (
        type: textField
        label {
            label: عرض مجموعة الموظفين 1 (فاصلة إنجليزية دون مسافات)
            alignment: left
        }
        layout {
            sequence: 50
            slot: body
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    pageItem P1101_EMPLOYEE_SET_1 (
        type: textField
        label {
            label: عرض مجموعة الموظفين 2
            alignment: left
        }
        layout {
            sequence: 60
            slot: body
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    pageItem P1101_EMPLOYEE_SET_2 (
        type: textField
        label {
            label: عرض مجموعة الموظفين 3
            alignment: left
        }
        layout {
            sequence: 70
            slot: body
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    pageItem P1101_EMPLOYEE_SET_3 (
        type: textField
        label {
            label: عرض مجموعة الموظفين 4
            alignment: left
        }
        layout {
            sequence: 80
            slot: body
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 50
        }
    )

    pageItem P1101_EMP_NUMBER (
        type: textField
        label {
            label: رقم الموظف المراد طباعة عقده
            alignment: left
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
