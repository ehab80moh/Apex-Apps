    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: BODY
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ( this.data.successMessage ) {
                    
                      apex.message.showPageSuccess(this.data.successMessage.text);
                    
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process enter-emp-id (
        name: Enter_emp_id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                :P4000_EMP_ID:=NVL(:P4000_EMP_ID,:APP_USER);
                :p4000_EMP_NUMBER:=:P4000_EMP_ID;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 38285454331689025
        }
    )

    process initialize-form-الخدمات-الالكترونية-للموظف (
        name: Initialize form الخدمات الالكترونية للموظف
        type: formInitialization
        formRegion: @بيانات-صاحب-الطلب
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 38284644558689014
        }
    )

    process new (
        name: New
        type: clearSessionState
        clear {
            type: items
            items: P4000_EMP_ID
        }
        execution {
            sequence: 10
            point: afterFooter
        }
        advanced {
            executionMappingIdentifier: 38285892082689026
        }
    )

)
