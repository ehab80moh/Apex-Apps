page 4000 (
    name: الخدمات الالكترونية للموظف
    alias: SE
    title: &APP_TEXT$ELECTRONIC_SERVICES_FOR_THE_EMPLOYEE.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .imgs {
              display: block;
              margin-left: auto;
              margin-right: auto;
              width: 30%;
            }
            
            .service-card-grid .imgs,
            .service-department .imgs {
              display: block;
              width: 34%;
              max-width: 7rem;
              min-width: 4.5rem;
              margin-inline: auto;
              object-fit: contain;
              filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.09));
              transition: transform 200ms ease;
            }
            
            .service-card-grid .t-Card:hover .imgs,
            .service-card-grid .a-CardView:hover .imgs,
            .service-card-grid .a-CardView-card:hover .imgs,
            .service-department .t-Card:hover .imgs,
            .service-department .a-CardView:hover .imgs,
            .service-department .a-CardView-card:hover .imgs {
              transform: scale(1.04);
            }
            
            :root {
              --ut-region-header-min-height: 1.75rem;
              --ut-region-header-padding: 0.35rem 0.75rem;
            }
            
            .t-Region-header {
              min-height: 1.75rem;
              padding: 0.35rem 0.75rem;
            }
            
            .t-Region-headerItems,
            .t-Region-headerItems--title,
            .t-Region-headerItems--controls,
            .t-Region-headerItems--buttons {
              padding-block: 0 !important;
            }
            
            .t-Region-header .t-Region-title {
              font-size: 0.95rem;
              line-height: 1.2;
            }
            
            .t-Region-header .t-Region-titleButton {
              padding: 0.1rem 0.35rem;
              min-height: unset;
              line-height: 1.2;
            }
            
            .t-Region-header .t-Button--hideShow {
              width: 1.5rem;
              height: 1.5rem;
              min-height: 1.5rem;
              line-height: 1.5rem;
              display: inline-flex;
              align-items: center;
              justify-content: center;
            }
            
            .t-Region-header .t-Region-headerItems--controls {
              min-height: 1.5rem;
              display: inline-flex;
              align-items: center;
            }
            
            .service-department {
              margin-block: 0.85rem;
              border: 0;
              border-radius: 1.25rem;
              overflow: hidden;
              box-shadow: 0 0.35rem 1.4rem rgba(24, 39, 75, 0.08);
            }
            
            .service-department > .t-Region-header {
              min-height: 1.85rem;
              padding: 0.55rem 0.9rem;
              padding-block: 0.35rem;
              background: linear-gradient(135deg, #123d5a, #1c6b7f);
              color: #fff;
            }
            
            .service-department > .t-Region-header .t-Region-title {
              font-size: 1rem;
              font-weight: 700;
              line-height: 1.2;
            }
            
            .service-department > .t-Region-body {
              padding: 1.15rem;
              background: #f8fafc;
            }
            
            .service-department--compact {
              margin-block: 0.45rem;
              border: 1px solid rgba(14, 116, 144, 0.16);
              border-radius: 0.8rem;
              box-shadow: 0 0.2rem 0.8rem rgba(15, 118, 110, 0.08);
            }
            
            .service-department--compact > .t-Region-header {
              min-height: 1.75rem;
              padding: 0.55rem 0.9rem;
              padding-block: 0.3rem;
              background: linear-gradient(135deg, #3f5a73, #3f5a73);
            }
            
            .service-department--compact > .t-Region-header .t-Region-title {
              font-size: 0.92rem;
              line-height: 1.2;
            }
            
            .service-department--compact > .t-Region-header .t-Region-titleButton {
              padding: 0.1rem 0.35rem;
            }
            
            .service-department--compact > .t-Region-header .t-Button--hideShow {
              width: 1.5rem;
              height: 1.5rem;
              min-height: 1.5rem;
              line-height: 1.5rem;
            }
            
            .service-department--compact > .t-Region-header .t-Region-headerItems--controls {
              min-height: 1.5rem;
            }
            
            .service-department--compact .t-Region-body {
              padding: 0.7rem;
            }
            
            .service-department--secondary {
              border-color: rgba(71, 85, 105, 0.2);
            }
            
            .service-department--secondary > .t-Region-header {
              background: linear-gradient(135deg, #3f5a73, #3f5a73);
            }
            
            .service-card-grid .t-Cards-item,
            .service-card-grid .a-CardView-item,
            .service-department .t-Cards-item,
            .service-department .a-CardView-item {
              min-height: 15rem;
            }
            
            .service-card-grid .t-Card,
            .service-card-grid .a-CardView,
            .service-card-grid .a-CardView-card,
            .service-card-grid .a-CardView-item .a-CardView,
            .service-department .t-Card,
            .service-department .a-CardView,
            .service-department .a-CardView-card,
            .service-department .a-CardView-item .a-CardView {
              position: relative;
              display: flex;
              flex-direction: column;
              height: 100%;
              border-radius: 1.1rem;
              border: 1px solid rgba(203, 213, 225, 0.85);
              background: linear-gradient(180deg, #ffffff 0%, #fbfcfd 55%, #f4f6f9 100%);
              box-shadow:
                inset 0 1px 0 0 rgba(255, 255, 255, 0.95),
                inset 0 -1px 0 0 rgba(15, 23, 42, 0.04),
                0 0.2rem 0.6rem -0.1rem rgba(15, 23, 42, 0.06),
                0 0.45rem 1.1rem -0.2rem rgba(15, 118, 110, 0.07);
              transition: transform 200ms cubic-bezier(0.34, 1.4, 0.64, 1),
                          box-shadow 200ms ease,
                          border-color 200ms ease;
              overflow: hidden;
            }
            
            .service-card-grid .t-Card:hover,
            .service-card-grid .t-Card:focus-within,
            .service-card-grid .a-CardView:hover,
            .service-card-grid .a-CardView:focus-within,
            .service-card-grid .a-CardView-card:hover,
            .service-card-grid .a-CardView-card:focus-within,
            .service-card-grid .a-CardView-item .a-CardView:hover,
            .service-card-grid .a-CardView-item .a-CardView:focus-within,
            .service-department .t-Card:hover,
            .service-department .t-Card:focus-within,
            .service-department .a-CardView:hover,
            .service-department .a-CardView:focus-within,
            .service-department .a-CardView-card:hover,
            .service-department .a-CardView-card:focus-within,
            .service-department .a-CardView-item .a-CardView:hover,
            .service-department .a-CardView-item .a-CardView:focus-within {
              transform: translateY(-0.35rem);
              border-color: rgba(61, 69, 72, 0.38);
              box-shadow:
                inset 0 1px 0 0 #ffffff,
                inset 0 -1px 0 0 rgba(15, 23, 42, 0.05),
                0 0.85rem 1.85rem -0.25rem rgba(15, 118, 110, 0.16),
