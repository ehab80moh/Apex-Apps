            }
        )

    )

    region أظهر-المزيد (
        name: أظهر المزيد ...
        title: &APP_TEXT$SHOW_MORE.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                SELECT REQUEST_TYPE_ID,
                       APEX_LANG.MESSAGE(
                           CASE
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('LEAVE_REQUEST_1', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'LEAVE_REQUEST_1'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('REQUEST_PERMISSION', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'REQUEST_PERMISSION'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('TASK_REQUEST', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'TASK_REQUEST'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('REQUEST_FOR_ADDITIONAL_WORKING_HOURS_OVERTIME_REST_PUBLIC', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'REQUEST_FOR_ADDITIONAL_WORKING_HOURS_OVERTIME_REST_PUBLIC'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE'
                               ELSE REQUEST_TYPE_NAME
                           END
                       ) REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE(
                           CASE
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_LEAVE_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_LEAVE_BODY'
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_PERMISSION_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_PERMISSION_BODY'
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_TASK_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_TASK_BODY'
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_OVERTIME_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_OVERTIME_BODY'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE_BODY'
                               ELSE REQUEST_DESCRIPTION
                           END
                       ) REQUEST_DESCRIPTION,
                       AUDIT_CODE,
                       STATUS,
                       OWNER_DEPARTMENT,
                       REQUIRED_ATTACHMENT,
                       IS_ACTIVE,
                       IMG_URL IMG_URL,
                       CASE 
                           WHEN REQUEST_TYPE_ID = 59 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 15)
                           WHEN REQUEST_TYPE_ID = 61 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 28)
                           WHEN REQUEST_TYPE_ID = 72 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 29)
                           WHEN REQUEST_TYPE_ID = 76 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 30)
                           WHEN REQUEST_TYPE_ID = 47 THEN APEX_PAGE.GET_URL(p_application => 104, p_page =>30)
                       END prev_req_url
                  FROM CENTRAL.APR_REQUESTS_LIST
                 WHERE REQUEST_TYPE_ID = 0
                 UNION ALL
                SELECT NULL, 
                       APEX_LANG.MESSAGE('REQUEST_FOR_FINANCIAL_SUPPORT_FOR_HAJJ') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '#APP_FILES#route.png' IMG_URL,
                       APEX_PAGE.GET_URL(p_application => 105, p_page => 31) prev_req_url
                  FROM dual
                 UNION ALL
                SELECT NULL, 
                       APEX_LANG.MESSAGE('REQUEST_FOR_FINANCIAL_SUPPORT_FOR_UMRAH') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '#APP_FILES#religion.png' IMG_URL,
                       APEX_PAGE.GET_URL(p_application => 105, p_page => 33) prev_req_url
                  FROM dual
                 UNION ALL
                SELECT NULL, 
                       APEX_LANG.MESSAGE('REQUEST_FOR_OBTAINING_A_SOCIAL_LOAN') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '#APP_FILES#cash.png' IMG_URL,
                       APEX_PAGE.GET_URL(p_application => 105, p_page => 35) prev_req_url
                  FROM dual
                 UNION ALL
                SELECT NULL, 
                       APEX_LANG.MESSAGE('REQUEST_FOR_A_MARRIAGE_LOAN') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '#APP_FILES#5.jpg' IMG_URL,
                        APEX_PAGE.GET_URL(p_application => 105, p_page => 39) prev_req_url
                   FROM dual
                  UNION ALL
                 SELECT NULL,
                        APEX_LANG.MESSAGE('APPLYING_FOR_A_SCHOOL_LOAN') REQUEST_TYPE_NAME,
                        APEX_LANG.MESSAGE('REQUEST_FOR_A_SCHOOL_ADVANCE') REQUEST_DESCRIPTION,
                        'aud_code' AUDIT_CODE,
                        '' STATUS,
                        'HR' OWNER_DEPARTMENT,
                        '' REQUIRED_ATTACHMENT,
                        'Yes' IS_ACTIVE,
                        '#WORKSPACE_FILES#school (1).jfif' IMG_URL,
                        APEX_PAGE.GET_URL(p_application => 105, p_page => 48) prev_req_url
                   FROM dual
                  UNION ALL
                 SELECT NULL,
                        APEX_LANG.MESSAGE('P4000_TRAVEL_ALLOWANCE_TITLE') REQUEST_TYPE_NAME,
                        APEX_LANG.MESSAGE('P4000_TRAVEL_ALLOWANCE_DESCRIPTION') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '#WORKSPACE_FILES#mobile-app_13972406.png' IMG_URL,
                       APEX_PAGE.GET_URL(p_application => 105, p_page => 68) prev_req_url
                  FROM dual;
                  
                ```
        }
        layout {
            sequence: 40
            parentRegion: @العلاقات-العامة
            slot: regionBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
