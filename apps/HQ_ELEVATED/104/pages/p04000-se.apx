              padding: 0.6rem 0.9rem;
              border-top: 1px solid rgba(226, 232, 240, 0.85);
              background: linear-gradient(180deg, rgba(248, 250, 252, 0.6) 0%, rgba(241, 245, 249, 0.85) 100%);
              box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.85);
            }
            
            /* Previous orders action buttons matching t-Region-header */
            .service-card-grid .t-Card-actions .t-Button,
            .service-card-grid .a-CardView-actions .t-Button,
            .service-card-grid .a-CardView-actions .a-CardView-button,
            .service-department .t-Card-actions .t-Button,
            .service-department .a-CardView-actions .t-Button,
            .service-department .a-CardView-actions .a-CardView-button,
            .service-department .t-Card .t-Button--hot,
            .service-card-grid .t-Card .t-Button--hot,
            .service-card-grid .t-Card .u-pullLeft.t-Button,
            .service-department .t-Card .u-pullLeft.t-Button,
            .a-CardView-button.u-pullLeft,
            a.a-CardView-button--hot.u-pullLeft,
            .service-card-btn-prev {
              display: inline-flex !important;
              align-items: center;
              justify-content: center;
              gap: 0.45rem;
              padding: 0.38rem 0.95rem !important;
              min-height: 2.15rem;
              border-radius: 0.6rem !important;
              background: linear-gradient(135deg, #3f5a73 0%, #115971 100%) !important;
              color: #ffffff !important;
              font-size: 0.86rem !important;
              font-weight: 600 !important;
              line-height: 1.3 !important;
              border: 1px solid rgba(255, 255, 255, 0.22) !important;
              box-shadow: 0 2px 6px rgba(15, 118, 110, 0.28),
                          inset 0 1px 0 rgba(255, 255, 255, 0.22) !important;
              text-decoration: none !important;
              cursor: pointer;
              transition: all 180ms cubic-bezier(0.4, 0, 0.2, 1);
            }
            
            .service-card-grid .t-Card-actions .t-Button .t-Icon,
            .service-card-grid .a-CardView-actions .t-Button .t-Icon,
            .service-card-grid .a-CardView-actions .a-CardView-button .t-Icon,
            .service-card-grid .a-CardView-actions .a-CardView-button .a-Icon,
            .service-department .t-Card-actions .t-Button .t-Icon,
            .service-department .a-CardView-actions .t-Button .t-Icon,
            .service-department .a-CardView-actions .a-CardView-button .t-Icon,
            .service-department .a-CardView-actions .a-CardView-button .a-Icon,
            .service-department .t-Card .t-Button--hot .t-Icon,
            .service-card-grid .t-Card .t-Button--hot .t-Icon,
            .service-card-grid .t-Card .u-pullLeft.t-Button .t-Icon,
            .service-department .t-Card .u-pullLeft.t-Button .t-Icon,
            .service-card-btn-prev .t-Icon,
            .service-card-btn-prev .a-Icon,
            .service-card-btn-prev [class*="fa-"] {
              color: #ffffff !important;
              font-size: 0.92rem !important;
              opacity: 0.95;
              transition: transform 200ms ease;
            }
            
            .service-card-btn-prev .t-Button-label,
            .service-card-btn-prev .a-CardView-button-label {
              color: #ffffff !important;
            }
            
            .service-card-grid .t-Card-actions .t-Button:hover,
            .service-card-grid .a-CardView-actions .t-Button:hover,
            .service-card-grid .a-CardView-actions .a-CardView-button:hover,
            .service-department .t-Card-actions .t-Button:hover,
            .service-department .a-CardView-actions .t-Button:hover,
            .service-department .a-CardView-actions .a-CardView-button:hover,
            .service-department .t-Card .t-Button--hot:hover,
            .service-card-grid .t-Card .t-Button--hot:hover,
            .service-card-grid .t-Card .u-pullLeft.t-Button:hover,
            .service-department .t-Card .u-pullLeft.t-Button:hover,
            .service-card-btn-prev:hover {
              background: linear-gradient(135deg, #24a3a3 0%, #5499ae 100%) !important;
              color: #ffffff !important;
              border-color: rgba(255, 255, 255, 0.38) !important;
              transform: translateY(-1px);
              box-shadow: 0 4px 14px rgba(61, 68, 67, 0.38),
                          inset 0 1px 0 rgba(255, 255, 255, 0.32) !important;
            }
            
            .service-card-grid .t-Card-actions .t-Button:hover .t-Icon,
            .service-card-grid .a-CardView-actions .t-Button:hover .t-Icon,
            .service-card-grid .a-CardView-actions .a-CardView-button:hover .t-Icon,
            .service-card-grid .a-CardView-actions .a-CardView-button:hover .a-Icon,
            .service-department .t-Card-actions .t-Button:hover .t-Icon,
            .service-department .a-CardView-actions .t-Button:hover .t-Icon,
            .service-department .a-CardView-actions .a-CardView-button:hover .t-Icon,
            .service-department .a-CardView-actions .a-CardView-button:hover .a-Icon,
            .service-department .t-Card .t-Button--hot:hover .t-Icon,
            .service-card-grid .t-Card .t-Button--hot:hover .t-Icon,
            .service-card-grid .t-Card .u-pullLeft.t-Button:hover .t-Icon,
            .service-department .t-Card .u-pullLeft.t-Button:hover .t-Icon,
            .service-card-btn-prev:hover .t-Icon,
            .service-card-btn-prev:hover .a-Icon,
            .service-card-btn-prev:hover [class*="fa-"] {
              transform: rotate(-20deg);
            }
            
            .service-card-grid .t-Card-actions .t-Button:active,
            .service-card-grid .a-CardView-actions .t-Button:active,
            .service-card-grid .a-CardView-actions .a-CardView-button:active,
            .service-department .t-Card-actions .t-Button:active,
            .service-department .a-CardView-actions .t-Button:active,
            .service-department .a-CardView-actions .a-CardView-button:active,
            .service-department .t-Card .t-Button--hot:active,
            .service-card-grid .t-Card .t-Button--hot:active,
            .service-card-grid .t-Card .u-pullLeft.t-Button:active,
            .service-department .t-Card .u-pullLeft.t-Button:active,
            .service-card-btn-prev:active {
              transform: translateY(0);
              box-shadow: 0 1px 3px rgba(136, 141, 139, 0.341),
                          inset 0 1px 2px rgba(0, 0, 0, 0.2) !important;
            }
            
            .service-card-grid .t-Card-actions .t-Button:focus-visible,
            .service-department .t-Card-actions .t-Button:focus-visible,
            .service-card-btn-prev:focus-visible {
              outline: 2px solid #626b74 !important;
              outline-offset: 2px;
            }
            
            @media (max-width: 640px) {
              .service-department > .t-Region-body {
                padding: 0.75rem;
              }
            
              .service-card-grid .t-Cards-item,
              .service-card-grid .a-CardView-item,
              .service-department .t-Cards-item,
              .service-department .a-CardView-item {
                min-height: 13rem;
              }
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region information-systems-department (
        name: إدارة نظم المعلومات
        title: &APP_TEXT$INFORMATION_SYSTEMS_MANAGEMENT.
        type: staticContent
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent15
                t-Region--scrollBody
            ]
            cssClasses: [
                service-department
                service-department--compact
            ]
        }
    )

    region it-service-request (
        name: IT Service Request
        title: &APP_TEXT$IT_SERVICE_REQUEST.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 104 REQUEST_TYPE_ID,
                       APEX_LANG.MESSAGE('IT_SERVICE_REQUEST') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('IT_SERVICE_REQUEST_DESCRIPTION') REQUEST_DESCRIPTION,
                       'IT' AUDIT_CODE,
                       '' STATUS,
                       'IT' OWNER_DEPARTMENT,
                       'No' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '#APP_FILES#it-request-logo.png' IMG_URL,
                       APEX_PAGE.GET_URL(
                           p_application => 104,
                           p_page        => 701,
                           p_triggering_element => '#it-service-request'
                       ) REQUEST_URL,
                       APEX_PAGE.GET_URL(
                           p_application => 104,
                           p_page        => 700
                       ) PREV_REQ_URL
                  FROM DUAL
                ```
        }
        layout {
            sequence: 10
            parentRegion: @information-systems-department
            slot: subRegions
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                t-Form--stretchInputs
                margin-top-sm
                margin-bottom-none
            ]
            cssClasses: service-card-grid
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: REQUEST_TYPE_NAME
            cssClasses: u-textCenter
        }
        body {
            column: REQUEST_DESCRIPTION
        }
        media {
            source: imageUrl
            url: &IMG_URL.
            appearance: square
            cssClasses: imgs
        }
        pagination {
            type: page
            cardsPerPage: 4
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &REQUEST_URL.
            }
        )

        action action-2 (
            label: &APP_TEXT$PREVIOUS_ORDERS.
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: &PREV_REQ_URL.
            }
            appearance {
                displayType: textWithIcon
                icon: fa-history
                hot: true
                cssClasses: [
                    u-pullLeft
                    service-card-btn-prev
                ]
            }
        )

    )

    region medical-department (
        name: &APP_TEXT$P4000_MEDICAL_SERVICES.
        type: staticContent
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent15
                t-Region--scrollBody
            ]
            cssClasses: [
                service-department
                service-department--compact
            ]
        }
    )

    region new (
        name: medical
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    REQUEST_TYPE_ID,
                    APEX_LANG.MESSAGE(
                        CASE REQUEST_TYPE_ID
                            WHEN 201 THEN 'MEDICAL_REFERRAL_REQUEST_FORM'
                            WHEN 202 THEN 'MEDICAL_PRESCRIPTION_REQUEST_FORM'
                            ELSE REQUEST_TYPE_NAME
                        END
                    ) AS REQUEST_TYPE_NAME,
                    APEX_LANG.MESSAGE(
                        CASE REQUEST_TYPE_ID
                            WHEN 201 THEN 'MEDICAL_REFERRAL_REQUEST_BODY'
                            WHEN 202 THEN 'MEDICAL_PRESCRIPTION_REQUEST_BODY'
                            ELSE REQUEST_DESCRIPTION
                        END
                    ) AS REQUEST_DESCRIPTION,
                    AUDIT_CODE,
                    STATUS,
                    OWNER_DEPARTMENT,
                    REQUIRED_ATTACHMENT,
                    IS_ACTIVE,
                    CASE
                      WHEN REQUEST_TYPE_ID = 201 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 106, p_triggering_element => '#new')
                      WHEN REQUEST_TYPE_ID = 202 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 111, p_triggering_element => '#new')
                    END AS request_url,
                    CASE
                      WHEN REQUEST_TYPE_ID IN (201, 202) THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 107)
                    END AS prev_req_url,
                    CASE
                      WHEN REQUEST_TYPE_ID = 201 THEN 'fa-notes-medical'
                      WHEN REQUEST_TYPE_ID = 202 THEN 'fa-file-prescription'
                    END AS card_icon,
                    CASE
                      WHEN REQUEST_TYPE_ID = 201 THEN '#APP_FILES#medical-letter-card.png'
                      WHEN REQUEST_TYPE_ID = 202 THEN '#APP_FILES#prescription-card.png'
                    END AS card_image
                FROM CENTRAL.APR_REQUESTS_LIST
                 WHERE IS_ACTIVE = 'Yes'
                   AND REQUEST_TYPE_ID IN (201, 202)
                 ORDER BY CASE REQUEST_TYPE_ID
                             WHEN 201 THEN 1
                             WHEN 202 THEN 2
                           ELSE 9999
                         END;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @medical-department
            slot: subRegions
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
            cssClasses: service-card-grid
        }
        card {
            primaryKeyColumn1: REQUEST_TYPE_ID
        }
        title {
            column: REQUEST_TYPE_NAME
            cssClasses: u-textCenter
        }
        body {
            column: REQUEST_DESCRIPTION
        }
        media {
            source: imageUrl
            url: &CARD_IMAGE.
            appearance: square
            cssClasses: service-card-icon
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &REQUEST_URL.
            }
        )

        action action-2 (
            label: &APP_TEXT$PREVIOUS_ORDERS.
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: &PREV_REQ_URL.
            }
            appearance {
                displayType: textWithIcon
                icon: fa-history
                hot: true
                cssClasses: [
                    u-pullLeft
                    service-card-btn-prev
                ]
            }
        )

    )

    region page_plug (
        name: employee-services
        title: &APP_TEXT$P4000_EMPLOYEE_SERVICES.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                
                
                
                
                
                
                
                
                
                SELECT REQUEST_TYPE_ID,
                       APEX_LANG.MESSAGE(
                           CASE
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('LEAVE_REQUEST_1', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'LEAVE_REQUEST_1'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('REQUEST_PERMISSION', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'REQUEST_PERMISSION'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('TASK_REQUEST', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'TASK_REQUEST'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('REQUEST_FOR_ADDITIONAL_WORKING_HOURS_OVERTIME_REST_PUBLIC', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'REQUEST_FOR_ADDITIONAL_WORKING_HOURS_OVERTIME_REST_PUBLIC'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE'
                               ELSE REQUEST_TYPE_NAME
                           END
                       ) REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE(
                           CASE
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_LEAVE_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_LEAVE_BODY'
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_PERMISSION_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_PERMISSION_BODY'
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_TASK_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_TASK_BODY'
                               WHEN INSTR(REQUEST_DESCRIPTION, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_OVERTIME_BODY', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_OVERTIME_BODY'
                               WHEN INSTR(REQUEST_TYPE_NAME, APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE', p_lang => 'ar-ae', p_application_id => 104)) = 1 THEN 'P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE_BODY'
                               ELSE REQUEST_DESCRIPTION
                           END
                       ) REQUEST_DESCRIPTION,
                       AUDIT_CODE,
                       STATUS,
                       OWNER_DEPARTMENT,
                       REQUIRED_ATTACHMENT,
                       IS_ACTIVE,
                       IMG_URL IMG_URL,
                       CASE 
                           WHEN REQUEST_TYPE_ID = 59 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 15)
                           WHEN REQUEST_TYPE_ID = 61 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 28)
                           WHEN REQUEST_TYPE_ID = 72 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 29)
                           WHEN REQUEST_TYPE_ID = 76 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 30)
                           WHEN REQUEST_TYPE_ID = 181 THEN APEX_PAGE.GET_URL(p_application => 104, p_page => 79)
                       END prev_req_url
                  FROM CENTRAL.APR_REQUESTS_LIST
                 WHERE REQUEST_TYPE_ID = 0
                 UNION ALL
                SELECT NULL,
                       APEX_LANG.MESSAGE('UPLOAD_RELATIVES_ATTACHMENTS') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('UPLOAD_ATTACHMENTS_ID_CARD_BIRTH_CERTIFICATE_MARRIAGE_CERTIFICATE') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '/apex/hq_elevated/g/attach/1679091c5a880faf6fb5e6087eb1b2dc' IMG_URL,
                       APEX_PAGE.GET_URL(p_application => 115, p_page => 9) prev_req_url
                  FROM dual
                 UNION ALL
                SELECT NULL,
                       APEX_LANG.MESSAGE('CHANGE_PROFILE_PICTURE_AND_RELATIVES_PICTURES') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('EDIT_PROFILE_PICTURE_AND_RELATIVES_PICTURES') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '/apex/hq_elevated/g/attach/eccbc87e4b5ce2fe28308fd9f2a7baf3' IMG_URL,
                       '/apex/r/epromhq/photo-upload?session=&SESSION.' prev_req_url
                  FROM dual
                 UNION ALL
                SELECT NULL,
                       APEX_LANG.MESSAGE('BENEFICIARIES_IN_CASE_OF_DEATH_AND_EMERGENCY_NUMBERS') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_FUNERAL_BENEFICIARIES_BODY') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '/apex/hq_elevated/g/attach/1c383cd30b7c298ab50293adfecb7b18' IMG_URL,
                       APEX_PAGE.GET_URL(p_application => 115, p_page => 2) prev_req_url
                  FROM dual
                  UNION ALL
                SELECT NULL,
                       APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE') REQUEST_TYPE_NAME,
                       APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_CHANGE_PROFILE_BODY') REQUEST_DESCRIPTION,
                       'aud_code' AUDIT_CODE,
                       '' STATUS,
                       'HR' OWNER_DEPARTMENT,
                       '' REQUIRED_ATTACHMENT,
                       'Yes' IS_ACTIVE,
                       '/apex/hq_elevated/g/attach/a87ff679a2f3e71d9181a67b7542122c' IMG_URL,
                       APEX_PAGE.GET_URL(
                         p_application => 104,
                         p_page        => 57,
                         p_items       => 'P57_EMP_ID',
                         p_values      => TO_CHAR(:P4000_EMP_ID)
                       )      FROM dual;
                ```
        }
        layout {
            sequence: 60
            parentRegion: @الموارد-البشرية
            slot: subRegions
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
