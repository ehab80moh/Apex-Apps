    region الطلبات-المتاحه-تقديمها-الكترونيا (
        name: الطلبات المتاحه تقديمها الكترونيا
        title: &APP_TEXT$APPLICATIONS_CAN_BE_SUBMITTED_ELECTRONICALLY.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select REQUEST_TYPE_ID,
                       CASE REQUEST_TYPE_ID
                           WHEN 59 THEN APEX_LANG.MESSAGE('LEAVE_REQUEST_1')
                           WHEN 61 THEN APEX_LANG.MESSAGE('REQUEST_PERMISSION')
                           WHEN 72 THEN APEX_LANG.MESSAGE('TASK_REQUEST')
                           WHEN 76 THEN APEX_LANG.MESSAGE('REQUEST_FOR_ADDITIONAL_WORKING_HOURS_OVERTIME_REST_PUBLIC')
                           ELSE REQUEST_TYPE_NAME
                       END REQUEST_TYPE_NAME,
                       CASE REQUEST_TYPE_ID
                           WHEN 59 THEN APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_LEAVE_BODY')
                           WHEN 61 THEN APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_PERMISSION_BODY')
                           WHEN 72 THEN APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_TASK_BODY')
                           WHEN 76 THEN APEX_LANG.MESSAGE('P4000_EMPLOYEE_SERVICE_OVERTIME_BODY')
                           ELSE REQUEST_DESCRIPTION
                       END REQUEST_DESCRIPTION,
                       AUDIT_CODE,
                       STATUS,
                       OWNER_DEPARTMENT,
                       REQUIRED_ATTACHMENT,
                       IS_ACTIVE,
                IMG_URL IMG_URL
                ,case when REQUEST_TYPE_ID=59
                then APEX_PAGE.GET_URL (p_application=>104, p_page   => 15)
                when REQUEST_TYPE_ID=61
                then APEX_PAGE.GET_URL (p_application=>104, p_page   => 28)
                when REQUEST_TYPE_ID=72
                then APEX_PAGE.GET_URL (p_application=>104, p_page   => 29)
                when REQUEST_TYPE_ID=76
                then APEX_PAGE.GET_URL (p_application=>104, p_page   => 30)
                end  prev_req_url
                  from CENTRAL.APR_REQUESTS_LIST
                where  (REQUEST_TYPE_ID in (72,59,61,76) )
                
                ```
        }
        layout {
            sequence: 50
            parentRegion: @الموارد-البشرية
            slot: subRegions
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                t-Form--stretchInputs
                margin-top-sm
                margin-bottom-none
            ]
            cssClasses: service-card-grid
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: REQUEST_TYPE_NAME
            cssClasses: u-textCenter
        }
        body {
            column: REQUEST_DESCRIPTION
        }
        media {
            source: imageUrl
            url: &IMG_URL.
            appearance: square
            cssClasses: imgs
        }
        pagination {
            type: page
            cardsPerPage: 4
        }

        action action (
            label: &APP_TEXT$PREVIOUS_ORDERS.
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: &PREV_REQ_URL.
            }
            appearance {
                displayType: textWithIcon
                icon: fa-history
                hot: true
                cssClasses: [
                    u-pullLeft
                    service-card-btn-prev
                ]
            }
        )

        action action-2 (
            type: fullCard
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 20
                    items: {
                        P20_REQUEST_TYPE_ID: &REQUEST_TYPE_ID.
                        P20_EMP_ID: &P4000_EMP_ID.
                    }
                }
            }
        )

    )

    region الطلبات-المتاحه-تقديمها-الكترونيا-2 (
        name: الطلبات المتاحه تقديمها الكترونيا
        title: &APP_TEXT$APPLICATIONS_CAN_BE_SUBMITTED_ELECTRONICALLY.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    REQUEST_TYPE_ID,
                    CASE REQUEST_TYPE_ID
                        WHEN 107 THEN APEX_LANG.MESSAGE('HOTEL_RESERVATION_REQUEST')
                        WHEN 35 THEN APEX_LANG.MESSAGE('REQUEST_A_CAR_FOR_WORK')
                        ELSE REQUEST_TYPE_NAME
                    END REQUEST_TYPE_NAME,
                    CASE REQUEST_TYPE_ID
                        WHEN 107 THEN APEX_LANG.MESSAGE('HOTEL_RESERVATION_REQUEST_FOR_ASSIGNMENTS_IS_SUBMITTED_AFTER_REQUESTING_A_MISSION_WORK_OR_TRAINING_MISSION')
                        WHEN 35 THEN APEX_LANG.MESSAGE('REQUESTING_A_MICROBUS_OR_LIMOUSINE_FOR_WORK_OUTSIDE_OR_INSIDE_THE_CITY')
                        ELSE REQUEST_DESCRIPTION
                    END REQUEST_DESCRIPTION,
                    AUDIT_CODE,
                    STATUS,
                    OWNER_DEPARTMENT,
                    REQUIRED_ATTACHMENT,
                    IS_ACTIVE,
                    IMG_URL IMG_URL,
                    CASE 
                        WHEN REQUEST_TYPE_ID = 107 THEN APEX_PAGE.GET_URL(p_application => 105, p_page => 28)
                        WHEN REQUEST_TYPE_ID = 35  THEN APEX_PAGE.GET_URL(p_application => 105, p_page => 20)
                    END prev_req_url
                FROM CENTRAL.APR_REQUESTS_LIST
                WHERE IS_ACTIVE = 'Yes'
                  AND REQUEST_TYPE_ID IN (107, 35)
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @العلاقات-العامة
            slot: regionBody
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                t-Form--stretchInputs
            ]
            cssClasses: service-card-grid
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: REQUEST_TYPE_NAME
            cssClasses: u-textCenter
        }
        body {
            column: REQUEST_DESCRIPTION
        }
        media {
            source: imageUrl
            url: &IMG_URL.
            appearance: square
            cssClasses: imgs
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 20
                    items: {
                        P20_REQUEST_TYPE_ID: &REQUEST_TYPE_ID.
                        P20_EMP_ID: &P4000_EMP_ID.
                    }
                }
            }
        )

        action action-2 (
            label: &APP_TEXT$PREVIOUS_ORDERS.
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: &PREV_REQ_URL.
            }
            appearance {
                displayType: textWithIcon
                icon: fa-history
                hot: true
                cssClasses: [
                    u-pullLeft
                    service-card-btn-prev
                ]
            }
        )

    )

    region الطلبات-المتاحه-تقديمها-الكترونيا-3 (
        name: الطلبات المتاحه تقديمها الكترونيا
        title: &APP_TEXT$APPLICATIONS_CAN_BE_SUBMITTED_ELECTRONICALLY.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    REQUEST_TYPE_ID,
                    CASE REQUEST_TYPE_ID
                        WHEN 107 THEN APEX_LANG.MESSAGE('HOTEL_RESERVATION_REQUEST')
                        WHEN 35 THEN APEX_LANG.MESSAGE('REQUEST_A_CAR_FOR_WORK')
                        WHEN 47 THEN APEX_LANG.MESSAGE('TRANSPORT_ALLOWANCE')
                        WHEN 46 THEN APEX_LANG.MESSAGE('HAJJ_SUPPORT_REQUEST')
                        WHEN 45 THEN APEX_LANG.MESSAGE('UMRAH_SUPPORT_REQUEST')
                        WHEN 44 THEN APEX_LANG.MESSAGE('SOCIAL_LOAN_REQUEST_ALT')
                        WHEN 43 THEN APEX_LANG.MESSAGE('MARRIAGE_LOAN_REQUEST')
                        ELSE REQUEST_TYPE_NAME
                    END REQUEST_TYPE_NAME,
                    CASE REQUEST_TYPE_ID
                        WHEN 107 THEN APEX_LANG.MESSAGE('HOTEL_RESERVATION_REQUEST_FOR_ASSIGNMENTS_IS_SUBMITTED_AFTER_REQUESTING_A_MISSION_WORK_OR_TRAINING_MISSION')
                        WHEN 35 THEN APEX_LANG.MESSAGE('REQUESTING_A_MICROBUS_OR_LIMOUSINE_FOR_WORK_OUTSIDE_OR_INSIDE_THE_CITY')
                        WHEN 47 THEN APEX_LANG.MESSAGE('P4000_TRAVEL_ALLOWANCE_DESCRIPTION')
                        WHEN 46 THEN APEX_LANG.MESSAGE('REQUEST_FOR_FINANCIAL_SUPPORT_FOR_HAJJ')
                        WHEN 45 THEN APEX_LANG.MESSAGE('REQUEST_FOR_FINANCIAL_SUPPORT_FOR_UMRAH')
                        WHEN 44 THEN APEX_LANG.MESSAGE('REQUEST_FOR_OBTAINING_A_SOCIAL_LOAN')
                        WHEN 43 THEN APEX_LANG.MESSAGE('REQUEST_FOR_A_MARRIAGE_LOAN')
                        ELSE REQUEST_DESCRIPTION
                    END REQUEST_DESCRIPTION,
                    AUDIT_CODE,
                    STATUS,
                    OWNER_DEPARTMENT,
                    REQUIRED_ATTACHMENT,
                    IS_ACTIVE,
                    IMG_URL                   AS IMG_URL,
                    CASE 
                      WHEN REQUEST_TYPE_ID = 107 THEN APEX_PAGE.GET_URL(p_application => 105, p_page => 28)
                      WHEN REQUEST_TYPE_ID = 35  THEN APEX_PAGE.GET_URL(p_application => 105, p_page => 20)
                      WHEN REQUEST_TYPE_ID = 47  THEN APEX_PAGE.GET_URL(p_application => 105, p_page => 80)
                      WHEN REQUEST_TYPE_ID IN (46,45,44,43)
                        THEN APEX_PAGE.GET_URL(
                               p_application => 105,
                               p_page        => 88,
                               p_items       => 'P88_REQUEST_TYPE_ID',
                               p_values      => TO_CHAR(REQUEST_TYPE_ID)
                             )
                    END AS prev_req_url
                FROM CENTRAL.APR_REQUESTS_LIST
                WHERE IS_ACTIVE = 'Yes'
                  AND REQUEST_TYPE_ID IN (107,35,47,46,45,44,43)
                ORDER BY CASE REQUEST_TYPE_ID
                           WHEN 107 THEN 1
                           WHEN 35  THEN 2
                           WHEN 47  THEN 3
                           WHEN 43  THEN 4
                           WHEN 46  THEN 5
                           WHEN 45  THEN 6
                           WHEN 44  THEN 7
                           ELSE 9999
                         END;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @العلاقات-العامة
            slot: regionBody
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
                t-Form--stretchInputs
            ]
            cssClasses: service-card-grid
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: REQUEST_TYPE_NAME
            cssClasses: u-textCenter
        }
        body {
            column: REQUEST_DESCRIPTION
        }
        media {
            source: imageUrl
            url: &IMG_URL.
            appearance: square
            cssClasses: imgs
        }

        action action (
            label: &APP_TEXT$PREVIOUS_ORDERS.
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: &PREV_REQ_URL.
            }
            appearance {
                displayType: textWithIcon
                icon: fa-history
                hot: true
                cssClasses: [
                    u-pullLeft
                    service-card-btn-prev
                ]
            }
        )

        action action-2 (
            type: fullCard
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 20
                    items: {
                        P20_REQUEST_TYPE_ID: &REQUEST_TYPE_ID.
                        P20_EMP_ID: &P4000_EMP_ID.
                    }
                }
            }
        )

    )

