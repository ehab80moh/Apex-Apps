              font-size: 2.75rem;
              filter: drop-shadow(0 2px 4px rgba(15, 118, 110, 0.18));
              transition: transform 200ms ease, color 200ms ease;
            }
            
            .service-card-grid .t-Card:hover .t-Card-icon,
            .service-card-grid .a-CardView:hover .a-CardView-icon,
            .service-card-grid .a-CardView-card:hover .a-CardView-icon,
            .service-department .t-Card:hover .t-Card-icon,
            .service-department .a-CardView:hover .a-CardView-icon,
            .service-department .a-CardView-card:hover .a-CardView-icon {
              transform: scale(1.06);
              color: #3c494d;
            }
            
            .service-card-grid .service-card-icon {
              display: block;
              width: 34%;
              max-width: 7rem;
              min-width: 4.5rem;
              margin-inline: auto;
              object-fit: contain;
              filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.09));
              transition: transform 200ms ease;
            }
            
            .service-card-grid .t-Card:hover .service-card-icon,
            .service-card-grid .a-CardView:hover .service-card-icon,
            .service-card-grid .a-CardView-card:hover .service-card-icon {
              transform: scale(1.04);
            }
            
            .service-card-grid .t-Card-title,
            .service-card-grid .a-CardView-title,
            .service-department .t-Card-title,
            .service-department .a-CardView-title {
              font-weight: 700;
              color: #0f172a;
              line-height: 1.55;
              letter-spacing: -0.01em;
            }
            
            .service-card-grid .t-Card-body,
            .service-card-grid .a-CardView-body,
