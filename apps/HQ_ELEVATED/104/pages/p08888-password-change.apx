page 8888 (
    name: تغيير كلمة السر
    alias: PASSWORD-CHANGE
    title: &APP_TEXT$CHANGE_PASSWORD.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
        cssClasses: password-change-page
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function P8888_CON_PASS()
            {
                var btn = document.querySelector('#P8888_CON_PASS_CONTAINER .t-Button--passwordVisibility');
                if (btn) {
                    btn.click();
                } else {
                    var Vpw = document.getElementById('P8888_CON_PASS');
                    if (Vpw) Vpw.type = (Vpw.type === 'password' ? 'text' : 'password');
                }
            }
            
            function P8888_NEW_PASS()
            {
                var btn = document.querySelector('#P8888_NEW_PASS_CONTAINER .t-Button--passwordVisibility');
                if (btn) {
                    btn.click();
                } else {
                    var Vpw = document.getElementById('P8888_NEW_PASS');
                    if (Vpw) Vpw.type = (Vpw.type === 'password' ? 'text' : 'password');
                }
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            apex.jQuery(function($) {
                var $sendBtn = $('.password-change-button--send');
                if (!$sendBtn.length) {
                    $sendBtn = $('#send-otp');
                }
                if (!$sendBtn.length) {
                    $sendBtn = $('button[data-action="send_otp"]');
                }
                if (!$sendBtn.length) return;
            
                var COOLDOWN_SECONDS = 60;
                var STORAGE_KEY = 'P8888_OTP_SENT_TIME';
                var timerId = null;
            
                // Ensure the cooldown banner exists in DOM
                var $banner = $('#p8888-cooldown-banner');
                if (!$banner.length) {
                    var bannerHtml = 
                        '<div class="col col-12" id="p8888-banner-col">' +
                            '<div id="p8888-cooldown-banner" class="otp-cooldown-banner" style="display:none;">' +
                                '<div class="otp-cooldown-content">' +
                                    '<div class="otp-cooldown-icon">' +
                                        '<span class="fa fa-hourglass-half fa-spin"></span>' +
                                    '</div>' +
                                    '<div class="otp-cooldown-info">' +
                                        '<div class="otp-cooldown-title">تم إرسال رمز التحقق إلى هاتفك المحمول</div>' +
                                        '<div class="otp-cooldown-subtitle">يمكنك طلب رمز جديد بعد: <strong id="p8888-cooldown-clock">01:00</strong></div>' +
                                    '</div>' +
                                '</div>' +
                                '<div class="otp-cooldown-progress">' +
                                    '<div id="p8888-cooldown-bar" class="otp-cooldown-progress-bar" style="width: 100%;"></div>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
            
                    var $btnCol = $sendBtn.closest('.col');
                    if ($btnCol.length) {
                        $btnCol.after(bannerHtml);
                    } else {
                        var $otpCol = $('#P8888_OTP_CONTAINER').closest('.col');
                        if ($otpCol.length) {
                            $otpCol.after(bannerHtml);
                        }
                    }
                    $banner = $('#p8888-cooldown-banner');
                }
            
                function formatClock(seconds) {
                    var m = Math.floor(seconds / 60);
                    var s = seconds % 60;
                    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
                }
            
                function getRemainingSeconds() {
                    var lastSent = parseInt(sessionStorage.getItem(STORAGE_KEY), 10);
                    if (!lastSent || isNaN(lastSent)) return 0;
                    var now = Math.floor(Date.now() / 1000);
                    var diff = now - lastSent;
                    return (diff < COOLDOWN_SECONDS) ? (COOLDOWN_SECONDS - diff) : 0;
                }
            
                function renderTimer() {
                    var remaining = getRemainingSeconds();
                    var $clock = $('#p8888-cooldown-clock');
                    var $bar = $('#p8888-cooldown-bar');
            
                    if (remaining > 0) {
                        $banner.show();
                        if ($clock.length) $clock.text(formatClock(remaining));
                        if ($bar.length) $bar.css('width', Math.round((remaining / COOLDOWN_SECONDS) * 100) + '%');
            
                        $sendBtn.prop('disabled', true)
                                .addClass('is-disabled')
                                .css({'pointer-events': 'none', 'opacity': '0.65', 'cursor': 'not-allowed'})
                                .html('<span class="fa fa-clock-o"></span> <span class="t-Button-label">إعادة الإرسال بعد<br>(' + remaining + ' ثانية)</span>');
            
                        if (!timerId) {
                            timerId = setInterval(renderTimer, 1000);
                        }
                    } else {
                        if (timerId) {
                            clearInterval(timerId);
                            timerId = null;
                        }
                        sessionStorage.removeItem(STORAGE_KEY);
            
                        $sendBtn.prop('disabled', false)
                                .removeClass('is-disabled')
                                .css({'pointer-events': '', 'opacity': '', 'cursor': ''});
            
                        var isOtpSent = apex.item('P8888_OTP_SENT') && apex.item('P8888_OTP_SENT').getValue() === 'Y';
                        var resendText = 'إعادة إرسال رمز التحقق<br>إلى الهاتف المسجل';
                        var sendText = 'إرسال رمز التحقق<br>إلى الهاتف المسجل';
                        $sendBtn.html('<span class="fa fa-paper-plane"></span> <span class="t-Button-label">' + (isOtpSent ? resendText : sendText) + '</span>');
            
                        if (isOtpSent) {
                            $banner.show().html(
                                '<div class="otp-cooldown-content">' +
                                    '<div class="otp-cooldown-icon otp-cooldown-icon--ready">' +
                                        '<span class="fa fa-check-circle"></span>' +
                                    '</div>' +
                                    '<div class="otp-cooldown-info">' +
                                        '<div class="otp-cooldown-title" style="color: #166534;">لم يصلك الرمز؟</div>' +
                                        '<div class="otp-cooldown-subtitle" style="color: #15803d;">يمكنك الآن الضغط على "إعادة إرسال رمز التحقق" لطلب رمز جديد.</div>' +
                                    '</div>' +
                                '</div>'
                            );
                        } else {
                            $banner.hide();
                        }
                    }
                }
            
                if (apex.item('P8888_OTP_SENT') && apex.item('P8888_OTP_SENT').getValue() === 'Y') {
                    if (!sessionStorage.getItem(STORAGE_KEY)) {
                        sessionStorage.setItem(STORAGE_KEY, Math.floor(Date.now() / 1000).toString());
                    }
                }
            
                renderTimer();
            
                $sendBtn.on('click', function(e) {
                    if ($sendBtn.prop('disabled') || getRemainingSeconds() > 0) {
                        e.preventDefault();
                        return false;
                    }
            
                    $sendBtn.prop('disabled', true).css({'opacity': '0.7', 'pointer-events': 'none'});
                    $sendBtn.html('<span class="fa fa-spinner fa-spin"></span> <span class="t-Button-label">جاري الإرسال...</span>');
            
                    sessionStorage.setItem(STORAGE_KEY, Math.floor(Date.now() / 1000).toString());
            
                    $banner.show();
            
                    apex.page.submit({
                        request: 'send_otp',
                        showWait: true
                    });
            
                    e.preventDefault();
                    return false;
                });
            });
            ```
    }
    css {
        inline:
            ```css
            .password-change-page {
                --password-primary: #0f766e;
                --password-primary-dark: #115e59;
                --password-ink: #0f172a;
                --password-muted: #64748b;
                --password-border: #dbe5ef;
                background:
                    radial-gradient(circle at 10% 0%, rgba(14, 165, 233, .10), transparent 34rem),
                    linear-gradient(180deg, #f8fbff 0%, #f1f5f9 100%);
            }
            
            .password-change-page .t-Body-main,
            .password-change-page .t-Body-contentInner {
                background: transparent;
            }
            
            .password-change-page .t-Body-contentInner {
                max-width: 960px;
                margin-inline: auto;
                padding-block: clamp(1.25rem, 4vw, 3rem);
            }
            
            .password-change-page .t-Alert,
            .password-change-page .password-change-intro,
            .password-change-page .password-change-card {
                max-width: 680px;
                margin-inline: auto;
            }
            
            .password-change-page .t-Alert {
                border: 1px solid #bae6fd;
                border-radius: 16px;
                box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
            }
            
            .password-change-page .password-change-intro {
                margin-block: .75rem 1rem;
                border: 1px solid #cfe8f5;
                border-radius: 18px;
                background: rgba(255, 255, 255, .80);
                box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
                backdrop-filter: blur(8px);
            }
            
            .password-change-page .password-change-intro .t-Region-header {
                display: none;
            }
            
            .password-change-page .password-change-intro .t-Region-body {
                padding: 1.15rem 1.35rem;
                text-align: center;
            }
            
            .password-change-page .password-change-kicker {
                color: var(--password-primary);
                font-size: .78rem;
                font-weight: 800;
                letter-spacing: .08em;
                text-transform: uppercase;
            }
            
            .password-change-page .password-change-description {
                margin: .45rem 0 .8rem;
                color: var(--password-muted);
                font-size: .98rem;
                line-height: 1.75;
            }
            
            .password-change-page .password-change-password-note {
                margin: .35rem 0 .9rem;
                color: #475569;
                font-size: .82rem;
                line-height: 1.6;
            }
            
            .password-change-page .password-change-steps {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: .5rem;
            }
            
            .password-change-page .password-change-steps span {
                padding: .35rem .7rem;
                border: 1px solid #ccfbf1;
                border-radius: 999px;
                background: #f0fdfa;
                color: #115e59;
                font-size: .78rem;
                font-weight: 700;
            }
            
            .password-change-page .password-change-card {
                overflow: hidden;
                border: 1px solid var(--password-border);
                border-radius: 24px;
                background: #fff;
                box-shadow: 0 18px 45px rgba(15, 23, 42, .10);
            }
            
            .password-change-page .password-change-card .t-Region-header {
                border-bottom: 1px solid #e8eef5;
                background: linear-gradient(135deg, #ffffff, #f8fafc);
            }
            
            .password-change-page .password-change-card .t-Region-title {
                color: var(--password-ink);
                font-size: 1.15rem;
                font-weight: 800;
            }
            
            .password-change-page .password-change-card .t-Region-body {
                padding: clamp(1rem, 4vw, 2rem);
            }
            
            .password-change-page .password-change-card .t-Form-label {
                color: #334155;
                font-weight: 700;
            }
            
            .password-change-page .password-change-card .t-Form-fieldContainer {
                margin-block-end: 1rem;
            }
            
            .password-change-page .password-change-card .t-Form-itemWrapper {
                position: relative;
                display: flex;
                align-items: center;
            }
            
            .password-change-page .password-change-card input[type="password"],
            .password-change-page .password-change-card input[type="text"] {
                width: 100%;
                min-height: 48px;
                border: 1px solid #cbd5e1;
                border-radius: 12px;
                background: #fff;
                padding-inline-end: 2.75rem !important;
                transition: border-color .18s ease, box-shadow .18s ease;
            }
            
            .password-change-page .password-change-card .apex-item-group--password {
                position: relative !important;
                display: flex !important;
                width: 100% !important;
            }
            
            .password-change-page .password-change-card .apex-item-group--password input.password {
                width: 100% !important;
                border-radius: 12px !important;
                padding-inline-end: 2.75rem !important;
            }
            
            .password-change-page .password-change-card .apex-item-group--password .t-Button--passwordVisibility {
                position: absolute !important;
                inset-inline-end: 0.5rem !important;
                top: 50% !important;
                transform: translateY(-50%) !important;
                height: 36px !important;
                min-height: 36px !important;
                width: 36px !important;
                background: transparent !important;
                border: none !important;
                color: #64748b !important;
                box-shadow: none !important;
                border-radius: 8px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                z-index: 2 !important;
                transition: color .18s ease, background-color .18s ease !important;
            }
            
            .password-change-page .password-change-card .apex-item-group--password .t-Button--passwordVisibility:hover,
            .password-change-page .password-change-card .apex-item-group--password .t-Button--passwordVisibility:focus-visible {
                color: #0f766e !important;
                background-color: rgba(15, 118, 110, .08) !important;
                outline: none !important;
            }
            
            /* Hide browser native password reveal and clear buttons to prevent double-icon overlap */
            .password-change-page input::-ms-reveal,
            .password-change-page input::-ms-clear {
                display: none !important;
                width: 0 !important;
                height: 0 !important;
            }
            
            .password-change-page .password-change-card input:focus {
                border-color: #14b8a6;
                box-shadow: 0 0 0 3px rgba(20, 184, 166, .16);
            }
            
            .password-change-page .password-change-card #P8888_OTP_CONTAINER,
            .password-change-page .password-change-card .password-change-otp {
                margin-block-end: 0;
            }
            
            .password-change-page .password-change-card #P8888_OTP_CONTAINER input,
            .password-change-page .password-change-card .password-change-otp input {
                border-color: #5eead4;
                letter-spacing: .25em;
                text-align: center;
                font-weight: 800;
                font-size: 1.25rem;
                height: 48px;
            }
            
            .password-change-page .password-change-card .col:has(.password-change-button--send) {
                display: flex;
                align-items: flex-end;
            }
            
            .password-change-button--send,
            button[data-action="send_otp"],
            #send-otp {
                width: 100% !important;
                height: auto !important;
                min-height: 48px !important;
                margin-block-end: 0 !important;
                padding: .4rem .6rem !important;
                font-size: .84rem !important;
                font-weight: 800 !important;
                line-height: 1.25 !important;
                white-space: normal !important;
                text-align: center !important;
                border-radius: 12px !important;
                border-color: var(--password-primary) !important;
                background-color: var(--password-primary) !important;
                background: var(--password-primary) !important;
                color: #fff !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: .4rem !important;
                cursor: pointer;
            }
            
            .password-change-button--send .t-Button-label,
            button[data-action="send_otp"] .t-Button-label,
            #send-otp .t-Button-label {
                white-space: normal !important;
                line-height: 1.25 !important;
                text-align: center !important;
                display: inline-block !important;
            }
            
            .password-change-button--send:hover,
            button[data-action="send_otp"]:hover,
            #send-otp:hover {
                border-color: #115e59 !important;
                background-color: #115e59 !important;
                background: #115e59 !important;
                color: #fff !important;
                transform: translateY(-1px);
                box-shadow: 0 7px 16px rgba(15, 23, 42, .12);
            }
            
            .otp-cooldown-banner {
                margin-block: .75rem 1.25rem;
                padding: .85rem 1.15rem;
                border: 1px solid #99f6e4;
                border-radius: 16px;
                background: linear-gradient(135deg, #f0fdfa 0%, #e6fffa 100%);
                box-shadow: 0 4px 14px rgba(15, 118, 110, .08);
            }
            
            .otp-cooldown-content {
                display: flex;
                align-items: center;
                gap: .85rem;
            }
            
            .otp-cooldown-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: #ccfbf1;
                color: #0f766e;
                font-size: 1.2rem;
                flex-shrink: 0;
            }
            
            .otp-cooldown-icon--ready {
                background: #dcfce7;
                color: #16a34a;
            }
            
            .otp-cooldown-info {
                flex-grow: 1;
            }
            
            .otp-cooldown-title {
                color: #115e59;
                font-size: .9rem;
                font-weight: 800;
            }
            
            .otp-cooldown-subtitle {
                color: #047857;
                font-size: .84rem;
                margin-top: .2rem;
                display: flex;
                align-items: center;
                gap: .4rem;
                flex-wrap: wrap;
            }
            
            .otp-cooldown-subtitle strong {
                font-family: monospace;
                font-size: 1.1rem;
                font-weight: 900;
                color: #065f46;
                background: #d1fae5;
                padding: .15rem .55rem;
                border-radius: 8px;
                display: inline-block;
                min-width: 3.5rem;
                text-align: center;
                border: 1px solid #a7f3d0;
            }
            
            .otp-cooldown-progress {
                height: 5px;
                background: #ccfbf1;
                border-radius: 99px;
                margin-top: .75rem;
                overflow: hidden;
            }
            
            .otp-cooldown-progress-bar {
                height: 100%;
                background: linear-gradient(90deg, #14b8a6, #0f766e);
                border-radius: 99px;
                transition: width 1s linear;
            }
            
            .password-change-button--save,
            #save {
                width: 100% !important;
                min-height: 48px !important;
                height: 48px !important;
                border-radius: 12px !important;
                font-weight: 800 !important;
                border-color: #15803d !important;
                background-color: #15803d !important;
                background: #15803d !important;
                color: #fff !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: .5rem !important;
            }
            
            .password-change-button--save:hover,
            #save:hover {
                border-color: #166534 !important;
                background-color: #166534 !important;
                background: #166534 !important;
                color: #fff !important;
                transform: translateY(-1px);
                box-shadow: 0 7px 16px rgba(15, 23, 42, .12);
            }
            
            .password-change-button--cancel,
            #cancel {
                width: 100% !important;
                min-height: 48px !important;
                height: 48px !important;
                border-radius: 12px !important;
                font-weight: 800 !important;
                border-color: #fecaca !important;
                background-color: #fff !important;
                background: #fff !important;
                color: #b91c1c !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: .5rem !important;
            }
            
            .password-change-button--cancel:hover,
            #cancel:hover {
                border-color: #fca5a5 !important;
                background-color: #fef2f2 !important;
                background: #fef2f2 !important;
                color: #991b1b !important;
                transform: translateY(-1px);
                box-shadow: 0 7px 16px rgba(15, 23, 42, .12);
            }
            
            .password-change-page .password-change-card .col:has(> .password-change-button--save):last-child,
            .password-change-page .password-change-card .col:has(> #save):last-child {
                grid-column: span 12;
                flex: 0 0 100%;
                max-width: 100%;
            }
            
            .password-change-page .password-change-back {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                color: var(--password-primary-dark);
                font-weight: 700;
            }
            
            .password-change-page .password-change-back .t-Icon {
                transition: transform .18s ease;
            }
            
            [dir="rtl"] .password-change-page .password-change-back .t-Icon {
                transform: scaleX(-1);
            }
            
            .password-change-page .password-change-card .pw-item-icon,
            .password-change-page .password-change-card .pw-toggle-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                padding: 0;
                margin: 0;
                border: none;
                background: transparent;
                border-radius: 8px;
                cursor: pointer;
                color: #64748b;
                font-size: 1.1rem;
                line-height: 1;
                float: none;
                position: static;
                transition: color .18s ease, background-color .18s ease;
            }
            
            .password-change-page .password-change-card .pw-item-icon:hover,
            .password-change-page .password-change-card .pw-toggle-btn:hover,
            .password-change-page .password-change-card .pw-toggle-btn:focus-visible {
                color: var(--password-primary, #0f766e);
                background-color: rgba(15, 118, 110, .08);
                outline: none;
            }
            
            .password-change-page .password-change-card .t-Button:focus-visible,
            .password-change-page .password-change-card input:focus-visible {
                outline: 3px solid rgba(14, 165, 233, .28);
                outline-offset: 2px;
            }
            
            [dir="rtl"] .password-change-page .password-change-card {
                text-align: right;
            }
            
            [dir="ltr"] .password-change-page .password-change-card {
                text-align: left;
            }
            
            @media (max-width: 640px) {
                .password-change-page .t-Body-contentInner {
                    padding-inline: .75rem;
                }
            
                .password-change-page .password-change-card {
                    border-radius: 18px;
                }
            
                .password-change-page .password-change-card .t-Region-body {
                    padding: 1rem;
                }
            
                .password-change-button--send,
                .password-change-button--save,
                .password-change-button--cancel {
                    width: 100% !important;
                }
            }
            
            @media (prefers-reduced-motion: reduce) {
                .password-change-page .password-change-card .t-Button,
                .password-change-page .password-change-card input {
                    transition: none;
                }
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region alert (
        name: alert
        title: &APP_TEXT$ALERT.
        type: staticContent
        source {
            htmlCode: "&{H1_H1}!RAW."
        }
        layout {
            sequence: 30
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P8888_PASS_CHANGED
            value: N
        }
    )

    region alert-2 (
        name: alert
        title: &APP_TEXT$CHANGE_PASSWORD.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$PAGE8888_INTRO!RAW.
        }
        layout {
            sequence: 40
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
            ]
