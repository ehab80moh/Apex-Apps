    validation confirm-pass (
        name: CONFIRM_PASS
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: :P8888_NEW_PASS = :P8888_CON_PASS
        }
        error {
            errorMessage: &APP_TEXT$CONFIRM_PASSWORD_MUST_BE_THE_SAME.
            associatedItem: @P8888_CON_PASS
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation not-same-as-old (
        name: not_same_as_old
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                begin
                return not central.auth_emp(:APP_USER,:P8888_NEW_PASS);
                    EXCEPTION
                      WHEN OTHERS THEN
                            RETURN FALSE;
                end;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE_1.
            associatedItem: @P8888_NEW_PASS
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation otp-format (
        name: OTP_FORMAT
        execution {
            sequence: 70
        }
        validation {
            type: itemMatchesRegexp
            item: P8888_OTP
            regexp: "^\\d{4}$"
        }
        error {
            errorMessage: &APP_TEXT$THE_CODE_IS_WRONG.
            associatedItem: @P8888_OTP
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation otp-required (
        name: OTP_REQUIRED
        execution {
            sequence: 60
        }
        validation {
            plsqlExpression: :P8888_OTP is not null
        }
        error {
            errorMessage: &APP_TEXT$PLEASE_ADD_THE_CODE.
            associatedItem: @P8888_OTP
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation pass-conditions (
        name: PASS_CONDITIONS
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                begin
                if central.CHECK_PWD(:P8888_NEW_PASS)=1 then
                    return true;
                else 
                    return false;
                end if;
                end;
                ```
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE_2.
            associatedItem: @P8888_NEW_PASS
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation pass-length (
        name: pass_length
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: length(:P8888_NEW_PASS) >= 8 AND length(:P8888_NEW_PASS) <= 20
        }
        error {
            errorMessage: &APP_TEXT$PASSWORD_LENGTH_MUST_BE_BETWEEN_8_AND_20_CHARACTERS.
            associatedItem: @P8888_NEW_PASS
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process send-otp-code (
        name: send OTP code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_mobile varchar2(99);
                    l_otp    varchar2(20);
                    l_sent   number;
                    l_message varchar2(4000);
                    l_last_time date;
                begin
                    -- 1) Double submit & 60-second cooldown protection
                    if :P8888_LAST_OTP_TIME is not null then
                        begin
                            l_last_time := to_date(:P8888_LAST_OTP_TIME, 'YYYYMMDDHH24MISS');
                            if (sysdate - l_last_time) * 86400 < 60 then
                                :P8888_OTP_SENT := 'Y';
                                apex_error.add_error(
                                    p_message => 'يرجى الانتظار دقيقة واحدة قبل إعادة طلب رمز التحقق.',
                                    p_display_location => apex_error.c_inline_in_notification
                                );
                                return;
                            end if;
                        exception
                            when others then null;
                        end;
                    end if;
                
                    l_mobile := central.sms_pkg.get_emp_mobile(
                        p_emp => :APP_USER,
                        p_confirmed => 1
                    );
                
                    if l_mobile is null then
                        :P8888_OTP_SENT := 'N';
                        apex_error.add_error(
                            p_message => apex_lang.message('PAGE8888_MOBILE_NOT_CONFIRMED'),
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        return;
                    end if;
                
                    if central.sms_pkg.throttle_otp(:APP_USER) <> 1 then
                        :P8888_OTP_SENT := 'N';
                        apex_error.add_error(
                            p_message => apex_lang.message('PAGE8888_OTP_LIMIT_REACHED'),
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        return;
                    end if;
                
                    l_otp := central.sms_pkg.otp(p_emp => :APP_USER);
                    if l_otp is null then
                        :P8888_OTP_SENT := 'N';
                        apex_error.add_error(
                            p_message => apex_lang.message('PAGE8888_OTP_GENERATION_FAILED'),
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        return;
                    end if;
                
                    l_message := apex_lang.message('PAGE8888_OTP_SMS', l_otp);
                    l_sent := central.sms_pkg.send_single(
                        msg => l_message,
                        mobile => l_mobile
                    );
                
                    if nvl(l_sent, 0) <> 1 then
                        :P8888_OTP_SENT := 'N';
                        apex_error.add_error(
                            p_message => apex_lang.message('PAGE8888_OTP_SEND_FAILED'),
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        return;
                    end if;
                
                    :P8888_OTP_SENT := 'Y';
                    :P8888_LAST_OTP_TIME := to_char(sysdate, 'YYYYMMDDHH24MISS');
                exception
                    when others then
                        :P8888_OTP_SENT := 'N';
                        apex_error.add_error(
                            p_message => apex_lang.message('PAGE8888_OTP_SEND_FAILED'),
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &APP_TEXT$PLEASE_RECEIVE_THE_CODE_AND_ADD_IT_TO_COMPLETE_THE_PROCESS_SUCCESSFULLY.
        }
        advanced {
            executionMappingIdentifier: 23626502914879842
        }
        serverSideCondition {
            whenButtonPressed: @send-otp
        }
    )

    process verify-otp-and-update (
        name: verify OTP and update password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if central.sms_pkg.check_otp(:APP_USER, :P8888_OTP) <> 1 then
                        apex_error.add_error(
                            p_message => apex_lang.message('PAGE8888_OTP_INVALID_OR_EXPIRED'),
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        return;
                    end if;
                
                    central.update_emp_password(
                        p_emp_id => :APP_USER,
                        p_new_pass => :P8888_NEW_PASS
                    );
                
                    :P8888_PASS_CHANGED := 'Y';
                    apex_authentication.logout(:SESSION, :APP_ID);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &APP_TEXT$SUCCESSFULLY_UPDATED_PASSWORD.
        }
        error {
            errorMessage: &APP_TEXT$SOMETHING_WENT_WRONG.
        }
        advanced {
            executionMappingIdentifier: 23626611534879842
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
