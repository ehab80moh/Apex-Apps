    validation email-must-match (
        name: email_must_match
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                
                exists ( 
                    select PERSONAL_EMAIL,COMP_EMAIL
                           from central.EMP_CONTACT
                          where EMP_ID = :P9990_USERNAME
                          and (
                           lower(PERSONAL_EMAIL) = lower(:P9990_EMAIL) 
                           or
                           lower(COMP_EMAIL) = lower(:P9990_EMAIL) 
                          )
                             )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_EMAIL_MUST_BE_THE_SAME_AS_THE_ONE_REGISTERED_WITH_US.
            associatedItem: @P9990_EMAIL
        }
        serverSideCondition {
            type: item=value
            item: P9990_CHANGE
            value: M
        }
    )

    validation phone-must-match (
        name: Phone_must_match
        execution {
            sequence: 30
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select MOBILE
                           from central.EMP_CONTACT
                          where EMP_ID = :P9990_USERNAME
                          and
                           lower(MOBILE) = lower(:P9990_PHONE) 
                             )
                ```
        }
        error {
            errorMessage: &APP_TEXT$YOU_MUST_ENTER_A_PHONE_NUMBER_THAT_IS_ALREADY_REGISTERED.
            associatedItem: @P9990_PHONE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation phone-number (
        name: Phone Number
        execution {
            sequence: 20
        }
        validation {
            type: itemMatchesRegexp
            item: P9990_PHONE
            regexp: "^01\\d{9}$"
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE.
            associatedItem: @P9990_PHONE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation site-must-be-opened (
        name: Site Must be opened
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: central.xxapex_authorization_dump.check_privilage(p_user_id => :P9990_USERNAME, p_app_id => 104, p_page_id => 1)=1
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE_3!RAW.
        }
    )

    process clear-session (
        name: clear session
        type: clearSessionState
        clear {
            type: session
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 26993917185709482
        }
    )

    process create-account-if-none (
        name: create account if none
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                central.CREATE_USER(
                    P_EMP_ID => :P9990_USERNAME
                  );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11034867975108612
        }
    )

    process send-email-with-new-password (
        name: send email with new password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                v_code varchar2(20);
                v_emp_name varchar2(99);
                begin
                
                  v_code := central.SET_EMP_REST_CODE(
                    P_EMP_ID => :P9990_USERNAME
                  );
                
                v_emp_name := CENTRAL.GET_EMP_NAME ( :P9990_USERNAME);
                
                
                    apex_mail.send (
                        p_from               => 'apex@eprom.com.eg',
                        p_to                 => :P9990_EMAIL,
                        p_template_static_id => 'PASSWORD_RESET',
                        p_placeholders       => '{' ||
                        '    "EMP_NAME":' || apex_json.stringify( v_emp_name ) ||
                        '   ,"EMP_ID":'   || apex_json.stringify( :P9990_USERNAME ) ||
                        '   ,"NEW_PASS":' || apex_json.stringify( v_code ) ||
                        '}' );
                
                APEX_MAIL.PUSH_QUEUE;
                
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: "&{P9990EMAIL P9990_EMAIL=&P9990_EMAIL.}."
        }
        error {
            errorMessage: &APP_TEXT$SOMETHING_WENT_WRONG.
        }
        advanced {
            executionMappingIdentifier: 26993586914709481
        }
        serverSideCondition {
            type: item=value
            item: P9990_CHANGE
            value: M
        }
    )

    process send-sms-with-new-password (
        name: SEND SMS WITH NEW PASSWORD
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                
                  v_sent NUMBER;
                
                BEGIN
                 
                  v_sent :=    central.SMS_PKG.SEND_RESET_CODE(
                    P_USER => :P9990_USERNAME
                  );
                  if v_sent =1 then 
                  null;
                  else
                  apex_error.add_error (
                      p_message          => 'يوجد خطأ ما في ارسال الرسالة',
                      p_display_location => apex_error.c_inline_in_notification
                    );
                  end if;
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: "&{P9990PHONE P9990_PHONE=&P9990_PHONE.}."
        }
        error {
            errorMessage: &APP_TEXT$SOMETHING_WENT_WRONG.
        }
        advanced {
            executionMappingIdentifier: 12450127712436023
        }
    )

    branch (
        name: go to reset password
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9992
            }
        }
    )

    branch (
        name: self redirect
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            target: {
                page: 9990
            }
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                l_retval boolean := false;
                begin
                
                 if apex_util.get_session_lang is null then
                     :P9998_LANG := NVL(:P9990_LANG, 'ar-ae');
                APEX_UTIL.SET_SESSION_LANG( P_LANG => nvl(:P9990_LANG,'ar-ae') );
                      l_retval := true;
                  end if;
                
                  return l_retval;
                end;
                ```
        }
    )

)
