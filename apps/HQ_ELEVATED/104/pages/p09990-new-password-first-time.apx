page 9990 (
    name: تعيين كلمة السر لأول مرة
    alias: NEW-PASSWORD-FIRST-TIME
    title: &APP_TEXT$SET_THE_PASSWORD_FOR_THE_FIRST_TIME.
    appearance {
        pageTemplate: @login
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Force English-only input for P9990_USERNAME (No Arabic numbers)
            apex.jQuery("#P9990_USERNAME").on("input", function() {
                var item = apex.item("P9990_USERNAME");
                var value = item.getValue();
            
                // Remove Arabic numbers (٠-٩) and non-English characters
                var newValue = value.replace(/[٠-٩]/g, function(d) {
                    return "٠١٢٣٤٥٦٧٨٩".indexOf(d);
                });
            newValue = newValue.replace(/\D/g, "");
                item.setValue(newValue);
            });
            
            // Force English numbers only for P9990_PHONE
            apex.jQuery("#P9990_PHONE").on("input", function() {
                var item = apex.item("P9990_PHONE");
                var value = item.getValue();
            
                // Convert Arabic numbers to English and remove any non-numeric characters
                var newValue = value.replace(/[٠-٩]/g, function(d) {
                    return "٠١٢٣٤٥٦٧٨٩".indexOf(d);
                }).replace(/\D/g, ""); // Remove non-numeric characters
            
                item.setValue(newValue);
            });
            
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

