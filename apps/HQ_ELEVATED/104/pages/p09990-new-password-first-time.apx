    dynamicAction changed (
        name: changed
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P9990_EMAIL_OK
                P9990_PHONE_OK
            ]
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @get-email-or-phone
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P9990_EMAIL
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction get-email-or-phone (
        name: Get email or phone
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @get-email-or-phone
        }
        clientSideCondition {
            type: item=value
            item: P9990_CHANGE
            value: M
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      vc VARCHAR2(99);
                    BEGIN
                      SELECT SUBSTR(MOBILE, -2) || '******' || SUBSTR(MOBILE, 1, 3)
                      INTO vc
                      FROM central.EMP_CONTACT
                      WHERE EMP_ID = :P9990_USERNAME;
                    
                      apex_util.set_session_state('P9990_RETRIEVE_PHONE', vc);
                      apex_util.set_session_state('P9990_PHONE_OK', 1);
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        apex_util.set_session_state('P9990_RETRIEVE_PHONE', 'No PHONE Found !!');
                        apex_util.set_session_state('P9990_PHONE_OK', 0);
                      WHEN OTHERS THEN
                        apex_util.set_session_state('P9990_RETRIEVE_PHONE', 'An error occurred while retrieving the phone');
                        apex_util.set_session_state('P9990_PHONE_OK', 0);
                    END;
                    
                    ```
                itemsToSubmit: P9990_USERNAME
                itemsToReturn: [
                    P9990_RETRIEVE_PHONE
                    P9990_PHONE_OK
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    
                    
                    DECLARE
                      vc VARCHAR2(99);
                      personal_email VARCHAR2(99);
                      comp_email VARCHAR2(99);
                    BEGIN
                      SELECT central.conceal_email(PERSONAL_EMAIL), central.conceal_email(COMP_EMAIL)
                      INTO personal_email, comp_email
                      FROM central.EMP_CONTACT
                      WHERE EMP_ID = :P9990_USERNAME;
                    
                      IF personal_email IS NOT NULL AND comp_email IS NOT NULL THEN
                        vc := personal_email || '   _____   ' || comp_email;
                      ELSIF personal_email IS NOT NULL THEN
                        vc := personal_email;
                      ELSIF comp_email IS NOT NULL THEN
                        vc := comp_email;
                      ELSE
                        RAISE NO_DATA_FOUND;
                      END IF;
                    
                      apex_util.set_session_state('P9990_RETRIEVE_MAIL', vc);
                      apex_util.set_session_state('P9990_EMAIL_OK', 1);
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        apex_util.set_session_state('P9990_RETRIEVE_MAIL', 'No Email Found !!');
                        apex_util.set_session_state('P9990_EMAIL_OK', 0);
                      WHEN OTHERS THEN
                        apex_util.set_session_state('P9990_RETRIEVE_MAIL', 'An error occurred while retrieving the email');
                        apex_util.set_session_state('P9990_EMAIL_OK', 0);
                    END;
                    
                    ```
                itemsToSubmit: P9990_USERNAME
                itemsToReturn: [
                    P9990_RETRIEVE_MAIL
                    P9990_EMAIL_OK
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

