page 9991 (
    name: تعيين كلمة سر جديدة
    alias: RESET-PASSWORD-NEW
    title: &APP_TEXT$SET_A_NEW_PASSWORD.
    appearance {
        pageTemplate: @login
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region info (
        name: info
        title: &APP_TEXT$INFO.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$PLUG_SOURCE_15.
        }
        layout {
            sequence: 10
            parentRegion: @تعيين-كلمة-سر-جديدة
            slot: regionBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
            ]
        }
    )

    region تعيين-كلمة-سر-جديدة (
        name: تعيين كلمة سر جديدة
        title: &APP_TEXT$SET_A_NEW_PASSWORD.
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P9991_EMAIL (
        type: textField
        label {
            label: &APP_TEXT$PLEASE_ENTER_THE_COMPLETE_EMAIL_REGISTERED_WITH_US.
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 60
            region: @تعيين-كلمة-سر-جديدة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 70
        }
    )

    pageItem P9991_EMAIL_OK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @تعيين-كلمة-سر-جديدة
            slot: regionBody
        }
    )

    pageItem P9991_RETRIVED_MAIL (
        type: displayOnly
        label {
            label: &APP_TEXT$PART_OF_THE_EMAIL_REGISTERED_WITH_US.
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 50
            region: @تعيين-كلمة-سر-جديدة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P9991_USERNAME (
        type: textField
        label {
            label: &APP_TEXT$WORKER_NUMBER.
            alignment: left
        }
        layout {
            sequence: 30
            region: @تعيين-كلمة-سر-جديدة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
    )

    button cancel (
        buttonName: cancel
        label: &APP_TEXT$CANCEL.
        layout {
            sequence: 10
            region: @تعيين-كلمة-سر-جديدة
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-times-circle
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button get-email (
        buttonName: get_email
        label: &APP_TEXT$INQUIRY_ABOUT_E_MAIL.
        layout {
            sequence: 40
            region: @تعيين-كلمة-سر-جديدة
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vc varchar2(99);
                    begin
                    
                    select central.conceal_email(pay_email) || '   _____   ' || central.conceal_email(comp_email)
                    into vc  from central.xxapex_hr_emp_data
                    where EMP_NUMBER = :P9991_USERNAME
                    ;
                    
                        apex_util.set_session_state('P9991_RETRIVED_MAIL', vc);
                        apex_util.set_session_state('P9991_EMAIL_OK', 1);
                    exception when others then 
                    apex_util.set_session_state('P9991_RETRIVED_MAIL', 'No Email Found !!');
                    apex_util.set_session_state('P9991_EMAIL_OK', 0);
                    end;
                    ```
                itemsToSubmit: P9991_USERNAME
                itemsToReturn: [
                    P9991_RETRIVED_MAIL
                    P9991_EMAIL_OK
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    button submit (
        buttonName: submit
        label: &APP_TEXT$SEND.
        layout {
            sequence: 10
            region: @تعيين-كلمة-سر-جديدة
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
            ]
            icon: fa-envelope
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction changed (
        name: changed
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P9991_EMAIL_OK
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @get-email
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P9991_EMAIL
            }
            execution {
                sequence: 30
            }
        )

    )

    validation email-must-match (
        name: email_must_match
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select pay_email,comp_email
                           from central.xxapex_hr_emp_data
                          where emp_number = :P9991_USERNAME
                          and (
                           lower(pay_email) = lower(:P9991_EMAIL) 
                           or
                           lower(comp_email) = lower(:P9991_EMAIL) 
                          )
                             )
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_EMAIL_MUST_BE_THE_SAME_AS_THE_ONE_REGISTERED_WITH_US.
            associatedItem: @P9991_EMAIL
        }
    )

    process clear-session (
        name: clear session
        type: clearSessionState
        clear {
            type: session
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 10535134829102247
        }
    )

    process send-email-with-new-password (
        name: send email with new password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                v_code varchar2(20);
                v_emp_name varchar2(99);
                begin
                
                  v_code := central.SET_EMP_REST_CODE(
                    P_EMP_ID => :P9991_USERNAME
                  );
                
                select emp_name
                into v_emp_name
                           from central.xxapex_hr_emp_data
                          where emp_number = :P9991_USERNAME;
                
                    apex_mail.send (
                        p_from               => 'apex@eprom.com.eg',
                        p_to                 => :P9991_EMAIL,
                        p_template_static_id => 'PASSWORD_RESET',
                        p_placeholders       => '{' ||
                        '    "EMP_NAME":' || apex_json.stringify( v_emp_name ) ||
                        '   ,"EMP_ID":'   || apex_json.stringify( :P9991_USERNAME ) ||
                        '   ,"NEW_PASS":' || apex_json.stringify( v_code ) ||
                        '}' );
                
                APEX_MAIL.PUSH_QUEUE;
                
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "&{P9991EMAIL P9991_EMAIL=&P9991_EMAIL.}."
        }
        error {
            errorMessage: &APP_TEXT$SOMETHING_WENT_WRONG.
        }
        advanced {
            executionMappingIdentifier: 10534536788102241
        }
    )

    branch (
        name: go to login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
            }
        }
    )

)
