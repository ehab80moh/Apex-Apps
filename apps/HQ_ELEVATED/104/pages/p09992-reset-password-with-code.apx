        layout {
            sequence: 20
            region: @تعيين-كلمة-السر-للبوابة-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P9992_PASSWORD2 (
        type: password
        label {
            label: &APP_TEXT$CONFIRM_PASSWORD.
            alignment: left
        }
        layout {
            sequence: 30
            region: @تعيين-كلمة-السر-للبوابة-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P9992_PHONE (
        type: textField
        label {
            label: &APP_TEXT$THE_MOBILE_NUMBER_REGISTERED_WITH_US.
            alignment: left
        }
        layout {
            sequence: 20
            region: @تعيين-كلمة-السر-للبوابة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 11
        }
    )

    pageItem P9992_USERNAME (
