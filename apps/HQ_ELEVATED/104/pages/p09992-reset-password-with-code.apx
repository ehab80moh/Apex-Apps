    button change-pass (
        buttonName: change_pass
        label: &APP_TEXT$CHANGE_PASSWORD.
        layout {
            sequence: 40
            region: @تعيين-كلمة-السر-للبوابة-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--gapBottom
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: Submit
        label: &APP_TEXT$SEND.
        layout {
            sequence: 40
            region: @تعيين-كلمة-السر-للبوابة
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation code (
        name: Code
        execution {
            sequence: 80
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_length NUMBER := 6;
                BEGIN
                    IF LENGTH(:P9992_CODE) = v_length THEN
                        RETURN TRUE;
                    ELSE
                        RETURN FALSE;
                    END IF;
                END;
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_CODE_MUST_CONTAIN_6_NUMBERS.
            associatedItem: @P9992_CODE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation code-is-good (
        name: code is good
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_code VARCHAR2(200);
                BEGIN
                
                  v_code := central.GET_EMP_REST_CODE( :P9992_EMP_ID );
                
                IF V_CODE IS NULL THEN RETURN FALSE; END IF;
                
                
                return trim(v_code) = trim(:P9992_CODE);
                
                END;
                ```
        }
        error {
            errorMessage: &APP_TEXT$THE_CODE_IS_INVALID_OR_EXPIRED.
        }
        serverSideCondition {
            type: itemIsNull
            item: P9992_OK
        }
    )

    validation email-match-emp-id (
        name: email match emp_id
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select pay_email,comp_email
                           from central.xxapex_hr_emp_data
                          where emp_number = :P9992_EMP_ID
                          and (
                           lower(pay_email) = lower(:P9992_EMAIL) 
                           or
                           lower(comp_email) = lower(:P9992_EMAIL) 
                          )
                             )
                ```
        }
        error {
            errorMessage: &APP_TEXT$INCORRECT_WORKING_NUMBER_OR_EMAIL.
        }
        serverSideCondition {
            type: never
        }
    )

    validation password-complex (
        name: password complex1
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                begin
                if central.CHECK_PWD(:P9992_PASSWORD)=1  then
                    return true;
                else 
                    return false;
                end if;
                end;
                ```
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE_4.
        }
        serverSideCondition {
            type: item=value
            item: P9992_OK
            value: 1
        }
    )

    validation password-is-not-empty (
        name: password IS NOT EMPTY
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                begin
                if :P9992_PASSWORD IS NOT NULL AND :P9992_PASSWORD2 IS NOT NULL AND  length(:P9992_PASSWORD) >= 8 AND length(:P9992_PASSWORD) <= 20 then
                    return true;
                else 
                    return false;
                end if;
                end;
                ```
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE_5.
        }
        serverSideCondition {
            type: item=value
            item: P9992_OK
            value: 1
        }
    )

    validation password-match (
        name: password_match
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: :P9992_PASSWORD = :P9992_PASSWORD2
        }
        error {
            errorMessage: &APP_TEXT$MSG_TEXT.
            associatedItem: @P9992_PASSWORD2
        }
    )

    validation phone-must-match (
        name: Phone_must_match
        execution {
            sequence: 70
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                exists ( 
                    select MOBILE
                           from central.EMP_CONTACT
                          where EMP_ID = :P9992_EMP_ID
                          and
                           lower(MOBILE) = lower(:P9992_PHONE) 
                             )
                ```
        }
        error {
            errorMessage: &APP_TEXT$YOU_MUST_ENTER_A_PHONE_NUMBER_THAT_IS_ALREADY_REGISTERED.
            associatedItem: @P9992_PHONE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    validation phone-number (
        name: Phone Number
        execution {
            sequence: 60
        }
        validation {
            type: itemMatchesRegexp
            item: P9992_PHONE
            regexp: "^01\\d{9}$"
        }
        error {
            errorMessage: &APP_TEXT$ERROR_MESSAGE.
            associatedItem: @P9992_PHONE
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process clear-items (
        name: clear items
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 7437286416486018
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P9992_OK =1 and :P9992_PASSWORD is not null
        }
    )

    process set-ok-and-username (
        name: set ok and username
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P9992_OK :=1   ;
                :P9992_USERNAME := :P9992_EMP_ID;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &APP_TEXT$PLEASE_TYPE_THE_NEW_PASSWORD_TWICE.
        }
        advanced {
            executionMappingIdentifier: 7435990770486005
        }
        serverSideCondition {
            type: itemIsNull
            item: P9992_OK
        }
    )

    process update-user-password (
        name: update user password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  central.UPDATE_EMP_PASSWORD(
                    P_EMP_ID => :P9992_EMP_ID,
                    P_NEW_PASS => :P9992_PASSWORD
                  );
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &APP_TEXT$SUCCESSFULLY_UPDATED_PASSWORD.
        }
        advanced {
            executionMappingIdentifier: 7437123732486017
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P9992_OK =1 and :P9992_PASSWORD is not null
        }
    )

    branch (
        name: go to login
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
            }
        }
        serverSideCondition {
            type: itemIsNull
            item: P9992_OK
        }
    )

)
