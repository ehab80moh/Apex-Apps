        layout {
            sequence: 10
            region: @تعيين-كلمة-السر-للبوابة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
