page 9992 (
    name: تعيين كلمة السر بالكود
    alias: RESET-PASSWORD-WITH-CODE
    title: &APP_TEXT$SET_PASSWORD.
    appearance {
        pageTemplate: @login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Function to enforce English numbers only
            function enforceEnglishNumbers(itemName) {
                apex.jQuery("#" + itemName).on("input", function() {
                    var item = apex.item(itemName);
                    var value = item.getValue();
            
                    // Convert Arabic numbers to English and remove any non-numeric characters
                    var newValue = value.replace(/[٠-٩]/g, function(d) {
                        return "٠١٢٣٤٥٦٧٨٩".indexOf(d);
                    }).replace(/\D/g, ""); // Remove non-numeric characters
            
                    item.setValue(newValue);
                });
            }
            
            // Apply the function to all three fields
            enforceEnglishNumbers("P9992_EMP_ID");
            enforceEnglishNumbers("P9992_PHONE");
            enforceEnglishNumbers("P9992_CODE");
            
            ```
    }
    css {
        fileUrls: #APP_FILES#test_s.min.css
        inline:
            ```css
            .bn31 {
              background-image: linear-gradient(to right, #006175 0%, #00a950 100%);
              border-radius: 40px;
              box-sizing: border-box;
              color: #18311f;
              display: block;
              height: 50px;
              font-family: Amiri; 
              font-size: 1.4em;
              padding: 4px;
              position: relative;
              text-decoration: none;
              width: 7em;
              z-index: 2;
            }
            
            .bn31:hover {
              color: #fff;
            }
            
            .bn31 .bn31span {
              align-items: center;
              background: #0e0e10;
              border-radius: 40px;
              display: flex;
              justify-content: center;
              height: 100%;
              transition: background 0.5s ease;
              width: 100%;
            }
            .bn31:hover .bn31span {
              background: transparent;
            }
            
            .pw-item-icon {
                float: left;
                margin-right: -30px; 
                margin-top: 4px;
                position: relative;
                z-index: 1;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region info (
        name: info
        title: &APP_TEXT$INFO.
        type: staticContent
        source {
            htmlCode: &APP_TEXT$PLUG_SOURCE_16.
        }
        layout {
            sequence: 10
            parentRegion: @تعيين-كلمة-السر-للبوابة-2
            slot: subRegions
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
            ]
        }
    )

    region تعيين-كلمة-السر-للبوابة (
        name: تعيين كلمة السر للبوابة
        title: &APP_TEXT$SET_THE_PASSWORD_FOR_THE_PORTAL.
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @login
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#app-icon-512.png
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNull
            item: P9992_OK
        }
    )

    region تعيين-كلمة-السر-للبوابة-2 (
        name: تعيين كلمة السر للبوابة
        title: &APP_TEXT$SET_THE_PASSWORD_FOR_THE_PORTAL.
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @login
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#app-icon-512.png
        }
        serverSideCondition {
            type: item=value
            item: P9992_OK
            value: 1
        }
    )

    pageItem P9992_CODE (
        type: textField
        label {
            label: &APP_TEXT$ACTIVATION_CODE_SENT.
            alignment: left
        }
        layout {
            sequence: 30
            region: @تعيين-كلمة-السر-للبوابة
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
