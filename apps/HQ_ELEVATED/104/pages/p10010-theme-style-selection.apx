page 10010 (
    name: Theme Style Selection
    alias: THEME-STYLE-SELECTION
    title: &APP_TEXT$THEME_STYLE_SELECTION.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: &APP_TEXT$HELP_TEXT_2!RAW.
    }
    config {
        buildOption: @feature-theme-style-selection
    }

    region buttons (
        name: Buttons
        title: &APP_TEXT$BUTTONS.
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region configure-appearance (
        name: Configure Appearance
        title: &APP_TEXT$CONFIGURE_APPEARANCE.
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            renderComponents: belowContent
        }
    )

    pageItem P10010_DESKTOP_THEME_STYLE_ID (
        type: selectList
        label {
            label: &APP_TEXT$DESKTOP_THEME_STYLE.
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @desktop-theme-styles
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @configure-appearance
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select s.theme_style_id
                from apex_application_theme_styles s,
                    apex_application_themes t
                where s.application_id = t.application_id
                    and s.theme_number = t.theme_number
                    and s.application_id = :app_id
                    and t.ui_type_name   = 'DESKTOP'
                    and s.is_current = 'Yes'
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select null
                  from apex_application_theme_styles s,
                       apex_application_themes t
                 where s.application_id = t.application_id
                   and s.theme_number   = t.theme_number
                   and s.application_id = :app_id
                   and t.ui_type_name   = 'DESKTOP'
                ```
        }
        security {
            restrictedChars: webSafe
        }
        help {
            inlineHelpText: &APP_TEXT$THE_DEFAULT_THEME_STYLE_APPLIES_TO_ALL_USERS.
        }
    )

    pageItem P10010_END_USER_STYLE (
        type: checkboxGroup
        label {
            label: &APP_TEXT$END_USER_THEME_PREFERENCE.
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @user-theme-preference
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @configure-appearance
            slot: regionBody
            alignment: left
            labelColumnSpan: 0
        }
        appearance {
            template: @hidden
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select a.theme_style_by_user_pref
                  from apex_applications a
                 where a.application_id  = :app_id
                ```
            used: always
        }
        help {
            inlineHelpText: &APP_TEXT$INLINE_HELP_TEXT_1.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: &APP_TEXT$CANCEL.
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$APPLY_CHANGES.
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-end-user-style-preference (
        name: Save End User Style Preference
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_enabled boolean := case when :P10010_END_USER_STYLE = 'Yes' then true else false end;
                begin
                    for l_theme in ( select ui.theme_number
                                       from apex_application_themes t,
                                            apex_appl_user_interfaces ui
                                      where ui.application_id = t.application_id
                                        and ui.theme_number   = t.theme_number
                                        and t.application_id  = :APP_ID
                                        and t.ui_type_name    = 'DESKTOP'
                                        and t.is_current      = 'Yes' )
                    loop
                        if l_enabled then
                            apex_theme.enable_user_style (
                                p_application_id => :APP_ID,
                                p_theme_number   => l_theme.theme_number );
                        else
                            apex_theme.disable_user_style (
                                p_application_id => :APP_ID,
                                p_theme_number   => l_theme.theme_number );
                            apex_theme.clear_all_users_style(:APP_ID);
                        end if;
                    end loop;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &APP_TEXT$APPLICATION_APPEARANCE_SETTINGS_SAVED.
        }
        advanced {
            executionMappingIdentifier: 4640114256082379
        }
    )

    process save-theme-style (
        name: Save Theme Style
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P10010_DESKTOP_THEME_STYLE_ID is not null then
                    for l_theme in (select theme_number
                                      from apex_application_themes
                                     where application_id = :app_id
                                       and ui_type_name   = 'DESKTOP'
                                       and is_current     = 'Yes')
                    loop
                        apex_util.set_current_theme_style (
                            p_theme_number   => l_theme.theme_number,
                            p_theme_style_id => :P10010_DESKTOP_THEME_STYLE_ID
                            );
                    end loop;
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &APP_TEXT$APPLICATION_APPEARANCE_SETTINGS_SAVED.
        }
        advanced {
            executionMappingIdentifier: 4639755898082379
        }
    )

    branch (
        name: Branch to Admin Page
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10000
                action: resetPagination
            }
        }
    )

)
