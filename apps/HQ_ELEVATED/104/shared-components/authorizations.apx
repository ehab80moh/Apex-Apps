authorization erc-self-services (
    name: ERC_self_services
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            DECLARE
              l_count NUMBER;
            BEGIN
            
             SELECT COUNT(*)
             INTO l_count
             FROM xxapex_hr_emp_data
             WHERE emp_number = :APP_USER
             AND (
                   site_code NOT IN ('EPROM_ERC','EPROM_MIDOR')
                   OR :APP_USER = '1198'
                 );
            
             RETURN l_count > 0;
            
            END;
            ```
    }
    advanced {
        evaluationType: perSession
    }
)

