authorization eprom-hq-auth (
    name: eprom_hq_auth
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            IF central.check_privilage(:app_user,:app_id,:app_page_id) THEN
                RETURN TRUE;
            ELSIF :app_id = '104' AND :app_page_id = '95' THEN
                RETURN central.check_privilage(:app_user,104,1)
                    AND APEX_AUTHORIZATION.IS_AUTHORIZED('Training Management Access');
            ELSIF :app_id = '104' AND :app_page_id IN ('52','200')
                  AND med.apr_med_approver_task_api.has_medical_task_access(
                      :app_user,TO_NUMBER(:app_page_id),
                      CASE WHEN :app_page_id='52' THEN TO_NUMBER(:P52_TASK_ID) ELSE NULL END
                  )='Y' THEN
                RETURN TRUE;
            ELSIF :app_id = '104' AND :app_page_id='109'
                  AND med.apr_med_approver_task_api.has_medical_request_task_access(
                      :app_user,106,TO_NUMBER(:P109_REFERAL_ID))='Y' THEN
                RETURN TRUE;
            END IF;
            RETURN FALSE;
            ```
    }
)

