authorization medical-referral-request-viewer (
    name: Medical_Referral_Request_Viewer
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            DECLARE
                l_employee VARCHAR2(128);
            BEGIN
                IF :APP_ID <> '104' OR :APP_PAGE_ID <> '109' OR :P109_REFERAL_ID IS NULL THEN
                    RETURN FALSE;
                END IF;
                SELECT emp_id_snapshot INTO l_employee
                  FROM med.md_referal_flow WHERE referal_id=TO_NUMBER(:P109_REFERAL_ID);
                RETURN UPPER(TRIM(l_employee))=UPPER(TRIM(:APP_USER))
                    OR apex_authorization.is_authorized(p_authorization_name=>'Medical_Team')
                    OR med.apr_med_approver_task_api.has_medical_request_task_access(
                           :APP_USER,106,TO_NUMBER(:P109_REFERAL_ID))='Y';
            EXCEPTION
                WHEN OTHERS THEN RETURN FALSE;
            END;
            ```
    }
)

authorization medical-referral-task-owner (
    name: Medical_Referral_Task_Owner
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            BEGIN
                RETURN apex_authorization.is_authorized(
                           p_authorization_name=>'Medical_Referral_Task_Reviewer')
                   AND apex_human_task.is_allowed(
                           p_task_id=>TO_NUMBER(:P109_TASK_ID),
                           p_operation=>apex_human_task.c_task_op_approve);
            EXCEPTION
                WHEN OTHERS THEN RETURN FALSE;
            END;
            ```
    }
)

authorization medical-referral-task-reviewer (
    name: Medical_Referral_Task_Reviewer
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            DECLARE
                l_count PLS_INTEGER;
            BEGIN
                IF :APP_ID <> '104' OR :APP_PAGE_ID <> '109'
                   OR :P109_TASK_ID IS NULL OR :P109_REFERAL_ID IS NULL THEN
                    RETURN FALSE;
                END IF;
                IF med.apr_med_approver_task_api.has_medical_task_access(
                       :APP_USER,52,TO_NUMBER(:P109_TASK_ID)) <> 'Y' THEN
                    RETURN FALSE;
                END IF;
                SELECT COUNT(*) INTO l_count
                  FROM apex_tasks t
                 WHERE t.task_id = TO_NUMBER(:P109_TASK_ID)
                   AND t.application_id = 104
                   AND LOWER(t.task_def_static_id) = 'approval-task'
                   AND EXISTS (SELECT 1 FROM apex_task_parameters p
                                WHERE p.task_id=t.task_id AND p.param_static_id='T_REQUEST_TYPE_ID'
                                  AND TRIM(p.param_value)='106')
                   AND EXISTS (SELECT 1 FROM apex_task_parameters p
                                WHERE p.task_id=t.task_id AND p.param_static_id='T_REQUEST_ID'
                                  AND TRIM(p.param_value)=TO_CHAR(TO_NUMBER(:P109_REFERAL_ID)));
                RETURN l_count = 1;
            EXCEPTION
                WHEN OTHERS THEN RETURN FALSE;
            END;
            ```
    }
)

