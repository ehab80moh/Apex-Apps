buildOption commented-out (
    name: Commented Out
)

buildOption dev-only (
    name: Dev Only
    status {
        defaultOnExport: exclude
    }
)

buildOption feature-push-notifications (
    name: Feature: Push Notifications
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_PUSH_NOTIFICATIONS
    }
    comments {
        comments: Allow users to subscribe to push notifications on their devices.
    }
)

buildOption feature-theme-style-selection (
    name: Feature: Theme Style Selection
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_THEME_STYLE_SELECTION
    }
    comments {
        comments: "Allow administrators to select a default color scheme (theme style) for the application. Administrators can also choose to allow end users to choose their own theme style. "
    }
)

buildOption feature-user-settings (
    name: Feature: User Settings
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_USER_SETTINGS
    }
    comments {
        comments: The user settings page is a drawer that links to all user settings pages.
    }
)
