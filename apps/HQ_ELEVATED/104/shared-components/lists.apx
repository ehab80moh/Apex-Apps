        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                RETURN :APP_USER in('1825','3455','3199') OR central.is_dev_or_super_n(:app_user) = 1;
                END;
                ```
        }
    )

)

