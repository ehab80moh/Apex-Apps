list hr (
    name: HR

    entry time-sheet (
        label: &APP_TEXT$TIME_SHEET.
        icon {
            imageIconCssClasses: fa-clock-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 54
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER in ( '3199','1837','1825','1168','867','1907') OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
        }
    )

    entry استيفاء-بيانات-الهيئة (
        label: &APP_TEXT$COMPLETE_THE_AUTHORITY_S_DATA.
        icon {
            imageIconCssClasses: fa-file
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                type: otherApp
                app: 115
                page: 31
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :app_user in (773,3775,3199,1837) OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
        }
    )

    entry التقييمات-السنوية (
        label: &APP_TEXT$ANNUAL_EVALUATIONS.
        icon {
            imageIconCssClasses: fa-handshake-o
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                type: otherApp
                app: 205
                page: 1
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :APP_USER in ('3199','1837','995','1825','3775','1168','1295')
                 OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
                ```
        }
    )

    entry تعديل-الموافقات (
        label: &APP_TEXT$MODIFY_APPROVALS.
        icon {
            imageIconCssClasses: "fa-building	"
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                type: url
                url: /apex/r/epromhq/approval-and-workflow-manager/custom-setup?session=&SESSION.
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :APP_USER IN ('3199','1837','1825')
                OR EXISTS (
                    SELECT 1
                    FROM central.apr_site_worker_priv
                    WHERE emp_id = TO_NUMBER(:APP_USER)
                )
                 OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
                ```
        }
    )

    entry رصيد-الاجازات (
        label: &APP_TEXT$LEAVE_BALANCE.
        icon {
            imageIconCssClasses: fa-calendar-plus
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 48
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER in ( '3199','1837','1825','1168','867','1907','3775') OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
        }
    )

    entry سلف-المدارس (
        label: &APP_TEXT$PREDECESSORS_OF_SCHOOLS.
        icon {
            imageIconCssClasses: fa-accordion
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                type: otherApp
                app: 105
                page: 45
            }
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @hr-test
        }
    )

    entry عرض-الطلبات-المعلقة (
        label: &APP_TEXT$VIEW_PENDING_ORDERS.
        icon {
            imageIconCssClasses: fa-hourglass-half
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 71
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER in ( '3199','1837','1825','1168','867','1907') OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
        }
    )

    entry عرض-تعديل-طلبات-موظفين-الشركة (
        label: &APP_TEXT$OFFER_TO_MODIFY_COMPANY_EMPLOYEE_REQUESTS.
        icon {
            imageIconCssClasses: fa-ai-sparkle-generate-list
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                type: otherApp
                app: 115
                page: 29
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER in ( '3199','1837','1825','1859','2766','3692','2278','1295','1168','3775','773') OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
        }
    )

    entry عرض-مرفقات-موظفين-الشركة (
        label: &APP_TEXT$VIEW_COMPANY_EMPLOYEE_ATTACHMENTS.
        icon {
            imageIconCssClasses: fa-folder
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                type: otherApp
                app: 115
                page: 23
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER in ( '3199','1837','1825','1859','2766','3692','2278','1295','1168','3775','773','3400') OR CENTRAL.IS_DEV_OR_SUPER_N(:APP_USER) = 1
        }
    )

)

