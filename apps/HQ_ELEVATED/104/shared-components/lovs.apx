lov cmpl-categories-name-ar-en (
    name: CMPL_CATEGORIES.NAME_AR_EN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            with lng as(
            select 
            case when 
            lower(APEX_UTIL.GET_SESSION_LANG) like '%en%' then 
            'en' else 'ar' end as ln
            from dual)
            select 
            cc.CATEGORY_ID,
            decode (l.ln,'en',cc.NAME_EN,cc.NAME_AR) cat_name,
            cc.ACTIVE_FLAG,
            cc.ORd
            ,L.LN
            from CMPL_CATEGORIES cc
            join lng l on 1=1
            WHERE cc.ACTIVE_FLAG=1
            ORDER BY cc.ORD,cc.CATEGORY_ID
            ```
    }
    columnMapping {
        return: CATEGORY_ID
        display: CAT_NAME
    }
)

lov cmpl-status-lov-name-ar (
    name: CMPL_STATUS_LOV.NAME_AR
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                STATUS_CODE,
                CASE
                    WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%'
                    THEN NAME_EN
                    ELSE NAME_AR
                END AS STATUS_NAME
            FROM CMPL_STATUS_LOV
            
            ```
    }
    columnMapping {
        return: STATUS_CODE
        display: STATUS_NAME
    }
)

lov cmpl-subcategories-name-ar-en (
    name: CMPL_SUBCATEGORIES.NAME_AR_EN_401
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            WITH lng AS (
                SELECT CASE 
                         WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%' 
                         THEN 'en' 
                         ELSE 'ar' 
                       END AS ln
                FROM dual
            )
            SELECT
                sc.SUBCATEGORY_ID,
                sc.CATEGORY_ID,
                CASE l.ln
                    WHEN 'en' THEN sc.NAME_EN
                    ELSE sc.NAME_AR
                END AS subcategory_name,
                sc.ACTIVE_FLAG,
                l.ln
            FROM CMPL_SUBCATEGORIES
             sc
            CROSS JOIN lng l
            WHERE sc.ACTIVE_FLAG = 1
            
            AND :P401_CATEGORY_ID = CATEGORY_ID
            ```
    }
    columnMapping {
        return: SUBCATEGORY_ID
        display: SUBCATEGORY_NAME
    }
)

lov cmpl-subcategories-name-ar-en-full (
    name: CMPL_SUBCATEGORIES.NAME_AR_EN_FULL
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            WITH lng AS (
                SELECT CASE 
                         WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%' 
                         THEN 'en' 
                         ELSE 'ar' 
                       END AS ln
                FROM dual
            )
            SELECT
                sc.SUBCATEGORY_ID,
                sc.CATEGORY_ID,
                CASE l.ln
                    WHEN 'en' THEN sc.NAME_EN
                    ELSE sc.NAME_AR
                END AS subcategory_name,
                sc.ACTIVE_FLAG,
                l.ln
            FROM CMPL_SUBCATEGORIES
             sc
            CROSS JOIN lng l
            WHERE sc.ACTIVE_FLAG = 1
            
            ```
    }
    columnMapping {
        return: SUBCATEGORY_ID
        display: SUBCATEGORY_NAME
    }
)

