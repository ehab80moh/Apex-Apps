lov p401-cmpl-evidence-check (
    name: P401_CMPL_EVIDENCE_CHECK
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                CASE WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%'
                     THEN 'Images'
                     ELSE 'صور'
                END AS display_value,
                'صور' AS return_value
            FROM dual
            
            UNION ALL
            
            SELECT
                CASE WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%'
                     THEN 'Witnesses'
                     ELSE 'شهود'
                END,
                'شهود'
            FROM dual
            
            UNION ALL
            
            SELECT
                CASE WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%'
                     THEN 'Documents'
                     ELSE 'مستندات'
                END,
                'مستندات'
            FROM dual
            
            UNION ALL
            
            SELECT
                CASE WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%'
                     THEN 'Email'
                     ELSE 'بريد إلكتروني'
                END,
                'بريد إلكتروني'
            FROM dual
            
            UNION ALL
            
            SELECT
                CASE WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%'
                     THEN 'Other'
                     ELSE 'أخرى'
                END,
                'أخرى'
            FROM dual;
            
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

