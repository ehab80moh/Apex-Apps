lov yes-no (
    name: YES_NO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            
            
            
            
            
            WITH labs_split AS (
              SELECT 
                ROWNUM AS rn,
                COLUMN_VALUE AS labs
              FROM 
                TABLE(
                  apex_string.split(
                    (SELECT labs FROM CENTRAL.USER_PREFS WHERE PREF_ID = :P20020_PREF_ID), ':'
                  )
                )
            ),
            
            vals_split AS (
              SELECT 
                ROWNUM AS rn,
                COLUMN_VALUE AS vals
              FROM 
                TABLE(
                  apex_string.split(
                    (SELECT vals FROM CENTRAL.USER_PREFS WHERE PREF_ID = :P20020_PREF_ID), ':'
                  )
                )
            )
            
            SELECT 
              CASE
                WHEN :FSP_LANGUAGE_PREFERENCE = 'ar-ae' THEN
                  CASE
                    WHEN l.labs = 'yes' THEN 'YES'
                    WHEN l.labs = 'no' THEN 'NO'
                    ELSE l.labs
                  END
                ELSE l.labs
              END AS labs,
              v.vals AS vals
            FROM 
              labs_split l
            JOIN 
              vals_split v
            ON 
              l.rn = v.rn;
            
            ```
    }
    columnMapping {
        return: VALS
        display: LABS
        defaultSort: LABS
    }
)

lov yes-no-0-1-ar-en (
    name: YES_NO_0_1_AR_EN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                CASE
                    WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%' THEN 'Yes'
                    ELSE 'YES'
                END AS DISPLAY_VALUE,
                1 AS RETURN_VALUE
            FROM dual
            
            UNION ALL
            
            SELECT
                CASE
                    WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%' THEN 'No'
                    ELSE 'NO'
                END,
                0
            FROM dual;
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

lov yes-or-no (
    name: YES_OR_NO_1_0
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                CASE
                    WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%' THEN 'YES'
                    ELSE 'نعم'
                END AS DISPLAY_VALUE,
                'yes' AS RETURN_VALUE
            FROM DUAL
            UNION ALL
            SELECT
                CASE
                    WHEN LOWER(APEX_UTIL.GET_SESSION_LANG) LIKE '%en%' THEN 'NO'
                    ELSE 'لا'
                END AS DISPLAY_VALUE,
                'no' AS RETURN_VALUE
            FROM DUAL
            
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

