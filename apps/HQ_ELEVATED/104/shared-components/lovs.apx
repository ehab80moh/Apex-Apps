lov subordinates-leave (
    name: SUBORDINATES_LEAVE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT d.emp_name || ' (' || d.emp_number || ')' AS display_name,
                   d.emp_number
              FROM central.xxapex_hr_emp_data d
             WHERE d.emp_number IN (
                 SELECT TO_NUMBER(f.emp_number)
                   FROM central.apr_approval_results_cust_f f
                  WHERE f.request_type_id = 59
                    AND (f.approver = :APP_USER OR ':' || f.approver || ':' LIKE '%:' || :APP_USER || ':%')
                 UNION
                 SELECT TO_NUMBER(r.emp_id)
                   FROM central.apr_log l
                   JOIN epromhq.hrf_emp_leave_request r ON r.request_id = l.request_id
                  WHERE l.request_type_id = 59
                    AND (l.approver = :APP_USER OR ':' || l.approver || ':' LIKE '%:' || :APP_USER || ':%')
                 UNION
                 SELECT TO_NUMBER(r.emp_id)
                   FROM epromhq.hrf_emp_leave_request r
                  WHERE ('->' || r.updated_by || '->' LIKE '%->' || :APP_USER || '->%'
                      OR '->' || r.updated_by || '->' LIKE '%->' || :APP_USER || 'd->%')
                    AND EXTRACT(YEAR FROM r.from_date) = EXTRACT(YEAR FROM SYSDATE)
             )
               AND d.emp_number <> :APP_USER
             ORDER BY display_name
            ```
    }
    columnMapping {
        return: EMP_NUMBER
        display: DISPLAY_NAME
    }
)

lov subordinates-missions (
    name: SUBORDINATES_MISSIONS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT d.emp_name || ' (' || d.emp_number || ')' AS display_name,
                   d.emp_number
              FROM central.xxapex_hr_emp_data d
             WHERE d.emp_number IN (
                 SELECT TO_NUMBER(f.emp_number)
                   FROM central.apr_approval_results_cust_f f
                  WHERE f.request_type_id IN (72, 121)
                    AND (f.approver = :APP_USER OR ':' || f.approver || ':' LIKE '%:' || :APP_USER || ':%')
                 UNION
                 SELECT TO_NUMBER(r.emp_id)
                   FROM central.apr_log l
                   JOIN epromhq.hrf_emp_mission_request r ON r.request_id = l.request_id
                  WHERE l.request_type_id IN (72, 121)
                    AND (l.approver = :APP_USER OR ':' || l.approver || ':' LIKE '%:' || :APP_USER || ':%')
                 UNION
                 SELECT TO_NUMBER(r.emp_id)
                   FROM epromhq.hrf_emp_mission_request r
                  WHERE ('->' || r.updated_by || '->' LIKE '%->' || :APP_USER || '->%'
                      OR '->' || r.updated_by || '->' LIKE '%->' || :APP_USER || 'd->%')
                    AND EXTRACT(YEAR FROM NVL(r.last_approval_date, r.from_date)) = EXTRACT(YEAR FROM SYSDATE)
             )
               AND d.emp_number <> :APP_USER
             ORDER BY display_name
            ```
    }
    columnMapping {
        return: EMP_NUMBER
        display: DISPLAY_NAME
    }
)

