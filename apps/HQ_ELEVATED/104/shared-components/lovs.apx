)

lov employee-numbers (
    name: EMPLOYEE NUMBERS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select emp_name || ' -- '||emp_number DESCRIPTION,emp_number from xxapex_hr_emp_data
            union all select null DESCRIPTION, null emp_number from dual
            ```
    }
    columnMapping {
        return: EMP_NUMBER
        display: DESCRIPTION
        defaultSort: EMP_NUMBER
    }
)

lov employee-numbers-2 (
    name: EMPLOYEE NUMBERS1
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 
                emp_name || ' -- ' || emp_number AS DESCRIPTION,
                emp_number 
            FROM 
                central.xxapex_hr_emp_data 
            WHERE 
                (
                    (SELECT SITE_CODE 
                     FROM central.xxapex_hr_emp_data 
                     WHERE emp_number = :APP_USER) != 'EPROM_ERC'
                    OR
                    SITE_CODE = 'EPROM_ERC'
                )
            ORDER BY 
                emp_name;
            
            ```
    }
    columnMapping {
        return: EMP_NUMBER
        display: DESCRIPTION
    }
)

lov employee-numbers-just-for-page (
    name: EMPLOYEE NUMBERS JUST FOR PAGE40
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select emp_name || ' -- '||emp_number DESCRIPTION,emp_number from xxapex_hr_emp_data
            union all select null DESCRIPTION, null emp_number from dual
            union all select 'لايوجد' DESCRIPTION, '-1' emp_number from dual
            ```
    }
    columnMapping {
        return: EMP_NUMBER
        display: DESCRIPTION
        defaultSort: EMP_NUMBER
    }
)

lov feedback-rating (
    name: FEEDBACK_RATING
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: &APP_TEXT$POSITIVE.
        return: 3
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-smile-o fa-2x feedback-positive" aria-hidden="true" ></span></span>
        }
    )

    entry lov_data-2 (
        sequence: 2
        display: &APP_TEXT$NEUTRAL.
        return: 2
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-emoji-neutral fa-2x feedback-neutral" aria-hidden="true" ></span></span>
        }
    )

    entry lov_data-3 (
        sequence: 3
        display: &APP_TEXT$NEGATIVE.
        return: 1
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-frown-o fa-2x feedback-negative" aria-hidden="true" ></span></span>
        }
    )

)

