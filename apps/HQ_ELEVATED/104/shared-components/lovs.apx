lov vac-unit (
    name: VAC_UNIT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct l.location_name || ' -- ' || l.unit_name as display_value,
                   s.block_id
              from epromhq.v_vac_unit_emp_serials s
              join epromhq.vac_unit_allocation v
                on s.allocation_id = v.id
              join epromhq.vac_trip_blocs_v l
                on l.unit_id = s.block_id
               and l.trip_id = v.trip_id
             where v.trip_id = 16
             order by display_value
            ```
    }
    columnMapping {
        return: BLOCK_ID
        display: DISPLAY_VALUE
    }
)

