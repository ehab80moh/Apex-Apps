lov approvals (
    name: APPROVALS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT d.emp_name,d.emp_number
            FROM central.xxapex_hr_emp_data d
            JOIN central.APR_APPROVAL_RESULTS_CUST_F c
            ON d.emp_number = c.emp_number
            WHERE d.emp_number IN (
                SELECT DISTINCT emp_number 
                FROM central.APR_APPROVAL_RESULTS_CUST_F
                WHERE approver = :app_user or emp_number = :App_user
            ) and REQUEST_TYPE_ID in (59, 61);
            ```
    }
    columnMapping {
        return: EMP_NUMBER
        display: EMP_NAME
    }
)

