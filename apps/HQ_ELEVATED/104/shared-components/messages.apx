textMessage PLUG_SOURCE_18 (
    message {
        text:
            ```
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Request Type Colors</title>
                <style>
                    /* Set a general background color for the table */
                    /* body {
                        font-family: Arial, sans-serif;
                    } */
                    /* Define text color styles */
                    table {
                        width: 100%;
                        border-collapse: collapse; /* Collapse borders for a cleaner look */
                    }
                    th, td {
                        text-align: center; /* Center align text */
                        padding: 5px; /* Reduced padding for thinner rows */
                    }
                    .apex-cal-black {
                        color: white;
                        font-weight: bold; /* Bold font */
                        background-color: black; /* Black background */
                    }
                    .u-color-3 {
                        color: black;
                        font-weight: bold; /* Bold font */
                    }
                    .apex-cal-blue {
                        color: white;
                        font-weight: bold; /* Bold font */
                        background-color: #4183d7; /* Blue background */
                    }
                    .apex-cal-green {
                        color: black;
                        font-weight: bold; /* Bold font */
                    }
                    .overtime {
                        color: black;
                        font-weight: bold; /* Bold font */
                        background-color: #2ecc71; /* Updated green background */
                    }
                    .u-color-20 {
                        color: black;
                        font-weight: bold; /* Bold font */
                    }
                    .u-color-8 {
                        color: black;
                        font-weight: bold; /* Bold font */
                    }
                    .to-late {
                        color: white;
                        font-weight: bold; /* Bold font */
                        background-color: #cb1100; /* Red background */
                    }
                    .public-holiday {
                        color: white;
                        font-weight: bold; /* Bold font */
                        background-color: #278701; /* Green background */
                    }
                </style>
            </head>
            <body>
                <table border="1">
                    <tr>
                         <th> <h2>Request Type</h2></th>
                    </tr>
                    <tr>
                        <td class="apex-cal-black">Annual Leave</td>
                    </tr>
                    <tr>
                        <td class="u-color-3">Permission</td>
                    </tr>
                    <tr>
                        <td class="apex-cal-blue">Mission</td>
                    </tr>
                    <tr>
                        <td class="overtime">Overtime</td>
                    </tr>
                    <tr>
                        <td class="u-color-20">Sign In</td>
                    </tr>
                    <tr>
                        <td class="u-color-8">Sign Out</td>
                    </tr>
                    <tr>
                        <td class="public-holiday">Public Holiday</td>
                    </tr>
                    <tr>
                        <td class="to-late">Late</td>
                    </tr>
                </table>
            </body>
            </html>
            
            ```
        language: ar-ae
    }
