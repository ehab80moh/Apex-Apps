textMessage PLUG_SOURCE_23 (
    message {
        text:
            ```
            SELECT E.EMP_NUMBER, D.EMP_NAME, EC.MOBILE, E.COMMITTEE, E.ESTIMATED_TIME
            
              FROM EPROMHQ.ENGINEERS_ELECTIONS E
              JOIN CENTRAL.XXAPEX_HR_eMP_DATA D ON E.EMP_NUMBER = D.EMP_NUMBER
              JOIN CENTRAL.EMP_CONTACT EC ON E.EMP_NUMBER = EC.EMP_ID
            
            ```
        language: ar-ae
    }
)

