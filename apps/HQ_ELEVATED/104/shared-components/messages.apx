            <h4 dir="rtl">إجازات في انتظار الاعتماد</h4>
            
            <table dir="rtl" style="width:100%;text-align:center;">
            %VAC_SUMMRY
            </table>
            
            <h4 dir="rtl">إذون في انتظار الاعتماد</h4>
            <table dir="rtl" style="width:100%; text-align:center;">
            %PER_SUMMRY
            </table>
            <h4 dir="rtl">مهمات في انتظار الاعتماد</h4>
            <table dir="rtl" style="width:100%; text-align:center;">
            %MISSION_SUMMRY
            </table>
              </body>
            </html>
            
            ```
        language: ar-ae
    }
)

textMessage HTML_BODY_4 (
    message {
        text:
            ```
            <!DOCTYPE html>
            <html dir="ltr">
              <head>
                <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
                <!--[if !mso]><!-->
                <meta http-equiv="X-UA-Compatible" content="IE=edge" />
                <!--<![endif]-->
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <meta name="format-detection" content="telephone=no" />
                <meta name="x-apple-disable-message-reformatting" />
                <title></title>
                <!--[if (gte mso 9)|(IE)]>
              <style type="text/css">
              table {border-collapse: collapse !important;}
              </style>
              <![endif]-->
                <style type="text/css">
                    @-ms-viewport {
                        width: device-width;
                    }
                </style>
                <style type="text/css">
                    td,
                    p {
                        font-size: 20px;
                        font-family: Arial, sans-serif;
                    }
            
                    .outline {
                        outline: 10px dashed #626262;
                    }
                </style>
              </head>
              <body>
            
            
                  <div class="container">
                    <h4><img src="https://apex.eprom.com.eg/img/epromlogo.gif" alt="eprom logo" width="250" height="56"></h4>     
                  </div>
            
            <div style="font-family:Montserrat, Helvetica, Arial, sans-serif;font-size:30px;font-weight:30;text-align: right;line-height:40px;color:#000000;"><b> EPROM Digital Portal </b></div>
            
                      
            <div style="font-family:Montserrat, Helvetica, Arial, sans-serif;font-size:22px;font-weight:300;line-height:24px;text-align:center;color:#000000;direction: rtl;">
                   <p>  Dear %EMP_NAME   </p>
             <h4>Requests Pending Approval </h4>
             </div>   
            
            <h4 dir="ltr">Leave Requests Pending Approval</h4>
            
            <table dir="ltr" style="width:100%;text-align:center;">
            %VAC_SUMMRY
            </table>
            
            <h4 dir="ltr">Permission Requests Pending Approval</h4>
            <table dir="ltr" style="width:100%; text-align:center;">
            %PER_SUMMRY
            </table>
            <h4 dir="ltr">Mission Requests Pending Approval</h4>
            <table dir="ltr" style="width:100%; text-align:center;">
            %MISSION_SUMMRY
            </table>
              </body>
            </html>
            
            ```
        language: en-us
    }
)

