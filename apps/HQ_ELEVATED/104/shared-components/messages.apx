textMessage P111_ATTACHMENT_HELP (
    message {
        text: للروشتة لمرة واحدة أو عند عدم وجود علاج شهري فعال: أرفق صورة واضحة أو ملف PDF. عند وجود علاج شهري فعال يصبح المرفق اختياريًا، ويجب تسليم الأصل لاحقًا بعد كتابة الرقم الوظيفي عليه إذا تم إرفاقه.
        language: ar-ae
    }
)

textMessage P111_ATTACHMENT_HELP (
    message {
        text: For one-time requests or when no active monthly treatment exists, attach a clear image or PDF. With active monthly treatment, the attachment is optional. If you attach it, write your employee number on the original and deliver it later.
        language: en-us
    }
)

textMessage P111_ATTACHMENT_INSTRUCTIONS (
    message {
        text: الروشتة لمرة واحدة تحتاج مرفقًا دائمًا. العلاج الشهري يحتاج المرفق أول مرة أو عند طلبه في يناير أو بعد انتهاء اعتماد الطبيب. يمكنك تصوير الروشتة بالكاميرا أو رفع ملف PDF أو صورة واضحة.
        language: ar-ae
    }
)

textMessage P111_ATTACHMENT_INSTRUCTIONS (
    message {
        text: A one-time prescription always requires an attachment. Monthly treatment requires an attachment for the first request, when requested in January, or after the doctor approval expires. You can take a photo or upload a clear image or PDF.
        language: en-us
    }
)

