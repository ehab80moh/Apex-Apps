textMessage PLUG_SOURCE_5 (
    message {
        text:
            ```
            <div style="
                direction: rtl;
                text-align: right;
                padding: 24px;
                font-family: 'Cairo', sans-serif;
                background: linear-gradient(135deg, #f9fafb, #eef2ff);
                border-radius: 16px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.08);
                max-width: 1100px;
                margin: auto;
            ">
            
              <!-- Header -->
              <div style="margin-bottom: 20px;">
                <h2 style="
                    color: #1f2937;
                    font-weight: 800;
                    font-size: 1.5rem;
                    margin-bottom: 10px;
                ">
                  📌 تنويه هام للسادة المديرين
                </h2>
                <div style="
                    width: 80px;
                    height: 4px;
                    background-color: #6366f1;
                    border-radius: 4px;
                "></div>
              </div>
            
              <!-- Content Text -->
              <div style="
                  color: #374151;
                  font-size: 1.05rem;
                  line-height: 1.9;
                  background-color: #ffffff;
                  padding: 20px;
                  border-radius: 12px;
                  border-right: 6px solid #6366f1;
                  margin-bottom: 24px;
              ">
                <p>
                  السادة المديرين،،
                </p>
            
                <p>
                  نحيط سيادتكم علماً بأنه سيتم هذا العام إستيفاء تقارير الكفاية السنوية
                  للسادة العاملين عن الفترة
                  <strong>2024 / 2025</strong>
                  من خلال
                  <strong>بوابة إيبروم الرقمية فقط</strong>.
                </p>
            
                <p>
                  سيتم إطلاق نسخة التقييم إعتباراً من
                  <strong style="color:#4f46e5;">30 / 12 / 2025</strong>
                  على أن يكون آخر موعد لتقييم كافة العاملين بالشركة هو
                  <strong style="color:#dc2626;">10 / 1 / 2026</strong>.
                </p>
            <!-- Video Download Section -->
            <div style="
                margin-top: 20px;
                text-align: center;
            ">
            
              <a
                href="%APP_FILESUntitled%20design.mp4"
                download
                style="
                  display: inline-flex;
                  align-items: center;
                  gap: 10px;
                  padding: 14px 28px;
                  background: linear-gradient(135deg, #4f46e5, #6366f1);
                  color: #ffffff;
                  text-decoration: none;
                  font-weight: 700;
                  font-size: 1rem;
                  border-radius: 12px;
                  box-shadow: 0 8px 20px rgba(79,70,229,0.35);
                  transition: all 0.3s ease;
                "
                onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 12px 28px rgba(79,70,229,0.45)'"
                onmouseout="this.style.transform='none';this.style.boxShadow='0 8px 20px rgba(79,70,229,0.35)'"
              >
                ⬇️ تحميل الفيديو التوضيحي
              </a>
            
              <p style="
                  margin-top: 10px;
                  font-size: 0.9rem;
                  color: #6b7280;
              ">
                (MP4 – يمكن حفظه أو مشاهدته لاحقًا)
              </p>
            
            </div>
            
                <p style="
                    margin-top: 16px;
                    padding: 12px;
                    background-color: #fef3c7;
                    border-radius: 8px;
                    color: #92400e;
                    font-weight: 600;
                ">
                  ⚠️ ملحوظة هامة:  
                  يتم الإستيفاء من جهاز الحاسب الآلي فقط.
                </p>
              </div>
            
              <!-- GIF Section -->
              <div style="text-align: center;">
                <h3 style="
                    color: #1f2937;
                    font-weight: 700;
                    margin-bottom: 12px;
                ">
                  🎞️ فيديو توضيحي لخطوات التنفيذ
                </h3>
            
                <img
                  src="https://apex-dev.eprom.com.eg/apex/hq_elevated/g/attach/e369853df766fa44e1ed0ff613f563bd"
                  alt="توضيح خطوات تقييم الكفاية"
                  style="
                    width: 100%;
                    max-width: 900px;
                    border-radius: 14px;
                    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
                  "
                />
              </div>
            
            </div>
            
            ```
        language: ar-ae
    }
)

