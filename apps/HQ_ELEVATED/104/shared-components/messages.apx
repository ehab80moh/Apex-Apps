textMessage PAGE8888_INTRO (
    message {
        text: <div class="password-change-kicker">أمان الحساب</div><p class="password-change-description">أكد هويتك باستخدام رمز التحقق المرسل إلى رقم الهاتف المحمول المسجل، ثم أنشئ كلمة مرور جديدة لحسابك.</p><p class="password-change-password-note">يجب أن تحتوي كلمة المرور على حرف كبير وحرف صغير ورقم، وأن تكون من 8 إلى 20 حرفًا أو رمزًا.</p><div class="password-change-steps"><span>1 · رمز التحقق</span><span>2 · كلمة مرور جديدة</span></div>
        language: ar-ae
    }
)

textMessage PAGE8888_INTRO (
    message {
        text: <div class="password-change-kicker">Account security</div><p class="password-change-description">Verify your identity with the code sent to your registered mobile number, then set your new password.</p><p class="password-change-password-note">Use 8–20 characters with at least one uppercase letter, one lowercase letter, and one number.</p><div class="password-change-steps"><span>1 · Verification code</span><span>2 · New password</span></div>
        language: en-us
    }
)

