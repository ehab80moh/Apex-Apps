plugin ucApexOfficePrintAopDa (
    name: UC - APEX Office Print (AOP) - DA
    staticId: BE.APEXRND.AOP_DA
    type: dynamicAction
    component {
        standardAttributes: [
            forItem
            stopExecutionOnErrorAttr
            waitForResultAttr
            initJavascriptCodeAttr
        ]
    }
    callbacks {
        apiInterface: function
        renderProcedureName: aop_api_pkg.f_render_aop
        ajaxProcedureName: aop_api_pkg.f_ajax_aop
    }
    advanced {
        category: execute
        substituteAttributeValues: true
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#css/spinkit.min.css
            #PLUGIN_FILES#css/spinkit-aop.min.css
            #PLUGIN_FILES#css/aop.min.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#js/es6-promise.min.js
            #PLUGIN_FILES#js/aop_da.min.js
        ]
    }
    information {
        version: 25.1.2
        aboutUrl: https://www.apexofficeprint.com
        helpText:
            ```
            APEX Office Print (AOP) is created by United Codes to facilitate exporting data and printing documents in Oracle Application Express (APEX) based on an Office document (Word, Excel, PowerPoint) or HTML, Markdown, CSV, or Text. This plugin can only be used to print to AOP and is copyrighted by APEX R&D and United Codes. If you have any questions please contact support@apexofficeprint.com.
            We hope you enjoy AOP!
            ```
    }

    standardAttributeConfig (
        name: hasInitJavaScriptCodeAttribute
        help {
            helpText: "&{HELP_TEXT}!RAW."
        }
        examples {
            examples: "&{EXAMPLES}!RAW."
        }
    )

)
