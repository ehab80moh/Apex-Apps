classicReportTemplate cards-news (
    name: cards_news
    templateClass: standard
    type: namedColumn
    templateOptions {
        preset: [
            t-Cards--basic
            t-Cards--3cols
            t-Cards--animColorFill
        ]
    }
    reportTemplate {
        top: <ul class="t-Cards #COMPONENT_CSS_CLASSES#" #REPORT_ATTRIBUTES# id="#REGION_STATIC_ID#_cards" data-region-id="#REGION_STATIC_ID#">
        bottom:
            ```html
            </ul>
            <table class="t-Report-pagination" role="presentation">#PAGINATION#</table>
            ```
    }
    rowTemplate1 {
        template:
            ```html
            <div class="p-4">
              <div class="bg-white shadow-lg rounded-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 ease-in-out">
                <!-- Image Section -->
                <div class="relative">
                  <img src="#CARD_IMAGE#" alt="News Image" class="w-full h-48 object-cover">
                  <span class="absolute top-2 left-2 bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded">
                    #CARD_DATETIME#
                  </span>
                </div>
                <!-- Content Section -->
                <div class="p-4">
                  <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-500 transition">
                    #CARD_TITLE#
                  </h3>
                  <p class="mt-2 text-sm text-gray-600 line-clamp-3">
                    #CARD_TEXT#
                  </p>
                </div>
                <!-- Additional Information -->
                <div class="px-4 py-2 flex items-center justify-between text-sm text-gray-500 border-t">
                  <!-- Left Section -->
                  <div class="flex items-center space-x-2">
                    <span class="font-medium">Additional Images:</span>
                    <span class="text-blue-500 truncate">#CARD_IMAGES#</span>
                  </div>
                  <!-- Right-to-Left Support -->
                  <div class="flex items-center">
                    <span class="italic" style="direction: #CARD_DIRECTION#;">#CARD_DIRECTION#</span>
                  </div>
                </div>
              </div>
            </div>
            ```
        conditionType: plsqlExpression
        plsqlExpression: :CARD_LINK is not null
    }
    rowTemplate2 {
        template:
            ```html
            <li class="t-Cards-item #CARD_MODIFIERS#">
              <div class="t-Card">
                <div class="t-Card-wrap">
                  <div class="t-Card-icon u-color #CARD_COLOR#"><span class="t-Icon fa #CARD_ICON#"><span class="t-Card-initials" role="presentation">#CARD_INITIALS#</span></span></div>
                  <div class="t-Card-titleWrap"><h3 class="t-Card-title">#CARD_TITLE#</h3><h4 class="t-Card-subtitle">#CARD_SUBTITLE#</h4></div>
                  <div class="t-Card-body">
                    <div class="t-Card-desc">#CARD_TEXT#</div>
                    <div class="t-Card-info">#CARD_SUBTEXT#</div>
                  </div>
                  <span class="t-Card-colorFill u-color #CARD_COLOR#"></span>
                </div>
              </div>
            </li>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              #PAGINATION_NEXT#<span class="a-Icon icon-right-arrow" aria-hidden="true"></span>
            </a>
            ```
        previousPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow" aria-hidden="true"></span>#PAGINATION_PREVIOUS#
            </a>
            ```
        nextSet:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              #PAGINATION_NEXT_SET#<span class="a-Icon icon-right-arrow" aria-hidden="true"></span>
            </a>
            ```
        previousSet:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow" aria-hidden="true"></span>#PAGINATION_PREVIOUS_SET#
            </a>
            ```
    }
    advanced {
        identifier: CARDS_NEWS
    }

    templateOption 2-columns (
        name: 2 Columns
        sequence: 15
        appearance {
            cssClasses: t-Cards--cols
        }
        advanced {
            identifier: 2_COLUMNS
        }
    )

    templateOption 2-lines (
        name: 2 Lines
        sequence: 10
        appearance {
            cssClasses: t-Cards--desc-2ln
        }
        advanced {
            identifier: 2_LINES
        }
    )

    templateOption 3-columns (
        name: 3 Columns
        sequence: 20
        appearance {
            cssClasses: t-Cards--3cols
        }
        advanced {
            identifier: 3_COLUMNS
        }
    )

    templateOption 3-lines (
        name: 3 Lines
        sequence: 20
        appearance {
            cssClasses: t-Cards--desc-3ln
        }
        advanced {
            identifier: 3_LINES
        }
    )

    templateOption 4-columns (
        name: 4 Columns
        sequence: 30
        appearance {
            cssClasses: t-Cards--4cols
        }
        advanced {
            identifier: 4_COLUMNS
        }
    )

    templateOption 4-lines (
        name: 4 Lines
        sequence: 30
        appearance {
            cssClasses: t-Cards--desc-4ln
        }
        advanced {
            identifier: 4_LINES
        }
    )

    templateOption 5-columns (
        name: 5 Columns
        sequence: 50
        appearance {
            cssClasses: t-Cards--5cols
        }
        advanced {
            identifier: 5_COLUMNS
        }
    )

    templateOption basic (
        name: Basic
        sequence: 10
        appearance {
            cssClasses: t-Cards--basic
        }
        advanced {
            identifier: BASIC
        }
    )

    templateOption block (
        name: Block
        sequence: 40
        appearance {
            cssClasses: [
                t-Cards--featured
                t-Cards--block
                force-fa-lg
            ]
        }
        advanced {
            identifier: BLOCK
        }
    )

    templateOption card-raise-card (
        name: Raise Card
        sequence: 20
        appearance {
            cssClasses: t-Cards--animRaiseCard
        }
        advanced {
            identifier: CARD_RAISE_CARD
        }
    )

    templateOption cards-color-fill (
        name: Color Fill
        sequence: 10
        appearance {
            cssClasses: t-Cards--animColorFill
        }
        advanced {
            identifier: CARDS_COLOR_FILL
        }
    )

    templateOption compact (
        name: Compact
        sequence: 20
        appearance {
            cssClasses: t-Cards--compact
        }
        help {
            helpText: Use this option when you want to show smaller cards.
        }
        advanced {
            identifier: COMPACT
        }
    )

    templateOption display-icons (
        name: Display Icons
        sequence: 10
        appearance {
            cssClasses: t-Cards--displayIcons
        }
        advanced {
            identifier: DISPLAY_ICONS
        }
    )

    templateOption display-initials (
        name: Display Initials
        sequence: 20
        appearance {
            cssClasses: t-Cards--displayInitials
        }
        advanced {
            identifier: DISPLAY_INITIALS
        }
    )

    templateOption display-subtitle (
        name: Display Subtitle
        sequence: 20
        appearance {
            cssClasses: t-Cards--displaySubtitle
        }
        advanced {
            identifier: DISPLAY_SUBTITLE
        }
    )

    templateOption featured (
        name: Featured
        sequence: 30
        appearance {
            cssClasses: [
                t-Cards--featured
                force-fa-lg
            ]
        }
        advanced {
            identifier: FEATURED
        }
    )

    templateOption float (
        name: Float
        sequence: 60
        appearance {
            cssClasses: t-Cards--float
        }
        advanced {
            identifier: FLOAT
        }
    )

    templateOption hidden-body-text (
        name: Hidden
        sequence: 50
        appearance {
            cssClasses: t-Cards--hideBody
        }
        help {
            helpText: This option hides the card body which contains description and subtext.
        }
        advanced {
            identifier: HIDDEN_BODY_TEXT
        }
    )

    templateOption icons-rounded (
        name: Rounded Corners
        sequence: 10
        appearance {
            cssClasses: t-Cards--iconsRounded
        }
        help {
            helpText: The icons are displayed within a square with rounded corners.
        }
        advanced {
            identifier: ICONS_ROUNDED
        }
    )

    templateOption icons-square (
        name: Square
        sequence: 20
        appearance {
            cssClasses: t-Cards--iconsSquare
        }
        help {
            helpText: The icons are displayed within a square shape.
        }
        advanced {
            identifier: ICONS_SQUARE
        }
    )

    templateOption span-horizontally (
        name: Span Horizontally
        sequence: 70
        appearance {
            cssClasses: t-Cards--spanHorizontally
        }
        advanced {
            identifier: SPAN_HORIZONTALLY
        }
    )

    templateOption use-theme-colors (
        name: Apply Theme Colors
        sequence: 10
        appearance {
            cssClasses: u-colors
        }
        advanced {
            identifier: USE_THEME_COLORS
        }
    )

)
