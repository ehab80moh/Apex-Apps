classicReportTemplate copy-of-cards-2 (
    name: copy_of_cards_2
    templateClass: custom1
    type: namedColumn
    templateOptions {
        preset: [
            t-Cards--basic
            t-Cards--3cols
            t-Cards--animColorFill
        ]
    }
    reportTemplate {
        top: <ul class="t-Cards #COMPONENT_CSS_CLASSES#" #REPORT_ATTRIBUTES# id="#REGION_STATIC_ID#_cards" data-region-id="#REGION_STATIC_ID#">
        bottom:
            ```html
            </ul>
            <table class="t-Report-pagination" role="presentation">#PAGINATION#</table>
            ```
    }
    rowTemplate1 {
        template:
            ```html
            <div class="flex flex-col space-y-4">
                <!-- كارت واحد -->
                <a href="news-details?id=#NEWS_ID#" 
                   class="flex flex-col items-center bg-white border border-gray-200 rounded-lg shadow md:flex-row md:max-w-[136rem] hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700"
                   style="margin: 10px;">
            
                    <!-- صورة الخبر -->
                    <img class="object-cover w-full rounded-t-lg h-96 md:h-auto md:w-48 md:rounded-none md:rounded-s-lg" 
                         src="#NEWS_IMAGES_1#" alt="#NEWS_TITLE_1#" onerror="this.src='fallback-image.jpg';">
            
                    <!-- محتوى الخبر -->
                    <div class="flex flex-col justify-between p-4 leading-normal">
                        <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                            #NEWS_TITLE_1#
                        </h5>
                        <p class="mb-3 font-normal text-gray-700 dark:text-gray-400">
                            #NEWS_TEXT_1#
                        </p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                            Published: #NEWS_DATETIME_1#
                        </p>
                    </div>
                </a>
            </div>
            
            ```
    }
    rowTemplate2 {
        template:
            ```html
            <a href="#NEWS_IMAGES#" 
               class="flex flex-col items-center bg-white border border-gray-200 rounded-lg shadow md:flex-row md:max-w-[136rem] hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700"
               style="margin: 10px;">
            
                <!-- News Image -->
                <img class="object-cover w-full rounded-t-lg h-96 md:h-auto md:w-48 md:rounded-none md:rounded-s-lg" 
                     src="#NEWS_IMAGE#" alt="#NEWS_TITLE#" onerror="this.src='fallback-image.jpg';">
            
                <!-- News Content -->
                <div class="flex flex-col justify-between p-4 leading-normal">
                    <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                        #NEWS_TITLE#
                    </h5>
                    <p class="mb-3 font-normal text-gray-700 dark:text-gray-400">
                        #NEWS_TEXT#
                    </p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        Published: #NEWS_DATETIME#
                    </p>
                </div>
            </a>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              #PAGINATION_NEXT#<span class="a-Icon icon-right-arrow" aria-hidden="true"></span>
            </a>
            ```
        previousPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow" aria-hidden="true"></span>#PAGINATION_PREVIOUS#
            </a>
            ```
        nextSet:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              #PAGINATION_NEXT_SET#<span class="a-Icon icon-right-arrow" aria-hidden="true"></span>
            </a>
            ```
        previousSet:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow" aria-hidden="true"></span>#PAGINATION_PREVIOUS_SET#
            </a>
            ```
    }
    advanced {
        identifier: COPY_OF_CARDS_2
    }

    templateOption 2-columns (
        name: 2 Columns
        sequence: 15
        appearance {
            cssClasses: t-Cards--cols
        }
        advanced {
            identifier: 2_COLUMNS
        }
    )

    templateOption 2-lines (
        name: 2 Lines
        sequence: 10
        appearance {
            cssClasses: t-Cards--desc-2ln
        }
        advanced {
            identifier: 2_LINES
        }
    )

    templateOption 3-columns (
        name: 3 Columns
        sequence: 20
        appearance {
            cssClasses: t-Cards--3cols
        }
        advanced {
            identifier: 3_COLUMNS
        }
    )

    templateOption 3-lines (
        name: 3 Lines
        sequence: 20
        appearance {
            cssClasses: t-Cards--desc-3ln
        }
        advanced {
            identifier: 3_LINES
        }
    )

    templateOption 4-columns (
        name: 4 Columns
        sequence: 30
        appearance {
            cssClasses: t-Cards--4cols
        }
        advanced {
            identifier: 4_COLUMNS
        }
    )

    templateOption 4-lines (
        name: 4 Lines
        sequence: 30
        appearance {
            cssClasses: t-Cards--desc-4ln
        }
        advanced {
            identifier: 4_LINES
        }
    )

    templateOption 5-columns (
        name: 5 Columns
        sequence: 50
        appearance {
            cssClasses: t-Cards--5cols
        }
        advanced {
            identifier: 5_COLUMNS
        }
    )

    templateOption basic (
        name: Basic
        sequence: 10
        appearance {
            cssClasses: t-Cards--basic
        }
        advanced {
            identifier: BASIC
        }
    )

    templateOption block (
        name: Block
        sequence: 40
        appearance {
            cssClasses: [
                t-Cards--featured
                t-Cards--block
                force-fa-lg
            ]
        }
        advanced {
            identifier: BLOCK
        }
    )

    templateOption card-raise-card (
        name: Raise Card
        sequence: 20
        appearance {
            cssClasses: t-Cards--animRaiseCard
        }
        advanced {
            identifier: CARD_RAISE_CARD
        }
    )

    templateOption cards-color-fill (
        name: Color Fill
        sequence: 10
        appearance {
            cssClasses: t-Cards--animColorFill
        }
        advanced {
            identifier: CARDS_COLOR_FILL
        }
    )

    templateOption compact (
        name: Compact
        sequence: 20
        appearance {
            cssClasses: t-Cards--compact
        }
        help {
            helpText: Use this option when you want to show smaller cards.
        }
        advanced {
            identifier: COMPACT
        }
    )

    templateOption display-icons (
        name: Display Icons
        sequence: 10
        appearance {
            cssClasses: t-Cards--displayIcons
        }
        advanced {
            identifier: DISPLAY_ICONS
        }
    )

    templateOption display-initials (
        name: Display Initials
        sequence: 20
        appearance {
            cssClasses: t-Cards--displayInitials
        }
        advanced {
            identifier: DISPLAY_INITIALS
        }
    )

    templateOption display-subtitle (
        name: Display Subtitle
        sequence: 20
        appearance {
            cssClasses: t-Cards--displaySubtitle
        }
        advanced {
            identifier: DISPLAY_SUBTITLE
        }
    )

    templateOption featured (
        name: Featured
        sequence: 30
        appearance {
            cssClasses: [
                t-Cards--featured
                force-fa-lg
            ]
        }
        advanced {
            identifier: FEATURED
        }
    )

    templateOption float (
        name: Float
        sequence: 60
        appearance {
            cssClasses: t-Cards--float
        }
        advanced {
            identifier: FLOAT
        }
    )

    templateOption hidden-body-text (
        name: Hidden
        sequence: 50
        appearance {
            cssClasses: t-Cards--hideBody
        }
        help {
            helpText: This option hides the card body which contains description and subtext.
        }
        advanced {
            identifier: HIDDEN_BODY_TEXT
        }
    )

    templateOption icons-rounded (
        name: Rounded Corners
        sequence: 10
        appearance {
            cssClasses: t-Cards--iconsRounded
        }
        help {
            helpText: The icons are displayed within a square with rounded corners.
        }
        advanced {
            identifier: ICONS_ROUNDED
        }
    )

    templateOption icons-square (
        name: Square
        sequence: 20
        appearance {
            cssClasses: t-Cards--iconsSquare
        }
        help {
            helpText: The icons are displayed within a square shape.
        }
        advanced {
            identifier: ICONS_SQUARE
        }
    )

    templateOption span-horizontally (
        name: Span Horizontally
        sequence: 70
        appearance {
            cssClasses: t-Cards--spanHorizontally
        }
        advanced {
            identifier: SPAN_HORIZONTALLY
        }
    )

    templateOption use-theme-colors (
        name: Apply Theme Colors
        sequence: 10
        appearance {
            cssClasses: u-colors
        }
        advanced {
            identifier: USE_THEME_COLORS
        }
    )

)
