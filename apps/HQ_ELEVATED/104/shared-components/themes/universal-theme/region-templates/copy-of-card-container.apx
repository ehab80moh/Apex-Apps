regionTemplate copy-of-card-container (
    name: copy_of_card_container
    templateClass: custom1
    templateOptions {
        default: u-colors
    }
    region {
        template:
            ```html
            <div class="custom-card" 
                 style="background: linear-gradient(135deg, #ffffff, #f3f4f6); border-radius: 12px; 
                        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1); padding: 20px; margin: 10px; 
                        width: 300px; text-align: center;">
            
                <!-- News Title -->
                <h3 class="custom-title" 
                    style="font-size: 20px; font-weight: bold; color: #333; margin-bottom: 15px;">
                    #NEWS_TITLE#
                </h3>
            
                <!-- News Image -->
                <div class="custom-image" style="margin-bottom: 15px;">
                    <img src="#NEWS_IMAGE#" alt="News Image" 
                         style="width: 100%; height: auto; border-radius: 8px; object-fit: cover;">
                </div>
            
                <!-- News Date -->
                <div class="custom-date" 
                     style="font-size: 14px; font-weight: bold; color: #6c757d; margin-bottom: 10px;">
                    Published: #NEWS_DATETIME#
                </div>
            
                <!-- News Text -->
                <div class="custom-text" 
                     style="font-size: 14px; color: #555; line-height: 1.5; margin-bottom: 15px;">
                    #NEWS_TEXT#
                </div>
            
                <!-- View Details Button -->
                <a href="#NEWS_IMAGES#" 
                   style="display: inline-block; background-color: #007bff; color: #ffffff; text-decoration: none; 
                          padding: 10px 15px; border-radius: 8px; font-weight: bold; font-size: 14px;">
                    View More Images
                </a>
            </div>
            
            ```
    }
    accessibility {
        landmarkType: region
    }
    advanced {
        identifier: COPY_OF_CARD_CONTAINER
    }

    templateOption apply-theme-colors (
        name: Apply Theme Colors
        sequence: 1
        appearance {
            cssClasses: u-colors
        }
        help {
            helpText: Applies the colors from the theme's color palette to the icons or initials within cards.
        }
        advanced {
            identifier: APPLY_THEME_COLORS
        }
    )

    templateOption style-a (
        name: Style A
        sequence: 10
        appearance {
            cssClasses: t-CardsRegion--styleA
        }
        advanced {
            identifier: STYLE_A
        }
    )

    templateOption style-b (
        name: Style B
        sequence: 20
        appearance {
            cssClasses: t-CardsRegion--styleB
        }
        advanced {
            identifier: STYLE_B
        }
    )

    templateOption style-c (
        name: Style C
        sequence: 30
        appearance {
            cssClasses: t-CardsRegion--styleC
        }
        advanced {
            identifier: STYLE_C
        }
    )

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot sortOrder (
        name: Sort Order
        staticId: ORDER_BY_ITEM
        supports {
            regions: false
            items: true
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
    )

)
