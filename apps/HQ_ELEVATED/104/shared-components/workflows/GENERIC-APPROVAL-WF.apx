                    END;
                    
                    ```
            }
            layout {
                sequence: 150
            }
            advanced {
                diagram: "{\"position\":{\"x\":1460,\"y\":960},\"z\":27}"
            }

            connection (
                name: New
                activity {
                    to: @new_1
                }
                advanced {
                    diagram: "{\"source\":{\"name\":\"topLeft\",\"args\":{\"dx\":\"95.455%\",\"dy\":\"50%\",\"rotate\":true}},\"target\":{\"name\":\"topLeft\",\"args\":{\"dx\":\"33.333%\",\"dy\":\"50%\",\"rotate\":true}},\"vertices\":[],\"z\":29,\"label\":{\"distance\":0.5,\"offset\":0}}"
                }
            )

        )

        variable APPROVER (
            label {
                label: Approver
            }
            value {
                type: item
                item: P_APPROVER
            }
        )

        variable TASK_OUTCOME (
            label {
                label: TASK_OUTCOME
            }
            value {
                type: item
                item: TASK_OUTCOME
            }
        )

        variable V_STEP (
            label {
                label: V_STEP
            }
            value {
                type: staticValue
                staticValue: 0
            }
        )

        variable V_TASK_ID (
            label {
                label: V_TASK_ID
            }
        )

        participant (
            name: New
            type: admin
            value {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 1825 from dual
                    union
                    select 3199 from dual
                    union
                    select 1837 from dual
                    
                    ```
            }
        )

    )

