        activity update-request-approved (
            name: Update Request as Approved
            type: executeCode
            source {
                plsqlCode:
                    ```plsql
                    BEGIN
                        UPDATE HQ_ELEVATED.ITR_REQUESTS
                           SET status = 20,
                               approved = 1,
                               last_approval_date = SYSDATE
                         WHERE request_id = TO_NUMBER(:P_REQUEST_ID);
                    
                        hq_elevated.gen_wf_log_pkg.capture_workflow_log(
                            p_workflow_id => :APEX$WORKFLOW_ID
                        );
                    END;
                    ```
            }
            layout {
                sequence: 60
            }
            advanced {
                diagram: "{\"position\":{\"x\":190,\"y\":-510}}"
            }

            connection (
                name: New
                activity {
                    to: @coordinator-triage-task
                }
            )

        )

        activity update-request-closed (
            name: Update Request as Closed Complete
            type: executeCode
            source {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_status NUMBER;
                    BEGIN
                        SELECT status
                          INTO l_status
                          FROM hq_elevated.itr_requests
                         WHERE request_id = TO_NUMBER(:P_REQUEST_ID);
                    
                        IF l_status <> 150 THEN
                            RAISE_APPLICATION_ERROR(
                                -20216,
                                'IT request reached the close activity with invalid status: ' || l_status
                            );
                        END IF;
                    
                        hq_elevated.gen_wf_log_pkg.capture_workflow_log(
                            p_workflow_id => :APEX$WORKFLOW_ID
                        );
                    END;
                    ```
            }
            layout {
                sequence: 130
            }
            advanced {
                diagram: "{\"position\":{\"x\":200,\"y\":220}}"
            }

            connection (
                name: Done
                activity {
                    to: @end-approve
                }
            )

        )

        activity update-request-rejected (
            name: Update Request as Rejected
            type: executeCode
            source {
                plsqlCode:
                    ```plsql
                    BEGIN
                        UPDATE HQ_ELEVATED.ITR_REQUESTS
                           SET status = 140,
                               approved = 0,
                               last_approval_date = SYSDATE
                         WHERE request_id = TO_NUMBER(:P_REQUEST_ID);
                    
                        hq_elevated.gen_wf_log_pkg.capture_workflow_log(
                            p_workflow_id => :APEX$WORKFLOW_ID
                        );
                    END;
                    ```
            }
            layout {
                sequence: 50
            }
            advanced {
                diagram: "{\"position\":{\"x\":-200,\"y\":-290}}"
            }

            connection (
                name: New
                activity {
                    to: @end-reject
                }
            )

        )

        activity update-request-reopened (
            name: Update Request as Reopened
            type: executeCode
            source {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_team_id HQ_ELEVATED.ITR_REQUESTS.ASSIGNED_TEAM_ID%TYPE;
                    BEGIN
                        UPDATE HQ_ELEVATED.ITR_REQUESTS
                           SET status = 100
                         WHERE request_id = TO_NUMBER(:P_REQUEST_ID)
                           AND status = 120
                         RETURNING assigned_team_id INTO l_team_id;
                    
                        IF SQL%ROWCOUNT <> 1 THEN
                            RAISE_APPLICATION_ERROR(
                                -20216,
                                'Only an on-hold IT request can be reopened.'
                            );
                        END IF;
                    
                        IF l_team_id IS NULL THEN
                            RAISE_APPLICATION_ERROR(
                                -20212,
                                'Cannot reopen an IT request without an assigned team.'
                            );
                        END IF;
                    
                        HQ_ELEVATED.ITR_TEAM_QUEUE_PKG.ENQUEUE_REQUEST(
                            p_request_id => TO_NUMBER(:P_REQUEST_ID),
                            p_team_id    => l_team_id
                        );
                    
                        hq_elevated.gen_wf_log_pkg.capture_workflow_log(
                            p_workflow_id => :APEX$WORKFLOW_ID
                        );
                    END;
                    ```
            }
            layout {
                sequence: 120
            }
            advanced {
                diagram: "{\"position\":{\"x\":520,\"y\":-20}}"
            }

            connection (
                name: LoopBackToTechnician
                activity {
                    to: @technician-execution-task
                }
            )

        )

        activity validate-leader-assignment-state (
            name: Validate Leader Assignment State
            type: executeCode
            source {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_status      NUMBER;
                        l_assigned_to VARCHAR2(255);
                    BEGIN
                        SELECT status, assigned_to
                          INTO l_status, l_assigned_to
                          FROM hq_elevated.itr_requests
                         WHERE request_id = TO_NUMBER(:P_REQUEST_ID);
                    
                        IF l_status <> 110 OR l_assigned_to IS NULL THEN
                            RAISE_APPLICATION_ERROR(
                                -20216,
                                'Leader task completed before a technician was assigned.'
                            );
                        END IF;
                    END;
                    ```
            }
            layout {
                sequence: 85
            }
            advanced {
                diagram: "{\"position\":{\"x\":350,\"y\":-230}}"
            }

            connection (
                name: AssignmentStateValid
                activity {
                    to: @technician-execution-task
                }
            )

        )

        activity validate-technician-completion-state (
            name: Validate Technician Completion State
            type: executeCode
            source {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_status NUMBER;
                    BEGIN
                        SELECT status
                          INTO l_status
                          FROM hq_elevated.itr_requests
                         WHERE request_id = TO_NUMBER(:P_REQUEST_ID);
                    
                        IF l_status <> 130 THEN
                            RAISE_APPLICATION_ERROR(
                                -20216,
                                'Technician task completed with invalid request status: ' || l_status
                            );
                        END IF;
                    END;
                    ```
            }
            layout {
                sequence: 95
            }
            advanced {
                diagram: "{\"position\":{\"x\":350,\"y\":-120}}"
            }

            connection (
                name: CompletionStateValid
                activity {
                    to: @requester-verification-task
                }
            )

        )

