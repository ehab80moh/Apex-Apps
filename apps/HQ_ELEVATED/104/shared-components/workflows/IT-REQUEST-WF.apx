                    type: sqlQuery
                    sqlQuery:
                        ```sql
                        SELECT COALESCE(
                                   (SELECT assigned_to
                                      FROM HQ_ELEVATED.ITR_REQUESTS
                                     WHERE request_id = TO_NUMBER(:P_REQUEST_ID)),
                                   (SELECT LISTAGG(username, ':') WITHIN GROUP (ORDER BY username)
                                      FROM HQ_ELEVATED.ITR_TEAM_MEMBERS
                                     WHERE team_id = (SELECT assigned_team_id
                                                        FROM HQ_ELEVATED.ITR_REQUESTS
                                                       WHERE request_id = TO_NUMBER(:P_REQUEST_ID))
                                       AND username IS NOT NULL)
                               )
                          FROM dual
                        ```
                }
            )

